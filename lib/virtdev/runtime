#!/usr/bin/env bash
#
# Names, paths, and cleanup for host-only per-machine runtime artifacts.
# QEMU argv and cleanup share these constants. Path accessors are pure.
# runtime_clean_sockets leaves port and launch state intact; runtime_clean is
# the full teardown. Cleaners attempt every artifact and report leftovers.
# Launch-phase helpers atomically publish/read shim or qemu ownership.
#
set -euo pipefail

# Basenames are independent of environment configuration.
readonly runtime_monitor_sock_name=monitor.sock
readonly runtime_console_sock_name=console.sock
readonly runtime_network_sock_name=network.sock
readonly runtime_legacy_passt_sock_name=passt.sock
readonly runtime_qmp_sock_name=qmp.sock
readonly runtime_port_name=port
readonly runtime_port_tmp_name=port.tmp
readonly runtime_launch_phase_name=launch.phase
readonly runtime_launch_phase_tmp_name=launch.phase.tmp
readonly runtime_launch_phase_shim=shim
readonly runtime_launch_phase_qemu=qemu
readonly runtime_socket_path_max=107

# Global because import() sources libraries from inside a function.
# shellcheck disable=SC2034  # read by consumers (qemu_command) and by the helpers below
declare -gra runtime_socket_basenames=(
  "${runtime_monitor_sock_name}"
  "${runtime_console_sock_name}"
  "${runtime_network_sock_name}"
  "${runtime_qmp_sock_name}"
)

declare -gra runtime_socket_cleanup_basenames=(
  "${runtime_socket_basenames[@]}"
  "${runtime_legacy_passt_sock_name}"
)

# Full cleanup adds port and launch-phase state.
declare -gra runtime_control_basenames=(
  "${runtime_socket_cleanup_basenames[@]}"
  "${runtime_port_name}"
  "${runtime_port_tmp_name}"
  "${runtime_launch_phase_name}"
  "${runtime_launch_phase_tmp_name}"
)

runtime_monitor_sock() {
  printf '%s' "${1}/${runtime_monitor_sock_name}"
}

runtime_console_sock() {
  printf '%s' "${1}/${runtime_console_sock_name}"
}

runtime_network_sock() {
  printf '%s' "${1}/${runtime_network_sock_name}"
}

runtime_qmp_sock() {
  printf '%s' "${1}/${runtime_qmp_sock_name}"
}

runtime_port_file() {
  printf '%s' "${1}/${runtime_port_name}"
}

runtime_port_tmp_file() {
  printf '%s' "${1}/${runtime_port_tmp_name}"
}

runtime_launch_phase_file() {
  printf '%s' "${1}/${runtime_launch_phase_name}"
}

runtime_launch_phase_publish() {
  local -r file="${1}" phase="${2}" tmp="${1}.tmp"
  case "${phase}" in
    "${runtime_launch_phase_shim}"|"${runtime_launch_phase_qemu}") ;;
    *) return 1 ;;
  esac
  runtime_remove_artifact "${tmp}" || return 1
  if ! printf '%s\n' "${phase}" > "${tmp}"; then
    runtime_remove_artifact "${tmp}" || true
    return 1
  fi
  if ! mv -T -- "${tmp}" "${file}"; then
    runtime_remove_artifact "${tmp}" || true
    return 1
  fi
}

runtime_launch_phase_read() {
  local -r file="${1}"
  [[ -f "${file}" && ! -L "${file}" ]] || return 1
  local size phase=''
  size="$(stat -c '%s' -- "${file}" 2>/dev/null)" || return 1
  # Both canonical tokens are four ASCII bytes plus one newline. The exact
  # bound rejects extra records, partial writes, NUL-bearing state, and floods.
  [[ "${size}" == 5 ]] || return 1
  IFS= read -r phase < "${file}" || return 1
  case "${phase}" in
    "${runtime_launch_phase_shim}"|"${runtime_launch_phase_qemu}")
      printf '%s' "${phase}"
      ;;
    *) return 1 ;;
  esac
}

# Socket-only cleanup must preserve an already-published port.
runtime_remove_artifact() {
  local -r path="${1}"
  [[ -e "${path}" || -L "${path}" ]] || return 0
  if [[ -d "${path}" && ! -L "${path}" ]]; then
    printf >&2 "warning: runtime artifact is a directory; refusing recursive removal: '%s'\n" \
      "${path}"
    return 1
  fi
  if ! rm -f -- "${path}"; then
    printf >&2 "warning: could not remove runtime artifact: '%s'\n" "${path}"
    return 1
  fi
}

runtime_clean_sockets() {
  local -r dir="${1}"
  local name status=0
  for name in "${runtime_socket_cleanup_basenames[@]}"; do
    runtime_remove_artifact "${dir}/${name}" || status=1
  done
  return "${status}"
}

# Full teardown includes port and launch provenance.
runtime_clean() {
  local -r dir="${1}"
  local name status=0
  for name in "${runtime_control_basenames[@]}"; do
    runtime_remove_artifact "${dir}/${name}" || status=1
  done
  return "${status}"
}

runtime_socket_paths_fit() {
  local -r dir="${1}"
  local LC_ALL=C
  local name path
  for name in "${runtime_socket_basenames[@]}"; do
    path="${dir}/${name}"
    (( ${#path} <= runtime_socket_path_max )) || return 1
  done
}
