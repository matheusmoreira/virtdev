#!/usr/bin/env bash
#
# runtime library: the per-machine ephemeral runtime artifact set.
#
# One source of truth for a project (or maintenance) virtual machine's
# transient host-side files: the monitor/console/passt/qmp sockets, the launch
# phase/provenance marker, and the `port` file that signals "this machine is
# running". The socket set, the
# argv path accessors, the cleanup helpers, and validate's sun_path
# length feed all derive from the name constants below, so the argv QEMU
# is launched with and the files cleaned up on teardown cannot drift
# apart. Adding a socket to the set is a one-line array change that every
# cleanup site and length check picks up automatically.
#
# These are host-side artifacts in the 0700 per-project directory. The
# guest has no path to them — same exposure class as the QEMU monitor
# socket. Nothing here spawns a process or touches the network; the
# accessors are pure and the cleaners are idempotent `rm -f`.
#
# Public:
#   Name constants (basenames, readonly):
#     runtime_monitor_sock_name   monitor.sock
#     runtime_console_sock_name   console.sock
#     runtime_passt_sock_name     passt.sock
#     runtime_qmp_sock_name       qmp.sock
#     runtime_port_name           port
#     runtime_launch_phase_name   launch.phase
#
#   runtime_socket_basenames      Array of the socket basenames (built
#                                 from the name constants). The single
#                                 socket set — accessors, cleanup, and the
#                                 sun_path maxlen all read it.
#
#   Path accessors (echo <dir>/<name>, no trailing newline). <dir> is the
#   per-machine socket directory (the per-project directory for a project
#   machine; projects/maintenance for the maintenance machine):
#     runtime_monitor_sock <dir>
#     runtime_console_sock <dir>
#     runtime_passt_sock <dir>
#     runtime_qmp_sock <dir>
#     runtime_launch_phase_file <dir>
#   These are what qemu_command uses to wire the QEMU argv, so the argv
#   socket paths and the cleanup set share one source.
#
#   runtime_clean_sockets <dir>   Remove every socket basename under <dir>.
#                                 Sockets ONLY — leaves the port and phase
#                                 files. The
#                                 pre-launch stale-socket sweep uses this;
#                                 it must not delete a just-written port.
#   runtime_clean <dir>           runtime_clean_sockets <dir> plus the port
#                                 and launch-phase files. The full teardown
#                                 (stop, failure cleanup) uses this.
#   runtime_launch_phase_publish <file> <shim|qemu>
#                                 Atomically publish which process owns the
#                                 unit's eventual ExecMainStatus.
#   runtime_launch_phase_read <file>
#                                 Print a canonical phase, or return nonzero
#                                 for missing/irregular/malformed state.
#
#   runtime_socket_name_maxlen    Print the longest socket basename length
#                                 (bytes). Feeds validate's AF_UNIX
#                                 sun_path overhead so the project-name cap
#                                 tracks the socket set instead of a magic
#                                 constant.
#
# No exit codes reserved: the accessors are pure. Cleaners attempt every path,
# diagnose unexpected directories/removal failures, and return nonzero if any
# artifact remains; nothing here calls error().
#
set -euo pipefail

# True constants — plain basenames, independent of any env var.
readonly runtime_monitor_sock_name=monitor.sock
readonly runtime_console_sock_name=console.sock
readonly runtime_passt_sock_name=passt.sock
readonly runtime_qmp_sock_name=qmp.sock
readonly runtime_port_name=port
readonly runtime_launch_phase_name=launch.phase
readonly runtime_launch_phase_tmp_name=launch.phase.tmp
readonly runtime_launch_phase_shim=shim
readonly runtime_launch_phase_qemu=qemu

# The single socket set, built FROM the name constants so a rename or
# addition happens in exactly one place. -gra: global (libraries are
# sourced from within import(), so a bare declare would be function-local)
# and read-only.
# shellcheck disable=SC2034  # read by consumers (qemu_command) and by the helpers below
declare -gra runtime_socket_basenames=(
  "${runtime_monitor_sock_name}"
  "${runtime_console_sock_name}"
  "${runtime_passt_sock_name}"
  "${runtime_qmp_sock_name}"
)

# Every artifact removed by a full runtime teardown. Kept separate from the
# socket-only set because the pre-launch socket sweep must not accidentally
# remove a deliberately published port/phase in callers that use it.
declare -gra runtime_control_basenames=(
  "${runtime_socket_basenames[@]}"
  "${runtime_port_name}"
  "${runtime_launch_phase_name}"
  "${runtime_launch_phase_tmp_name}"
)

runtime_monitor_sock() {
  printf '%s' "${1}/${runtime_monitor_sock_name}"
}

runtime_console_sock() {
  printf '%s' "${1}/${runtime_console_sock_name}"
}

runtime_passt_sock() {
  printf '%s' "${1}/${runtime_passt_sock_name}"
}

runtime_qmp_sock() {
  printf '%s' "${1}/${runtime_qmp_sock_name}"
}

runtime_launch_phase_file() {
  printf '%s' "${1}/${runtime_launch_phase_name}"
}

runtime_launch_phase_publish() {
  local -r file="${1}" phase="${2}" tmp="${1}.tmp"
  case "${phase}" in
    "${runtime_launch_phase_shim}"|"${runtime_launch_phase_qemu}") ;;
    *) return 1 ;;
  esac
  runtime_remove_artifact "${tmp}" || return 1
  if ! printf '%s\n' "${phase}" > "${tmp}"; then
    runtime_remove_artifact "${tmp}" || true
    return 1
  fi
  if ! mv -T -- "${tmp}" "${file}"; then
    runtime_remove_artifact "${tmp}" || true
    return 1
  fi
}

runtime_launch_phase_read() {
  local -r file="${1}"
  [[ -f "${file}" && ! -L "${file}" ]] || return 1
  local size phase=''
  size="$(stat -c '%s' -- "${file}" 2>/dev/null)" || return 1
  # Both canonical tokens are four ASCII bytes plus one newline. The exact
  # bound rejects extra records, partial writes, NUL-bearing state, and floods.
  [[ "${size}" == 5 ]] || return 1
  IFS= read -r phase < "${file}" || return 1
  case "${phase}" in
    "${runtime_launch_phase_shim}"|"${runtime_launch_phase_qemu}")
      printf '%s' "${phase}"
      ;;
    *) return 1 ;;
  esac
}

# Remove every socket basename under <dir>. Sockets only — the port file is
# deliberately left in place so callers that sweep stale sockets before a
# launch do not delete a port that has already been written.
runtime_remove_artifact() {
  local -r path="${1}"
  [[ -e "${path}" || -L "${path}" ]] || return 0
  if [[ -d "${path}" && ! -L "${path}" ]]; then
    printf >&2 "warning: runtime artifact is a directory; refusing recursive removal: '%s'\n" \
      "${path}"
    return 1
  fi
  if ! rm -f -- "${path}"; then
    printf >&2 "warning: could not remove runtime artifact: '%s'\n" "${path}"
    return 1
  fi
}

runtime_clean_sockets() {
  local -r dir="${1}"
  local name status=0
  for name in "${runtime_socket_basenames[@]}"; do
    runtime_remove_artifact "${dir}/${name}" || status=1
  done
  return "${status}"
}

# Full teardown: sockets, port "running" signal, and launch provenance.
runtime_clean() {
  local -r dir="${1}"
  local name status=0
  for name in "${runtime_control_basenames[@]}"; do
    runtime_remove_artifact "${dir}/${name}" || status=1
  done
  return "${status}"
}

# The longest socket basename length, in bytes. LC_ALL=C so ${#name}
# counts bytes (matching sun_path's byte limit), not characters, even
# though the current basenames are pure ASCII. Computed from the set so
# validate's sun_path overhead cannot fall out of sync with it. Currently
# 12 (monitor.sock / console.sock); qmp.sock is 8, so adding it did not
# move the maximum and validate's project-name cap is unchanged.
runtime_socket_name_maxlen() {
  local LC_ALL=C
  local name max=0
  for name in "${runtime_socket_basenames[@]}"; do
    (( ${#name} > max )) && max=${#name}
  done
  printf '%s' "${max}"
}
