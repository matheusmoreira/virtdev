#!/usr/bin/env bash
# shellcheck disable=SC2154  # machine constants are provided by import
# Project enumeration, unit state, and generation validation.
#
# Public API: project_list, project_list_into; project_state; project_load_state;
# project_is_{running,stopped,unreachable,outdated,detached}; project_require;
# generation_read_{base,project}; and their display-only lenient variants.
#
# Running and stopped are deliberately not complements: transitional or unknown
# units satisfy neither. project_is_outdated returns 2 for corrupt project state
# and 3 for corrupt shared-base state; callers must never rebuild either case.
# Detached authority additionally requires two readable, backing-free images.
# Numeric generations are canonical integers in 0..generation_max.
#
# Exit 3 means project not found; exit 82 means corrupt generation state.
#

set -euo pipefail

import enumerate error machine validate

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

readonly generation_max=2147483647

project_list_into() {
  local -n _project_list_result="${1}"
  local LC_ALL=C
  local -r projects_dir="${VIRTDEV_HOME}/projects"
  local -a discovered=()
  local name

  _project_list_result=()
  [[ -d "${projects_dir}" ]] || return 0
  enumerate_nul_sorted discovered "${enumerate_max_bytes}" \
    "${enumerate_max_records}" \
    find "${projects_dir}" -maxdepth 1 -mindepth 1 -type d -printf '%f\0' \
    || return $?
  for name in "${discovered[@]}"; do
    project_name_is_valid "${name}" || continue
    [[ "${name}" == "maintenance" ]] && continue
    _project_list_result+=("${name}")
  done
  return 0
}

project_list() {
  local -a projects=()
  project_list_into projects || return $?
  (( ${#projects[@]} )) && printf '%s\n' "${projects[@]}"
  return 0
}

project_state() {
  if ! machine_target_resolve "${1}"; then
    printf 'unknown\n'
    return 0
  fi
  machine_state "${1}"
}

# These predicates are intentionally not complements: transitional or unknown
# state satisfies neither, so destructive callers remain fail-closed.
project_is_running() {
  [[ "$(project_state "${1}")" == running ]]
}

project_is_stopped() {
  [[ "$(project_state "${1}")" == stopped ]]
}

project_is_unreachable() {
  machine_target_resolve "${1}" && machine_is_unreachable "${1}"
}

_project_load_state_impl() {
  local -n _project_state_result=$1
  shift
  (( $# )) || return 0

  local -A _project_state_unit_projects=()
  local -a _project_state_units=()
  local _project_state_project
  for _project_state_project in "$@"; do
    _project_state_result["${_project_state_project}"]=unknown
    _project_state_unit_projects["virtdev-${_project_state_project}.service"]="${_project_state_project}"
    _project_state_units+=("virtdev-${_project_state_project}.service")
  done

  local _project_state_output
  if ! _project_state_output="$(systemctl --user show "${_project_state_units[@]}" \
      --property=Id --property=ActiveState 2>/dev/null)"; then
    return 0
  fi

  local _project_state_id='' _project_state_active='' _project_state_line
  while IFS= read -r _project_state_line; do
    if [[ -z "${_project_state_line}" ]]; then
      if [[ -v _project_state_unit_projects["${_project_state_id}"] ]]; then
        _project_state_project="${_project_state_unit_projects[${_project_state_id}]}"
        _project_state_result["${_project_state_project}"]="$(
          machine_state_from_active "${_project_state_active}"
        )"
      fi
      _project_state_id=''
      _project_state_active=''
      continue
    fi
    case "${_project_state_line}" in
      Id=*)          _project_state_id="${_project_state_line#Id=}" ;;
      ActiveState=*) _project_state_active="${_project_state_line#ActiveState=}" ;;
    esac
  done <<< "${_project_state_output}"
  if [[ -v _project_state_unit_projects["${_project_state_id}"] ]]; then
    _project_state_project="${_project_state_unit_projects[${_project_state_id}]}"
    _project_state_result["${_project_state_project}"]="$(
      machine_state_from_active "${_project_state_active}"
    )"
  fi
}

_project_load_state_via_proxy() {
  local -n _virtdev_load_proxy_result=$1
  shift
  local -A _virtdev_load_proxy_values=()
  _project_load_state_impl _virtdev_load_proxy_values "$@"
  local _virtdev_load_proxy_project _virtdev_load_proxy_value
  for _virtdev_load_proxy_project in "${!_virtdev_load_proxy_values[@]}"; do
    _virtdev_load_proxy_value="${_virtdev_load_proxy_values[${_virtdev_load_proxy_project}]}"
    _virtdev_load_proxy_result["${_virtdev_load_proxy_project}"]="${_virtdev_load_proxy_value}"
  done
}

_project_load_state_dispatch() {
  while [[ -R "${2}" ]]; do
    if (( ${1} >= 32 )); then
      printf >&2 'project_load_state: result nameref chain is too deep\n'
      return 2
    fi
    if [[ "$(declare -p "${2}" 2>/dev/null)" \
          =~ ^declare\ -[a-zA-Z]*n[a-zA-Z]*\ [a-zA-Z_][a-zA-Z0-9_]*=\"([a-zA-Z_][a-zA-Z0-9_]*)\"$ ]]; then
      set -- "$(( ${1} + 1 ))" "${BASH_REMATCH[1]}" "${@:3}"
      continue
    fi
    printf >&2 'project_load_state: result nameref must target an array name\n'
    return 2
  done

  case "${2}" in
    _project_state_*) _project_load_state_via_proxy "${@:2}" ;;
    *)                _project_load_state_impl "${@:2}" ;;
  esac
}

project_load_state() {
  # Resolve forwarding namerefs before choosing a disjoint helper namespace.
  _project_load_state_dispatch 0 "$@"
}

project_is_outdated() {
  local project="${1}"
  local -r base_file="${VIRTDEV_HOME}/system/generation"
  local -r project_file="${VIRTDEV_HOME}/projects/${project}/generation"
  [[ -f "${base_file}" && ! -L "${base_file}" ]] || return 3
  [[ -f "${project_file}" && ! -L "${project_file}" ]] || return 2
  project_is_detached "${project}" && return 1
  local base_gen project_gen
  # Generation readers panic (exit 82) on corruption, but here they run
  # inside a command substitution, so that exit would be swallowed and
  # the variable left empty — silently reading as "outdated". Capture it
  # explicitly so callers iterating over projects warn and skip instead
  # of destroying a project off an unreadable generation file.
  # Distinguish the source: 3 = the shared BASE file is corrupt (so every
  # project returns 3), 2 = this project's own file is corrupt. 2>/dev/null
  # suppresses the per-file panic; the caller emits the right message.
  base_gen="$(generation_read_base "${base_file}" 2>/dev/null)" || return 3
  project_gen="$(generation_read_project "${project_file}" 2>/dev/null)" || return 2
  [[ "${project_gen}" != "${base_gen}" ]]
}

project_is_detached() {
  local project="${1}"
  local -r project_directory="${VIRTDEV_HOME}/projects/${project}"
  local -r generation_file="${project_directory}/generation"
  [[ -f "${generation_file}" ]] || return 1
  local generation
  generation="$(generation_read_project "${generation_file}" 2>/dev/null)" \
    || return 1
  [[ "${generation}" == detached ]] || return 1

  local disk info
  for disk in system.qcow2 home.qcow2; do
    [[ -f "${project_directory}/${disk}" ]] || return 1
    info="$(qemu-img info --output=json "${project_directory}/${disk}" 2>/dev/null)" \
      || return 1
    [[ ! "${info}" =~ \"backing-filename\"[[:space:]]*: ]] || return 1
  done
}

project_require() {
  local -r project="${1}"
  local -r project_directory="${VIRTDEV_HOME}/projects/${project}"
  if [[ ! -d "${project_directory}" || -L "${project_directory}" ]]; then
    error 3 <<<"Project not found: ${project}"
  fi
}

project_require_ordinary() {
  local -r project="${1}"
  if ! machine_target_resolve "${project}" \
      || [[ "${VIRTDEV_MACHINE_KIND}" != "${machine_kind_project}" ]]; then
    error 3 <<<"Not an ordinary project target: ${project}"
  fi
  project_require "${project}"
}

_generation_error() {
  local -r file="${1}" kind="${2}" content="${3}"
  local escaped_content repair_rule
  printf -v escaped_content '%q' "${content}"
  repair_rule="a canonical integer from 0 through ${generation_max}"
  if [[ "${kind}" == project ]]; then
    repair_rule+=" or the exact project marker 'detached'"
  fi
  error 82 <<MESSAGE
Corrupted ${kind} generation file: '${file}'
Content (bounded): ${escaped_content}
Repair manually with ${repair_rule}.
MESSAGE
}

_generation_read() {
  local -r file="${1}" kind="${2}"
  # C locale makes byte counts and [0-9] agree. A fixed-size `read -N` retains
  # meaningful trailing newlines without command substitution and bounds shell
  # allocation; exact stat-size comparison also rejects NUL/binary contents.
  local LC_ALL=C raw='' file_size content
  if [[ ! -f "${file}" || -L "${file}" ]]; then
    _generation_error "${file}" "${kind}" '<missing-or-nonregular>'
  fi
  file_size="$(stat -c '%s' -- "${file}" 2>/dev/null)" \
    || _generation_error "${file}" "${kind}" '<unreadable>'
  if [[ ! "${file_size}" =~ ^[0-9]+$ || ${file_size} -gt 11 ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  IFS= read -r -N 12 raw < "${file}" 2>/dev/null || true
  if [[ ${#raw} -ne file_size ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi

  content="${raw}"
  if [[ "${content}" == *$'\n' ]]; then
    content="${content%$'\n'}"
  fi
  if [[ "${content}" == *$'\n'* ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi

  if [[ "${kind}" == project && "${content}" == detached ]]; then
    printf '%s' "${content}"
    return 0
  fi
  if [[ ! "${content}" =~ ^(0|[1-9][0-9]*)$ \
        || ${#content} -gt 10 ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  if (( 10#${content} > generation_max )); then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  printf '%s' "${content}"
}

generation_read_base() {
  _generation_read "${1}" base
}

generation_read_project() {
  _generation_read "${1}" project
}

_generation_read_lenient() {
  local -r file="${1}" kind="${2}"
  local result
  if result="$(_generation_read "${file}" "${kind}" 2>/dev/null)"; then
    printf '%s' "${result}"
  else
    printf '%s' '<corrupt>'
  fi
}

generation_read_base_lenient() {
  _generation_read_lenient "${1}" base
}

generation_read_project_lenient() {
  _generation_read_lenient "${1}" project
}
