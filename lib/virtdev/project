#!/usr/bin/env bash
# lib/virtdev/project
#
# Project enumeration and state queries.
#
# Public functions:
#
#   project_list
#       Prints sorted valid project names, one per line.
#       Excludes the reserved 'maintenance' name and entries
#       that don't match the project name regex. Prints nothing
#       and returns 0 if no projects exist.
#
#   project_is_running <project>
#       Returns 0 iff the unit is PROVABLY active. Fail-SAFE partner for the
#       query commands (ssh, monitor, backup, …): an unreachable user manager
#       reads as "not running", so they refuse to touch a machine they cannot
#       confirm is up rather than erroring on a live one.
#
#   project_is_stopped <project>
#       Returns 0 iff the unit is PROVABLY inactive or failed. Fail-CLOSED
#       partner for the destructive commands (destroy, detach, move, nuke, and
#       stop's already-stopped guard): a transitional state OR an unreachable
#       manager reads as "not stopped", so they refuse to mutate a machine that
#       might still be running. NOT the boolean inverse of project_is_running —
#       see their definitions for the indeterminate middle.
#
#   project_is_unreachable <project>
#       Returns 0 iff the user manager could not be reached to determine the
#       unit's state. The "indeterminate because we could not ask" case,
#       distinct from a transitional state; lets a caller (virtdev-stop)
#       fast-fail instead of waiting on a state it can never read.
#
#   project_load_running_state <result-array> <project>...
#       Batch-queries systemctl for the running state of the
#       given projects in a single call. Populates the caller's
#       associative array (passed by nameref): keys are project
#       names, values are 1 (running) or 0 (stopped). DISPLAY ONLY
#       (virtdev-list) — see the note at the definition.
#
#   project_is_outdated <project>
#       Returns 0 if the project's generation does not match the
#       sealed base generation. Returns 1 (not outdated) when either
#       generation file is missing or the project is detached.
#       Returns 2 if the PROJECT's generation file is corrupt, or 3 if
#       the BASE generation file is corrupt. Callers iterating over
#       projects must warn and skip on 2/3, never treat them as outdated
#       (that would feed corruption into a destroy/recreate pipeline).
#       Note 3 is identical for every project (the base is shared), so a
#       caller seeing 3 should report the base once and stop, not blame
#       each project in turn.
#
#   project_is_detached <project>
#       Returns 0 only if the project's generation file contains the literal
#       string 'detached' AND both qcow2 disks are readable standalone images
#       with no backing filename. Metadata alone is not sufficient authority
#       to bypass generation safety.
#
#   project_require <project>
#       Errors with code 3 if the project directory does not exist.
#
#   generation_read_base <file>
#       Reads a base/snapshot generation. Prints a canonical integer in
#       0..2147483647. Base metadata can never be 'detached'.
#
#   generation_read_project <file>
#       Reads a project generation. Prints a canonical bounded integer or the
#       literal 'detached'. Callers that treat detached as authority must also
#       prove standalone qcow2 topology with project_is_detached.
#
#   generation_read_{base,project}_lenient <file>
#       Display-oriented variants that print '<corrupt>' instead of exiting.
#
#   generation_max
#       Largest accepted numeric generation. The bound makes increment and
#       every Bash arithmetic consumer safe.
#
# Exit codes:
#   3   project not found (project_require)
#   82  corrupt generation file (generation readers)
#

set -euo pipefail

import error

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

readonly generation_max=2147483647

project_list() {
  # LC_ALL=C so the name regex is byte-wise ASCII, matching validate_project_name's
  # charset exactly (a UTF-8 locale would let [a-zA-Z] also match accented letters).
  local LC_ALL=C
  local -r projects_dir="${VIRTDEV_HOME}/projects"
  [[ -d "${projects_dir}" ]] || return 0
  local name
  # NUL-delimited (-printf %f\0 + read -d '' + sort -z) so a directory name
  # containing a newline is read as ONE entry and rejected by the regex below,
  # instead of splitting into phantom project names (an owner-creatable dir
  # would otherwise feed bogus names into upgrade/recreate iteration).
  while IFS= read -r -d '' name; do
    [[ "${name}" =~ ^[a-zA-Z0-9_-]+$ ]] || continue
    [[ "${name}" == "maintenance" ]] && continue
    printf '%s\n' "${name}"
  done < <(find "${projects_dir}" -maxdepth 1 -mindepth 1 -type d -printf '%f\0' | sort -z)
}

# _project_active_state <project>
# The single systemctl call behind the running/stopped predicates below. Echoes
# the unit's raw ActiveState (active / activating / deactivating / reloading /
# inactive / failed), or the EMPTY string when the user manager is unreachable
# (no session bus: a cron/at job, `ssh host virtdev-…` without a login session, an
# unset or stale XDG_RUNTIME_DIR). `systemctl show` prints the state and exits 0
# for a known OR unknown unit, but prints NOTHING and exits non-zero when it cannot
# reach the bus — so an empty result means "could not ask", distinct from a real
# "inactive". A known-ABSENT unit (never started, or reset-failed away) reads
# 'inactive' (rc 0) too, so project_is_stopped treats a never-started project as
# stopped — the safe default for destroy/detach/move/nuke. That distinction is what
# lets the predicates fail closed. Verified:
# `XDG_RUNTIME_DIR=/nonexistent systemctl --user show … -p ActiveState --value`
# emits nothing and returns non-zero.
_project_active_state() {
  systemctl --user show "virtdev-${1}" -p ActiveState --value 2>/dev/null || true
}

# project_is_running / project_is_stopped are deliberately NOT complementary. For a
# transitional state (activating / deactivating / reloading) OR an unreachable
# manager (empty), BOTH return non-zero: that indeterminate middle is where each
# caller picks its safe default. Query commands demand provably-running (fail SAFE);
# destructive commands demand provably-stopped (fail CLOSED). The old bare
# `is-active` collapsed the middle into "not running", which fails OPEN under a
# destructive caller — the anchor bug this pair fixes. (`== active` also narrows away
# is-active's rc-0 "activating" and "reloading": a query caller refusing a mid-boot
# machine is correct — the port file isn't published until QMP liveness, so those
# callers already refuse via port_require; a QEMU unit never reloads.)
project_is_running() {
  [[ "$(_project_active_state "${1}")" == active ]]
}

project_is_stopped() {
  case "$(_project_active_state "${1}")" in
    inactive|failed) return 0 ;;
    *)               return 1 ;;
  esac
}

# project_is_unreachable <project> — 0 iff the user manager could not be reached to
# determine the unit's state (the classifier returned empty). The "indeterminate
# BECAUSE we could not ask" case, distinct from the transitional indeterminate
# (activating/deactivating, where the manager DID answer). Callers that must act
# differently on an unreachable manager than on a mid-transition machine use this —
# virtdev-stop fast-fails on it rather than entering a wait loop that could never
# observe a terminal state.
project_is_unreachable() {
  [[ -z "$(_project_active_state "${1}")" ]]
}

# Batch running-state for DISPLAY ONLY (virtdev-list's RUNNING column): one
# systemctl call for N projects instead of N calls. Maps is-active semantics
# (active → 1, else → 0); this agrees with project_is_running only because BOTH key
# off the literal state word "active" (here from is-active, there from show -p
# ActiveState) — a future switch of this batch to an rc-based is-active loop would
# silently reintroduce a status-vs-list skew. It deliberately does NOT model the
# indeterminate middle that project_is_stopped guards — an unreachable
# manager here reads every project as stopped, which merely mislabels the table
# (cosmetic), never a data hazard: every destructive path is independently gated
# by the fail-closed project_is_stopped. Do NOT wire this into a mutate decision.
project_load_running_state() {
  local -n _project_result=$1
  shift
  (( $# )) || return 0
  local -a names=("$@")
  local -a units=()
  local project
  for project in "${names[@]}"; do
    units+=("virtdev-${project}")
  done
  local -a statuses=()
  mapfile -t statuses < <(systemctl --user is-active "${units[@]}" 2>/dev/null || true)
  local i
  for (( i = 0; i < ${#names[@]}; i++ )); do
    if [[ "${statuses[i]:-}" == "active" ]]; then
      _project_result["${names[i]}"]=1
    else
      _project_result["${names[i]}"]=0
    fi
  done
}

project_is_outdated() {
  local project="${1}"
  project_is_detached "${project}" && return 1
  local -r base_file="${VIRTDEV_HOME}/system/generation"
  local -r project_file="${VIRTDEV_HOME}/projects/${project}/generation"
  [[ -f "${base_file}" ]] || return 1
  [[ -f "${project_file}" ]] || return 1
  local base_gen project_gen
  # Generation readers panic (exit 82) on corruption, but here they run
  # inside a command substitution, so that exit would be swallowed and
  # the variable left empty — silently reading as "outdated". Capture it
  # explicitly so callers iterating over projects warn and skip instead
  # of destroying a project off an unreadable generation file.
  # Distinguish the source: 3 = the shared BASE file is corrupt (so every
  # project returns 3), 2 = this project's own file is corrupt. 2>/dev/null
  # suppresses the per-file panic; the caller emits the right message.
  base_gen="$(generation_read_base "${base_file}" 2>/dev/null)" || return 3
  project_gen="$(generation_read_project "${project_file}" 2>/dev/null)" || return 2
  [[ "${project_gen}" != "${base_gen}" ]]
}

project_is_detached() {
  local project="${1}"
  local -r project_directory="${VIRTDEV_HOME}/projects/${project}"
  local -r generation_file="${project_directory}/generation"
  [[ -f "${generation_file}" ]] || return 1
  local generation
  generation="$(generation_read_project "${generation_file}" 2>/dev/null)" \
    || return 1
  [[ "${generation}" == detached ]] || return 1

  local disk info
  for disk in system.qcow2 home.qcow2; do
    [[ -f "${project_directory}/${disk}" ]] || return 1
    info="$(qemu-img info --output=json "${project_directory}/${disk}" 2>/dev/null)" \
      || return 1
    [[ ! "${info}" =~ \"backing-filename\"[[:space:]]*: ]] || return 1
  done
}

project_require() {
  local -r project="${1}"
  local -r project_directory="${VIRTDEV_HOME}/projects/${project}"
  if [[ ! -d "${project_directory}" ]]; then
    error 3 <<<"Project not found: ${project}"
  fi
}

_generation_error() {
  local -r file="${1}" kind="${2}" content="${3}"
  local escaped_content repair_rule
  printf -v escaped_content '%q' "${content}"
  repair_rule="a canonical integer from 0 through ${generation_max}"
  if [[ "${kind}" == project ]]; then
    repair_rule+=" or the exact project marker 'detached'"
  fi
  error 82 <<MESSAGE
Corrupted ${kind} generation file: '${file}'
Content (bounded): ${escaped_content}
Repair manually with ${repair_rule}.
MESSAGE
}

_generation_read() {
  local -r file="${1}" kind="${2}"
  # C locale makes byte counts and [0-9] agree. A fixed-size `read -N` retains
  # meaningful trailing newlines without command substitution and bounds shell
  # allocation; exact stat-size comparison also rejects NUL/binary contents.
  local LC_ALL=C raw='' file_size content
  if [[ ! -f "${file}" || -L "${file}" ]]; then
    _generation_error "${file}" "${kind}" '<missing-or-nonregular>'
  fi
  file_size="$(stat -c '%s' -- "${file}" 2>/dev/null)" \
    || _generation_error "${file}" "${kind}" '<unreadable>'
  if [[ ! "${file_size}" =~ ^[0-9]+$ || ${file_size} -gt 11 ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  IFS= read -r -N 12 raw < "${file}" 2>/dev/null || true
  if [[ ${#raw} -ne file_size ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi

  content="${raw}"
  if [[ "${content}" == *$'\n' ]]; then
    content="${content%$'\n'}"
  fi
  if [[ "${content}" == *$'\n'* ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi

  if [[ "${kind}" == project && "${content}" == detached ]]; then
    printf '%s' "${content}"
    return 0
  fi
  if [[ ! "${content}" =~ ^(0|[1-9][0-9]*)$ \
        || ${#content} -gt 10 ]]; then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  if (( 10#${content} > generation_max )); then
    _generation_error "${file}" "${kind}" "${raw}"
  fi
  printf '%s' "${content}"
}

generation_read_base() {
  _generation_read "${1}" base
}

generation_read_project() {
  _generation_read "${1}" project
}

_generation_read_lenient() {
  local -r file="${1}" kind="${2}"
  local result
  if result="$(_generation_read "${file}" "${kind}" 2>/dev/null)"; then
    printf '%s' "${result}"
  else
    printf '%s' '<corrupt>'
  fi
}

generation_read_base_lenient() {
  _generation_read_lenient "${1}" base
}

generation_read_project_lenient() {
  _generation_read_lenient "${1}" project
}
