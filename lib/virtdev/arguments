#!/usr/bin/env bash
#
# Declarative flag parser and usage generator.
#
# API:
#   arguments_parse <spec_name> <flags_name> <positional_name> "$@"
#   arguments_usage <spec_name>
#
# Specs map long names to bool, value, or required. Required means present;
# callers validate non-empty values. Optional companions are:
#   <spec>_short          short-to-long aliases
#   <spec>_placeholders   usage labels for values
#   <spec>_positionals    names suffixed by ?, +, or *
# Positionals may be interleaved with flags; -- ends flag parsing. Short bools
# may cluster, with only the final member allowed to consume a value.
#
# --help/-h and --color[=yes|no|auto] are universal before --. Rich-help
# commands may intercept help first. A bare --color means yes unless followed
# by a non-option value. The selected mode is exposed as _virtdev_color_mode.
# Usage errors exit 64.
#
set -euo pipefail
import error

readonly arguments_usage_exit_code=64

# Populated by the universal --color handler in arguments_parse.
# Read by terminal_init when called with no arguments.
declare -g _virtdev_color_mode=""

arguments_color_set() {
  local -r value="${1}"
  case "${value}" in
    yes|no|auto) _virtdev_color_mode="${value}" ;;
    *)
      error "${arguments_usage_exit_code}" \
        <<<"invalid --color value: '${value}' (expected yes, no, or auto)"
      ;;
  esac
}

arguments_parse() {
  local -n _arguments_spec="${1}"
  local -n _arguments_flags="${2}"
  local -n _arguments_positional="${3}"

  # arguments_usage needs the name, not the nameref.
  local _arguments_spec_name="${1}"

  local _arguments_short_name="${1}_short"
  local _arguments_positionals_name="${1}_positionals"
  local _arguments_has_short=0
  if declare -p "${_arguments_short_name}" &>/dev/null; then
    # shellcheck disable=SC2178  # nameref, not scalar reassignment
    local -n _arguments_short="${_arguments_short_name}"
    _arguments_has_short=1
  fi
  if ! declare -p "${_arguments_positionals_name}" &>/dev/null; then
    error "${arguments_usage_exit_code}" \
      <<<"missing positional schema: ${_arguments_positionals_name}"
  fi
  # shellcheck disable=SC2178  # nameref, not scalar reassignment
  local -n _arguments_positionals_spec="${_arguments_positionals_name}"

  shift 3

  local key type short_key short_target
  for key in "${!_arguments_spec[@]}"; do
    type="${_arguments_spec[$key]}"
    case "${type}" in
      bool|value|required) ;;
      *)
        error "${arguments_usage_exit_code}" \
          <<<"invalid argument type for --${key}: ${type}"
        ;;
    esac
  done

  if (( _arguments_has_short )); then
    for short_key in "${!_arguments_short[@]}"; do
      if [[ "${#short_key}" -ne 1 ]]; then
        error "${arguments_usage_exit_code}" \
          <<<"invalid short flag key: '${short_key}' (must be a single character)"
      fi
      short_target="${_arguments_short[$short_key]}"
      if [[ ! -v _arguments_spec[$short_target] ]]; then
        error "${arguments_usage_exit_code}" \
          <<<"short flag -${short_key} aliases unknown flag: --${short_target}"
      fi
    done
  fi

  local _arguments_entry _arguments_name _arguments_modifier
  local _arguments_min_positionals=0 _arguments_max_positionals=0
  local _arguments_unbounded_positionals=0 _arguments_optional_seen=0
  local _arguments_index
  local -A _arguments_positional_names=()
  for _arguments_index in "${!_arguments_positionals_spec[@]}"; do
    _arguments_entry="${_arguments_positionals_spec[$_arguments_index]}"
    _arguments_modifier="${_arguments_entry: -1}"
    case "${_arguments_modifier}" in
      '?'|'+'|'*') _arguments_name="${_arguments_entry%?}" ;;
      *) _arguments_modifier='' ; _arguments_name="${_arguments_entry}" ;;
    esac
    if [[ -z "${_arguments_name}" || "${_arguments_name}" == *[?+*]* ]]; then
      error "${arguments_usage_exit_code}" \
        <<<"invalid positional schema entry: '${_arguments_entry}'"
    fi
    if [[ -v _arguments_positional_names[$_arguments_name] ]]; then
      error "${arguments_usage_exit_code}" \
        <<<"duplicate positional schema name: '${_arguments_name}'"
    fi
    _arguments_positional_names["${_arguments_name}"]=1
    case "${_arguments_modifier}" in
      '')
        if (( _arguments_optional_seen )); then
          error "${arguments_usage_exit_code}" \
            <<<"required positional follows an optional one: '${_arguments_entry}'"
        fi
        (( _arguments_min_positionals += 1 ))
        (( _arguments_max_positionals += 1 ))
        ;;
      '?')
        _arguments_optional_seen=1
        (( _arguments_max_positionals += 1 ))
        ;;
      '+'|'*')
        if (( _arguments_index != ${#_arguments_positionals_spec[@]} - 1 )); then
          error "${arguments_usage_exit_code}" \
            <<<"variadic positional must be final: '${_arguments_entry}'"
        fi
        [[ "${_arguments_modifier}" == '+' ]] \
          && (( _arguments_min_positionals += 1 ))
        _arguments_unbounded_positionals=1
        ;;
    esac
  done

  for key in "${!_arguments_spec[@]}"; do
    [[ -v _arguments_flags[$key] ]] && continue
    case "${_arguments_spec[$key]}" in
      bool)  _arguments_flags["${key}"]=0 ;;
      value) _arguments_flags["${key}"]="" ;;
      required) ;;
    esac
  done

  local arg flag_name flag_value short_char
  while (( $# > 0 )); do
    arg="${1}"
    case "${arg}" in
      --help|-h)
        arguments_usage "${_arguments_spec_name}"
        exit 0
        ;;
      --color=*)
        arguments_color_set "${arg#*=}"
        shift
        continue
        ;;
      --color)
        if (( $# >= 2 )) && [[ "${2}" != -* ]]; then
          arguments_color_set "${2}"
          shift 2
        else
          arguments_color_set yes
          shift
        fi
        continue
        ;;
      --)
        # Break so required-flag validation still runs.
        shift
        _arguments_positional+=("$@")
        break
        ;;
      --*=*)
        flag_name="${arg%%=*}"
        flag_name="${flag_name#--}"
        flag_value="${arg#*=}"
        if [[ ! -v _arguments_spec[$flag_name] ]]; then
          error "${arguments_usage_exit_code}" \
            <<<"unknown flag: --${flag_name}"
        fi
        if [[ "${_arguments_spec[$flag_name]}" == "bool" ]]; then
          error "${arguments_usage_exit_code}" \
            <<<"--${flag_name} does not take a value"
        fi
        _arguments_flags["${flag_name}"]="${flag_value}"
        shift
        ;;
      --*)
        flag_name="${arg#--}"
        if [[ ! -v _arguments_spec[$flag_name] ]]; then
          error "${arguments_usage_exit_code}" \
            <<<"unknown flag: --${flag_name}"
        fi
        case "${_arguments_spec[$flag_name]}" in
          bool)
            _arguments_flags["${flag_name}"]=1
            shift
            ;;
          value|required)
            if (( $# < 2 )) || [[ "${2}" == "--" ]]; then
              error "${arguments_usage_exit_code}" \
                <<<"--${flag_name} requires a value"
            fi
            _arguments_flags["${flag_name}"]="${2}"
            shift 2
            ;;
        esac
        ;;
      -?)
        short_char="${arg#-}"
        if (( _arguments_has_short )) \
           && [[ -v _arguments_short[$short_char] ]]; then
          flag_name="${_arguments_short[$short_char]}"
        else
          error "${arguments_usage_exit_code}" \
            <<<"unknown flag: ${arg}"
        fi
        case "${_arguments_spec[$flag_name]}" in
          bool)
            _arguments_flags["${flag_name}"]=1
            shift
            ;;
          value|required)
            if (( $# < 2 )) || [[ "${2}" == "--" ]]; then
              error "${arguments_usage_exit_code}" \
                <<<"-${short_char} (--${flag_name}) requires a value"
            fi
            _arguments_flags["${flag_name}"]="${2}"
            shift 2
            ;;
        esac
        ;;
      -*)
        if (( ! _arguments_has_short )); then
          error "${arguments_usage_exit_code}" \
            <<<"unknown flag: ${arg}"
        fi
        # Only the final cluster member may consume the next argument.
        local _arguments_cluster="${arg#-}"
        if [[ -z "${_arguments_cluster}" ]]; then
          # Reject before the zero-iteration loop can spin forever.
          error "${arguments_usage_exit_code}" <<<"unknown flag: ${arg}"
        fi
        local _arguments_ci _arguments_cc
        for (( _arguments_ci=0; _arguments_ci < ${#_arguments_cluster}; _arguments_ci++ )); do
          _arguments_cc="${_arguments_cluster:_arguments_ci:1}"
          if [[ ! -v _arguments_short[$_arguments_cc] ]]; then
            error "${arguments_usage_exit_code}" \
              <<<"unknown flag: -${_arguments_cc} (in ${arg})"
          fi
          flag_name="${_arguments_short[$_arguments_cc]}"
          if (( _arguments_ci < ${#_arguments_cluster} - 1 )); then
            if [[ "${_arguments_spec[$flag_name]}" != "bool" ]]; then
              error "${arguments_usage_exit_code}" \
                <<<"-${_arguments_cc} (--${flag_name}) requires a value and cannot be clustered"
            fi
            _arguments_flags["${flag_name}"]=1
          else
            case "${_arguments_spec[$flag_name]}" in
              bool)
                _arguments_flags["${flag_name}"]=1
                shift
                ;;
              value|required)
                if (( $# < 2 )) || [[ "${2}" == "--" ]]; then
                  error "${arguments_usage_exit_code}" \
                    <<<"-${_arguments_cc} (--${flag_name}) requires a value"
                fi
                _arguments_flags["${flag_name}"]="${2}"
                shift 2
                ;;
            esac
          fi
        done
        ;;
      *)
        _arguments_positional+=("${arg}")
        shift
        ;;
    esac
  done

  local -a missing=()
  for key in "${!_arguments_spec[@]}"; do
    if [[ "${_arguments_spec[$key]}" == "required" ]] \
       && [[ ! -v _arguments_flags[$key] ]]; then
      missing+=("--${key}")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    error "${arguments_usage_exit_code}" \
      <<<"missing required flag(s): ${missing[*]}"
  fi

  if (( ${#_arguments_positional[@]} < _arguments_min_positionals )) \
      || (( ! _arguments_unbounded_positionals \
            && ${#_arguments_positional[@]} > _arguments_max_positionals )); then
    error "${arguments_usage_exit_code}" \
      <<<"$(arguments_usage "${_arguments_spec_name}")"
  fi
}

arguments_usage() {
  local -n _au_spec="${1}"
  local _au_short_name="${1}_short"
  local _au_ph_name="${1}_placeholders"
  local _au_pos_name="${1}_positionals"
  local _au_has_short=0
  local _au_has_ph=0
  local _au_has_pos=0

  if declare -p "${_au_short_name}" &>/dev/null; then
    # shellcheck disable=SC2178  # nameref, not scalar reassignment
    local -n _au_short="${_au_short_name}"
    _au_has_short=1
  fi

  if declare -p "${_au_ph_name}" &>/dev/null; then
    # shellcheck disable=SC2178  # nameref, not scalar reassignment
    local -n _au_ph="${_au_ph_name}"
    _au_has_ph=1
  fi

  if declare -p "${_au_pos_name}" &>/dev/null; then
    # shellcheck disable=SC2178  # nameref, not scalar reassignment
    local -n _au_pos="${_au_pos_name}"
    _au_has_pos=1
  fi

  local -A _au_long_to_short=()
  if (( _au_has_short )); then
    local _au_s
    for _au_s in "${!_au_short[@]}"; do
      _au_long_to_short["${_au_short[$_au_s]}"]="${_au_s}"
    done
  fi

  local -a _au_required=() _au_value=() _au_bool=()
  local _au_key _au_type
  for _au_key in "${!_au_spec[@]}"; do
    _au_type="${_au_spec[$_au_key]}"
    case "${_au_type}" in
      required) _au_required+=("${_au_key}") ;;
      value)    _au_value+=("${_au_key}") ;;
      bool)     _au_bool+=("${_au_key}") ;;
    esac
  done

  if (( ${#_au_required[@]} > 0 )); then
    readarray -t _au_required < <(printf '%s\n' "${_au_required[@]}" | sort)
  fi
  if (( ${#_au_value[@]} > 0 )); then
    readarray -t _au_value < <(printf '%s\n' "${_au_value[@]}" | sort)
  fi
  if (( ${#_au_bool[@]} > 0 )); then
    readarray -t _au_bool < <(printf '%s\n' "${_au_bool[@]}" | sort)
  fi

  local _au_out
  _au_out="usage: $(basename "$0")"
  local _au_placeholder _au_flag_label _au_type

  for _au_key in "${_au_required[@]}" "${_au_value[@]}" "${_au_bool[@]}"; do
    _au_flag_label="--${_au_key}"
    if [[ -v _au_long_to_short[$_au_key] ]]; then
      _au_flag_label="-${_au_long_to_short[$_au_key]}|${_au_flag_label}"
    fi
    _au_type="${_au_spec[$_au_key]}"
    if [[ "${_au_type}" == bool ]]; then
      _au_out+=" [${_au_flag_label}]"
    else
      _au_placeholder="value"
      (( _au_has_ph )) && [[ -v _au_ph[$_au_key] ]] \
        && _au_placeholder="${_au_ph[$_au_key]}"
      if [[ "${_au_type}" == required ]]; then
        _au_out+=" ${_au_flag_label} <${_au_placeholder}>"
      else
        _au_out+=" [${_au_flag_label} <${_au_placeholder}>]"
      fi
    fi
  done

  if (( _au_has_pos )); then
    local _au_entry _au_mod _au_name
    for _au_entry in "${_au_pos[@]}"; do
      _au_mod="${_au_entry: -1}"
      case "${_au_mod}" in
        '?') _au_name="${_au_entry%?}" ; _au_out+=" [${_au_name}]" ;;
        '+') _au_name="${_au_entry%?}" ; _au_out+=" <${_au_name}...>" ;;
        '*') _au_name="${_au_entry%?}" ; _au_out+=" [${_au_name}...]" ;;
        *)   _au_out+=" <${_au_entry}>" ;;
      esac
    done
  fi

  printf '%s\n' "${_au_out}"
}
