#!/usr/bin/env bash
#
# Snapshot paths are ${VIRTDEV_HOME}/backups/<project>/<date>/<time>.
# Missing-tree list operations return an empty result.
#
# API: snapshot_directory, snapshot_validate_format, strict *_into inventory
# functions and their printing wrappers, snapshot_any_strict,
# snapshot_tree_has_entries_strict, and snapshot_id_from_path. Dates and times use YYYY-MM-DD/HH-MM-SS;
# malformed input exits 79. An empty directory counts as a tree entry.
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error
import enumerate

readonly snapshot_invalid_format_exit_code=79
readonly snapshot_date_regex='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
readonly snapshot_time_regex='^[0-9]{2}-[0-9]{2}-[0-9]{2}$'
readonly snapshot_format_regex='^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{2}-[0-9]{2}-[0-9]{2}$'

snapshot_directory() {
  local -r project="${1}"
  printf '%s\n' "${VIRTDEV_HOME}/backups/${project}"
}

snapshot_validate_format() {
  local -r snapshot="${1}"
  # Keep [0-9] byte-wise ASCII.
  local LC_ALL=C
  if [[ ! "${snapshot}" =~ ${snapshot_format_regex} ]]; then
    error "${snapshot_invalid_format_exit_code}" \
      <<<"Invalid snapshot format: '${snapshot}' (expected YYYY-MM-DD/HH-MM-SS)"
  fi
}

snapshot_list_days_into() {
  local -n _snapshot_days_result="${1}"
  local -r project="${2}"
  local -r dir="${VIRTDEV_HOME}/backups/${project}"
  local LC_ALL=C name
  local -a discovered=()

  _snapshot_days_result=()
  [[ -d "${dir}" ]] || return 0
  # shellcheck disable=SC2154  # imported from enumerate
  enumerate_nul_sorted discovered "${enumerate_max_bytes}" \
    find "${dir}" -maxdepth 1 -mindepth 1 -type d -printf '%f\0' \
    || return $?
  for name in "${discovered[@]}"; do
    [[ "${name}" =~ ${snapshot_date_regex} ]] \
      && _snapshot_days_result+=("${name}")
  done
}

snapshot_list_days() {
  local -a days=()
  snapshot_list_days_into days "${1}" || return $?
  (( ${#days[@]} )) && printf '%s\n' "${days[@]}"
  return 0
}

snapshot_list_times_into() {
  local -n _snapshot_times_result="${1}"
  local -r project="${2}"
  local -r day="${3}"
  local -r dir="${VIRTDEV_HOME}/backups/${project}/${day}"
  local LC_ALL=C name
  local -a discovered=()

  _snapshot_times_result=()
  [[ -d "${dir}" ]] || return 0
  # shellcheck disable=SC2154  # imported from enumerate
  enumerate_nul_sorted discovered "${enumerate_max_bytes}" \
    find "${dir}" -maxdepth 1 -mindepth 1 -type d -printf '%f\0' \
    || return $?
  for name in "${discovered[@]}"; do
    [[ "${name}" =~ ${snapshot_time_regex} ]] \
      && _snapshot_times_result+=("${name}")
  done
}

snapshot_list_times() {
  local -a times=()
  snapshot_list_times_into times "${1}" "${2}" || return $?
  (( ${#times[@]} )) && printf '%s\n' "${times[@]}"
  return 0
}

snapshot_list_into() {
  local -n _snapshot_list_result="${1}"
  local -r project="${2}"
  local -r dir="${VIRTDEV_HOME}/backups/${project}"
  local -a discovered=()

  _snapshot_list_result=()
  [[ -d "${dir}" ]] || return 0
  # shellcheck disable=SC2154  # imported from enumerate
  enumerate_nul_sorted discovered "${enumerate_max_bytes}" \
    find "${dir}" -mindepth 2 -maxdepth 2 -type d \
      -regextype posix-extended \
      -regex '.*/[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{2}-[0-9]{2}-[0-9]{2}' \
      -printf '%P\0'
  _snapshot_list_result=("${discovered[@]}")
}

snapshot_list() {
  local -a snapshots=()
  snapshot_list_into snapshots "${1}" || return $?
  (( ${#snapshots[@]} )) && printf '%s\n' "${snapshots[@]}"
  return 0
}

snapshot_count_into() {
  local -n _snapshot_count_result="${1}"
  local -a snapshots=()
  snapshot_list_into snapshots "${2}" || return $?
  _snapshot_count_result="${#snapshots[@]}"
}

snapshot_count() {
  local count
  snapshot_count_into count "${1}" || return $?
  printf '%s\n' "${count}"
}

snapshot_any_strict() {
  local -a snapshots=()
  snapshot_list_into snapshots "${1}" || return 2
  (( ${#snapshots[@]} > 0 ))
}

snapshot_any() {
  snapshot_any_strict "${1}"
}

snapshot_latest_into() {
  local -n _snapshot_latest_result="${1}"
  local -a snapshots=()
  snapshot_list_into snapshots "${2}" || return $?
  _snapshot_latest_result=''
  (( ${#snapshots[@]} )) \
    && _snapshot_latest_result="${snapshots[-1]}"
}

snapshot_latest() {
  local latest
  snapshot_latest_into latest "${1}" || return $?
  printf '%s' "${latest}"
}

snapshot_tree_has_entries_strict() {
  local -r tree="${1}"
  local -a entries=()
  [[ -d "${tree}" ]] || return 1
  # shellcheck disable=SC2154  # imported from enumerate
  enumerate_nul_sorted entries "${enumerate_max_bytes}" \
    find "${tree}" -mindepth 1 -print0 -quit || return 2
  (( ${#entries[@]} > 0 ))
}

snapshot_tree_has_entries() {
  snapshot_tree_has_entries_strict "${1}"
}

snapshot_tree_count_entries() {
  local -r tree="${1}"
  find "${tree}" -mindepth 1 -printf 'x' 2>/dev/null | wc -c
}

snapshot_id_from_path() {
  local -r project="${1}" path="${2}"
  local -r prefix="${VIRTDEV_HOME}/backups/${project}/"
  [[ "${path}" == "${prefix}"* ]] || return 1
  local -r snapshot="${path#"${prefix}"}"
  [[ "${snapshot}" =~ ${snapshot_format_regex} ]] || return 1
  printf '%s' "${snapshot}"
}
