#!/usr/bin/env bash
# Bounded, durable copies for inputs used across irreversible workflows.
# shellcheck disable=SC2034  # imported limits and result constants

set -euo pipefail

readonly frozen_input_max_bytes=1048576
readonly frozen_input_result_invalid=40
readonly frozen_input_result_too_large=41
readonly frozen_input_result_timeout=42
readonly frozen_input_result_io=43
readonly frozen_input_result_durability=44

frozen_input_digest() {
  local -n _frozen_digest="${1}"
  local -r path="${2}" deadline="${3}" kill_after="${4}"
  local remaining status=0 output

  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return "${frozen_input_result_timeout}"
  output="$(timeout --signal=TERM --kill-after="${kill_after}" \
    "${remaining}" sha256sum -- "${path}")" || status=$?
  case "${status}" in
    0) ;;
    124|137) return "${frozen_input_result_timeout}" ;;
    *) return "${frozen_input_result_io}" ;;
  esac
  _frozen_digest="${output%% *}"
  [[ "${_frozen_digest}" =~ ^[0-9a-f]{64}$ ]] \
    || return "${frozen_input_result_io}"
}

frozen_input_copy() {
  local -n _frozen_copy_digest="${1}"
  local -r source="${2}" destination="${3}" deadline="${4}" \
    kill_after="${5}"
  local -r temporary="${destination}.tmp"
  local remaining status=0 size digest=''

  [[ -f "${source}" && -r "${source}" && -d "$(dirname "${destination}")" ]] \
    || return "${frozen_input_result_invalid}"
  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return "${frozen_input_result_timeout}"
  timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" \
    head -c "$(( frozen_input_max_bytes + 1 ))" -- "${source}" \
    > "${temporary}" || status=$?
  case "${status}" in
    0) ;;
    124|137)
      rm -f -- "${temporary}"
      return "${frozen_input_result_timeout}"
      ;;
    *)
      rm -f -- "${temporary}"
      return "${frozen_input_result_io}"
      ;;
  esac
  size="$(stat -c '%s' -- "${temporary}" 2>/dev/null)" || size=''
  if [[ ! "${size}" =~ ^[0-9]+$ ]]; then
    rm -f -- "${temporary}"
    return "${frozen_input_result_io}"
  fi
  if (( size > frozen_input_max_bytes )); then
    rm -f -- "${temporary}"
    return "${frozen_input_result_too_large}"
  fi
  if ! chmod 0400 -- "${temporary}" \
      || ! mv -T -- "${temporary}" "${destination}"; then
    rm -f -- "${temporary}"
    return "${frozen_input_result_io}"
  fi
  frozen_input_digest digest "${destination}" "${deadline}" "${kill_after}" \
    || return $?
  if ! sync -f -- "${destination}" \
      || ! sync -f -- "$(dirname "${destination}")"; then
    return "${frozen_input_result_durability}"
  fi
  _frozen_copy_digest="${digest}"
}

frozen_input_verify() {
  local -r path="${1}" expected="${2}" deadline="${3}" kill_after="${4}"
  local actual=''

  [[ "${expected}" =~ ^[0-9a-f]{64}$ ]] \
    || return "${frozen_input_result_invalid}"
  frozen_input_digest actual "${path}" "${deadline}" "${kill_after}" \
    || return $?
  [[ "${actual}" == "${expected}" ]] \
    || return "${frozen_input_result_invalid}"
}
