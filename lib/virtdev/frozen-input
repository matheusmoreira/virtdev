#!/usr/bin/env bash
# Bounded, durable copies for inputs used across irreversible workflows.
# shellcheck disable=SC2034  # imported limits and result constants

set -euo pipefail

readonly frozen_input_max_bytes=1048576
readonly frozen_input_result_invalid=40
readonly frozen_input_result_too_large=41
readonly frozen_input_result_timeout=42
readonly frozen_input_result_io=43
readonly frozen_input_result_durability=44

_frozen_input_cleanup() {
  local -r kill_after="${1}" path="${2}"
  local grace="${kill_after}"

  (( grace <= 5 )) || grace=5
  timeout --signal=TERM --kill-after="${grace}" "${grace}" \
    rm -f -- "${path}" >/dev/null 2>&1 || true
}

_frozen_input_deadline_run() {
  local -r deadline="${1}" kill_after="${2}"
  shift 2
  local remaining=$(( deadline - BASH_MONOSECONDS ))

  (( remaining > 0 )) || return 124
  timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" "$@"
}

frozen_input_digest() {
  local -n _frozen_digest="${1}"
  local -r path="${2}" deadline="${3}" kill_after="${4}"
  local remaining status=0 output

  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return "${frozen_input_result_timeout}"
  output="$(timeout --signal=TERM --kill-after="${kill_after}" \
    "${remaining}" sha256sum -- "${path}")" || status=$?
  case "${status}" in
    0) ;;
    124|137) return "${frozen_input_result_timeout}" ;;
    *) return "${frozen_input_result_io}" ;;
  esac
  _frozen_digest="${output%% *}"
  [[ "${_frozen_digest}" =~ ^[0-9a-f]{64}$ ]] \
    || return "${frozen_input_result_io}"
}

frozen_input_copy() {
  local -n _frozen_copy_digest="${1}"
  local -r source="${2}" destination="${3}" deadline="${4}" \
    kill_after="${5}"
  local -r temporary="${destination}.tmp"
  local status=0 size digest=''

  [[ -f "${source}" && -r "${source}" \
      && -d "$(dirname "${destination}")" \
      && ! -L "$(dirname "${destination}")" \
      && ! -e "${destination}" && ! -L "${destination}" \
      && ! -e "${temporary}" && ! -L "${temporary}" \
      && "${deadline}" =~ ^[0-9]+$ && "${kill_after}" =~ ^[0-9]+$ \
      && "${kill_after}" != 0 ]] \
    || return "${frozen_input_result_invalid}"
  _frozen_input_deadline_run "${deadline}" "${kill_after}" \
      head -c "$(( frozen_input_max_bytes + 1 ))" -- "${source}" \
      > "${temporary}" || status=$?
  case "${status}" in
    0) ;;
    124|137)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_timeout}"
      ;;
    *)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_io}"
      ;;
  esac
  status=0
  size="$(_frozen_input_deadline_run "${deadline}" "${kill_after}" \
    stat -c '%s' -- "${temporary}" 2>/dev/null)" || status=$?
  case "${status}" in
    0) ;;
    124|137)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_timeout}"
      ;;
    *)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_io}"
      ;;
  esac
  [[ "${size}" =~ ^[0-9]+$ ]] || {
    _frozen_input_cleanup "${kill_after}" "${temporary}"
    return "${frozen_input_result_io}"
  }
  if (( size > frozen_input_max_bytes )); then
    _frozen_input_cleanup "${kill_after}" "${temporary}"
    return "${frozen_input_result_too_large}"
  fi
  status=0
  _frozen_input_deadline_run "${deadline}" "${kill_after}" \
    chmod 0400 -- "${temporary}" || status=$?
  case "${status}" in
    0) ;;
    124|137)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_timeout}"
      ;;
    *)
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${frozen_input_result_io}"
      ;;
  esac
  frozen_input_digest digest "${temporary}" "${deadline}" "${kill_after}" \
    || {
      status=$?
      _frozen_input_cleanup "${kill_after}" "${temporary}"
      return "${status}"
    }

  status=0
  _frozen_input_deadline_run "${deadline}" "${kill_after}" \
    mv -T -- "${temporary}" "${destination}" || status=$?
  if (( status != 0 )); then
    if [[ -f "${destination}" && ! -L "${destination}" \
        && ! -e "${temporary}" && ! -L "${temporary}" ]]; then
      return "${frozen_input_result_durability}"
    fi
    _frozen_input_cleanup "${kill_after}" "${temporary}"
    case "${status}" in
      124|137) return "${frozen_input_result_timeout}" ;;
      *) return "${frozen_input_result_io}" ;;
    esac
  fi
  if [[ ! -f "${destination}" || -L "${destination}" ]]; then
    return "${frozen_input_result_durability}"
  fi

  status=0
  _frozen_input_deadline_run "${deadline}" "${kill_after}" \
    sync -f -- "${destination}" || status=$?
  (( status == 0 )) || return "${frozen_input_result_durability}"
  status=0
  _frozen_input_deadline_run "${deadline}" "${kill_after}" \
    sync -f -- "$(dirname "${destination}")" || status=$?
  if (( status != 0 )); then
    return "${frozen_input_result_durability}"
  fi
  _frozen_copy_digest="${digest}"
}

frozen_input_verify() {
  local -r path="${1}" expected="${2}" deadline="${3}" kill_after="${4}"
  local actual=''

  [[ "${expected}" =~ ^[0-9a-f]{64}$ ]] \
    || return "${frozen_input_result_invalid}"
  frozen_input_digest actual "${path}" "${deadline}" "${kill_after}" \
    || return $?
  [[ "${actual}" == "${expected}" ]] \
    || return "${frozen_input_result_invalid}"
}
