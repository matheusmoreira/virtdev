#!/usr/bin/env bash
#
# SSH forwarding-port file access.
#
# Public:
#   port_require <varname> <project>
#                                Assign a validated port. Exit 87 when absent
#                                or 81 when corrupt. Do not wrap in $().
#   port_read_lenient <project>  Print the validated port, or "?" when
#                                the file is missing or corrupt.
#   port_is_valid <port>         Return 0 only for canonical decimal ports in
#                                1024..65535 (no sign or leading zero).
#   port_in_use <port>           Returns 0 if the given port is bound.
#
# port_require must run in the caller so error() is not isolated in a command
# substitution. Output names beginning `__port_require_` are reserved.
#
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error

readonly port_corrupt_exit_code=81
readonly port_missing_exit_code=87

port_is_valid() {
  local LC_ALL=C
  local -r port="${1}"
  [[ "${port}" =~ ^[1-9][0-9]{3,4}$ ]] || return 1
  (( 10#${port} >= 1024 && 10#${port} <= 65535 ))
}

# Internal. Print the port and return 0; return 1 if the port file is
# missing, or 81 (port_corrupt_exit_code) if it exists but is not a
# valid integer. Never exits — callers map the status to behavior.
_port_value_or_status() {
  local -r port_file="${VIRTDEV_HOME}/projects/${1}/port"
  [[ -e "${port_file}" || -L "${port_file}" ]] || return 1
  [[ -f "${port_file}" && ! -L "${port_file}" ]] \
    || return "${port_corrupt_exit_code}"
  # Parse digits bytewise so non-ASCII numerals cannot pass validation.
  local LC_ALL=C raw='' file_size port
  file_size="$(stat -c '%s' -- "${port_file}" 2>/dev/null)" \
    || return "${port_corrupt_exit_code}"
  if [[ ! "${file_size}" =~ ^[0-9]+$ || ${file_size} -gt 6 ]]; then
    return "${port_corrupt_exit_code}"
  fi
  # The length check also detects NUL bytes, which Bash cannot store.
  IFS= read -r -N 7 raw < "${port_file}" 2>/dev/null || true
  [[ ${#raw} -eq file_size ]] || return "${port_corrupt_exit_code}"
  port="${raw}"
  if [[ "${port}" == *$'\n' ]]; then
    port="${port%$'\n'}"
  fi
  [[ "${port}" != *$'\n'* ]] || return "${port_corrupt_exit_code}"
  port_is_valid "${port}" || return "${port_corrupt_exit_code}"
  printf '%s' "${port}"
}

port_require() {
  # Reserved local names cannot shadow the caller's printf -v destination.
  local -r __port_require_varname="${1}" __port_require_project="${2}"
  local __port_require_value __port_require_status=0
  __port_require_value="$(_port_value_or_status "${__port_require_project}")" || __port_require_status=$?
  if (( __port_require_status == 0 )); then
    printf -v "${__port_require_varname}" '%s' "${__port_require_value}"
  elif (( __port_require_status == port_corrupt_exit_code )); then
    error "${port_corrupt_exit_code}" \
      <<<"Corrupt port file: ${VIRTDEV_HOME}/projects/${__port_require_project}/port"
  else
    error "${port_missing_exit_code}" <<MESSAGE
Project has no port assigned: ${__port_require_project}
Start the virtual machine first: virtdev-start ${__port_require_project}
MESSAGE
  fi
}

port_read_lenient() {
  local result
  if result="$(_port_value_or_status "${1}")"; then
    printf '%s' "${result}"
  else
    printf '%s' '?'
  fi
}

port_in_use() {
  port_is_valid "${1}" || return 2
  [[ -n "$(ss -tlnH "sport = :${1}" 2>/dev/null)" ]]
}
