#!/usr/bin/env bash
#
# port library: SSH forwarding port file reading and validation.
#
# Public:
#   port_require <varname> <project>
#                                Read and validate the port file and
#                                assign the port to the caller's
#                                <varname>. Errors 87 if the file is
#                                absent, or 81 if it is present but
#                                corrupt. Runs in the caller's shell so
#                                the exit code propagates — do NOT wrap
#                                in $(). <varname> must not begin with
#                                __port_require_ (reserved for the
#                                function's own locals; a collision would
#                                make printf -v write the local instead).
#   port_read_lenient <project>  Print the validated port, or "?" when
#                                the file is missing or corrupt. For
#                                display-oriented commands (list).
#   port_in_use <port>           Returns 0 if the given port is bound.
#
# Exit codes:
#   81  corrupt port file (not a valid integer)
#   87  no port assigned (port file absent — virtual machine not running)
#
# The port file is written by virtdev-start with printf '%d\n' and
# removed by virtdev-stop. Corruption requires filesystem-level issues
# or external tampering.
#
# Why port_require uses a nameref instead of `port="$(port_read ...)"`:
# a port_read that called error() on a corrupt file would only exit the
# command-substitution subshell, and the caller's `if !` would then
# report its own code with a contradictory message — never the reserved
# 87 or 81. port_require runs in the caller's shell, so its error()
# terminates the process with the correct code.
#
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error

readonly port_corrupt_exit_code=81
readonly port_missing_exit_code=87

# Internal. Print the port and return 0; return 1 if the port file is
# missing, or 81 (port_corrupt_exit_code) if it exists but is not a
# valid integer. Never exits — callers map the status to behavior.
_port_value_or_status() {
  local -r port_file="${VIRTDEV_HOME}/projects/${1}/port"
  [[ -f "${port_file}" ]] || return 1
  # LC_ALL=C so [0-9] is byte-wise ASCII: under a UTF-8 locale a non-ASCII digit would
  # pass the regex and read as a valid port, defeating the corruption guard — the same
  # locale pin the generation readers / project_list carry for integer files.
  local LC_ALL=C
  local port
  port="$(< "${port_file}")"
  [[ "${port}" =~ ^[0-9]+$ ]] || return "${port_corrupt_exit_code}"
  printf '%s' "${port}"
}

port_require() {
  # Internal locals use the reserved __port_require_ prefix so the
  # caller's output <varname> cannot collide with one: printf -v assigns
  # in this function's scope, where a same-named local would shadow the
  # caller's variable and silently swallow the result.
  local -r __port_require_varname="${1}" __port_require_project="${2}"
  local __port_require_value __port_require_status=0
  __port_require_value="$(_port_value_or_status "${__port_require_project}")" || __port_require_status=$?
  if (( __port_require_status == 0 )); then
    printf -v "${__port_require_varname}" '%s' "${__port_require_value}"
  elif (( __port_require_status == port_corrupt_exit_code )); then
    error "${port_corrupt_exit_code}" \
      <<<"Corrupt port file: ${VIRTDEV_HOME}/projects/${__port_require_project}/port"
  else
    error "${port_missing_exit_code}" <<MESSAGE
Project has no port assigned: ${__port_require_project}
Start the virtual machine first: virtdev-start ${__port_require_project}
MESSAGE
  fi
}

port_read_lenient() {
  local result
  if result="$(_port_value_or_status "${1}")"; then
    printf '%s' "${result}"
  else
    printf '%s' '?'
  fi
}

port_in_use() {
  [[ -n "$(ss -tlnH "sport = :${1}" 2>/dev/null)" ]]
}
