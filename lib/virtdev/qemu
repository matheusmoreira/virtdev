#!/usr/bin/env bash
# qemu library: the shared QEMU argv for project and maintenance machines.
#
# This owns the shared network-isolation baseline. Start uses it directly;
# maintenance appends explicit shutdown-policy and cache arguments.
#
# Public:
#   qemu_suboption_encode <variable>
#       Double each comma in the variable's value for interpolation into a
#       comma-delimited QEMU option. Other bytes are preserved.
#
#   qemu_command <array_name> <disk_dir> <sock_dir> <fw_cfg_project> \
#                <ssh_host_key> <memory> <cpus> <ovmf_code> [extra_args...]
#       Build the argv after the `virtdev-netexec ... --` boundary without
#       spawning it. disk_dir holds the images; sock_dir holds the HMP, QMP,
#       serial, and passt sockets. They differ during maintenance. Fixed-field
#       values are comma-encoded here; callers embedding values in trusted
#       extra_args must encode those values before calling.
#
#       The fixed isolation baseline is writable qcow2 deltas, read-only OVMF
#       code, passt stream networking (never SLIRP), no display, and host-only
#       HMP/QMP control sockets.
#
set -euo pipefail

import runtime

qemu_suboption_encode() {
  if (( $# != 1 )) || [[ ! "${1}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] \
      || [[ ! -v "${1}" ]]; then
    return 2
  fi
  printf -v "${1}" '%s' "${!1//,/,,}"
}

qemu_command() {
  local -n _command="${1}"
  local -r disk_dir="${2}"
  local -r sock_dir="${3}"
  local fw_cfg_project="${4}"
  local ssh_host_key="${5}"
  local -r memory="${6}"
  local -r cpus="${7}"
  local ovmf_code="${8}"
  shift 8
  # Remaining positionals (if any) are the caller's trailing extra args.

  runtime_socket_paths_fit "${sock_dir}" || return 1

  local system_disk="${disk_dir}/system.qcow2"
  local home_disk="${disk_dir}/home.qcow2"
  local nvram="${disk_dir}/nvram"
  # Keep argv socket names aligned with runtime cleanup.
  local monitor_sock console_sock network_sock qmp_sock
  monitor_sock="$(runtime_monitor_sock "${sock_dir}")"
  console_sock="$(runtime_console_sock "${sock_dir}")"
  network_sock="$(runtime_network_sock "${sock_dir}")"
  qmp_sock="$(runtime_qmp_sock "${sock_dir}")"

  qemu_suboption_encode ovmf_code
  qemu_suboption_encode nvram
  qemu_suboption_encode system_disk
  qemu_suboption_encode home_disk
  qemu_suboption_encode network_sock
  qemu_suboption_encode monitor_sock
  qemu_suboption_encode qmp_sock
  qemu_suboption_encode console_sock
  qemu_suboption_encode fw_cfg_project
  qemu_suboption_encode ssh_host_key

  # The stream wire format has no virtio-net header. Disable every negotiated
  # segmentation/checksum offload so each framed payload is one ordinary L2
  # packet within the advertised 1500-byte MTU.
  local network_device='virtio-net-pci,netdev=net0,host_mtu=1500'
  network_device+=',csum=off,gso=off,host_tso4=off,host_tso6=off'
  network_device+=',host_ecn=off,host_ufo=off,host_uso=off'
  network_device+=',host_tunnel=off,host_tunnel_csum=off'
  network_device+=',guest_csum=off,guest_tso4=off,guest_tso6=off'
  network_device+=',guest_ecn=off,guest_ufo=off,guest_uso4=off,guest_uso6=off'
  network_device+=',guest_tunnel=off,guest_tunnel_csum=off'
  network_device+=',ctrl_guest_offloads=off'

  # Network-isolation boundary: passt stream only, never SLIRP.
  # shellcheck disable=SC2054  # commas are QEMU option syntax, not array separators
  _command=(
    qemu-system-x86_64
    -enable-kvm
    -cpu host
    -machine q35
    -m "${memory}"
    -smp "${cpus}"
    -drive if=pflash,format=raw,readonly=on,file="${ovmf_code}"
    -drive if=pflash,format=raw,file="${nvram}"
    -drive file="${system_disk}",if=virtio,format=qcow2
    -drive file="${home_disk}",if=virtio,format=qcow2
    -netdev stream,id=net0,server=off,addr.type=unix,addr.path="${network_sock}"
    -device "${network_device}"
    -device virtio-rng-pci
    -display none
    -chardev socket,id=monitor,path="${monitor_sock}",server=on,wait=off
    -monitor chardev:monitor
    -chardev socket,id=qmp,path="${qmp_sock}",server=on,wait=off
    -mon chardev=qmp,mode=control
    -chardev socket,id=serial,path="${console_sock}",server=on,wait=off
    -serial chardev:serial
    -fw_cfg name=opt/virtdev/project,string="${fw_cfg_project}"
    -fw_cfg name=opt/virtdev/ssh_host_key,file="${ssh_host_key}"
  )

  # Trailing arguments cannot rewrite the fixed drive/network entries above.
  if (( $# > 0 )); then
    _command+=("$@")
  fi
}
