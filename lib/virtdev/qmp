#!/usr/bin/env bash
# shellcheck disable=SC2034  # VIRTDEV_QMP_WAIT_STATE is exported to callers
#
# Host-only QMP client for launch liveness and maintenance shutdown proof.
# qmp.sock lives in the 0700 runtime directory and is not exposed to the guest.
#
# Public:
#   qmp_query_running <sock> <deadline>
#   qmp_query_running_once <sock> <probe-timeout>
#   qmp_wait_shutdown <sock> <deadline> <unit>
#     Requires -no-shutdown and accepts only status=shutdown,running=false.
#     A zero deadline is unbounded; VIRTDEV_QMP_WAIT_STATE explains failure.
#   qmp_quit <sock> <deadline>
#     Requires a command-specific acknowledgement; callers still prove the
#     owning unit terminal.
#
# _qmp_exchange negotiates capabilities and returns bounded raw replies. Its
# coprocess write end stays open so SHUT_WR cannot truncate a delayed response.
#
set -euo pipefail
import deadline integer

# Per-read stall, chunk, and total captured-reply bounds.
readonly _qmp_reply_read_timeout=0.1
readonly _qmp_reply_chunk_bytes=4096
readonly _qmp_reply_max_bytes=65536
# Preserve part of each public exchange timeout for TERM/KILL/reap. The
# millisecond monotonic clock avoids consuming an entire one-second timeout just
# to obtain subsecond cleanup accounting.
readonly _qmp_cleanup_reserve_ms=500
readonly _qmp_kill_reserve_ms=250

# Diagnostic only; `shutdown` is the sole positive result.
VIRTDEV_QMP_WAIT_STATE=unknown

_qmp_monotonic_milliseconds() {
  local -n _qmp_monotonic_result="${1}"
  local uptime seconds fraction ignored

  IFS=' ' read -r uptime ignored < /proc/uptime || return 1
  [[ "${uptime}" =~ ^([0-9]+)\.([0-9]{1,3})$ ]] || return 1
  seconds="${BASH_REMATCH[1]}"
  fraction="${BASH_REMATCH[2]}000"
  fraction="${fraction:0:3}"
  _qmp_monotonic_result=$(( 10#${seconds} * 1000 + 10#${fraction} ))
}

_qmp_child_reaped() {
  local -r child_pid="${1}"
  local process_stat state

  if [[ ! -r "/proc/${child_pid}/stat" ]]; then
    wait "${child_pid}" 2>/dev/null || true
    return 0
  fi
  if ! { IFS= read -r process_stat < "/proc/${child_pid}/stat"; } \
      2>/dev/null; then
    if [[ ! -e "/proc/${child_pid}" ]]; then
      wait "${child_pid}" 2>/dev/null || true
      return 0
    fi
    return 1
  fi
  process_stat="${process_stat##*) }"
  state="${process_stat%% *}"
  if [[ "${state}" == Z ]]; then
    wait "${child_pid}" 2>/dev/null || true
    return 0
  fi
  return 1
}

_qmp_reap_until() {
  local -r child_pid="${1}" deadline_ms="${2}"
  local now_ms term_deadline_ms=$(( deadline_ms - _qmp_kill_reserve_ms ))

  _qmp_monotonic_milliseconds now_ms || return 1
  (( term_deadline_ms >= now_ms )) || term_deadline_ms=${now_ms}
  kill -TERM "${child_pid}" 2>/dev/null || true
  while true; do
    _qmp_child_reaped "${child_pid}" && return 0
    _qmp_monotonic_milliseconds now_ms || return 1
    (( now_ms < term_deadline_ms )) || break
    sleep 0.02
  done

  kill -KILL "${child_pid}" 2>/dev/null || true
  while true; do
    _qmp_child_reaped "${child_pid}" && return 0
    _qmp_monotonic_milliseconds now_ms || return 1
    (( now_ms < deadline_ms )) || break
    sleep 0.02
  done
  _qmp_child_reaped "${child_pid}"
}

# _qmp_response_for_id_impl <raw-qmp-reply> <response-id> <append-newline>
_qmp_response_for_id_impl() {
  local -r reply="${1}" response_id="${2}" append_newline="${3}"
  {
    if (( append_newline )); then
      # Command substitution strips the newline whose presence the exchange
      # already proved before returning success.
      printf '%s\n' "${reply}"
    else
      printf '%s' "${reply}"
    fi
  } | jq -Rcse --arg id "${response_id}" '
    . as $raw |
    first(
      ($raw | [splits("\n")] | .[0:-1][]) |
      sub("\r$"; "") | fromjson? |
      select(
        type == "object" and .id == $id and
        ((has("return") and (has("error") | not)) or
         (has("error") and (has("return") | not)))
      )
    )
  ' 2>/dev/null
}

# _qmp_response_for_id <successful-exchange-reply> <response-id>
_qmp_response_for_id() {
  _qmp_response_for_id_impl "${1}" "${2}" 1
}

_qmp_complete_response_for_id() {
  _qmp_response_for_id_impl "${1}" "${2}" 0
}

# _qmp_exchange <sock> <timeout_seconds> <response-id> <json...>
# Send qmp_capabilities followed by the given command(s) over a socat
# coproc (write fd held open) and echo the raw reply, reading until
# a complete response with <response-id>, EOF, the byte cap, or the deadline.
_qmp_exchange() {
  local -r sock="${1}" timeout_seconds="${2}" response_id="${3}"
  shift 3
  integer_is_bounded_positive "${timeout_seconds}" 86400 || return 1
  [[ -S "${sock}" ]] || return 1

  # QMP capabilities negotiation must precede commands.
  local request
  request="$(printf '%s\n' \
    '{"execute":"qmp_capabilities","id":"virtdev-capabilities"}' "$@")"

  local now_ms
  _qmp_monotonic_milliseconds now_ms || return 1
  local -r deadline_ms=$(( now_ms + timeout_seconds * 1000 ))
  local -r reply_deadline_ms=$(( deadline_ms - _qmp_cleanup_reserve_ms ))
  # `exec` makes QMPCO_PID the socat process, so cleanup reaps the right PID.
  coproc QMPCO { exec socat - UNIX-CONNECT:"${sock}" 2>/dev/null; }
  # Bash clears QMPCO metadata when the coprocess exits; save it immediately.
  local -r rfd="${QMPCO[0]}" wfd="${QMPCO[1]}" sock_pid="${QMPCO_PID}"

  # Keep the write fd open; tolerate a stale peer closing before this write.
  { printf '%s\n' "${request}" >&"${wfd}"; } 2>/dev/null || true

  local LC_ALL=C
  local reply="" chunk="" rc=1 read_size read_rc chunk_bytes
  while true; do
    _qmp_monotonic_milliseconds now_ms || break
    (( now_ms < reply_deadline_ms )) || break
    read_size=$(( _qmp_reply_max_bytes - ${#reply} ))
    (( read_size > 0 )) || break
    (( read_size > _qmp_reply_chunk_bytes )) \
      && read_size=${_qmp_reply_chunk_bytes}

    chunk=""
    if IFS= read -r -d '' -n "${read_size}" \
        -t "${_qmp_reply_read_timeout}" \
        -u "${rfd}" chunk 2>/dev/null; then
      read_rc=0
    else
      read_rc=$?
    fi
    chunk_bytes=${#chunk}
    reply+="${chunk}"

    # With an empty delimiter, a short successful read consumed a raw NUL.
    # JSON forbids it; reject before Bash can silently normalize the frame.
    (( read_rc == 0 && chunk_bytes < read_size )) && break

    # Only a chunk containing a newline can have completed a new QMP frame.
    # Parse all accumulated complete lines in jq; Bash substring splitting is
    # quadratic on a maximum-size single line and can consume the reap budget.
    if [[ "${chunk}" == *$'\n'* ]] \
        && _qmp_complete_response_for_id \
          "${reply}" "${response_id}" >/dev/null; then
      rc=0
      break
    fi

    (( ${#reply} >= _qmp_reply_max_bytes )) && break
    # >128 is a read timeout; retain partial input and retry. 1 is EOF.
    (( read_rc == 0 || read_rc > 128 )) && continue
    break
  done

  # QEMU keeps QMP connected; close and reap the client explicitly.
  { exec {wfd}>&-; } 2>/dev/null || true
  _qmp_reap_until "${sock_pid}" "${deadline_ms}" || rc=1

  printf '%s' "${reply}"
  return "${rc}"
}

# qmp_query_running_once <qmp_sock> <timeout_seconds>
qmp_query_running_once() {
  local -r qmp_sock="${1}" timeout_seconds="${2}" \
    query_id="virtdev-query-running"
  integer_is_bounded_positive "${timeout_seconds}" 86400 || return 1
  [[ -S "${qmp_sock}" ]] || return 1
  local reply response
  reply="$(_qmp_exchange "${qmp_sock}" "${timeout_seconds}" \
    "${query_id}" \
    "{\"execute\":\"query-status\",\"id\":\"${query_id}\"}")" \
    || return 1
  response="$(_qmp_response_for_id "${reply}" "${query_id}")" || return 1
  jq -e '
    has("return") and ((.return | type) == "object") and
    (.return.running == true)
  ' <<< "${response}" >/dev/null 2>&1
}

# qmp_query_running <qmp_sock> <deadline_seconds>
qmp_query_running() {
  local -r qmp_sock="${1}" deadline_seconds="${2}"
  integer_is_bounded_positive "${deadline_seconds}" 86400 || return 1
  local deadline remaining exchange_timeout
  deadline=$(( BASH_MONOSECONDS + deadline_seconds ))
  while (( BASH_MONOSECONDS < deadline )); do
    remaining=$(( deadline - BASH_MONOSECONDS ))
    (( remaining > 0 )) || break
    exchange_timeout=3
    (( remaining < exchange_timeout )) && exchange_timeout=${remaining}
    qmp_query_running_once "${qmp_sock}" "${exchange_timeout}" && return 0
    (( BASH_MONOSECONDS < deadline )) || break
    sleep 0.2
  done
  return 1
}

# _qmp_reply_is_shutdown <raw-qmp-reply>
# Require status=shutdown and running=false from one exchange.
_qmp_reply_is_shutdown() {
  local -r reply="${1}"
  jq -e '
    type == "object" and has("return") and
    ((.return | type) == "object") and
    (.return.status == "shutdown") and (.return.running == false)
  ' <<< "${reply}" >/dev/null 2>&1
}

# _qmp_query_shutdown_once <qmp-sock> [timeout-seconds]
# The command ID prevents a capabilities acknowledgement from matching.
_qmp_query_shutdown_once() {
  local -r qmp_sock="${1}" timeout_seconds="${2:-3}" \
    query_id="virtdev-query-shutdown"
  local reply response
  reply="$(_qmp_exchange "${qmp_sock}" "${timeout_seconds}" "${query_id}" \
    "{\"execute\":\"query-status\",\"id\":\"${query_id}\"}")" \
    || return 1
  response="$(_qmp_response_for_id "${reply}" "${query_id}")" || return 1
  _qmp_reply_is_shutdown "${response}"
}

# qmp_wait_shutdown <qmp_sock> <deadline_seconds> <unit>
qmp_wait_shutdown() {
  local -r qmp_sock="${1}" deadline_seconds="${2}" unit="${3}"
  if [[ "${deadline_seconds}" != 0 ]]; then
    integer_is_bounded_positive "${deadline_seconds}" 86400 || return 1
  fi
  local deadline=0 unit_state exchange_timeout remaining unit_query_status
  if (( deadline_seconds > 0 )); then
    deadline=$(( BASH_MONOSECONDS + deadline_seconds ))
  fi

  VIRTDEV_QMP_WAIT_STATE=unknown
  while true; do
    if (( deadline_seconds > 0 && BASH_MONOSECONDS >= deadline )); then
      VIRTDEV_QMP_WAIT_STATE=timeout
      return 1
    fi
    unit_query_status=0
    if (( deadline_seconds > 0 )); then
      deadline_capture unit_state "${deadline}" 1 \
        systemctl --user show "${unit}" \
          --property=ActiveState --value 2>/dev/null \
        || unit_query_status=$?
    else
      unit_state="$(systemctl --user show "${unit}" \
        --property=ActiveState --value 2>/dev/null)" \
        || unit_query_status=$?
    fi
    case "${unit_query_status}" in
      0) ;;
      124|137)
        VIRTDEV_QMP_WAIT_STATE=timeout
        return 1
        ;;
      *)
        VIRTDEV_QMP_WAIT_STATE=manager-unreachable
        return 1
        ;;
    esac
    case "${unit_state}" in
      active|activating)
        ;;
      inactive|failed)
        VIRTDEV_QMP_WAIT_STATE=terminal
        return 1
        ;;
      '')
        VIRTDEV_QMP_WAIT_STATE=manager-unreachable
        return 1
        ;;
      *)
        # Transitional and unknown states prove neither shutdown nor ownership.
        VIRTDEV_QMP_WAIT_STATE=nonterminal
        return 1
        ;;
    esac

    exchange_timeout=3
    if (( deadline_seconds > 0 )); then
      if (( BASH_MONOSECONDS >= deadline )); then
        VIRTDEV_QMP_WAIT_STATE=timeout
        return 1
      fi
      remaining=$(( deadline - BASH_MONOSECONDS ))
      (( remaining < exchange_timeout )) && exchange_timeout=${remaining}
    fi
    if _qmp_query_shutdown_once "${qmp_sock}" "${exchange_timeout}"; then
      VIRTDEV_QMP_WAIT_STATE=shutdown
      return 0
    fi
    if (( deadline_seconds > 0 && BASH_MONOSECONDS >= deadline )); then
      VIRTDEV_QMP_WAIT_STATE=timeout
      return 1
    fi
    sleep 0.2
  done
}

# qmp_quit <qmp_sock> <timeout_seconds>
qmp_quit() {
  local -r qmp_sock="${1}" timeout_seconds="${2}" quit_id="virtdev-quit"
  integer_is_bounded_positive "${timeout_seconds}" 86400 || return 1
  local reply response
  reply="$(_qmp_exchange "${qmp_sock}" "${timeout_seconds}" "${quit_id}" \
    "{\"execute\":\"quit\",\"id\":\"${quit_id}\"}")" || return 1
  response="$(_qmp_response_for_id "${reply}" "${quit_id}")" || return 1
  jq -e 'type == "object" and has("return") and ((.return | type) == "object")' \
    <<< "${response}" >/dev/null 2>&1
}
