#!/usr/bin/env bash
# Backup manifest resolution and validation.
#
#   manifest_resolve <project>                 print first existing manifest
#   manifest_has_entries <path>                test for an active entry
#   manifest_parent_entries <path>             print active entries containing ..
#   manifest_write_rsync_files_from <src> <dst>
#   manifest_freeze_validate <src> <dst> <files-from> <deadline> <kill-after>
#   manifest_sources_confined <root> <files-from>
#
# Resolution prefers the project-local file, then XDG config. Generated
# files-from paths remove empty and `.` components as well as trailing slashes,
# so alternate spellings cannot turn a final symlink into an intermediate one.

set -euo pipefail
# shellcheck disable=SC2034,SC2016  # imported constants; literal awk program

readonly manifest_max_bytes=1048576
readonly manifest_max_lines=65536
readonly manifest_max_entries=65536
readonly manifest_max_path_bytes=4095
readonly manifest_result_invalid=40
readonly manifest_result_too_large=41
readonly manifest_result_empty=42
readonly manifest_result_timeout=43
readonly manifest_result_io=44

_manifest_cleanup_pair() {
  local -r kill_after="${1}"
  shift
  local grace="${kill_after}"

  (( grace <= 5 )) || grace=5
  timeout --signal=TERM --kill-after="${grace}" "${grace}" \
    rm -f -- "$@" >/dev/null 2>&1 || true
}

# Move a validated manifest pair under an absolute deadline. The manifest is
# the commit marker, so it is published only after its files-from companion.
manifest_publish_pair() {
  local -r source_manifest="${1:-}" source_files="${2:-}" \
    destination_manifest="${3:-}" destination_files="${4:-}" \
    deadline="${5:-}" kill_after="${6:-}"
  local remaining status=0

  [[ -f "${source_manifest}" && ! -L "${source_manifest}" \
      && -f "${source_files}" && ! -L "${source_files}" \
      && ! -e "${destination_manifest}" && ! -L "${destination_manifest}" \
      && ! -e "${destination_files}" && ! -L "${destination_files}" \
      && "${deadline}" =~ ^[0-9]+$ && "${kill_after}" =~ ^[0-9]+$ \
      && "${kill_after}" != 0 ]] || return "${manifest_result_invalid}"
  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return "${manifest_result_timeout}"

  # shellcheck disable=SC2016  # child receives paths as positional arguments
  timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" \
    bash -c '
      set -euo pipefail
      source_manifest=$1
      source_files=$2
      destination_manifest=$3
      destination_files=$4
      cleanup() {
        saved_status=$?
        trap - EXIT
        rm -f -- "${destination_manifest}" "${destination_files}"
        exit "${saved_status}"
      }
      trap cleanup EXIT
      mv -T -- "${source_files}" "${destination_files}"
      mv -T -- "${source_manifest}" "${destination_manifest}"
      trap - EXIT
    ' manifest-publish "${source_manifest}" "${source_files}" \
      "${destination_manifest}" "${destination_files}" || status=$?

  if [[ -f "${destination_manifest}" && ! -L "${destination_manifest}" \
      && -f "${destination_files}" && ! -L "${destination_files}" \
      && ! -e "${source_manifest}" && ! -L "${source_manifest}" \
      && ! -e "${source_files}" && ! -L "${source_files}" ]]; then
    return 0
  fi
  _manifest_cleanup_pair "${kill_after}" "${destination_manifest}" \
    "${destination_files}"
  case "${status}" in
    124|137) return "${manifest_result_timeout}" ;;
    *) return "${manifest_result_io}" ;;
  esac
}

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

manifest_resolve() {
  local project="${1}"
  local project_local="${VIRTDEV_HOME}/projects/${project}/manifest"
  local xdg_fallback="${XDG_CONFIG_HOME}/virtdev/projects/${project}/manifest"
  if [[ -f "${project_local}" ]]; then
    printf '%s\n' "${project_local}"
    return 0
  elif [[ -f "${xdg_fallback}" ]]; then
    printf '%s\n' "${xdg_fallback}"
    return 0
  fi
  return 1
}

manifest_has_entries() {
  grep -Eq '^[^#[:space:]]' "${1}" 2>/dev/null
}

manifest_parent_entries() {
  awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    {
      count = split($0, component, "/")
      for (i = 1; i <= count; i++) {
        if (component[i] == "..") {
          printf("%d: %s\n", NR, $0)
          break
        }
      }
    }
  ' "${1}"
}

manifest_write_rsync_files_from() {
  local -r manifest="${1}" output="${2}"
  awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    {
      count = split($0, component, "/")
      normalized = ""
      for (i = 1; i <= count; ++i) {
        if (component[i] == "" || component[i] == ".") continue
        normalized = normalized (normalized == "" ? "" : "/") component[i]
      }
      print normalized == "" ? "." : normalized
    }
  ' "${manifest}" > "${output}"
}

manifest_freeze_validate() {
  local -r source="${1:-}" destination="${2:-}" files_from="${3:-}" \
    deadline="${4:-}" kill_after="${5:-}"
  local -r frozen_tmp="${destination}.tmp" files_tmp="${files_from}.tmp"
  local remaining copy_status validate_status size_status size

  [[ -n "${source}" && -n "${destination}" && -n "${files_from}" \
      && "${deadline}" =~ ^[0-9]+$ && "${kill_after}" =~ ^[0-9]+$ \
      && "${kill_after}" != 0 && -f "${source}" && -r "${source}" \
      && ! -e "${frozen_tmp}" && ! -L "${frozen_tmp}" \
      && ! -e "${files_tmp}" && ! -L "${files_tmp}" ]] \
    || return "${manifest_result_invalid}"
  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return "${manifest_result_timeout}"

  copy_status=0
  timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" \
    head -c "$(( manifest_max_bytes + 1 ))" -- "${source}" \
    > "${frozen_tmp}" || copy_status=$?
  case "${copy_status}" in
    0) ;;
    124|137)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_timeout}"
      ;;
    *)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_io}"
      ;;
  esac
  remaining=$(( deadline - BASH_MONOSECONDS ))
  if (( remaining <= 0 )); then
    _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
    return "${manifest_result_timeout}"
  fi
  size_status=0
  size="$(timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" \
    stat -c '%s' -- "${frozen_tmp}" 2>/dev/null)" || size_status=$?
  case "${size_status}" in
    0) ;;
    124|137)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_timeout}"
      ;;
    *)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_io}"
      ;;
  esac
  if [[ ! "${size}" =~ ^[0-9]+$ ]] || (( size > manifest_max_bytes )); then
    _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
    return "${manifest_result_too_large}"
  fi

  remaining=$(( deadline - BASH_MONOSECONDS ))
  if (( remaining <= 0 )); then
    _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
    return "${manifest_result_timeout}"
  fi
  validate_status=0
  # shellcheck disable=SC2016  # awk program is literal
  LC_ALL=C timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" \
    awk -v maximum_lines="${manifest_max_lines}" \
      -v maximum_entries="${manifest_max_entries}" \
      -v maximum_path_bytes="${manifest_max_path_bytes}" '
      NR > maximum_lines { result = 41; exit }
      /^[[:space:]]*$/ { next }
      /^[[:space:]]*#/ { next }
      {
        if (length($0) > maximum_path_bytes) { result = 41; exit }
        if ($0 ~ /^[[:space:]]/ || $0 ~ /[[:space:]]$/ \
            || $0 ~ /[[:cntrl:]]/ || substr($0, 1, 1) == "/") {
          result = 40
          exit
        }
        count = split($0, component, "/")
        normalized = ""
        for (i = 1; i <= count; ++i) {
          if (component[i] == "..") { result = 40; exit }
          if (component[i] == "" || component[i] == ".") continue
          normalized = normalized (normalized == "" ? "" : "/") component[i]
        }
        if (++entries > maximum_entries) { result = 41; exit }
        print normalized == "" ? "." : normalized
      }
      END {
        if (result) exit result
        if (entries == 0) exit 42
      }
    ' "${frozen_tmp}" > "${files_tmp}" || validate_status=$?
  case "${validate_status}" in
    0) ;;
    40)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_invalid}"
      ;;
    41)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_too_large}"
      ;;
    42)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_empty}"
      ;;
    124|137)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_timeout}"
      ;;
    *)
      _manifest_cleanup_pair "${kill_after}" "${frozen_tmp}" "${files_tmp}"
      return "${manifest_result_io}"
      ;;
  esac

  manifest_publish_pair "${frozen_tmp}" "${files_tmp}" "${destination}" \
    "${files_from}" "${deadline}" "${kill_after}"
}

manifest_sources_confined() {
  local -r root="${1}" files_from="${2}"
  local path component current index normalized_count
  local -a components=() normalized=()

  [[ -d "${root}" && ! -L "${root}" ]] || return 2
  while IFS= read -r path || [[ -n "${path}" ]]; do
    IFS=/ read -r -a components <<< "${path}"
    (( ${#components[@]} > 0 )) || return 2
    normalized=()
    normalized_count=0
    for component in "${components[@]}"; do
      [[ "${component}" != .. ]] || return 2
      if [[ -n "${component}" && "${component}" != . ]]; then
        normalized[normalized_count++]="${component}"
      fi
    done
    current="${root}"
    for (( index = 0; index < normalized_count; ++index )); do
      component="${normalized[${index}]}"
      if (( index + 1 < normalized_count )); then
        current+="/${component}"
        [[ ! -L "${current}" ]] || return 1
        [[ ! -e "${current}" || -d "${current}" ]] || return 1
        [[ -e "${current}" ]] || break
      fi
    done
  done < "${files_from}"
}
