#!/usr/bin/env bash
# lib/virtdev/manifest
#
# Backup manifest resolution and validation.
#
# Public functions:
#
#   manifest_resolve <project>
#       Prints the path to the project's manifest and returns 0.
#       Resolution order: project-local first, XDG config fallback.
#       Returns 1 if no manifest is found at either location.
#
#   manifest_has_entries <path>
#       Returns 0 if the file at <path> has at least one real entry:
#       a line starting at column 0 with a non-'#' character. Leading
#       whitespace does not count — virtdev-backup rejects indented
#       lines as malformed, so counting them here would report "has
#       entries" and then "manifest has malformed paths".
#
#   manifest_write_rsync_files_from <manifest> <output>
#       Write the validated, active manifest entries for rsync. Removes
#       trailing slashes so a directory entry still recurses under rsync -r,
#       but a symlink swapped into that root is copied as a symlink rather than
#       dereferenced as a directory. This closes rsync --files-from's special
#       trailing-slash symlink-root behavior.
#
# No reserved exit codes. These functions return status codes only;
# callers are responsible for error messages.
#

set -euo pipefail

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

manifest_resolve() {
  local project="${1}"
  local project_local="${VIRTDEV_HOME}/projects/${project}/manifest"
  local xdg_fallback="${XDG_CONFIG_HOME}/virtdev/projects/${project}/manifest"
  if [[ -f "${project_local}" ]]; then
    printf '%s\n' "${project_local}"
    return 0
  elif [[ -f "${xdg_fallback}" ]]; then
    printf '%s\n' "${xdg_fallback}"
    return 0
  fi
  return 1
}

manifest_has_entries() {
  grep -Eq '^[^#[:space:]]' "${1}" 2>/dev/null
}

manifest_write_rsync_files_from() {
  local -r manifest="${1}" output="${2}"
  awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    { sub(/\/+$/, ""); print }
  ' "${manifest}" > "${output}"
}
