#!/usr/bin/env bash
# shellcheck disable=SC2034  # exit constants are consumed by launch commands
# Temporary passt backend argv. passt creates the stream socket before its
# successful foreground invocation returns.
#
set -euo pipefail

readonly passt_missing_exit_code=83
readonly passt_init_failure_exit_code=84
readonly passt_port_race_exit_code=85
readonly passt_qemu_missing_exit_code=86

passt_command() {
  local -n _command="${1}"
  local -r socket="${2}"
  local -r forward_port="${3:-}"
  local -r allow_host_loopback="${4:-}"

  _command=(
    passt
    --socket "${socket}"
    --map-guest-addr none
  )
  # A host-hole zone omits the all-or-nothing loopback block; the temporary
  # firewall then restricts the mapped path by port.
  if [[ "${allow_host_loopback}" != "1" ]]; then
    _command+=(--map-host-loopback none)
  fi
  if [[ -n "${forward_port}" ]]; then
    _command+=(-t "127.0.0.1/${forward_port}:22")
  fi
}

passt_socket_clean() {
  local -r socket="${1}"
  rm -f "${socket}"
}
