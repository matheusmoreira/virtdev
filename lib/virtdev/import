#!/usr/bin/env bash
#
# Library bootstrap and idempotent importer.
#
# Usage after set -euo pipefail:
#
#     # shellcheck disable=SC1090
#     source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"
#     import error validate lock   # whatever the script needs
#
# Exposes:
#
#   virtdev_library_directory   resolved lib/virtdev path
#   virtdev_bin_directory       resolved command directory
#   virtdev_libexec_directory   resolved private-helper directory
#   virtdev_loaded_libraries    loaded-module set
#   import()                    source named libraries once
#

set -euo pipefail

virtdev_library_directory="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck disable=SC2034  # used by consumers (virtdev-recreate, virtdev-upgrade)
virtdev_bin_directory="$(readlink -f "${virtdev_library_directory}/../../bin")"
# shellcheck disable=SC2034  # used by start and maintain
virtdev_libexec_directory="$(readlink -f "${virtdev_library_directory}/../../libexec/virtdev")"

declare -A virtdev_loaded_libraries=([import]=1)

import() {
  local f
  for f in "$@"; do
    [[ -v virtdev_loaded_libraries[$f] ]] && continue
    # Mark before sourcing to terminate circular imports.
    virtdev_loaded_libraries[$f]=1
    # shellcheck disable=SC1090
    source -p "${virtdev_library_directory}" "${f}"
  done
}
