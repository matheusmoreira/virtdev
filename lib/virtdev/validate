#!/usr/bin/env bash
#
# validate library: input validation helpers.
# Public:
#   validate_project_name <name>           charset + length (every consumer)
#   validate_project_name_reserved <name>  reserved as a project name? (minters only)
# Exit codes:
#   2  invalid project name
#
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error

validate_project_name() {
  local -r name="${1}"

  # Project names are ASCII bytes shared by hostnames, units, and paths.
  local LC_ALL=C

  if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    error 2 <<MESSAGE
Invalid project name: '${name}'
Allowed: a-z A-Z 0-9 _ - (letters, digits, underscores, hyphens)
MESSAGE
  fi

  local -r host_name_max=64
  if (( ${#name} > host_name_max )); then
    error 2 <<MESSAGE
Project name too long: '${name}' (${#name} characters)
Maximum ${host_name_max} characters (Linux HOST_NAME_MAX).
MESSAGE
  fi
}

# validate_project_name_reserved <name>
# Echo why a name collides with a storage or machine target. Network-zone names
# occupy a separate namespace and are deliberately not reserved here.
validate_project_name_reserved() {
  local -r name="${1:-}"
  case "${name}" in
    maintenance)
      printf "Project name 'maintenance' is reserved by virtdev-maintain"; return 0 ;;
    base)
      printf "Project name 'base' is reserved for the sealed base system"; return 0 ;;
    firewall)
      printf "Project name 'firewall' is reserved (the host egress lockdown unit)"; return 0 ;;
  esac
  return 1
}
