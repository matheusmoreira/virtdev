#!/usr/bin/env bash
#
# validate library: input validation helpers.
# Public:
#   validate_project_name <name>
# Exit codes:
#   2  invalid project name
#
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error

validate_project_name() {
  local -r name="${1}"

  # Pin the C locale for this function. Under a UTF-8 locale the
  # a-z/A-Z ranges in [[ =~ ]] match accented letters (e.g. 'café'
  # would pass and then flow into the systemd unit name, the guest
  # hostname, and filesystem paths), and ${#...} counts characters
  # while sun_path is a byte limit. LC_ALL=C makes the allowlist
  # strictly ASCII and the length checks byte-exact in one stroke.
  local LC_ALL=C

  if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    error 2 <<MESSAGE
Invalid project name: '${name}'
Allowed: a-z A-Z 0-9 _ - (letters, digits, underscores, hyphens)
MESSAGE
  fi

  # The longest socket path is ${VIRTDEV_HOME}/projects/<name>/console.sock.
  # sun_path is 108 bytes including the trailing NUL, so 107 are usable.
  local -r socket_overhead=23  # /projects//console.sock
  local -r sun_path_limit=107  # 108-byte sun_path minus the NUL terminator
  local max_length=$(( sun_path_limit - ${#VIRTDEV_HOME} - socket_overhead ))

  if (( max_length < 1 )); then
    error 2 <<MESSAGE
VIRTDEV_HOME path is too long for Unix domain sockets: '${VIRTDEV_HOME}'
The path must leave room for project socket paths within the 108-byte sun_path limit.
MESSAGE
  fi

  # The project name also becomes the guest hostname (via fw_cfg), and
  # the kernel truncates hostnames at 64 bytes (HOST_NAME_MAX). Cap here
  # so a long name cannot yield a guest hostname that silently diverges
  # from the project name. Track which limit actually binds so the
  # rejection message names the real cause, not always sun_path.
  local limit_reason="Unix domain socket paths are limited to 108 bytes (sun_path)."
  if (( max_length > 64 )); then
    max_length=64
    limit_reason="Project names become the guest hostname, capped at 64 bytes (HOST_NAME_MAX)."
  fi

  if (( ${#name} > max_length )); then
    error 2 <<MESSAGE
Project name too long: '${name}' (${#name} characters)
Maximum ${max_length} characters with current VIRTDEV_HOME.
${limit_reason}
MESSAGE
  fi
}
