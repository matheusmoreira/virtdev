#!/usr/bin/env bash
# Terminfo-backed terminal output.
#
#   terminal_init [auto|yes|no] [probe_fd]
#   terminal_write <text-or-attribute>...
#
# Auto mode uses fd 2 unless overridden and honors NO_COLOR and TERM=dumb.
# Attributes are fg=<color>, bg=<color>, bold, dim, italic, underline,
# reverse, standout, invisible, blink, and reset. The global `terminal`
# array contains empty values when styling is disabled.

set -euo pipefail

# Libraries are imported inside a function, so these must be global.
declare -gA terminal=()
declare -g _terminal_initialized=0

terminal_init() {
  _terminal_initialized=1
  local color_mode="${1:-${_virtdev_color_mode:-auto}}"
  local -r probe_fd="${2:-2}"
  local enable=0

  case "${color_mode}" in
    yes)
      enable=1
      ;;
    no)
      enable=0
      ;;
    auto|'')
      if [[ -t "${probe_fd}" ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-dumb}" != "dumb" ]]; then
        enable=1
      fi
      ;;
  esac

  terminal=()

  if (( enable )); then
    local -a _keys=(
      fg.black fg.red fg.green fg.yellow
      fg.blue fg.magenta fg.cyan fg.white
      bg.black bg.red bg.green bg.yellow
      bg.blue bg.magenta bg.cyan bg.white
      bold dim italic underline
      reverse standout invisible blink
      reset
    )
    # BEL separates values and cannot occur in SGR sequences.
    local -a _caps=(
      "setaf 0" "setaf 1" "setaf 2" "setaf 3"
      "setaf 4" "setaf 5" "setaf 6" "setaf 7"
      "setab 0" "setab 1" "setab 2" "setab 3"
      "setab 4" "setab 5" "setab 6" "setab 7"
      bold dim sitm smul
      rev smso invis blink
      sgr0
    )
    local _raw
    _raw=$(printf '%s\nbel\n' "${_caps[@]}" | tput -S 2>/dev/null || true)
    local -a _values=()
    local _v
    while IFS= read -rd $'\a' _v; do
      _values+=("${_v}")
    done <<< "${_raw}"
    local _i
    for (( _i = 0; _i < ${#_keys[@]}; _i++ )); do
      terminal["${_keys[_i]}"]="${_values[_i]:-}"
    done
  fi
}

terminal_write() {
  (( _terminal_initialized )) || terminal_init
  local output=''
  local arg
  for arg in "$@"; do
    case "${arg}" in
      fg=*)
        output+="${terminal[fg.${arg#*=}]:-}" ;;
      bg=*)
        output+="${terminal[bg.${arg#*=}]:-}" ;;
      bold|dim|italic|underline|reverse|standout|invisible|blink|reset)
        output+="${terminal[${arg}]:-}" ;;
      *)
        output+="${arg}" ;;
    esac
  done
  printf '%s' "${output}"
}
