#!/usr/bin/env bash
#
# ssh library: SSH helpers for virtdev guest connections.
#
# Public:
#   ssh_rsync_command <varname> <key-path> <port>
#       Builds an rsync-compatible SSH command string and assigns it
#       to the caller's variable named by <varname>. The command
#       includes key, port, and host-key/logging options.
#
#   ssh_poll_until_ready <key-path> <port> <unit> <timeout>
#       Polls SSH on 127.0.0.1:<port> every 2s until a connection
#       succeeds or <timeout> seconds elapse. Checks systemd unit
#       state each iteration; returns immediately if the unit dies.
#       Returns: 0 = SSH up, 1 = timeout, 2 = unit exited.
#
#   ssh_key_validate <key-path>
#       Verify the file at <key-path> exists and has acceptable
#       permissions (mode 600 or 400). Errors with code 77 if
#       missing, 78 if the mode is too open. The two checks are
#       paired because a key file with a wide mode is almost always
#       a setup mistake (umask leftover, copy from another host with
#       relaxed perms) and ssh would refuse it anyway with a less
#       targeted message.
#
# Exit codes:
#   77  SSH key not found
#   78  SSH key permissions too open
#
set -euo pipefail
import error

readonly ssh_key_not_found_exit_code=77
readonly ssh_key_permissions_exit_code=78

ssh_rsync_command() {
  local -r varname="${1}" key="${2}" port="${3}"
  printf -v "${varname}" \
      'ssh -i %q -p %q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR' \
      "${key}" "${port}"
}

ssh_poll_until_ready() {
  local -r key="${1}" port="${2}" unit="${3}" timeout="${4}"
  local deadline
  deadline=$(( SECONDS + timeout ))
  while (( SECONDS < deadline )); do
    local unit_state
    unit_state="$(systemctl --user is-active "${unit}" 2>/dev/null || true)"
    case "${unit_state}" in
      active|activating) ;;
      *) return 2 ;;
    esac
    if ssh \
        -F /dev/null \
        -i "${key}" \
        -p "${port}" \
        -o BatchMode=yes \
        -o ConnectTimeout=3 \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        dev@127.0.0.1 \
        true 2>/dev/null
    then
      return 0
    fi
    sleep 2
  done
  return 1
}

ssh_key_validate() {
  local -r key="${1}"
  if [[ ! -f "${key}" ]]; then
    error "${ssh_key_not_found_exit_code}" <<MESSAGE
SSH key not found: '${key}'
Generate one with virtdev-key, place an existing key at that path,
or override the location with VIRTDEV_SSH_KEY.
MESSAGE
  fi
  local -r perms="$(stat -c '%a' "${key}")"
  if [[ "${perms}" != "600" && "${perms}" != "400" ]]; then
    error "${ssh_key_permissions_exit_code}" <<MESSAGE
SSH key permissions too open: '${key}' (${perms})
Fix with: chmod 600 '${key}'
MESSAGE
  fi
}
