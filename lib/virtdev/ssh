#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2154  # public constants; import provides library path
#
# ssh library: host identity and client transport helpers.
#
# Public:
#   ssh_host_identity_ensure <project>
#       Create or validate the project's host-owned ed25519 identity.
#   ssh_host_identity_require <project>
#       Require valid existing identity state.
#   ssh_host_identity_remove <project>
#       Remove only the known identity files and their directory.
#   ssh_host_identity_rebind <project> <previous-project>
#       Rebind a moved project's known-host alias without changing its key.
#   ssh_host_identity_key <project>
#   ssh_host_identity_known_hosts <project>
#   ssh_host_identity_alias <project>
#       Print an identity path or lookup alias.
#
#   ssh_guest_contract_valid <directory>
#       Return success only for the exact current guest transport marker.
#   ssh_guest_contract_require <project>
#       Require the project marker, or the sealed-base marker for maintenance.
#
#   ssh_transport_argv <array> <mode> <project> <client-key> <port> \
#                      <config> [connect-timeout]
#       Build the common SSH argv. mode is interactive, batch, or poll;
#       poll alone requires connect-timeout.
#
#   ssh_client_option_valid <option>
#       Accept one self-contained SSH option token. Options that take an
#       argument must carry it in the same token (for example -L8080:x:80).
#
#   ssh_rsync_command <cmd-varname> <wrapper-varname> <project> \
#                     <client-key> <port>
#       Create the shared-policy SSH wrapper used as rsync's -e command.
#       Callers remove the returned wrapper path in their EXIT trap.
#
#   ssh_poll_until_ready <project> <key-path> <port> <unit> <timeout>
#       Polls SSH on 127.0.0.1:<port> up to every 2s until a connection
#       succeeds or <timeout> seconds elapse. Checks systemd unit
#       state each iteration; returns immediately if the unit dies.
#       Returns: 0 = SSH up, 1 = timeout, 2 = unit exited.
#
#   ssh_key_validate <key-path>
#       Require a regular key with mode 600 or 400.
#
# Exit codes:
#   77  SSH key not found
#   78  SSH key permissions too open
#   103 guest host identity is missing, corrupt, or could not be created
#   104 guest SSH transport marker is missing or incompatible
#
set -euo pipefail
import error integer port

readonly ssh_key_not_found_exit_code=77
readonly ssh_key_permissions_exit_code=78
readonly ssh_host_identity_exit_code=103
readonly ssh_guest_contract_exit_code=104
readonly ssh_host_identity_directory_name=ssh-host
readonly ssh_host_private_key_name=host_key
readonly ssh_host_public_key_name=host_key.pub
readonly ssh_known_hosts_name=known_hosts
readonly ssh_known_hosts_temporary_name=known_hosts.tmp
readonly ssh_guest_contract_name=guest-contract
readonly ssh_guest_contract_value='ssh-host-identity=1'
readonly ssh_guest_contract_progress="capability:${ssh_guest_contract_value}"

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

_ssh_project_name_valid() {
  local LC_ALL=C
  [[ "${1}" =~ ^[a-zA-Z0-9_-]+$ ]] && (( ${#1} <= 64 ))
}

ssh_host_identity_root() {
  _ssh_project_name_valid "${1}" || return 1
  printf '%s' "${VIRTDEV_HOME}/projects/${1}/${ssh_host_identity_directory_name}"
}

ssh_host_identity_key() {
  local root
  root="$(ssh_host_identity_root "${1}")" || return 1
  printf '%s/%s' "${root}" "${ssh_host_private_key_name}"
}

ssh_host_identity_known_hosts() {
  local root
  root="$(ssh_host_identity_root "${1}")" || return 1
  printf '%s/%s' "${root}" "${ssh_known_hosts_name}"
}

ssh_host_identity_alias() {
  _ssh_project_name_valid "${1}" || return 1
  printf 'virtdev-%s' "${1}"
}

ssh_guest_contract_valid() {
  (( $# == 1 )) || return 2
  local -r directory="${1}"
  local -r marker="${directory}/${ssh_guest_contract_name}"
  [[ -d "${directory}" && ! -L "${directory}" \
      && -f "${marker}" && ! -L "${marker}" ]] || return 1
  [[ "$(stat -c '%s' -- "${marker}" 2>/dev/null)" \
        == "$(( ${#ssh_guest_contract_value} + 1 ))" ]] || return 1
  grep -Fqx -- "${ssh_guest_contract_value}" "${marker}"
}

ssh_guest_contract_require() {
  (( $# == 1 )) || return 2
  local -r project="${1}"
  _ssh_project_name_valid "${project}" || return 2
  local directory="${VIRTDEV_HOME}/projects/${project}"
  [[ "${project}" != maintenance ]] || directory="${VIRTDEV_HOME}/system"
  ssh_guest_contract_valid "${directory}" \
    || error "${ssh_guest_contract_exit_code}" <<MESSAGE
Guest SSH contract marker is missing or incompatible: '${directory}/${ssh_guest_contract_name}'
No insecure fallback was attempted. If this image predates strict host identity,
use the previous virtdev version to back it up, then install and seal the current
ISO and recreate or restore it. virtdev-upgrade cannot cross that boundary.
MESSAGE
}

_ssh_host_identity_remove_directory() {
  local -r directory="${1}"
  [[ -e "${directory}" || -L "${directory}" ]] || return 0
  [[ -d "${directory}" && ! -L "${directory}" ]] || return 1

  local path
  for path in \
      "${directory}/${ssh_host_private_key_name}" \
      "${directory}/${ssh_host_public_key_name}" \
      "${directory}/${ssh_known_hosts_name}" \
      "${directory}/${ssh_known_hosts_temporary_name}"; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    [[ -f "${path}" && ! -L "${path}" ]] || return 1
    rm -f -- "${path}" || return 1
  done
  rmdir -- "${directory}"
}

_ssh_host_identity_validate_for_alias() {
  local -r project="${1}" alias_project="${2}"
  local root private_key public_key known_hosts
  root="$(ssh_host_identity_root "${project}")" || return 1
  private_key="${root}/${ssh_host_private_key_name}"
  public_key="${root}/${ssh_host_public_key_name}"
  known_hosts="${root}/${ssh_known_hosts_name}"

  [[ -d "${root}" && ! -L "${root}" ]] || return 1
  [[ "$(stat -c '%a' -- "${root}" 2>/dev/null)" == 700 ]] || return 1
  local file
  for file in "${private_key}" "${public_key}" "${known_hosts}"; do
    [[ -f "${file}" && ! -L "${file}" ]] || return 1
  done
  case "$(stat -c '%a' -- "${private_key}" 2>/dev/null)" in
    400|600) ;;
    *) return 1 ;;
  esac

  local private_size
  private_size="$(stat -c '%s' -- "${private_key}" 2>/dev/null)" || return 1
  [[ "${private_size}" =~ ^[0-9]+$ ]] \
    && (( private_size > 0 && private_size <= 16384 )) || return 1

  local derived type blob extra alias
  derived="$(ssh-keygen -y -P '' -f "${private_key}" 2>/dev/null)" || return 1
  [[ -n "${derived}" && "${derived}" != *$'\n'* ]] || return 1
  read -r type blob extra <<< "${derived}"
  [[ "${type}" == ssh-ed25519 && -n "${blob}" && -z "${extra}" ]] || return 1
  derived="${type} ${blob}"
  alias="$(ssh_host_identity_alias "${alias_project}")" || return 1

  local expected_public="${derived}" expected_known="${alias} ${derived}"
  [[ "$(stat -c '%s' -- "${public_key}" 2>/dev/null)" \
        == "$(( ${#expected_public} + 1 ))" ]] || return 1
  [[ "$(stat -c '%s' -- "${known_hosts}" 2>/dev/null)" \
        == "$(( ${#expected_known} + 1 ))" ]] || return 1
  grep -Fqx -- "${expected_public}" "${public_key}" || return 1
  grep -Fqx -- "${expected_known}" "${known_hosts}" || return 1
}

_ssh_host_identity_validate() {
  _ssh_host_identity_validate_for_alias "${1}" "${1}"
}

_ssh_host_identity_create() {
  local -r project="${1}"
  local project_directory="${VIRTDEV_HOME}/projects/${project}"
  local root staging private_key public_key known_hosts derived alias
  root="$(ssh_host_identity_root "${project}")" || return 1
  staging="${project_directory}/.${ssh_host_identity_directory_name}.tmp"

  [[ -d "${project_directory}" && ! -L "${project_directory}" ]] || return 1
  [[ ! -e "${root}" && ! -L "${root}" ]] || return 1
  _ssh_host_identity_remove_directory "${staging}" || return 1
  mkdir -m 0700 -- "${staging}" || return 1

  private_key="${staging}/${ssh_host_private_key_name}"
  public_key="${staging}/${ssh_host_public_key_name}"
  known_hosts="${staging}/${ssh_known_hosts_name}"
  if ! ssh-keygen -q -t ed25519 -N '' -C '' -f "${private_key}"; then
    _ssh_host_identity_remove_directory "${staging}" || true
    return 1
  fi
  derived="$(ssh-keygen -y -P '' -f "${private_key}" 2>/dev/null)" || {
    _ssh_host_identity_remove_directory "${staging}" || true
    return 1
  }
  alias="$(ssh_host_identity_alias "${project}")" || {
    _ssh_host_identity_remove_directory "${staging}" || true
    return 1
  }
  printf '%s\n' "${derived}" > "${public_key}" \
    && printf '%s %s\n' "${alias}" "${derived}" > "${known_hosts}" \
    && chmod 0600 "${private_key}" "${known_hosts}" \
    && chmod 0644 "${public_key}" \
    && sync -f "${private_key}" "${public_key}" "${known_hosts}" \
    && sync -f "${staging}" \
    && mv -T -- "${staging}" "${root}" \
    && sync -f "${project_directory}" \
    && _ssh_host_identity_validate "${project}" && return 0

  _ssh_host_identity_remove_directory "${staging}" || true
  return 1
}

ssh_host_identity_ensure() {
  local -r project="${1}"
  local root project_directory="${VIRTDEV_HOME}/projects/${project}"
  root="$(ssh_host_identity_root "${project}")" || {
    error "${ssh_host_identity_exit_code}" <<<'Invalid SSH host-identity project name'
  }
  if [[ -e "${root}" || -L "${root}" ]]; then
    _ssh_host_identity_validate "${project}" || error "${ssh_host_identity_exit_code}" <<MESSAGE
Guest SSH host identity is corrupt: '${root}'
Refusing to replace existing identity state automatically.
MESSAGE
    sync -f "${project_directory}" || error "${ssh_host_identity_exit_code}" <<MESSAGE
Could not durably confirm SSH host identity for project: ${project}
MESSAGE
    return 0
  fi
  _ssh_host_identity_create "${project}" || error "${ssh_host_identity_exit_code}" <<MESSAGE
Could not create guest SSH host identity: '${root}'
MESSAGE
}

ssh_host_identity_require() {
  local -r project="${1}"
  _ssh_host_identity_validate "${project}" || error "${ssh_host_identity_exit_code}" <<MESSAGE
Guest SSH host identity is missing or corrupt for project: ${project}
Stop and restart the virtual machine to repair missing identity state.
Existing corrupt state is never replaced automatically.
MESSAGE
}

ssh_host_identity_remove() {
  local root
  root="$(ssh_host_identity_root "${1}")" || return 1
  _ssh_host_identity_remove_directory "${root}"
}

ssh_host_identity_rebind() {
  (( $# == 2 )) || return 2
  local -r project="${1}" previous_project="${2}"
  local root known_hosts temporary old_line public_line alias
  root="$(ssh_host_identity_root "${project}")" || return 2
  ssh_host_identity_alias "${previous_project}" >/dev/null || return 2
  [[ -e "${root}" || -L "${root}" ]] || return 0
  if _ssh_host_identity_validate "${project}"; then
    sync -f "${root}" || error "${ssh_host_identity_exit_code}" <<MESSAGE
Could not durably confirm SSH host-alias rebind for project: ${project}
MESSAGE
    return 0
  fi
  _ssh_host_identity_validate_for_alias "${project}" "${previous_project}" \
    || error "${ssh_host_identity_exit_code}" <<MESSAGE
Guest SSH host identity cannot be rebound after project rename: '${root}'
MESSAGE

  known_hosts="${root}/${ssh_known_hosts_name}"
  temporary="${root}/${ssh_known_hosts_temporary_name}"
  old_line="$(< "${known_hosts}")"
  public_line="$(< "${root}/${ssh_host_public_key_name}")"
  alias="$(ssh_host_identity_alias "${project}")"
  if [[ -e "${temporary}" || -L "${temporary}" ]]; then
    [[ -f "${temporary}" && ! -L "${temporary}" ]] \
      || error "${ssh_host_identity_exit_code}" \
        <<<"Unsafe SSH alias-rebind temporary: '${temporary}'"
    rm -f -- "${temporary}"
  fi

  if ! printf '%s %s\n' "${alias}" "${public_line}" > "${temporary}" \
      || ! chmod 0600 "${temporary}" \
      || ! sync -f "${temporary}"; then
    rm -f -- "${temporary}" || true
    error "${ssh_host_identity_exit_code}" \
      <<<"Could not prepare SSH host-alias rebind for project: ${project}"
  fi
  if ! mv -T -- "${temporary}" "${known_hosts}"; then
    rm -f -- "${temporary}" || true
    error "${ssh_host_identity_exit_code}" \
      <<<"Could not commit SSH host-alias rebind for project: ${project}"
  fi
  if sync -f "${root}" && _ssh_host_identity_validate "${project}"; then
    return 0
  fi

  printf '%s\n' "${old_line}" > "${temporary}" \
    && chmod 0600 "${temporary}" \
    && sync -f "${temporary}" \
    && mv -T -- "${temporary}" "${known_hosts}" \
    && sync -f "${root}" || true
  error "${ssh_host_identity_exit_code}" \
    <<<"Could not durably rebind SSH host alias for project: ${project}"
}

ssh_transport_argv() {
  (( $# == 6 || $# == 7 )) || return 2
  local -r __ssh_transport_output_name="${1}"
  local -r __ssh_transport_mode="${2}"
  local -r __ssh_transport_project="${3}"
  local -r __ssh_transport_key="${4}"
  local -r __ssh_transport_port="${5}"
  local -r __ssh_transport_config="${6}"
  local __ssh_transport_timeout="${7:-}"
  [[ "${__ssh_transport_output_name}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ \
      && ${#__ssh_transport_output_name} -le 64 ]] || return 2
  port_is_valid "${__ssh_transport_port}" || return 2

  case "${__ssh_transport_mode}" in
    interactive|batch) (( $# == 6 )) || return 2 ;;
    poll)
      (( $# == 7 )) || return 2
      integer_is_bounded_positive "${__ssh_transport_timeout}" 86400 || return 2
      ;;
    *) return 2 ;;
  esac

  ssh_guest_contract_require "${__ssh_transport_project}"
  ssh_key_validate "${__ssh_transport_key}"
  ssh_host_identity_require "${__ssh_transport_project}"

  local __ssh_transport_known_hosts __ssh_transport_alias
  __ssh_transport_known_hosts="$(ssh_host_identity_known_hosts \
    "${__ssh_transport_project}")" || return 2
  __ssh_transport_alias="$(ssh_host_identity_alias \
    "${__ssh_transport_project}")" || return 2

  local -n __ssh_transport_output="${__ssh_transport_output_name}"
  __ssh_transport_output=(
    ssh
    -F "${__ssh_transport_config}"
    -i "${__ssh_transport_key}"
    -p "${__ssh_transport_port}"
    -o HostName=127.0.0.1
    -o AddressFamily=inet
    -o CanonicalizeHostname=no
    -o ProxyCommand=none
    -o ProxyJump=none
    -o IdentitiesOnly=yes
    -o PubkeyAuthentication=yes
    -o PreferredAuthentications=publickey
    -o PasswordAuthentication=no
    -o KbdInteractiveAuthentication=no
    -o GSSAPIAuthentication=no
    -o HostbasedAuthentication=no
    -o ForwardAgent=no
    -o GSSAPIDelegateCredentials=no
    -o StrictHostKeyChecking=yes
    -o UserKnownHostsFile="${__ssh_transport_known_hosts}"
    -o GlobalKnownHostsFile=/dev/null
    -o HostKeyAlias="${__ssh_transport_alias}"
    -o CheckHostIP=no
    -o NoHostAuthenticationForLocalhost=no
    -o HostKeyAlgorithms=ssh-ed25519
    -o UpdateHostKeys=no
    -o KnownHostsCommand=none
    -o VerifyHostKeyDNS=no
    -o ControlMaster=no
    -o ControlPath=none
    -o ControlPersist=no
    -o LogLevel=ERROR
  )
  case "${__ssh_transport_mode}" in
    batch) __ssh_transport_output+=(-o BatchMode=yes) ;;
    poll)
      __ssh_transport_output+=(
        -o BatchMode=yes
        -o ConnectTimeout="${__ssh_transport_timeout}"
      )
      ;;
  esac
}

ssh_client_option_valid() {
  (( $# == 1 && ${#1} > 1 && ${#1} <= 4096 )) || return 1
  [[ "${1}" =~ ^-[46aCgknNqTtvXxYy]+$ \
      || "${1}" =~ ^-[DELR].+ ]]
}

ssh_rsync_command() {
  (( $# == 5 )) || return 2
  local -r __ssh_rsync_cmd_name="${1}" __ssh_rsync_wrapper_name="${2}"
  local -r __ssh_rsync_project="${3}" __ssh_rsync_key="${4}"
  local -r __ssh_rsync_port="${5}"
  [[ "${__ssh_rsync_cmd_name}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ \
      && ${#__ssh_rsync_cmd_name} -le 64 \
      && "${__ssh_rsync_wrapper_name}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ \
      && ${#__ssh_rsync_wrapper_name} -le 64 ]] || return 2

  local -a __ssh_rsync_check=()
  ssh_transport_argv __ssh_rsync_check batch "${__ssh_rsync_project}" \
    "${__ssh_rsync_key}" "${__ssh_rsync_port}" /dev/null

  local __ssh_rsync_wrapper
  __ssh_rsync_wrapper="$(mktemp /tmp/virtdev-rsync-ssh.XXXXXXXX)"
  if ! chmod 700 "${__ssh_rsync_wrapper}"; then
    rm -f -- "${__ssh_rsync_wrapper}"
    return 1
  fi
  if ! cat > "${__ssh_rsync_wrapper}" <<'WRAPPER_EOF'
#!/usr/bin/env bash
set -euo pipefail
export VIRTDEV_HOME="${_VIRTDEV_RSYNC_HOME:?}"
source "${_VIRTDEV_RSYNC_IMPORT:?}"
import ssh
declare -a _virtdev_rsync_ssh_argv=()
ssh_transport_argv _virtdev_rsync_ssh_argv batch \
  "${_VIRTDEV_RSYNC_PROJECT:?}" "${_VIRTDEV_RSYNC_KEY:?}" \
  "${_VIRTDEV_RSYNC_PORT:?}" /dev/null
unset _VIRTDEV_RSYNC_IMPORT _VIRTDEV_RSYNC_HOME _VIRTDEV_RSYNC_PROJECT \
  _VIRTDEV_RSYNC_KEY _VIRTDEV_RSYNC_PORT
exec "${_virtdev_rsync_ssh_argv[@]}" "$@"
WRAPPER_EOF
  then
    rm -f -- "${__ssh_rsync_wrapper}"
    return 1
  fi
  printf -v "${__ssh_rsync_cmd_name}" '%s' "${__ssh_rsync_wrapper}"
  printf -v "${__ssh_rsync_wrapper_name}" '%s' "${__ssh_rsync_wrapper}"
  export _VIRTDEV_RSYNC_IMPORT="${virtdev_library_directory}/import"
  export _VIRTDEV_RSYNC_HOME="${VIRTDEV_HOME}"
  export _VIRTDEV_RSYNC_PROJECT="${__ssh_rsync_project}"
  export _VIRTDEV_RSYNC_KEY="${__ssh_rsync_key}"
  export _VIRTDEV_RSYNC_PORT="${__ssh_rsync_port}"
}

ssh_poll_until_ready() {
  local -r project="${1}" key="${2}" port="${3}" unit="${4}" timeout="${5}"
  integer_is_bounded_positive "${timeout}" 86400 || return 1
  local -r attempt_timeout=10
  local deadline unit_state remaining probe_timeout connect_timeout sleep_timeout
  deadline=$(( BASH_MONOSECONDS + timeout ))
  while (( BASH_MONOSECONDS < deadline )); do
    unit_state="$(systemctl --user is-active "${unit}" 2>/dev/null || true)"
    case "${unit_state}" in
      active|activating) ;;
      *) return 2 ;;
    esac

    remaining=$(( deadline - BASH_MONOSECONDS ))
    (( remaining > 0 )) || break
    probe_timeout=${attempt_timeout}
    (( remaining < probe_timeout )) && probe_timeout=${remaining}
    connect_timeout=3
    (( remaining < connect_timeout )) && connect_timeout=${remaining}
    # ConnectTimeout covers connection setup; coreutils timeout also bounds a
    # peer that stalls during the pre-authentication banner exchange.
    local -a ssh_argv=()
    ssh_transport_argv ssh_argv poll "${project}" "${key}" "${port}" \
      /dev/null "${connect_timeout}"
    if timeout "${probe_timeout}" "${ssh_argv[@]}" dev@127.0.0.1 \
        true 2>/dev/null
    then
      return 0
    fi

    remaining=$(( deadline - BASH_MONOSECONDS ))
    (( remaining > 0 )) || break
    sleep_timeout=2
    (( remaining < sleep_timeout )) && sleep_timeout=${remaining}
    sleep "${sleep_timeout}"
  done
  return 1
}

ssh_key_validate() {
  local -r key="${1}"
  if [[ ! -f "${key}" ]]; then
    error "${ssh_key_not_found_exit_code}" <<MESSAGE
SSH key not found: '${key}'
Generate one with virtdev-key, place an existing key at that path,
or override the location with VIRTDEV_SSH_KEY.
MESSAGE
  fi
  local -r perms="$(stat -c '%a' "${key}")"
  if [[ "${perms}" != "600" && "${perms}" != "400" ]]; then
    error "${ssh_key_permissions_exit_code}" <<MESSAGE
SSH key permissions too open: '${key}' (${perms})
Fix with: chmod 600 '${key}'
MESSAGE
  fi
}
