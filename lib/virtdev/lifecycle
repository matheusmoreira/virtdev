#!/usr/bin/env bash
# shellcheck disable=SC2034  # status constants and diagnostic globals are public
# shellcheck disable=SC2154  # imported runtime/passt constants
# Lifecycle service for a systemd-owned QEMU machine.
#
# Public operations return structured statuses; they never exit the caller.
# Diagnostic globals describe the last observed activation or stop state.

set -euo pipefail

import integer passt port qmp runtime

readonly lifecycle_ready=0
readonly lifecycle_backend_missing=10
readonly lifecycle_backend_failed=11
readonly lifecycle_qemu_missing=12
readonly lifecycle_qemu_crashed=13
readonly lifecycle_activation_timeout=14
readonly lifecycle_qmp_unready=15
readonly lifecycle_invalid=16
readonly lifecycle_systemd_unreachable=17

readonly lifecycle_stop_clean=0
readonly lifecycle_stop_indeterminate=20
readonly lifecycle_stop_timeout=21
readonly lifecycle_stop_cleanup_failed=22
readonly lifecycle_stop_invalid=23

readonly lifecycle_publish_ok=0
readonly lifecycle_publish_invalid=30
readonly lifecycle_publish_failed=31

VIRTDEV_LIFECYCLE_ACTIVE_STATE=unknown
VIRTDEV_LIFECYCLE_EXIT_STATUS=unknown
VIRTDEV_LIFECYCLE_LAUNCH_PHASE=unknown
VIRTDEV_LIFECYCLE_STOP_STATE=unknown

lifecycle_deadline_run() {
  local -r deadline="${1:-}" kill_after="${2:-}"
  shift 2
  local remaining

  [[ "${deadline}" =~ ^[0-9]+$ && "${kill_after}" =~ ^[0-9]+$ \
      && "${kill_after}" != 0 && $# -gt 0 ]] || return 125
  remaining=$(( deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return 124
  timeout --signal=TERM --kill-after="${kill_after}" "${remaining}" "$@"
}

lifecycle_deadline_capture() {
  local -n _lifecycle_capture_ref="${1}"
  local -r deadline="${2}" kill_after="${3}"
  shift 3
  local status=0

  _lifecycle_capture_ref="$(
    lifecycle_deadline_run "${deadline}" "${kill_after}" "$@"
  )" || status=$?
  return "${status}"
}

_lifecycle_active_state_until() {
  local -n _lifecycle_state_ref="${1}"
  local -r unit="${2}" deadline="${3}"
  local status=0

  _lifecycle_state_ref=''
  lifecycle_deadline_capture _lifecycle_state_ref "${deadline}" 1 \
    systemctl --user show "${unit}" --property=ActiveState --value \
    2>/dev/null || status=$?
  (( status == 0 )) || return "${status}"
  [[ -n "${_lifecycle_state_ref}" ]] || return 1
}

_lifecycle_classify_terminal() {
  local -r unit="${1}" phase_file="${2}" deadline="${3}"
  local query_status=0

  lifecycle_deadline_capture VIRTDEV_LIFECYCLE_EXIT_STATUS "${deadline}" 1 \
    systemctl --user show "${unit}" --property=ExecMainStatus --value \
    2>/dev/null || query_status=$?
  case "${query_status}" in
    0) ;;
    124|137) return "${lifecycle_activation_timeout}" ;;
    *) return "${lifecycle_systemd_unreachable}" ;;
  esac
  VIRTDEV_LIFECYCLE_EXIT_STATUS="${VIRTDEV_LIFECYCLE_EXIT_STATUS:-unknown}"
  VIRTDEV_LIFECYCLE_LAUNCH_PHASE="$(
    runtime_launch_phase_read "${phase_file}" 2>/dev/null || true
  )"
  VIRTDEV_LIFECYCLE_LAUNCH_PHASE="${VIRTDEV_LIFECYCLE_LAUNCH_PHASE:-unknown}"
  if [[ "${VIRTDEV_LIFECYCLE_LAUNCH_PHASE}" == "${runtime_launch_phase_shim}" ]]; then
    case "${VIRTDEV_LIFECYCLE_EXIT_STATUS}" in
      "${passt_missing_exit_code}") return "${lifecycle_backend_missing}" ;;
      "${passt_init_failure_exit_code}") return "${lifecycle_backend_failed}" ;;
      "${passt_qemu_missing_exit_code}") return "${lifecycle_qemu_missing}" ;;
    esac
  fi
  return "${lifecycle_qemu_crashed}"
}

lifecycle_wait_active() {
  local -r unit="${1:-}" runtime_directory="${2:-}" deadline_seconds="${3:-}"
  if [[ -z "${unit}" || -z "${runtime_directory}" ]] \
      || { [[ "${deadline_seconds}" != 0 ]] \
        && ! integer_is_bounded_positive "${deadline_seconds}" 86400; }; then
    return "${lifecycle_invalid}"
  fi
  local deadline=$(( BASH_MONOSECONDS + deadline_seconds ))
  local -r phase_file="$(runtime_launch_phase_file "${runtime_directory}")"
  local state query_status=0 terminal_status=0

  (( deadline_seconds > 0 )) || (( deadline++ ))

  VIRTDEV_LIFECYCLE_ACTIVE_STATE=unknown
  VIRTDEV_LIFECYCLE_EXIT_STATUS=unknown
  VIRTDEV_LIFECYCLE_LAUNCH_PHASE=unknown

  while true; do
    query_status=0
    _lifecycle_active_state_until state "${unit}" "${deadline}" \
      || query_status=$?
    case "${query_status}" in
      0) ;;
      124|137)
        VIRTDEV_LIFECYCLE_ACTIVE_STATE=timeout
        return "${lifecycle_activation_timeout}"
        ;;
      *)
        VIRTDEV_LIFECYCLE_ACTIVE_STATE=unknown
        return "${lifecycle_systemd_unreachable}"
        ;;
    esac
    VIRTDEV_LIFECYCLE_ACTIVE_STATE="${state:-unknown}"
    case "${state}" in
      active)
        VIRTDEV_LIFECYCLE_LAUNCH_PHASE="$(
          runtime_launch_phase_read "${phase_file}" 2>/dev/null || true
        )"
        VIRTDEV_LIFECYCLE_LAUNCH_PHASE="${VIRTDEV_LIFECYCLE_LAUNCH_PHASE:-unknown}"
        if [[ "${VIRTDEV_LIFECYCLE_LAUNCH_PHASE}" == "${runtime_launch_phase_qemu}" ]]; then
          return "${lifecycle_ready}"
        fi
        ;;
      failed|inactive)
        terminal_status=0
        _lifecycle_classify_terminal "${unit}" "${phase_file}" \
          "${deadline}" || terminal_status=$?
        return "${terminal_status}"
        ;;
    esac
    (( BASH_MONOSECONDS >= deadline )) \
      && return "${lifecycle_activation_timeout}"
    sleep 0.1
  done
}

lifecycle_wait_ready() {
  local -r unit="${1:-}" runtime_directory="${2:-}" \
    activation_timeout="${3:-}" qmp_timeout="${4:-}"
  lifecycle_wait_active "${unit}" "${runtime_directory}" "${activation_timeout}" \
    || return $?
  integer_is_bounded_positive "${qmp_timeout}" 86400 \
    || return "${lifecycle_invalid}"
  local -r deadline=$(( BASH_MONOSECONDS + qmp_timeout )) \
    qmp_sock="$(runtime_qmp_sock "${runtime_directory}")" \
    phase_file="$(runtime_launch_phase_file "${runtime_directory}")"
  local state remaining probe_timeout query_status=0 terminal_status=0
  while (( BASH_MONOSECONDS < deadline )); do
    query_status=0
    _lifecycle_active_state_until state "${unit}" "${deadline}" \
      || query_status=$?
    case "${query_status}" in
      0) ;;
      124|137)
        VIRTDEV_LIFECYCLE_ACTIVE_STATE=timeout
        return "${lifecycle_qmp_unready}"
        ;;
      *)
        VIRTDEV_LIFECYCLE_ACTIVE_STATE=unknown
        return "${lifecycle_systemd_unreachable}"
        ;;
    esac
    VIRTDEV_LIFECYCLE_ACTIVE_STATE="${state:-unknown}"
    case "${state}" in
      active)
        remaining=$(( deadline - BASH_MONOSECONDS ))
        (( remaining > 0 )) || break
        probe_timeout=1
        (( remaining < probe_timeout )) && probe_timeout=${remaining}
        qmp_query_running_once "${qmp_sock}" "${probe_timeout}" \
          && return "${lifecycle_ready}"
        ;;
      failed|inactive)
        terminal_status=0
        _lifecycle_classify_terminal "${unit}" "${phase_file}" \
          "${deadline}" || terminal_status=$?
        return "${terminal_status}"
        ;;
      *) return "${lifecycle_qmp_unready}" ;;
    esac
    (( BASH_MONOSECONDS < deadline )) || break
    sleep 0.1
  done
  return "${lifecycle_qmp_unready}"
}

lifecycle_publish_ready() {
  local -r runtime_directory="${1:-}" published_port="${2:-}"
  [[ -n "${runtime_directory}" ]] && port_is_valid "${published_port}" \
    || return "${lifecycle_publish_invalid}"
  local -r port_file="$(runtime_port_file "${runtime_directory}")" \
    port_tmp="$(runtime_port_tmp_file "${runtime_directory}")"
  runtime_remove_artifact "${port_tmp}" \
    || return "${lifecycle_publish_failed}"
  if ! printf '%s\n' "${published_port}" > "${port_tmp}" \
      || ! mv -T -- "${port_tmp}" "${port_file}"; then
    runtime_remove_artifact "${port_tmp}" || true
    return "${lifecycle_publish_failed}"
  fi
}

lifecycle_confirm_terminal() {
  local -r unit="${1:-}" deadline_seconds="${2:-1}"
  if [[ -z "${unit}" ]] \
      || { [[ "${deadline_seconds}" != 0 ]] \
        && ! integer_is_bounded_positive "${deadline_seconds}" 86400; }; then
    return "${lifecycle_stop_invalid}"
  fi
  local deadline=$(( BASH_MONOSECONDS + deadline_seconds ))
  local state query_status=0

  (( deadline_seconds > 0 )) || (( deadline++ ))
  _lifecycle_active_state_until state "${unit}" "${deadline}" \
    || query_status=$?
  case "${query_status}" in
    0) ;;
    124|137)
      VIRTDEV_LIFECYCLE_STOP_STATE=timeout
      return "${lifecycle_stop_indeterminate}"
      ;;
    *)
      VIRTDEV_LIFECYCLE_STOP_STATE=unknown
      return "${lifecycle_stop_indeterminate}"
      ;;
  esac
  VIRTDEV_LIFECYCLE_STOP_STATE="${state:-unknown}"
  case "${state}" in
    inactive|failed) return "${lifecycle_stop_clean}" ;;
    '') return "${lifecycle_stop_indeterminate}" ;;
    *) return "${lifecycle_stop_timeout}" ;;
  esac
}

lifecycle_wait_terminal_until() {
  local -r unit="${1:-}" deadline="${2:-}"
  local state query_status=0

  [[ -n "${unit}" && "${deadline}" =~ ^[0-9]+$ ]] \
    || return "${lifecycle_stop_invalid}"
  while true; do
    query_status=0
    _lifecycle_active_state_until state "${unit}" "${deadline}" \
      || query_status=$?
    case "${query_status}" in
      0) ;;
      124|137)
        VIRTDEV_LIFECYCLE_STOP_STATE=timeout
        return "${lifecycle_stop_timeout}"
        ;;
      *)
        VIRTDEV_LIFECYCLE_STOP_STATE=unknown
        return "${lifecycle_stop_indeterminate}"
        ;;
    esac
    VIRTDEV_LIFECYCLE_STOP_STATE="${state:-unknown}"
    case "${state}" in
      inactive|failed) return "${lifecycle_stop_clean}" ;;
    esac
    (( BASH_MONOSECONDS < deadline )) \
      || return "${lifecycle_stop_timeout}"
    sleep 0.1
  done
}

lifecycle_stop_and_confirm() {
  local -r unit="${1:-}" deadline_seconds="${2:-}"
  if [[ -z "${unit}" ]] \
      || { [[ "${deadline_seconds}" != 0 ]] \
        && ! integer_is_bounded_positive "${deadline_seconds}" 86400; }; then
    return "${lifecycle_stop_invalid}"
  fi
  local deadline=$(( BASH_MONOSECONDS + deadline_seconds ))
  local submit_status=0

  VIRTDEV_LIFECYCLE_STOP_STATE=unknown
  (( deadline_seconds > 0 )) || (( deadline++ ))
  lifecycle_deadline_run "${deadline}" 1 \
    systemctl --user stop --no-block "${unit}" >/dev/null 2>&1 \
    || submit_status=$?
  case "${submit_status}" in
    0) ;;
    124|137)
      VIRTDEV_LIFECYCLE_STOP_STATE=timeout
      return "${lifecycle_stop_timeout}"
      ;;
    *)
      VIRTDEV_LIFECYCLE_STOP_STATE=unknown
      return "${lifecycle_stop_indeterminate}"
      ;;
  esac
  lifecycle_wait_terminal_until "${unit}" "${deadline}"
}

lifecycle_stop_and_clean() {
  local -r unit="${1:-}" runtime_directory="${2:-}" deadline_seconds="${3:-}"
  [[ -n "${runtime_directory}" ]] || return "${lifecycle_stop_invalid}"
  lifecycle_stop_and_confirm "${unit}" "${deadline_seconds}" || return $?
  runtime_clean "${runtime_directory}" \
    || return "${lifecycle_stop_cleanup_failed}"
}

lifecycle_clean_unowned() {
  local -r runtime_directory="${1:-}"
  [[ -n "${runtime_directory}" ]] || return "${lifecycle_stop_invalid}"
  runtime_clean "${runtime_directory}" \
    || return "${lifecycle_stop_cleanup_failed}"
}
