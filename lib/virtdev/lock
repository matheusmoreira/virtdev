#!/usr/bin/env bash
#
# lock library: exclusive virtdev lock acquisition.
# Public:
#   lock_acquire                  every script except maintain
#   lock_acquire_for_maintain     maintain (different message when
#                                 holder is also maintain)
# Exit codes:
#   75  lock contention (EX_TEMPFAIL — retry possible)
#   76  lock setup failure (cannot create/open the lock file)
#
# The lock is held via fd 9 for the entire lifetime of the calling
# process and released automatically when the process exits (fd 9
# closes). Opening with >> (append) preserves the holder PID file
# for the contention path; O_TRUNC would wipe it before the loser
# could read it.
#
set -euo pipefail
: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
import error

readonly lock_contention_exit_code=75
readonly lock_setup_exit_code=76

# lock_file is deliberately NOT declared as a top-level readonly:
# its value derives from VIRTDEV_HOME, and a top-level binding would
# capture VIRTDEV_HOME's current value at source time — freezing the
# lock target even if a consumer rebinds VIRTDEV_HOME afterward
# (e.g., from a --virtdev-home flag parsed after the import). Each
# function that needs the path declares it as `local -r` at entry,
# which still forbids rebinding within the call but evaluates
# ${VIRTDEV_HOME} fresh each time.

lock_acquire() {
  local -r lock_file="${VIRTDEV_HOME}/lock"
  lock_open "${lock_file}"
  if ! flock -n 9; then
    lock_die_for_other
  fi
  printf '%d\n' "$$" > "${lock_file}"
}

lock_acquire_for_maintain() {
  local -r lock_file="${VIRTDEV_HOME}/lock"
  lock_open "${lock_file}"
  if ! flock -n 9; then
    lock_die_for_maintain
  fi
  printf '%d\n' "$$" > "${lock_file}"
}

# lock_open <lock-file>
#   Create VIRTDEV_HOME (mode 0700) and open the lock file on fd 9.
#   A failure here is a STRUCTURAL problem (path is a directory,
#   unwritable, read-only filesystem, ENOSPC) — fatal with the
#   distinct, non-retryable code 76. Previously open and flock shared
#   one code path, so a failed open fell through to `flock -n 9`
#   (EBADF) and was misreported as retryable lock contention (75).
lock_open() {
  local -r lock_file="${1}"
  # shellcheck disable=SC2174  # VIRTDEV_HOME is the deepest component, so -m applies to it
  if ! mkdir -p -m 0700 "${VIRTDEV_HOME}" 2>/dev/null; then
    error "${lock_setup_exit_code}" <<MESSAGE
Cannot create virtdev home directory: '${VIRTDEV_HOME}'
Check that its parent directory is writable.
MESSAGE
  fi
  # Best-effort harden a pre-existing VIRTDEV_HOME (may be owned by
  # another user on shared storage); don't abort if the chmod fails.
  chmod 0700 "${VIRTDEV_HOME}" 2>/dev/null || true
  # Probe openability with a catchable redirection before the fd-9
  # `exec`: an exec redirection error would exit the shell outright,
  # bypassing this diagnostic.
  if ! { : >> "${lock_file}"; } 2>/dev/null; then
    error "${lock_setup_exit_code}" <<MESSAGE
Cannot open lock file: '${lock_file}'
Check that '${VIRTDEV_HOME}' is writable and on a normal filesystem.
MESSAGE
  fi
  exec 9>>"${lock_file}"
}

lock_holder_pid_and_cmdline() {
  local -r lock_file="${VIRTDEV_HOME}/lock"
  local pid cmdline=""
  pid="$(cat "${lock_file}" 2>/dev/null || true)"
  if [[ -n "${pid}" && -r "/proc/${pid}/cmdline" ]]; then
    cmdline="$(tr '\0' ' ' < "/proc/${pid}/cmdline")"
  fi
  printf '%s\t%s\n' "${pid}" "${cmdline}"
}

lock_die_for_other() {
  local -r lock_file="${VIRTDEV_HOME}/lock"
  local pid cmdline
  IFS=$'\t' read -r pid cmdline < <(lock_holder_pid_and_cmdline)
  if [[ "${cmdline}" == *virtdev-maintain* ]]; then
    error "${lock_contention_exit_code}" <<MESSAGE
Base system maintenance is in progress (virtdev-maintain, PID ${pid}).
Wait for it to finish or inspect its virtual machine:
    systemctl --user status virtdev-maintenance
MESSAGE
  else
    error "${lock_contention_exit_code}" <<MESSAGE
Another virtdev operation is in progress.
Lock file: ${lock_file}
Holder PID: ${pid:-unknown}
MESSAGE
  fi
}

lock_die_for_maintain() {
  local -r lock_file="${VIRTDEV_HOME}/lock"
  local pid cmdline
  IFS=$'\t' read -r pid cmdline < <(lock_holder_pid_and_cmdline)
  if [[ "${cmdline}" == *virtdev-maintain* ]]; then
    error "${lock_contention_exit_code}" <<MESSAGE
Another virtdev-maintain is already running (PID ${pid}).
Wait for it to finish or inspect its virtual machine:
    systemctl --user status virtdev-maintenance
MESSAGE
  else
    error "${lock_contention_exit_code}" <<MESSAGE
Another virtdev operation is in progress.
Lock file: ${lock_file}
Holder PID: ${pid:-unknown}
MESSAGE
  fi
}
