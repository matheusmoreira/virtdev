#!/usr/bin/env bash
# Mount-boundary inspection for recursive host operations.

set -euo pipefail

mount_find_below() {
  local -r root="${1}"
  local -n _mount_find_ref="${2}"
  local line mount_id parent_id device filesystem_root encoded_path remainder
  local decoded_path
  local -a mountinfo=()

  _mount_find_ref=""
  [[ "${root}" == /* ]] || return 2
  mapfile -t mountinfo < /proc/self/mountinfo || return 2
  (( ${#mountinfo[@]} > 0 )) || return 2
  for line in "${mountinfo[@]}"; do
    IFS=' ' read -r mount_id parent_id device filesystem_root encoded_path \
      remainder <<< "${line}"
    [[ "${mount_id}" =~ ^[0-9]+$ && "${parent_id}" =~ ^[0-9]+$ \
        && "${device}" =~ ^[0-9]+:[0-9]+$ && "${filesystem_root}" == /* \
        && "${encoded_path}" == /* && -n "${remainder}" ]] || return 2
    printf -v decoded_path '%b' "${encoded_path}"
    if [[ "${decoded_path}" == "${root}" \
        || "${decoded_path}" == "${root}/"* ]] \
        && (( ${#decoded_path} > ${#_mount_find_ref} )); then
      _mount_find_ref="${decoded_path}"
    fi
  done
  [[ -n "${_mount_find_ref}" ]]
}

mount_find_containing() {
  local -r path="${1}"
  local -n _mount_containing_ref="${2}"
  local line mount_id parent_id device filesystem_root encoded_path remainder
  local decoded_path
  local -a mountinfo=()

  _mount_containing_ref=""
  [[ "${path}" == /* ]] || return 2
  mapfile -t mountinfo < /proc/self/mountinfo || return 2
  (( ${#mountinfo[@]} > 0 )) || return 2
  for line in "${mountinfo[@]}"; do
    IFS=' ' read -r mount_id parent_id device filesystem_root encoded_path \
      remainder <<< "${line}"
    [[ "${mount_id}" =~ ^[0-9]+$ && "${parent_id}" =~ ^[0-9]+$ \
        && "${device}" =~ ^[0-9]+:[0-9]+$ && "${filesystem_root}" == /* \
        && "${encoded_path}" == /* && -n "${remainder}" ]] || return 2
    printf -v decoded_path '%b' "${encoded_path}"
    if [[ "${decoded_path}" == / || "${path}" == "${decoded_path}" \
        || "${path}" == "${decoded_path}/"* ]] \
        && (( ${#decoded_path} > ${#_mount_containing_ref} )); then
      _mount_containing_ref="${decoded_path}"
    fi
  done
  [[ -n "${_mount_containing_ref}" ]] || return 2
}

# Remove one absolute, non-symlink directory only after a fresh mount check.
# Returns 1 for a subordinate mount, 2 for an unsafe/indeterminate target, and
# 3 when bounded removal itself fails. The mount path is returned by nameref.
mount_remove_tree() {
  local -r path="${1}"
  local -n _mount_remove_ref="${2}"
  local canonical before after found_mount="" status=0

  _mount_remove_ref=""
  [[ "${path}" == /* ]] || return 2
  [[ -e "${path}" || -L "${path}" ]] || return 0
  [[ -d "${path}" && ! -L "${path}" ]] || return 2
  canonical="$(realpath -e -- "${path}" 2>/dev/null)" || return 2
  before="$(stat -Lc '%d:%i:%u' -- "${canonical}" 2>/dev/null)" || return 2
  mount_find_below "${canonical}" found_mount || status=$?
  case "${status}" in
    0)
      _mount_remove_ref="${found_mount}"
      return 1
      ;;
    1) ;;
    *) return 2 ;;
  esac
  after="$(stat -Lc '%d:%i:%u' -- "${canonical}" 2>/dev/null)" || return 2
  [[ "${after}" == "${before}" ]] || return 2
  rm -rf --one-file-system -- "${canonical}" || return 3
}

mount_cleanup_guidance() {
  local -r path="${1}"
  local canonical mount_path="" quoted_path quoted_mount status=0

  printf -v quoted_path '%q' "${path}"
  if [[ "${path}" != /* || ! -d "${path}" || -L "${path}" ]]; then
    printf 'Cleanup target is not a safe directory; preserve and inspect it: %s' \
      "${quoted_path}"
    return 0
  fi
  canonical="$(realpath -e -- "${path}" 2>/dev/null)" || {
    printf 'Mount state is indeterminate; preserve and inspect: %s' \
      "${quoted_path}"
    return 0
  }
  mount_find_below "${canonical}" mount_path || status=$?
  case "${status}" in
    0)
      printf -v quoted_mount '%q' "${mount_path}"
      printf 'Mounted filesystem detected below the preserved tree: %s\n' \
        "${mount_path}"
      printf 'Unmount it first: umount -- %s' "${quoted_mount}"
      ;;
    1)
      printf 'Remove it if stale: rm -rf --one-file-system -- %s' \
        "${quoted_path}"
      ;;
    *)
      printf 'Mount state is indeterminate; preserve and inspect: %s' \
        "${quoted_path}"
      ;;
  esac
}
