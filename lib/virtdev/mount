#!/usr/bin/env bash
# Mount-boundary inspection for recursive host operations.
# shellcheck disable=SC2154  # library directory is provided by import

set -euo pipefail

mount_find_below() {
  local -r root="${1}"
  local -n _mount_find_ref="${2}"
  local line mount_id parent_id device filesystem_root encoded_path remainder
  local decoded_path
  local -a mountinfo=()

  _mount_find_ref=""
  [[ "${root}" == /* ]] || return 2
  mapfile -t mountinfo < /proc/self/mountinfo || return 2
  (( ${#mountinfo[@]} > 0 )) || return 2
  for line in "${mountinfo[@]}"; do
    IFS=' ' read -r mount_id parent_id device filesystem_root encoded_path \
      remainder <<< "${line}"
    [[ "${mount_id}" =~ ^[0-9]+$ && "${parent_id}" =~ ^[0-9]+$ \
        && "${device}" =~ ^[0-9]+:[0-9]+$ && "${filesystem_root}" == /* \
        && "${encoded_path}" == /* && -n "${remainder}" ]] || return 2
    printf -v decoded_path '%b' "${encoded_path}"
    if [[ "${decoded_path}" == "${root}" \
        || "${decoded_path}" == "${root}/"* ]] \
        && (( ${#decoded_path} > ${#_mount_find_ref} )); then
      _mount_find_ref="${decoded_path}"
    fi
  done
  [[ -n "${_mount_find_ref}" ]]
}

mount_find_containing() {
  local -r path="${1}"
  local -n _mount_containing_ref="${2}"
  local line mount_id parent_id device filesystem_root encoded_path remainder
  local decoded_path
  local -a mountinfo=()

  _mount_containing_ref=""
  [[ "${path}" == /* ]] || return 2
  mapfile -t mountinfo < /proc/self/mountinfo || return 2
  (( ${#mountinfo[@]} > 0 )) || return 2
  for line in "${mountinfo[@]}"; do
    IFS=' ' read -r mount_id parent_id device filesystem_root encoded_path \
      remainder <<< "${line}"
    [[ "${mount_id}" =~ ^[0-9]+$ && "${parent_id}" =~ ^[0-9]+$ \
        && "${device}" =~ ^[0-9]+:[0-9]+$ && "${filesystem_root}" == /* \
        && "${encoded_path}" == /* && -n "${remainder}" ]] || return 2
    printf -v decoded_path '%b' "${encoded_path}"
    if [[ "${decoded_path}" == / || "${path}" == "${decoded_path}" \
        || "${path}" == "${decoded_path}/"* ]] \
        && (( ${#decoded_path} > ${#_mount_containing_ref} )); then
      _mount_containing_ref="${decoded_path}"
    fi
  done
  [[ -n "${_mount_containing_ref}" ]] || return 2
}

# Remove one absolute, non-symlink directory without crossing a mount.
# Returns 1 for a mount boundary, 2 for an unsafe target, and 3 for failure.
mount_remove_tree() {
  local -r path="${1}"
  local -n _mount_remove_ref="${2}"
  local canonical found_mount="" helper_output="" scan_status=0 remove_status=0
  local remove_tree_helper

  _mount_remove_ref=""
  [[ "${path}" == /* ]] || return 2
  [[ -e "${path}" || -L "${path}" ]] || return 0
  [[ -d "${path}" && ! -L "${path}" ]] || return 2
  canonical="$(realpath -e -- "${path}" 2>/dev/null)" || return 2
  mount_find_below "${canonical}" found_mount || scan_status=$?
  case "${scan_status}" in
    0)
      _mount_remove_ref="${found_mount}"
      return 1
      ;;
    1) ;;
    *) return 2 ;;
  esac
  remove_tree_helper="${virtdev_libexec_directory:-$(readlink -f \
    "$(dirname "${BASH_SOURCE[0]}")/../../libexec/virtdev")}/virtdev-remove-tree"
  [[ -x "${remove_tree_helper}" ]] || return 2
  helper_output="$("${remove_tree_helper}" "${canonical}")" \
    || remove_status=$?
  case "${remove_status}" in
    0) ;;
    1)
      _mount_remove_ref="${helper_output:-${canonical}}"
      return 1
      ;;
    2) return 2 ;;
    *) return 3 ;;
  esac
}

# Supervise the complete inspection-and-removal operation. Returns the same
# statuses as mount_remove_tree, plus 4 when the cleanup window expires.
mount_remove_tree_bounded() {
  local -r path="${1}" timeout_seconds="${3}" kill_after="${4}"
  local -n _mount_remove_bounded_ref="${2}"
  local output='' status=0

  _mount_remove_bounded_ref=''
  [[ "${timeout_seconds}" =~ ^[0-9]+$ && "${timeout_seconds}" != 0 \
      && "${kill_after}" =~ ^[0-9]+$ && "${kill_after}" != 0 ]] || return 2
  # shellcheck disable=SC2016  # child receives paths as positional arguments
  output="$(timeout --signal=TERM --kill-after="${kill_after}" \
    "${timeout_seconds}" bash -c '
      set -euo pipefail
      source "$1/import"
      import mount
      mount_path=""
      remove_status=0
      mount_remove_tree "$2" mount_path || remove_status=$?
      printf "%s" "${mount_path}"
      exit "${remove_status}"
    ' mount-remove-tree "${virtdev_library_directory}" "${path}")" || status=$?
  _mount_remove_bounded_ref="${output}"
  case "${status}" in
    0|1|2|3) return "${status}" ;;
    124|137) return 4 ;;
    *) return 3 ;;
  esac
}

mount_cleanup_guidance() {
  local -r path="${1}"
  local canonical mount_path="" quoted_path quoted_mount status=0

  printf -v quoted_path '%q' "${path}"
  if [[ "${path}" != /* || ! -d "${path}" || -L "${path}" ]]; then
    printf 'Cleanup target is not a safe directory; preserve and inspect it: %s' \
      "${quoted_path}"
    return 0
  fi
  canonical="$(realpath -e -- "${path}" 2>/dev/null)" || {
    printf 'Mount state is indeterminate; preserve and inspect: %s' \
      "${quoted_path}"
    return 0
  }
  mount_find_below "${canonical}" mount_path || status=$?
  case "${status}" in
    0)
      printf -v quoted_mount '%q' "${mount_path}"
      printf 'Mounted filesystem detected below the preserved tree: %s\n' \
        "${mount_path}"
      printf 'Unmount it first: umount -- %s' "${quoted_mount}"
      ;;
    1)
      printf 'No mount is currently visible. Retry the owning virtdev command; '
      printf 'do not recursively remove this tree by pathname: %s' "${quoted_path}"
      ;;
    *)
      printf 'Mount state is indeterminate; preserve and inspect: %s' \
        "${quoted_path}"
      ;;
  esac
}
