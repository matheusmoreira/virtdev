#!/usr/bin/env bash
#
# virtdev-move <source> <target>
#
# Renames a project. The project must be stopped.
#
# Moves the project directory, any backup snapshots, and updates
# the project marker inside each snapshot. Backing file paths in
# qcow2 images are absolute and do not reference the project name,
# so no image rewriting is needed.
#
# If a config directory exists under the XDG config path for the
# source project (provision scripts, manifests, triggers,
# ssh_config), a warning is printed — those are user-owned files
# and must be moved manually.
#
# Exit codes:
#
#   0   success
#   3   source project not found
#   4   target project already exists
#   5   source virtual machine is running
#   6   reserved project name
#   7   source and target are the same
#   8   backup snapshots already exist for the target name
#   9   move transaction journal is invalid or conflicts with the request
#   103 SSH host identity could not be rebound to the target project name
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import enumerate error validate lock arguments terminal project runtime ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(old-name new-name)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 2 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

source_name="${1}"
target_name="${2}"

validate_project_name "${source_name}"
validate_project_name "${target_name}"

if [[ "${source_name}" == "${target_name}" ]]; then
  error 7 <<<"Source and target are the same: ${source_name}"
fi

# Both endpoints must avoid real storage/machine collisions. Zone names are
# independent project identities.
for name in "${source_name}" "${target_name}"; do
  if reserved_reason="$(validate_project_name_reserved "${name}")"; then
    error 6 <<<"${reserved_reason}"
  fi
done

target_directory="${VIRTDEV_HOME}/projects/${target_name}"
if ! runtime_socket_paths_fit "${target_directory}"; then
  error 2 <<MESSAGE
Runtime path is too long for Unix sockets: '${target_directory}'
Choose a shorter VIRTDEV_HOME or target project name.
MESSAGE
fi

lock_acquire

source_directory="${VIRTDEV_HOME}/projects/${source_name}"
transaction_file="${VIRTDEV_HOME}/move.transaction"

move_transaction_read() {
  [[ -f "${transaction_file}" && ! -L "${transaction_file}" ]] || return 1
  local -a lines=()
  mapfile -t lines < "${transaction_file}"
  (( ${#lines[@]} == 3 )) || return 1
  [[ "${lines[0]}" == 'version=1' ]] || return 1
  [[ "${lines[1]}" == "source=${source_name}" ]] || return 1
  [[ "${lines[2]}" == "target=${target_name}" ]] || return 1
}

move_transaction_write() {
  local -r temporary="${transaction_file}.tmp.$$"
  ( umask 077; printf 'version=1\nsource=%s\ntarget=%s\n' \
      "${source_name}" "${target_name}" > "${temporary}" )
  sync -f "${temporary}"
  mv -- "${temporary}" "${transaction_file}"
  sync -f "${VIRTDEV_HOME}"
}

# Recovery authority is the journal, never endpoint topology. In particular,
# `source missing + target present` is also the ordinary shape produced by a
# typo that names an existing unrelated project. Without the exact journal,
# that shape remains "source not found" and no target/backup marker is touched.
recovering=0
if [[ -e "${transaction_file}" || -L "${transaction_file}" ]]; then
  if ! move_transaction_read; then
    error 9 <<MESSAGE
An unfinished move transaction exists but does not exactly match this request:
    ${transaction_file}
Inspect it and resume the recorded source/target pair. It was not modified.
MESSAGE
  fi
  recovering=1
fi

if (( recovering )); then
  if [[ -d "${source_directory}" && -d "${target_directory}" ]]; then
    error 9 <<<"Move transaction is inconsistent: both source and target projects exist."
  fi
  if [[ ! -d "${source_directory}" && ! -d "${target_directory}" ]]; then
    error 9 <<<"Move transaction is inconsistent: neither source nor target project exists."
  fi

  # A target can be started after a crash but before recovery. Re-prove both
  # possible unit names terminal before touching either endpoint.
  if ! project_is_stopped "${source_name}" || ! project_is_stopped "${target_name}"; then
    error 5 <<<"Move transaction project is running or has indeterminate state. Stop it before recovery."
  fi
else
  if [[ ! -d "${source_directory}" ]]; then
    error 3 <<<"Project not found: ${source_name}"
  fi
  if [[ -d "${target_directory}" ]]; then
    error 4 <<<"Project already exists: ${target_name}"
  fi

  # Fail CLOSED: only a PROVABLY stopped source moves (unreachable manager reads as not-stopped).
  if ! project_is_stopped "${source_name}"; then
    error 5 <<<"Project virtual machine is running: ${source_name}"
  fi
fi

source_backups="${VIRTDEV_HOME}/backups/${source_name}"
target_backups="${VIRTDEV_HOME}/backups/${target_name}"

# Refuse a backups/<target> collision BEFORE the critical section: moving the source
# snapshots into an existing target backups dir would nest them and relabel a dead
# project's snapshots (the project-dir collision is already refused at error 4 above).
# Skipped when recovering — a crash between the project-dir and backups moves leaves
# target_backups absent, so a resume never reaches this case.
if (( ! recovering )) && [[ -e "${target_backups}" ]]; then
  error 8 <<MESSAGE
Backup snapshots already exist for the target name: ${target_backups}
Renaming ${source_name} would nest its snapshots inside them. Move or remove
that directory first.
MESSAGE
fi

if (( recovering )); then
  if [[ -e "${source_backups}" && -e "${target_backups}" ]]; then
    error 9 <<<"Move transaction is inconsistent: both source and target backup roots exist."
  fi
  if [[ -d "${source_directory}" && -e "${target_backups}" ]]; then
    error 9 <<<"Move transaction has not renamed the project, but target backups already exist."
  fi
else
  # Commit recovery authority only after every collision and stopped-state
  # preflight succeeds. The journal is synced before the first rename.
  move_transaction_write
fi

# A matching journal makes the partially completed namespace shapes below
# authoritative. Resume idempotently from whichever rename already landed.
if (( recovering )); then
  printf >&2 '%s\n' "$(terminal_write fg=yellow 'Recovering from interrupted move...' reset)"
fi

# Critical section: suppress signals to prevent partial state.
# The rename sequence is: project dir, backups dir, marker update.
# An interrupt between steps is recoverable by re-running the command.
trap '' INT TERM HUP QUIT

if [[ -d "${source_directory}" ]]; then
  mv -- "${source_directory}" "${target_directory}"
fi

ssh_host_identity_rebind "${target_name}" "${source_name}"

if [[ -d "${source_backups}" ]]; then
  mv -- "${source_backups}" "${target_backups}"
fi

if [[ -d "${target_backups}" ]]; then
  # The project marker lives at <date>/<time>/project (depth 3) and is
  # a regular file. Bound the search to that exact shape: an unbounded
  # `find -name project` also matches arbitrary backed-up guest content
  # named 'project' under <date>/<time>/tree/..., which would then be
  # clobbered with the new project name (and a 'project' *directory*
  # would make the redirect fail mid-critical-section).
  declare -a snapshot_markers=()
  # shellcheck disable=SC2154  # imported from enumerate
  enumerate_nul_sorted snapshot_markers "${enumerate_max_bytes}" \
    "${enumerate_max_records}" \
    find "${target_backups}" -mindepth 3 -maxdepth 3 -type f \
      -name project -print0 \
    || error 9 <<<'Could not completely enumerate moved snapshot markers; the move journal was preserved.'
  for marker in "${snapshot_markers[@]}"; do
    printf '%s\n' "${target_name}" > "${marker}"
  done
  printf >&2 'Backup snapshots moved and markers updated.\n'
fi

# Make the completed namespace/marker state durable before removing its only
# recovery authority. If this sync fails, set -e leaves the journal in place
# and a retry safely repeats the idempotent marker update.
sync -f "${VIRTDEV_HOME}"
rm -f -- "${transaction_file}"
if ! sync -f "${VIRTDEV_HOME}"; then
  printf >&2 'warning: move completed, but journal removal could not be durably synced\n'
fi

trap - INT TERM HUP QUIT

xdg_config_source="${XDG_CONFIG_HOME}/virtdev/projects/${source_name}"
if [[ -d "${xdg_config_source}" ]]; then
  printf >&2 '%s\n' "$(terminal_write fg=yellow 'Warning:' reset " XDG config directory exists for the old name:")"
  printf >&2 '    %s\n' "${xdg_config_source}"
  printf >&2 'Move it manually if needed:\n'
  printf >&2 '    mv %q %q\n' \
    "${xdg_config_source}" \
    "${XDG_CONFIG_HOME}/virtdev/projects/${target_name}"
fi

printf >&2 '%s\n' "$(terminal_write fg=green "Project renamed: ${source_name} -> ${target_name}" reset)"
