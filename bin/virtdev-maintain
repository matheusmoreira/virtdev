#!/usr/bin/env bash
# shellcheck disable=SC2154  # virtdev_bin_directory and passt_* provided by imported libraries
#
# virtdev-maintain
#
# Boots the sealed base system in a writable maintenance staging area
# where it is possible to configure and update the system
# as well as seed dotfiles into the base system home disk.
# Reseals automatically on clean power off
# as signaled by the systemd unit exit status
# after explicit confirmation from the user.
#
# Workflow:
#
#   1. Copy system/ to maintenance/
#   2. Make maintenance/ images writable
#   3. Start the maintenance virtual machine as a systemd user service on port 2222
#   4. Run provision script if present (non-fatal)
#   5. Take inventory if present (for before/after diff)
#   6. Connect via SSH once the virtual machine is ready: virtdev-ssh maintenance
#   7. Perform maintenance inside the virtual machine
#   8. Power off, not reboot: sudo poweroff
#   9. On clean exit
#      9.1. Boot again and take inventory (if step 5 succeeded)
#      9.2. Show diff of before/after inventory
#      9.3. Integrity check
#      9.4. Confirm reseal
#           9.4.1 Atomically exchange system/ and maintenance/
#
# Hooks (optional, in ${XDG_CONFIG_HOME}/virtdev/maintenance/):
#
#   provision    Runs inside the guest after SSH is up. Sets up dotfiles,
#                tools, and other environment configuration. Non-fatal.
#
#   inventory    Runs inside the guest to capture diffable system state
#                (e.g., pacman -Q, file trees). Executed twice: once
#                before the interactive session and once via a second
#                boot after the user powers off. The diff is shown
#                before the reseal prompt. Non-fatal; skipped if absent.
#
# If the virtual machine does not exit cleanly,
# as signaled by a non-zero systemd unit exit status
# QEMU failure or SIGINT from Ctrl-C or virtdev-stop,
# maintenance/ is left intact for inspection
# and the sealed system/ is unchanged.
# Remove maintenance/ manually to retry.
#
# The maintenance virtual machine runs as a systemd user service
# named virtdev-maintenance. Use standard systemd and virtdev tools
# to inspect or stop it:
#
#   virtdev-ssh maintenance
#   virtdev-stop maintenance
#   systemctl --user status virtdev-maintenance
#   journalctl --user -u virtdev-maintenance
#
# All running project virtual machines
# must be stopped before running virtdev-maintain.
# Project virtual machines use system/system.qcow2
# as a backing file. Replacing it under a running
# virtual machine would corrupt its delta image.
#
# After resealing, project virtual machines do not pick up changes
# automatically. Recreate them with virtdev-destroy + virtdev-create,
# or use virtdev-recreate to do that with backup/restore around it.
#
# Exit codes (each distinct failure mode gets a distinct code so
# programmatic callers can discriminate them):
#
#   0   success
#   3   sealed base system directory not found
#   4   base system image missing (system.qcow2/home.qcow2/nvram)
#   5   maintenance staging directory already exists
#   6   OVMF firmware not found
#   7   one or more project virtual machines are running
#   8   orphaned maintenance virtual machine is already running
#   9   maintenance port already in use on this host
#   10  SSH did not become available within the timeout (Boot 1)
#   11  Boot 1 exited via SIGTERM (143); reseal refused
#   12  reseal cancelled at the confirmation prompt
#   13  system disk integrity check (qemu-img) failed
#   14  home disk integrity check (qemu-img) failed
#   15  base system generation file missing
#   16  passt forward-port bind race during Boot 1 activation
#   17  virtdev-exchange helper not found (run 'make')
#   18  Boot 1 exited abnormally (non-zero, non-143); reseal refused
#   19  virtdev-exchange (renameat2 RENAME_EXCHANGE) swap failed
#   20  failed to start the maintenance virtual machine (systemd-run)
#   21  passt is not installed (Boot 1 activation)
#   22  passt failed to initialise (Boot 1 activation)
#   23  QEMU command not found (Boot 1 activation)
#   24  Boot 2 (inventory) ended unclean; reseal refused to protect the base
#   25  host egress lockdown baseline changed during launch (post-activation
#       TOCTOU re-check failed); machine stopped, reseal refused
#   26  could not enumerate running project machines (user manager unreachable);
#       reseal refused to protect the base — fail closed
#   27  exchange occurred but its post-exchange durability sync failed
#   28  base generation counter exhausted; reseal refused before mutation
#   29  submitted maintenance unit state/termination is indeterminate
#   30  terminal maintenance unit left malformed/unremovable runtime controls
#
# Library-propagated codes (emitted by imported libraries, not by this
# script directly; included here so callers have a complete picture):
#
#   64  usage error (unknown flag, missing value) — arguments_parse
#   75  another virtdev operation holds the lock (retry possible) — lock_acquire_for_maintain
#   76  lock setup failure (cannot create/open the lock file) — lock_acquire_for_maintain
#   77  SSH key not found — ssh_key_validate
#   78  SSH key permissions too open — ssh_key_validate
#   82  corrupt base generation file — generation_read_base
#   88  host egress lockdown not active / stale baseline / wrong user —
#       firewall_require (the pre-copy guard and maintenance_boot)
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME              Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY           Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_WAIT_TIMEOUT      Seconds to wait for SSH. Default: 120
#   VIRTDEV_STOP_TIMEOUT      Seconds to wait for the maintenance unit
#                             to leave active state after stop. Default: 60
#   VIRTDEV_VM_MEMORY         Default: 4096
#   VIRTDEV_VM_CPUS           Default: 4
#   OVMF_CODE                 Default: /usr/share/edk2/x64/OVMF_CODE.4m.fd
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error lock arguments ssh project confirm terminal port passt qemu firewall runtime

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_CACHE:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${VIRTDEV_WAIT_TIMEOUT:=120}"
: "${VIRTDEV_STOP_TIMEOUT:=60}"
: "${VIRTDEV_VM_MEMORY:=4096}"
: "${VIRTDEV_VM_CPUS:=4}"
: "${OVMF_CODE:="/usr/share/edk2/x64/OVMF_CODE.4m.fd"}"

for _timeout_var in VIRTDEV_WAIT_TIMEOUT VIRTDEV_STOP_TIMEOUT; do
  if [[ ! "${!_timeout_var}" =~ ^[1-9][0-9]*$ ]]; then
    error 64 <<<"Invalid ${_timeout_var}: must be a positive integer"
  fi
done
if [[ ! "${VIRTDEV_VM_MEMORY}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_MEMORY: must be a positive integer"
fi
if [[ ! "${VIRTDEV_VM_CPUS}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_CPUS: must be a positive integer"
fi

readonly maintenance_port=2222
# NOT readonly: shared library functions (ssh_poll_until_ready, the qemu helper,
# firewall_slice_of_unit / firewall_zone_of_unit) declare `local unit` and shadow this
# global. A readonly global here blocks that shadow with "readonly variable" and breaks
# their reads — e.g. firewall_slice_of_unit's `local -r unit=...` aborts, killing the
# slice/zone capture. (firewall_running_machine_units' enumerator once relied on this
# too; it now namespaces its loop var _frmu_unit, so it no longer does.) virtdev-start
# uses a plain `unit=` too.
unit=virtdev-maintenance

: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([yes]=bool [no-provision]=bool [no-inventory]=bool [unfiltered]=bool)
# shellcheck disable=SC2034
declare -A spec_short=([y]=yes)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

# Network isolation (Phase 2). Resolved once here and consulted by
# maintenance_boot, which gates BOTH Boot 1 (interactive) and Boot 2
# (inventory) on the host egress lockdown. The maintenance virtual machine runs
# in the 'wan' zone — it needs WAN for pacman -Syu, the base image it runs is
# trusted, and it never needs the host or LAN; --unfiltered is maintain's own
# bypass.
maintenance_unfiltered="${flags[unfiltered]}"

# ── Hook resolution ─────────────────────────────────────────────────

maintenance_config="${XDG_CONFIG_HOME}/virtdev/maintenance"
provision_path=""
inventory_path=""

if (( ! flags[no-provision] )); then
  if [[ -f "${maintenance_config}/provision" && -r "${maintenance_config}/provision" ]]; then
    provision_path="${maintenance_config}/provision"
  fi
fi

if (( ! flags[no-inventory] )); then
  if [[ -f "${maintenance_config}/inventory" && -r "${maintenance_config}/inventory" ]]; then
    inventory_path="${maintenance_config}/inventory"
  fi
fi

# ── Functions ───────────────────────────────────────────────────────

maintenance_unit_owned=0
maintenance_terminal_proven=0

maintenance_boot() {
  # Gate the launch on the host egress lockdown. This function backs BOTH
  # Boot 1 and Boot 2, so the guard fires before each boot — if the
  # firewall went down between them, Boot 2 refuses (fail-closed) before
  # the reseal commit, leaving maintenance/ intact for a retry.
  if [[ "${maintenance_unfiltered}" != "0" ]]; then
    firewall_require --unfiltered || return $?
  else
    firewall_require || return $?
  fi

  local pacman_cache="${VIRTDEV_CACHE}/pacman"
  if ! mkdir -p "${pacman_cache}"; then
    printf >&2 "Could not create maintenance package cache: '%s'\n" "${pacman_cache}"
    return 1
  fi

  local -a cache_args=()
  # shellcheck disable=SC2054  # commas are QEMU option syntax, not array separators
  cache_args+=(-virtfs local,path="${pacman_cache}",mount_tag=pacman_cache,security_model=mapped-xattr)
  # shellcheck disable=SC2054
  [[ -d /var/cache/pacman/pkg ]] && cache_args+=(
    -virtfs local,path=/var/cache/pacman/pkg,mount_tag=host_cache,security_model=mapped-xattr,readonly=on)

  if ! mkdir -p "${maintenance_project}"; then
    printf >&2 "Could not create maintenance runtime directory: '%s'\n" \
      "${maintenance_project}"
    return 1
  fi
  if ! chmod 0700 "${maintenance_project}"; then
    printf >&2 "Could not secure maintenance runtime directory: '%s'\n" \
      "${maintenance_project}"
    return 1
  fi
  # Nothing is submitted yet, so every leftover control is stale. The port is
  # published only after SSH and the post-launch filtering proof succeed.
  if ! runtime_clean "${maintenance_project}"; then
    printf >&2 "Could not clear stale maintenance runtime controls: '%s'\n" \
      "${maintenance_project}"
    return 1
  fi
  systemctl --user reset-failed "${unit}" 2>/dev/null || true

  # The QEMU argv (everything after the netexec `--` boundary) is owned by
  # lib/virtdev/qemu so it cannot drift from virtdev-start's copy — it is
  # the network-isolation security boundary. Maintenance's disks live in
  # maintenance/ while its sockets live in projects/maintenance/, so the
  # two roots are passed separately. cache_args (the -virtfs pacman-cache
  # mounts) are trailing, additive extra args.
  local -a qemu_argv=()
  if ! qemu_command qemu_argv \
      "${maintenance_directory}" "${maintenance_project}" maintenance \
      "${VIRTDEV_VM_MEMORY}" "${VIRTDEV_VM_CPUS}" "${OVMF_CODE}" \
      "${cache_args[@]}"; then
    printf >&2 'Could not construct the maintenance QEMU command.\n'
    return 1
  fi

  local maintenance_slice
  maintenance_slice="$(firewall_slice_for wan)" || return $?
  if [[ -z "${maintenance_slice}" ]]; then
    printf >&2 'Could not resolve the maintenance systemd slice.\n'
    return 1
  fi

  maintenance_terminal_proven=0
  maintenance_unit_owned=1
  systemd-run \
      --user \
      --unit="${unit}" \
      --slice="${maintenance_slice}" \
      --description='virtdev base system maintenance virtual machine' \
      -- \
      "${virtdev_bin_directory}/virtdev-netexec" \
          --socket "${passt_sock}" \
          --forward "${maintenance_port}" \
          -- \
          "${qemu_argv[@]}"
}

maintenance_publish_ready() {
  local -r port_file="${maintenance_project}/port"
  rm -f -- "${port_file}.tmp" || return 1
  printf '%d\n' "${maintenance_port}" > "${port_file}.tmp" || return 1
  mv -T -- "${port_file}.tmp" "${port_file}"
}

# Stop a submitted unit and retain its controls unless terminal state is proven.
# qemu_stop_unit_then_clean_runtime owns the one bounded stop/poll protocol.
maintenance_stop_and_confirm() {
  (( maintenance_unit_owned )) || return 0
  if ! qemu_stop_unit_then_clean_runtime \
      "${unit}" "${maintenance_project}" "${VIRTDEV_STOP_TIMEOUT}"; then
    return 1
  fi
  maintenance_terminal_proven=1
}

# Final cleanup is legal only with terminal proof. It intentionally does not
# stop a live/unknown unit; callers and the EXIT guard use the helper above.
maintenance_cleanup() {
  if (( maintenance_unit_owned && ! maintenance_terminal_proven )); then
    local observed_state
    observed_state="$(systemctl --user show "${unit}" \
      --property=ActiveState --value 2>/dev/null || true)"
    case "${observed_state}" in
      inactive|failed) maintenance_terminal_proven=1 ;;
      *) return 1 ;;
    esac
  fi

  local cleanup_status=0
  runtime_clean "${maintenance_project}" || cleanup_status=$?
  systemctl --user reset-failed "${unit}" 2>/dev/null || true
  rmdir "${maintenance_project}" 2>/dev/null || true
  # Once terminal state is proven, a malformed runtime artifact does not keep
  # ownership of the disks. Clear the lifecycle flags, but propagate the local
  # cleanup failure so the caller cannot report a fully clean teardown.
  maintenance_unit_owned=0
  maintenance_terminal_proven=0
  return "${cleanup_status}"
}

maintenance_cleanup_or_error() {
  local -r context="${1}"
  if ! maintenance_cleanup; then
    if (( maintenance_unit_owned )); then
      error 29 <<MESSAGE
${context}: the maintenance unit is not provably terminal.
Runtime controls and staging were preserved; inspect ${unit} before cleanup.
MESSAGE
    fi
    error 30 <<MESSAGE
${context}: the maintenance unit is terminal, but one or more runtime controls
could not be removed safely. Inspect '${maintenance_project}' before retrying.
MESSAGE
  fi
}

# maintenance_assert_filtered — post-launch firewall TOCTOU close (mirrors
# virtdev-start). maintenance_boot's guard ran before systemd-run, so a
# user-manager teardown in that window could churn virtdev.slice's inode and
# leave the boot UNFILTERED behind the stale ruleset. Called once the unit is
# active (both boots, on the SSH-up success path): assert the unit sits under
# the frozen virtdev.slice, else stop it + clean up + abort (fail CLOSED, so
# Boot 2 aborts before the reseal). --unfiltered opted out, so skips.
maintenance_assert_filtered() {
  [[ "${maintenance_unfiltered}" != "0" ]] && return 0
  local control_group="" i
  for (( i = 0; i < 25; i++ )); do
    control_group="$(systemctl --user show "${unit}" -p ControlGroup --value 2>/dev/null || true)"
    [[ -n "${control_group}" ]] && break
    sleep 0.2
  done
  firewall_assert_unit_filtered "${control_group}" && return 0
  if ! maintenance_stop_and_confirm; then
    error 29 <<MESSAGE
Maintenance filtering proof failed, and the submitted VM could not be proven
terminal. Runtime controls and staging were preserved for recovery:
    ${maintenance_project}
    ${maintenance_directory}
MESSAGE
  fi
  maintenance_cleanup_or_error 'Filtering-failure cleanup'
  error 25 <<MESSAGE
host egress lockdown baseline changed during maintenance launch: not filtered.
virtdev.slice's cgroup inode churned between the pre-boot guard and unit
activation (a user-manager restart?). The maintenance virtual machine was
stopped to avoid running unfiltered. Re-apply the firewall and retry:
    sudo virtdev firewall apply
    virtdev-maintain
MESSAGE
}

maintenance_wait_ssh() {
  ssh_poll_until_ready "${VIRTDEV_SSH_KEY}" "${maintenance_port}" "${unit}" "${VIRTDEV_WAIT_TIMEOUT}"
}

# maintenance_wait_exit [escalate]
#   Block until the maintenance unit reaches a TERMINAL state
#   (inactive/failed), then return 0. Waiting for terminal — not merely
#   "no longer active" — matters because ExecMainStatus is final only
#   once QEMU has exited, and a still-active unit reports
#   ExecMainStatus=0: breaking on the transient 'deactivating' state, or
#   returning on a timeout, would let the caller misread a wedged guest
#   as a clean poweroff and reseal a live, dirty image.
#
#   Default (no argument): wait indefinitely. The interactive session
#   uses this — the user decides when to `sudo poweroff`, which can take
#   arbitrarily long; force-stopping a working session would be wrong.
#
#   "escalate": for an automated caller that has ALREADY requested
#   shutdown. After VIRTDEV_STOP_TIMEOUT with no terminal state, force
#   `systemctl stop` once; systemd's own TimeoutStopSec then escalates
#   SIGTERM→SIGKILL, so the unit is guaranteed to terminate. We still
#   return only on a real terminal state (never on the timeout), so the
#   status the caller reads afterward is the genuine, non-zero one.
maintenance_wait_exit() {
  local -r escalate="${1:-}"
  local -r deadline=$(( SECONDS + VIRTDEV_STOP_TIMEOUT ))
  while true; do
    local unit_state
    unit_state="$(systemctl --user show "${unit}" \
      --property=ActiveState --value 2>/dev/null || true)"
    case "${unit_state}" in
      inactive|failed)
        maintenance_terminal_proven=1
        return 0
        ;;
      '') return 2 ;;
    esac
    if [[ "${escalate}" == "escalate" ]] && (( SECONDS >= deadline )); then
      printf >&2 '%s\n' "$(terminal_write fg=yellow "Maintenance virtual machine did not halt within ${VIRTDEV_STOP_TIMEOUT:-60}s; forcing stop..." reset)"
      if maintenance_stop_and_confirm; then
        return 0
      fi
      return 1
    fi
    sleep 2
  done
}

maintenance_ssh() {
  # shellcheck disable=SC2154  # virtdev_bin_directory provided by lib/virtdev/import
  "${virtdev_bin_directory}/virtdev-ssh" maintenance "$@"
}

# ── Pre-flight checks ──────────────────────────────────────────────

# Held for the entire maintenance session, which may last hours while
# the user runs pacman -Syu or other long operations inside the guest.
lock_acquire_for_maintain

system_directory="${VIRTDEV_HOME}/system"
maintenance_directory="${VIRTDEV_HOME}/maintenance"
maintenance_project="${VIRTDEV_HOME}/projects/maintenance"

# shellcheck disable=SC2154  # virtdev_bin_directory provided by lib/virtdev/import
if [[ ! -x "${virtdev_bin_directory}/virtdev-exchange" ]]; then
  error 17 <<<"virtdev-exchange not found: '${virtdev_bin_directory}/virtdev-exchange'. Run 'make' to compile it."
fi

if [[ ! -d "${system_directory}" ]]; then
  error 3 <<MESSAGE
Sealed base system not found: '${system_directory}'
Create it with virtdev-iso, virtdev-install and virtdev-seal.
MESSAGE
fi

for file in system.qcow2 home.qcow2 nvram; do
  if [[ ! -f "${system_directory}/${file}" ]]; then
    error 4 <<<"Base system image missing: '${system_directory}/${file}'"
  fi
done

if [[ ! -f "${system_directory}/generation" ]]; then
  error 15 <<<"Base system generation file missing: '${system_directory}/generation'"
fi
preflight_generation="$(generation_read_base "${system_directory}/generation")"
if (( preflight_generation >= generation_max )); then
  error 28 <<MESSAGE
Base generation counter is exhausted at ${preflight_generation}.
No maintenance staging or VM was started. Reinstall the base and recreate or
restore projects rather than publishing a wrapped generation.
MESSAGE
fi

# Check unit ownership before mentioning removal of old staging. A live or
# indeterminate QEMU may still hold those images; advising rm first would turn
# an interrupted session into unlinked, still-written disks.
existing_maintenance_state="$(systemctl --user show virtdev-maintenance \
  --property=ActiveState --value 2>/dev/null || true)"
case "${existing_maintenance_state}" in
  inactive|failed)
    ;;
  '')
    error 29 <<MESSAGE
Cannot reach the user systemd manager to determine whether an interrupted
maintenance VM still owns staging. Do not remove '${maintenance_directory}'.
Restore the user session/systemd manager and retry.
MESSAGE
    ;;
  *)
    error 8 <<MESSAGE
An interrupted maintenance virtual machine is still ${existing_maintenance_state}.
Do not remove its staging directory while QEMU may be writing it.
Stop and verify the unit first:

    systemctl --user stop virtdev-maintenance
    systemctl --user show virtdev-maintenance -p ActiveState

Then re-run virtdev-maintain.
MESSAGE
    ;;
esac

if [[ -d "${maintenance_directory}" ]]; then
  error 5 <<MESSAGE
Maintenance staging directory already exists: '${maintenance_directory}'
A previous virtdev-maintain session may have failed or been interrupted.
Inspect the directory and remove it manually to proceed:

    rm -rf '${maintenance_directory}'

The original sealed base system should be intact: '${system_directory}'
MESSAGE
fi

if [[ ! -f "${OVMF_CODE}" ]]; then
  error 6 <<<"Firmware not found: '${OVMF_CODE}'"
fi

ssh_key_validate "${VIRTDEV_SSH_KEY}"

# Refuse to run if any project virtual machine is still alive: its QEMU holds
# system/system.qcow2 open as a backing file, and reseal-swapping that file out
# from under it corrupts the running delta (silent backing-file divergence). Alive
# is read through the shared firewall_running_machine_units predicate — the single
# source of "machine running" shared with the apply host-map guard — which reads
# ActiveState by property, so a machine in `deactivating` (mid-shutdown via the
# lockless ExecStop/poweroff routes, still holding the fd) still blocks the reseal.
# The old `--state=active` filter missed that window (a LIVE-PROVEN corruption gap).
# The firewall pins are excluded inside the helper.
running_machines="$(firewall_running_machine_units systemctl --user)" \
  || error 26 <<MESSAGE
Could not determine whether any project virtual machines are running (the user
systemd manager was unreachable). Refusing to reseal the base while a machine might
still hold system/system.qcow2 open. Retry when the user session is reachable.
MESSAGE
if [[ -n "${running_machines}" ]]; then
  error 7 <<MESSAGE
One or more project virtual machines are running.
Stop all project virtual machines before running virtdev-maintain:

    virtdev-stop <project>

MESSAGE
fi

if port_in_use "${maintenance_port}"; then
  error 9 <<<"Port ${maintenance_port} is already in use on this host"
fi

mkdir -p "${maintenance_directory}"

staging_ready=0
cleanup_partial_staging() {
  (( staging_ready )) || rm -rf "${maintenance_directory}"
}
trap cleanup_partial_staging EXIT

system_disk="${maintenance_directory}/system.qcow2"
home_disk="${maintenance_directory}/home.qcow2"
nvram="${maintenance_directory}/nvram"

# Enforce the host egress lockdown BEFORE the expensive base-image copy, so a
# down lockdown fails fast instead of after a multi-GiB reflink copy.
# maintenance_boot re-checks before each boot (Boot 2's re-verification gates
# the reseal).
if [[ "${maintenance_unfiltered}" != "0" ]]; then
  firewall_require --unfiltered
else
  firewall_require
fi

printf >&2 "Copying sealed base images to: '%s'\n" "${maintenance_directory}"
# --reflink=auto produces an instant COW clone on filesystems that
# support reflinks (btrfs, XFS with reflink=1) and silently falls
# back to a full byte copy everywhere else, so the flag is safe to
# pass unconditionally. On supported hosts this replaces a
# (system + home) ~ 72 GiB copy with a near-instantaneous metadata
# operation; the sealed originals stay untouched because subsequent
# writes to the clone get copy-on-write'd.
cp --reflink=auto "${system_directory}/system.qcow2" "${system_disk}"
cp --reflink=auto "${system_directory}/home.qcow2"   "${home_disk}"
cp --reflink=auto "${system_directory}/nvram"        "${nvram}"

printf >&2 'Making maintenance images writable...\n'
chmod 644 "${system_disk}" "${home_disk}" "${nvram}"

staging_ready=1
trap - EXIT

# From this point onward staging is deliberately preserved on every failure.
# The EXIT guard owns any submitted unit before the shell releases the global
# lock: stop with one bound, remove controls only after terminal proof, and
# otherwise leave both runtime endpoints and images intact for recovery.
maintenance_exit_guard() {
  local -r exit_status=$?
  trap - EXIT HUP INT TERM
  set +e
  if (( maintenance_unit_owned )); then
    if maintenance_stop_and_confirm; then
      if ! maintenance_cleanup; then
        printf >&2 'warning: %s is terminal, but its runtime controls could not be cleaned completely\n' \
          "${unit}"
      fi
    else
      printf >&2 'warning: could not prove %s terminal during exit; runtime controls and staging were preserved\n' \
        "${unit}"
      printf >&2 'Inspect before cleanup: systemctl --user status %s\n' "${unit}"
    fi
  fi
  exit "${exit_status}"
}
trap maintenance_exit_guard EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The monitor/console/passt sockets live in projects/maintenance/; the set
# and the cleanup are owned by lib/virtdev/runtime. Only passt_sock is still
# spelled out here, for maintenance_boot's netexec --socket argument; it comes
# from the same runtime source so it cannot drift from the qemu_command /
# cleanup set.
passt_sock="$(runtime_passt_sock "${maintenance_project}")"

# ── Boot 1: interactive maintenance session ─────────────────────────

printf >&2 'Starting maintenance virtual machine...\n'
if ! maintenance_boot; then
  if (( maintenance_unit_owned )); then
    if ! maintenance_stop_and_confirm; then
      error 29 <<MESSAGE
Maintenance launch failed after submission, and the unit could not be proven
terminal. Runtime controls and staging were preserved for inspection.
MESSAGE
    fi
    maintenance_cleanup_or_error 'Failed-launch cleanup'
    error 20 <<MESSAGE
Failed to submit the maintenance virtual machine.
systemd-run returned an error; the possibly-created unit was stopped and proven
terminal. Inspect with: journalctl --user -u ${unit}
Maintenance images preserved: '${maintenance_directory}'
MESSAGE
  fi
  error 20 <<MESSAGE
Failed a maintenance launch prerequisite before systemd submission.
The specific prerequisite diagnostic is printed above; no VM was submitted.
Maintenance images preserved: '${maintenance_directory}'
MESSAGE
fi

# Early activation check: briefly poll the unit state so that a passt
# failure (missing, init error, port race) fails fast with a targeted
# message instead of falling through to the full 120s SSH wait and a
# misleading "SSH did not become available" report.
#
# Mirrors virtdev-start's post-launch poll via the shared
# qemu_activation_classify (lib/virtdev/qemu). No new code arm is needed
# in the later reseal 'case "${qemu_exit}"': once the shim exec's QEMU,
# qemu_exit is QEMU's (0/143/…) and can never be a pre-exec shim code
# (83/84/85/86).
qemu_activation_classify "${unit}" 5 && activate_classify=0 || activate_classify=$?
activate_exit="${VIRTDEV_QEMU_EXIT_STATUS}"
case "${activate_classify}" in
  "${qemu_active}")
    : # Unit is active. The firewall TOCTOU re-check fires after the SSH wait
      # (below), NOT here: a boot that activates past this 5s classify deadline
      # falls through to the SSH wait, so anchoring the check there covers every
      # boot speed (mirrors Boot 2).
    ;;
  "${passt_port_race_exit_code}")
    maintenance_cleanup_or_error 'Port-race cleanup'
    error 16 <<MESSAGE
Port ${maintenance_port} is bound by another process.
Between virtdev-maintain's pre-flight port check and passt's bind()
call, another process took the port. The sealed base images are
intact: '${system_directory}'
Maintenance images preserved for inspection: '${maintenance_directory}'
Remove manually to retry: rm -rf '${maintenance_directory}'
MESSAGE
    ;;
  "${passt_missing_exit_code}")
    maintenance_cleanup_or_error 'Missing-passt cleanup'
    error 21 <<MESSAGE
passt is not installed: ${unit} exit status ${activate_exit}.
Install passt and retry: pacman -S passt
    virtdev-maintain
MESSAGE
    ;;
  "${passt_init_failure_exit_code}")
    maintenance_cleanup_or_error 'Passt-initialization cleanup'
    error 22 <<MESSAGE
passt failed to initialise: ${unit} exit status ${activate_exit}.
The socket did not come up before the virtual machine was launched.
Investigate:
    systemctl --user status ${unit}
    journalctl --user -u ${unit}
MESSAGE
    ;;
  "${passt_qemu_missing_exit_code}")
    maintenance_cleanup_or_error 'Missing-QEMU cleanup'
    error 23 <<MESSAGE
QEMU command not found: ${unit} exit status ${activate_exit}.
The netexec shim pre-flighted the QEMU binary and could not find it,
so passt was never started. Install QEMU and retry:
    pacman -S qemu-base
    virtdev-maintain
MESSAGE
    ;;
  "${qemu_crashed}"|"${qemu_still_activating}")
    # qemu_crashed: some other early exit (bad qcow2, KVM failure, etc.).
    # qemu_still_activating: deadline expired, unit still transient.
    # Both fall through to the SSH wait, which detects the unit is not
    # active and produces its own diagnostic.
    :
    ;;
esac

printf >&2 'Waiting for SSH on port %d with timeout %ds...' \
       "${maintenance_port}" "${VIRTDEV_WAIT_TIMEOUT}"

if ! maintenance_wait_ssh; then
  printf >&2 ' failed.\n'

  if ! maintenance_stop_and_confirm; then
    error 29 <<MESSAGE
SSH did not become available, and the submitted maintenance VM could not be
proven terminal. Runtime controls and staging were preserved. Inspect:
    systemctl --user status ${unit}
MESSAGE
  fi
  maintenance_cleanup_or_error 'SSH-timeout cleanup'
  error 10 <<MESSAGE
SSH did not become available within ${VIRTDEV_WAIT_TIMEOUT}s.
The sealed base images are intact: '${system_directory}'
Maintenance images preserved for inspection: '${maintenance_directory}'
Remove manually to retry: rm -rf '${maintenance_directory}'
MESSAGE
fi

printf >&2 ' up.\n'

# Close the firewall TOCTOU now that the unit is active (SSH up). Anchored here,
# not in the qemu_active classify arm, so a boot that activates after the 5s
# classify deadline still gets the inode re-check before the session runs
# (mirrors Boot 2). Fails CLOSED on a mismatch (stop + error 25).
maintenance_assert_filtered

if ! maintenance_publish_ready; then
  if ! maintenance_stop_and_confirm; then
    error 29 <<MESSAGE
Maintenance became ready, but its port signal could not be published and the
VM could not be proven terminal. Runtime controls and staging were preserved.
MESSAGE
  fi
  maintenance_cleanup_or_error 'Readiness-publication cleanup'
  error 20 <<<"Could not publish maintenance runtime readiness: '${maintenance_project}/port'"
fi

# ── Provision ───────────────────────────────────────────────────────

if [[ -n "${provision_path}" ]]; then
  printf >&2 '\nRunning provision script: %s\n' "${provision_path}"
  if ! maintenance_ssh -- bash -s < "${provision_path}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'warning: provision script failed (non-zero exit)' reset)"
  fi
fi

# ── Inventory (before) ──────────────────────────────────────────────

inventory_before=""
if [[ -n "${inventory_path}" ]]; then
  inventory_before="$(mktemp)"
  printf >&2 'Taking inventory (before)...\n'
  if ! maintenance_ssh -- bash -s < "${inventory_path}" > "${inventory_before}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'warning: inventory script failed, skipping diff' reset)"
    rm -f "${inventory_before}"
    inventory_before=""
  fi
fi

# ── Interactive session ─────────────────────────────────────────────

printf >&2 '\nConnect to the maintenance virtual machine:\n\n'
printf >&2 '\tvirtdev-ssh maintenance\n\n'
printf >&2 'When done, power off to trigger resealing:\n\n'
printf >&2 '\tsudo poweroff\n\n'
printf >&2 'Waiting for virtual machine to exit...\n'
printf >&2 'To abort:\n\n'
printf >&2 '\tvirtdev-stop maintenance\n\n'

wait_exit_status=0
maintenance_wait_exit || wait_exit_status=$?
if (( wait_exit_status != 0 )); then
  error 29 <<MESSAGE
Could not observe a terminal maintenance unit state (status ${wait_exit_status}).
Runtime controls and staging were preserved; the EXIT guard will make one
bounded stop attempt. Inspect the user systemd manager before deleting anything.
MESSAGE
fi

# Capture exit status before reset-failed removes it.
qemu_exit="$(systemctl --user show "${unit}" \
    --property=ExecMainStatus --value 2>/dev/null || echo 1)"
qemu_exit="${qemu_exit:-unknown}"

maintenance_cleanup_or_error 'Boot 1 terminal cleanup'

printf >&2 '\n'

# Any non-zero exit means the maintenance session did not finish
# with a clean guest poweroff. The sealed base must NOT be
# overwritten in that case: ext4 journal replay needs write
# access, half-applied pacman transactions produce inconsistent
# package state, and so on. Preserve maintenance/ for inspection
# in every non-zero path, and let the user retry from a clean
# start. See DESIGN.md 'Base System Maintenance' for the ext4
# unclean-shutdown rationale.
#
# 143 is called out specifically because it is the common case: a
# 'virtdev-stop maintenance' whose ACPI powerdown timed out and
# fell back to SIGTERM, a 'systemctl --user stop
# virtdev-maintenance', or an external kill -TERM all route here.
# The message distinguishes the likely cause and explains why
# SIGTERM-to-QEMU is not equivalent to a guest-level shutdown —
# users who don't know the distinction are tempted to just say
# 'y' to a reseal prompt, so we refuse the prompt entirely and
# tell them how to redo the session cleanly.
case "${qemu_exit}" in
  0)
    : # Clean guest poweroff. Fall through to the reseal prompt below.
    ;;
  143)
    [[ -n "${inventory_before}" ]] && rm -f "${inventory_before}"
    error 11 <<MESSAGE
Maintenance virtual machine exited abnormally.
Unit exit status: 143 (SIGTERM).

Likely cause:

    virtdev-stop maintenance       (ACPI powerdown fallback to SIGTERM)
    systemctl --user stop virtdev-maintenance
    kill -TERM <qemu-pid>

SIGTERM tells QEMU to shut ITSELF down cleanly — flush qcow2
buffers, close file handles — but does not give the guest
operating system a chance to run its own shutdown. From the
guest kernel's perspective this is an abrupt power-off:
ext4's journal is dirty, the page cache is lost, and any
in-progress package transactions are half-applied. Resealing
in this state would bake that dirty state into the new base.

The sealed base images are intact: '${system_directory}'
Maintenance images preserved for inspection: '${maintenance_directory}'

Discard the staging directory and re-enter maintenance:

    rm -rf '${maintenance_directory}'
    virtdev-maintain

Inside the virtual machine, finish with 'sudo poweroff' — that triggers a
proper guest-level shutdown and QEMU will then exit 0.
MESSAGE
    ;;
  *)
    [[ -n "${inventory_before}" ]] && rm -f "${inventory_before}"
    error 18 <<MESSAGE
Maintenance virtual machine exited abnormally.
Unit exit status: ${qemu_exit}

This is not a clean guest poweroff. Whatever happened may have
left the guest filesystem in an inconsistent state (dirty ext4
journal, half-applied writes). Resealing is refused.

The sealed base images are intact: '${system_directory}'
Maintenance images preserved for inspection: '${maintenance_directory}'
Remove manually to retry: rm -rf '${maintenance_directory}'
MESSAGE
    ;;
esac

# qemu_exit == 0 only confirms the QEMU process exited without a
# signal — it does not prove the guest actually ran its shutdown
# sequence rather than being, say, manually 'exit 0' from a
# foreground shell inside the guest. Require explicit user
# confirmation before overwriting the sealed base system.
printf >&2 '%s\n' "$(terminal_write fg=green 'Virtual machine exited cleanly.' reset)"

# ── Boot 2: inventory capture ──────────────────────────────────────

if [[ -n "${inventory_before}" ]]; then
  printf >&2 '\nBooting for inventory capture...\n'

  inventory_after="$(mktemp)"
  do_diff=0

  if maintenance_boot; then
    printf >&2 'Waiting for SSH...'
    if maintenance_wait_ssh; then
      printf >&2 ' up.\n'
      maintenance_assert_filtered
      if ! maintenance_publish_ready; then
        if ! maintenance_stop_and_confirm; then
          error 29 <<<'Boot 2 became ready, but readiness publication and terminal recovery both failed.'
        fi
        maintenance_cleanup_or_error 'Boot 2 readiness-publication cleanup'
        error 24 <<<'Inventory boot readiness could not be published; resealing refused.'
      fi
      printf >&2 'Taking inventory (after)...\n'
      if maintenance_ssh -- bash -s < "${inventory_path}" > "${inventory_after}"; then
        do_diff=1
      else
        printf >&2 '%s\n' "$(terminal_write fg=yellow 'warning: inventory capture failed' reset)"
      fi
      maintenance_ssh -- sudo poweroff 2>/dev/null || true
      if ! maintenance_wait_exit escalate; then
        error 29 <<MESSAGE
Inventory boot did not reach a provable terminal state.
Runtime controls and staging were preserved; resealing is refused.
MESSAGE
      fi
    else
      printf >&2 ' failed.\n'
      printf >&2 '%s\n' "$(terminal_write fg=yellow 'warning: SSH did not come up, skipping inventory' reset)"
      if ! maintenance_stop_and_confirm; then
        error 29 <<MESSAGE
Inventory boot SSH failed and the submitted VM could not be proven terminal.
Runtime controls and staging were preserved; resealing is refused.
MESSAGE
      fi
    fi
    boot2_exit="$(systemctl --user show "${unit}" \
        --property=ExecMainStatus --value 2>/dev/null || echo 1)"
    boot2_exit="${boot2_exit:-1}"

    # Boot 2 DID launch (the `if maintenance_boot` above succeeded), so
    # the guest opened the maintenance images and may have written to
    # them. A non-zero terminal status therefore means the same thing it
    # does for Boot 1: the guest did not power off cleanly, its ext4
    # journal is potentially dirty, and qemu-img check (which only
    # validates the qcow2 container, not the guest filesystem) cannot see
    # it. Hard-gate the reseal exactly as Boot 1 does — a dirtied image
    # sealed here is inherited by every project.
    #
    # 143 is the common case: the SSH-probe-failure path above uses the bounded
    # stop-and-confirm helper (SIGTERM → QEMU exit 143), and
    # maintenance_wait_exit escalates through the same helper if the guest
    # wedges past VIRTDEV_STOP_TIMEOUT.
    #
    # This gate fires only on the booted-but-unclean path. A Boot 2 prerequisite
    # failure before submission remains safe to skip; an ambiguous systemd-run
    # failure is treated as submitted and refuses resealing because QEMU may
    # have opened the images. Terminal cleanup runs before this gate. The reseal
    # commit steps (generation bump, chmod 444, virtdev-exchange) have not run,
    # so maintenance/ survives intact and the session can be retried.
    maintenance_cleanup_or_error 'Boot 2 terminal cleanup'
    case "${boot2_exit}" in
      0)
        : # Clean inventory boot. do_diff was set by the capture above.
        ;;
      *)
        [[ -n "${inventory_before}" ]] && rm -f "${inventory_before}"
        [[ -n "${inventory_after}" ]] && rm -f "${inventory_after}"
        error 24 <<MESSAGE
Inventory boot (Boot 2) exited abnormally.
Unit exit status: ${boot2_exit}$( [[ "${boot2_exit}" == "143" ]] && printf ' (SIGTERM)' )

After a clean interactive session, virtdev-maintain boots the
to-be-sealed images a second time to capture the after-inventory.
That boot did not end with a clean guest poweroff, so the maintenance
image may now carry a dirty ext4 journal or half-applied writes.
qemu-img check validates only the qcow2 container, not the guest
filesystem, so resealing in this state would bake the dirty state
into the base every project inherits. Resealing is refused.

The sealed base images are intact: '${system_directory}'
The maintenance staging is preserved intact: '${maintenance_directory}'
No reseal commit ran — the generation bump, the read-only re-marking,
and the atomic exchange were all skipped, so the staging from your
maintenance session survives and the session can be retried.

Inspect the staging, then either re-enter maintenance for a clean
inventory boot, or discard and start over:

    rm -rf '${maintenance_directory}'
    virtdev-maintain
MESSAGE
        ;;
    esac
  else
    if (( maintenance_unit_owned )); then
      if ! maintenance_stop_and_confirm; then
        error 29 <<MESSAGE
Inventory launch failed after submission, and the VM could not be proven
terminal. Runtime controls and staging were preserved; resealing is refused.
MESSAGE
      fi
      maintenance_cleanup_or_error 'Failed Boot 2 launch cleanup'
      [[ -n "${inventory_before}" ]] && rm -f "${inventory_before}"
      [[ -n "${inventory_after}" ]] && rm -f "${inventory_after}"
      error 24 <<MESSAGE
Inventory boot submission failed. The unit was proven terminal, but it may have
opened the maintenance images before failing. Resealing is conservatively
refused; staging is preserved: '${maintenance_directory}'
MESSAGE
    fi
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'warning: second boot prerequisites failed before submission; skipping inventory' reset)"
    maintenance_cleanup_or_error 'Boot 2 pre-submission cleanup'
  fi

  if (( do_diff )); then
    printf >&2 '\n%s\n\n' "$(terminal_write bold 'Changes:' reset)"
    diff_color=auto
    # shellcheck disable=SC2154  # _virtdev_color_mode set by arguments library
    case "${_virtdev_color_mode}" in
      yes) diff_color=always ;;
      no)  diff_color=never ;;
    esac
    diff -u --label before --label after --color="${diff_color}" \
      "${inventory_before}" "${inventory_after}" >&2 || true
  fi

  rm -f "${inventory_before}" "${inventory_after}"
fi

if (( ! flags[yes] )); then
  if ! confirm_word reseal "Reseal the base system? Every project inherits it. Type 'reseal' to confirm: "; then
    error 12 <<MESSAGE
Reseal cancelled.
The sealed base images are intact: '${system_directory}'
Maintenance images preserved for inspection: '${maintenance_directory}'
Remove manually to retry: rm -rf '${maintenance_directory}'
MESSAGE
  fi
fi

printf >&2 'Checking maintenance image integrity...\n'
if ! qemu-img check -q "${system_disk}"; then
  error 13 <<<"System disk integrity check failed: '${system_disk}'"
fi
if ! qemu-img check -q "${home_disk}"; then
  error 14 <<<"Home disk integrity check failed: '${home_disk}'"
fi

# Read and validate the old generation counter before the exchange
# below. Failing here leaves the sealed base untouched in place.
if [[ ! -f "${system_directory}/generation" ]]; then
  error 15 <<<"Base system generation file missing: '${system_directory}/generation'"
fi
old_generation="$(generation_read_base "${system_directory}/generation")"
if (( old_generation >= generation_max )); then
  error 28 <<MESSAGE
Base generation counter is exhausted at ${old_generation}.
The sealed base is unchanged and maintenance staging is preserved.
MESSAGE
fi
next_generation=$(( old_generation + 1 ))

# Reseal via atomic exchange.
#
# The generation counter and chmod 444 are applied to maintenance/
# BEFORE the swap so the exchange is the single commit point: after
# it, system/ has the new images with correct generation and
# read-only permissions. A crash before the exchange leaves the old
# system/ intact; a crash after leaves system/ fully sealed.
#
# virtdev-exchange flushes the staged filesystem, wraps renameat2(2) with
# RENAME_EXCHANGE, then flushes the exchanged namespace before returning.
# After the call, system/ holds the durable new images and maintenance/ holds
# the old ones. There is no intermediate namespace state where system/ is
# missing or partially populated; a post-exchange sync failure is reported
# distinctly so the old tree is preserved instead of being deleted.
#
# After the exchange, maintenance/ (which now holds the previous
# base) is removed as best-effort cleanup.
printf >&2 'Incrementing generation counter (%d → %d)...\n' \
       "${old_generation}" "${next_generation}"
printf '%d\n' "${next_generation}" > "${maintenance_directory}/generation.tmp"
mv "${maintenance_directory}/generation.tmp" "${maintenance_directory}/generation"

printf >&2 'Marking maintenance images read-only before exchange...\n'
chmod 444 "${maintenance_directory}"/*

printf >&2 '%s\n' "$(terminal_write bold "Resealing base system images to: '${system_directory}'" reset)"
# Guard the commit explicitly rather than relying on `set -e`: a bare
# failure here (EXDEV across mounts, or EINVAL/ENOSYS where the
# filesystem lacks RENAME_EXCHANGE) would abort with an opaque C errno
# and skip the cleanup below, leaving maintenance/ with the incremented,
# mode-444 generation. The sealed base stays intact either way.
exchange_status=0
"${virtdev_bin_directory}/virtdev-exchange" \
  "${system_directory}" "${maintenance_directory}" || exchange_status=$?
case "${exchange_status}" in
  0)
    ;;
  1)
    error 19 <<MESSAGE
Failed to swap the new images into place (virtdev-exchange).
This needs renameat2(RENAME_EXCHANGE); system/ and maintenance/ must be
on the same filesystem and it must support it (ext4/btrfs/xfs). The
sealed base is unchanged. Staged images preserved: '${maintenance_directory}'
MESSAGE
    ;;
  2)
    error 27 <<MESSAGE
The system/ and maintenance/ names were exchanged, but the durability sync
failed. Both trees are preserved. Do not delete either one or start a project
until their generations/images are inspected and the filesystem is healthy:
    system:      '${system_directory}'
    previous:    '${maintenance_directory}'
MESSAGE
    ;;
  *)
    error 27 <<<"virtdev-exchange returned unexpected status ${exchange_status}; both trees were preserved."
    ;;
esac

if ! rm -rf "${maintenance_directory}"; then
  printf >&2 'warning: could not remove %s; will be cleaned up on next virtdev-maintain run\n' \
             "${maintenance_directory}"
fi
if ! sync -f "${VIRTDEV_HOME}"; then
  printf >&2 'warning: could not durably sync cleanup of %s; the new base itself was already committed\n' \
             "${maintenance_directory}"
fi

printf >&2 '%s\n' "$(terminal_write fg=green "Base system resealed: ${system_directory}" reset)"

outdated_count=0
while IFS= read -r p; do
  outdated_status=0
  project_is_outdated "${p}" || outdated_status=$?
  case "${outdated_status}" in
    0) (( ++outdated_count )) ;;
    2) printf >&2 '%s\n' "$(terminal_write fg=yellow "warning: ${p} has a corrupt generation file; cannot assess" reset)" ;;
    3) # The base was just resealed with a freshly written generation, so
       # this is unreachable; warn once and stop the advisory rather than
       # repeat it for every project if that invariant ever breaks.
       printf >&2 '%s\n' "$(terminal_write fg=yellow "warning: base generation file is unreadable; cannot assess outdated projects" reset)"
       break ;;
  esac
done < <(project_list)

if (( outdated_count > 0 )); then
  printf >&2 '\n'
  printf >&2 '%s\n' "$(terminal_write fg=yellow "${outdated_count} project(s) are now outdated. Upgrade them with:" reset)"
  printf >&2 '\n'
  printf >&2 '    virtdev-upgrade\n'
else
  printf >&2 '\n'
  printf >&2 'No project virtual machines to upgrade.\n'
fi
