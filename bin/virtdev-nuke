#!/usr/bin/env bash
#
# virtdev-nuke
#
# Permanently deletes all virtdev data:
#
#   ${VIRTDEV_HOME}                                   (projects, images, keys)
#   ${XDG_CACHE_HOME:-~/.cache}/virtdev               (ISO, build artifacts)
#
# No other paths are touched. Ever.
#
# All project virtual machines must be stopped before running this.
# Requires typing "nuke" to confirm.
# This operation is irreversible.
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error lock arguments snapshot confirm terminal project mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_CACHE:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev"}"

# shellcheck disable=SC2034  # spec read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

# Resolve each deletion root once and reject final-component symlinks.
home_real="$(realpath -- "${HOME}")"
declare -a nuke_roots=()
for variable in VIRTDEV_HOME VIRTDEV_CACHE; do
  path="${!variable}"
  if [[ -L "${path}" ]]; then
    error 3 <<MESSAGE
Nuke root must not be a symbolic link: '${path}'
Resolve the configuration to the intended directory explicitly, then retry.
Nuke aborted.
MESSAGE
  fi
  real="$(realpath -m -- "${path}")"
  if [[ "${real}" != "${home_real}"/?* ]]; then
    error 3 <<MESSAGE
Path is not strictly under \$HOME: '${path}'
	Resolved: '${real}'
	Home:     '${home_real}'
Nuke aborted.
MESSAGE
  fi
  printf -v "${variable}" '%s' "${real}"
  nuke_roots+=("${real}")
done

lock_directory="$(lock_control_directory)"
for path in "${nuke_roots[@]}"; do
  if [[ "${lock_directory}" == "${path}" \
        || "${lock_directory}" == "${path}"/?* ]]; then
    error 3 <<MESSAGE
Lock directory is inside a nuke root: '${lock_directory}'
Choose an external VIRTDEV_LOCK_DIRECTORY before retrying.
Nuke aborted.
MESSAGE
  fi
done

# Keep starts and cache builders out through deletion.
lock_acquire
lock_acquire_cache

require_unmounted_root() {
  local -r path="${1}"
  local mount_path="" status=0

  mount_find_below "${path}" mount_path || status=$?
  case "${status}" in
    0)
      error 6 <<MESSAGE
Mounted filesystem detected below nuke root: '${mount_path}'
Unmount it explicitly; nuke was refused.
MESSAGE
      ;;
    1) ;;
    *) error 6 <<<'Could not inspect mount state; nuke was refused.' ;;
  esac
}

require_unmounted_roots() {
  local path

  for path in "${nuke_roots[@]}"; do
    require_unmounted_root "${path}"
  done
}

require_unmounted_roots

require_loaded_units_stopped() {
  local units status=0 unit active _

  units="$(LC_ALL=C systemctl --user list-units --all --type=service \
    --no-pager --no-legend --plain 'virtdev-*.service' 2>/dev/null)" \
    || status=$?
  (( status == 0 )) || error 4 <<<'Could not enumerate loaded virtdev units; nuke was refused.'
  while read -r unit _ active _; do
    [[ -n "${unit}" ]] || continue
    if [[ "${unit}" != virtdev-*.service || -z "${active}" ]]; then
      error 4 <<<'Loaded virtdev unit state was malformed; nuke was refused.'
    fi
    case "${active}" in
      inactive|failed) ;;
      *)
        error 4 <<MESSAGE
Loaded virtual machine unit is not stopped: ${unit} (${active})
Stop it and verify terminal state before nuking.
MESSAGE
        ;;
    esac
  done <<< "${units}"
}

require_maintenance_stopped() {
  if ! project_is_stopped maintenance; then
    error 4 <<MESSAGE
Maintenance virtual machine is running or has indeterminate state.
Stop and verify it before nuking:
    virtdev-stop maintenance
    systemctl --user status virtdev-maintenance
All virtual machines must be stopped before nuking.
MESSAGE
  fi
}

require_projects_stopped() {
  declare -a nuke_projects=()
  project_list_into nuke_projects \
    || error 3 <<<'Could not completely enumerate projects; nuke was refused.'
  local project
  for project in "${nuke_projects[@]}"; do
    if ! project_is_stopped "${project}"; then
      error 4 <<MESSAGE
Project virtual machine is running: ${project}
Stop it with: virtdev-stop ${project}
All virtual machines must be stopped before nuking
MESSAGE
    fi
  done
}

require_every_machine_stopped() {
  require_loaded_units_stopped
  require_maintenance_stopped
  require_projects_stopped
}

require_every_machine_stopped

printf >&2 'This will permanently delete all virtdev data:\n\n'

for path in "${VIRTDEV_HOME}" "${VIRTDEV_CACHE}"; do
  if [[ -e "${path}" ]]; then
    printf >&2 '\t%s\t%s\n' "$(du -sh "${path}" 2>/dev/null | cut -f1 || true)" "${path}"
  fi
done

backups_root="${VIRTDEV_HOME}/backups"
if [[ -d "${backups_root}" ]]; then
  declare -a backup_projects=()
  # shellcheck disable=SC2154  # imported through project
  enumerate_nul_sorted backup_projects "${enumerate_max_bytes}" \
    "${enumerate_max_records}" \
    find "${backups_root}" -maxdepth 1 -mindepth 1 -type d -printf '%f\0' \
    || error 3 <<<'Could not completely enumerate backup roots; nuke was refused.'
  if (( ${#backup_projects[@]} > 0 )); then
    printf >&2 '\nBackup snapshots:\n'
    for bp in "${backup_projects[@]}"; do
      bp_dir="${backups_root}/${bp}"
      count=0
      snapshot_count_into count "${bp}" \
        || error 3 <<<'Could not completely enumerate backup snapshots; nuke was refused.'
      size="$(du -sh "${bp_dir}" 2>/dev/null | cut -f1 || true)"
      printf >&2 '\t%s\t%s\t(%d snapshots)\n' "${size}" "${bp_dir}" "${count}"
    done
  fi
fi

printf >&2 '\nThis includes:\n'
printf >&2 '\tALL project virtual machines\n'
printf >&2 '\tALL disk images\n'
printf >&2 '\tALL backup snapshots\n'
printf >&2 '\tBase system images\n'
printf >&2 '\tSSH keys\n'
printf >&2 '\tISOs\n'
printf >&2 '\nThis operation is irreversible.\n'
if ! confirm_word "nuke"; then
  error 5 <<<"Aborted."
fi

# Revalidate each root and mount boundary, then all loaded and directory-backed
# machine identities immediately before the first deletion.
machines_reproved=0
for path in "${nuke_roots[@]}"; do
  current="$(realpath -m -- "${path}")"
  if [[ -L "${path}" || "${current}" != "${path}" \
      || "${current}" != "${home_real}"/?* ]]; then
    error 3 <<MESSAGE
Nuke root changed after validation: '${path}'
Current resolution: '${current}'
This root was not deleted.
MESSAGE
  fi
  require_unmounted_root "${path}"
  if (( ! machines_reproved )); then
    require_every_machine_stopped
    machines_reproved=1
  fi
  mount_path=''
  remove_status=0
  mount_remove_tree "${path}" mount_path || remove_status=$?
  case "${remove_status}" in
    0) ;;
    1) error 6 <<<"Mounted filesystem appeared during nuke: '${mount_path}'" ;;
    *) error 6 <<<"Nuke root changed or could not be removed safely: '${path}'" ;;
  esac
done

printf >&2 '%s\n' "$(terminal_write fg=green 'All virtdev data deleted.' reset)"
