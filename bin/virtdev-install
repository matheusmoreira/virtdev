#!/usr/bin/env bash
# shellcheck disable=SC2154  # SSH contract constants are imported
#
# virtdev-install [--timezone tz] [--locale locale] [--keymap keymap]
#                 [--dns ip] [--packages path] [--script path]
#                 [--inventory path] [iso]
#
# Boots the virtdev ISO in a temporary QEMU process to install
# the base system into fresh qcow2 disks. Does not daemonize.
# Progress is reported via a virtio-serial channel and displayed
# as structured status messages. The serial console is available
# for debugging via the console socket.
#
# If no ISO path is given, defaults to the ISO produced by virtdev-iso.
#
# Resulting disk images are placed in ${VIRTDEV_HOME}/installation.
# Use virtdev-seal to promote them to sealed base system images
# from which project virtual machines may be derived.
#
# Exit codes:
#
#   0   success
#   3   ISO not found
#   4   OVMF_CODE not found
#   5   OVMF_VARS not found
#   6   installation directory already exists
#   7   sealed base system already present
#   8   SSH public key not found
#   9   socat not found
#  10   installation failed
#  11   explicit packages file missing or unreadable
#  12   explicit install script missing or unreadable
#  13   explicit inventory script missing or unreadable
#  14   invalid installer lifecycle timeout
#  15   invalid DNS address
#  16   SSH key pair is invalid or mismatched
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME              Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_ISO               Default: ${VIRTDEV_CACHE}/virtdev.iso
#   VIRTDEV_SSH_KEY           Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_TIMEZONE          Default: host timezone (UTC fallback)
#   VIRTDEV_LOCALE            Default: host locale (en_US.UTF-8 fallback)
#   VIRTDEV_KEYMAP            Default: host keymap (us fallback)
#   VIRTDEV_INSTALL_DNS       Default: ${VIRTDEV_DNS:-9.9.9.9}
#   VIRTDEV_DNS               Legacy alias for VIRTDEV_INSTALL_DNS
#   VIRTDEV_PACKAGES          Default: (none) path to extra packages file
#   VIRTDEV_SCRIPT            Default: (none) path to custom install script
#   VIRTDEV_INVENTORY         Default: (none) path to user inventory script
#   VIRTDEV_CACHE             Default: ${XDG_CACHE_HOME:-~/.cache}/virtdev
#   VIRTDEV_SYSTEM_DISK_SIZE  Default: 24G
#   VIRTDEV_HOME_DISK_SIZE    Default: 48G
#   VIRTDEV_VM_MEMORY         Default: 4096
#   VIRTDEV_VM_CPUS           Default: 4
#   VIRTDEV_INSTALL_SOCKET_TIMEOUT    Default: 120 seconds
#   VIRTDEV_INSTALL_PROGRESS_TIMEOUT  Default: 1200 seconds
#   VIRTDEV_INSTALL_SHUTDOWN_TIMEOUT  Default: 120 seconds
#   OVMF_CODE                 Default: /usr/share/edk2/x64/OVMF_CODE.4m.fd
#   OVMF_VARS                 Default: /usr/share/edk2/x64/OVMF_VARS.4m.fd
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error lock arguments terminal ssh ip integer qemu mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_CACHE:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev"}"
: "${VIRTDEV_ISO:="${VIRTDEV_CACHE}/virtdev.iso"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"

host_timezone="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
: "${VIRTDEV_TIMEZONE:="${host_timezone:-UTC}"}"

host_locale="$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null || true)"
: "${VIRTDEV_LOCALE:="${host_locale:-en_US.UTF-8}"}"

host_keymap="$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null || true)"
: "${VIRTDEV_KEYMAP:="${host_keymap:-us}"}"

: "${VIRTDEV_INSTALL_DNS:=${VIRTDEV_DNS:-9.9.9.9}}"

: "${VIRTDEV_SYSTEM_DISK_SIZE:=24G}"
: "${VIRTDEV_HOME_DISK_SIZE:=48G}"
: "${VIRTDEV_VM_MEMORY:=4096}"
: "${VIRTDEV_VM_CPUS:=4}"
: "${VIRTDEV_INSTALL_SOCKET_TIMEOUT:=120}"
: "${VIRTDEV_INSTALL_PROGRESS_TIMEOUT:=1200}"
: "${VIRTDEV_INSTALL_SHUTDOWN_TIMEOUT:=120}"
: "${OVMF_CODE:="/usr/share/edk2/x64/OVMF_CODE.4m.fd"}"
: "${OVMF_VARS:="/usr/share/edk2/x64/OVMF_VARS.4m.fd"}"

if [[ ! "${VIRTDEV_VM_MEMORY}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_MEMORY: must be a positive integer"
fi
if [[ ! "${VIRTDEV_VM_CPUS}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_CPUS: must be a positive integer"
fi
for timeout_name in VIRTDEV_INSTALL_SOCKET_TIMEOUT \
                    VIRTDEV_INSTALL_PROGRESS_TIMEOUT \
                    VIRTDEV_INSTALL_SHUTDOWN_TIMEOUT; do
  timeout_value="${!timeout_name}"
  if ! integer_is_bounded_positive "${timeout_value}" 86400; then
    error 14 <<<"Invalid ${timeout_name}: must be an integer from 1 through 86400"
  fi
done

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([timezone]=value [locale]=value [keymap]=value
                 [dns]=value [packages]=value [script]=value
                 [inventory]=value)
# shellcheck disable=SC2034
declare -A spec_placeholders=([timezone]=tz [locale]=locale [keymap]=keymap
                              [dns]=ip [packages]=path [script]=path
                              [inventory]=path)
# shellcheck disable=SC2034
declare -a spec_positionals=("iso?")
# shellcheck disable=SC2034
declare -A flags=([dns]="${VIRTDEV_INSTALL_DNS}")
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

[[ -n "${flags[timezone]:-}" ]]  && VIRTDEV_TIMEZONE="${flags[timezone]}"
[[ -n "${flags[locale]:-}" ]]    && VIRTDEV_LOCALE="${flags[locale]}"
[[ -n "${flags[keymap]:-}" ]]    && VIRTDEV_KEYMAP="${flags[keymap]}"
VIRTDEV_INSTALL_DNS="${flags[dns]}"
[[ -n "${flags[packages]:-}" ]]  && VIRTDEV_PACKAGES="${flags[packages]}"
[[ -n "${flags[script]:-}" ]]    && VIRTDEV_SCRIPT="${flags[script]}"
[[ -n "${flags[inventory]:-}" ]] && VIRTDEV_INVENTORY="${flags[inventory]}"

if [[ $# -gt 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

if [[ $# -eq 1 ]]; then
  VIRTDEV_ISO="${1}"
fi

if ! ip_literal_is_valid "${VIRTDEV_INSTALL_DNS}"; then
  error 15 <<<"Invalid DNS address: '${VIRTDEV_INSTALL_DNS}' (expected an IPv4 or IPv6 literal)"
fi

if [[ -n "${VIRTDEV_PACKAGES:-}" && \
      ( ! -f "${VIRTDEV_PACKAGES}" || ! -r "${VIRTDEV_PACKAGES}" ) ]]; then
  error 11 <<<"Packages file not found or not readable: ${VIRTDEV_PACKAGES}"
fi
if [[ -n "${VIRTDEV_SCRIPT:-}" && \
      ( ! -f "${VIRTDEV_SCRIPT}" || ! -r "${VIRTDEV_SCRIPT}" ) ]]; then
  error 12 <<<"Install script not found or not readable: ${VIRTDEV_SCRIPT}"
fi
if [[ -n "${VIRTDEV_INVENTORY:-}" && \
      ( ! -f "${VIRTDEV_INVENTORY}" || ! -r "${VIRTDEV_INVENTORY}" ) ]]; then
  error 13 <<<"Inventory script not found or not readable: ${VIRTDEV_INVENTORY}"
fi

lock_acquire

if ! command -v socat &>/dev/null; then
  error 9 <<<'socat not found, install socat'
fi

ssh_key_validate "${VIRTDEV_SSH_KEY}"

public_key="${VIRTDEV_SSH_KEY}.pub"
if [[ ! -e "${public_key}" && ! -L "${public_key}" ]]; then
  error 8 <<<"SSH public key not found: '${public_key}'"
fi
if ! command -v ssh-keygen &>/dev/null; then
  error 16 <<<'ssh-keygen not found; install OpenSSH to validate the SSH key pair'
fi
private_public=''
if ! private_public="$(ssh_client_public_from_private "${VIRTDEV_SSH_KEY}")"; then
  error 16 <<<"SSH private key is invalid, encrypted, or not ed25519: '${VIRTDEV_SSH_KEY}'"
fi
supplied_public=''
if ! supplied_public="$(ssh_client_public_read "${public_key}")"; then
  error 16 <<<"SSH public key is invalid or unsafe: '${public_key}'"
fi
if [[ "${supplied_public}" != "${private_public}" ]]; then
  error 16 <<<"SSH public key does not match its private key: '${public_key}'"
fi

if [[ ! -f "${VIRTDEV_ISO}" ]]; then
  error 3 <<<"ISO not found: '${VIRTDEV_ISO}'"
fi

if [[ ! -f "${OVMF_CODE}" ]]; then
  error 4 <<<"OVMF_CODE not found: '${OVMF_CODE}'"
fi

if [[ ! -f "${OVMF_VARS}" ]]; then
  error 5 <<<"OVMF_VARS not found: '${OVMF_VARS}'"
fi

installation_directory="${VIRTDEV_HOME}"/installation

if [[ -d "${installation_directory}" ]]; then
  error 6 <<MESSAGE
Installation directory already exists: '${installation_directory}'
Use virtdev-seal to seal the installation, or remove it manually to reinstall.
MESSAGE
fi

system_directory="${VIRTDEV_HOME}"/system

if [[ -d "${system_directory}" ]]; then
  error 7 <<MESSAGE
Sealed base system images already present: '${system_directory}'
Remove the system directory manually to reinstall.
MESSAGE
fi

mkdir -p "${installation_directory}"

install_sock="${installation_directory}"/install.sock
console_sock="${installation_directory}"/console.sock
install_progress="${installation_directory}"/progress.log
install_ssh_key="${installation_directory}"/ssh_key.pub

pacman_cache="${VIRTDEV_CACHE}/pacman"
mkdir -p "${pacman_cache}"

install_succeeded=0
qemu_pid=''
socat_pid=''
install_cleanup_phase=0
install_cleanup_signal_status=0

# Child processes retain open image/socket/cache descriptors after their
# paths are unlinked. Treat QEMU and the progress bridge as owned resources:
# TERM, bounded wait, KILL, bounded wait, and reap before deleting anything.
readonly install_child_term_timeout=5
readonly install_child_kill_timeout=5
readonly install_progress_record_limit=256
readonly install_progress_record_bytes=256
readonly install_progress_log_bytes=65536

child_is_active() {
  local -r pid="${1}"
  [[ -n "${pid}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1

  # kill -0 remains true for an exited, unreaped zombie. Recognize that state
  # so the parent can call wait instead of timing out and needlessly killing.
  local process_stat
  if IFS= read -r process_stat < "/proc/${pid}/stat" 2>/dev/null \
     && [[ "${process_stat}" =~ ^[0-9]+\ \(.*\)\ ([A-Z])\  ]]; then
    [[ "${BASH_REMATCH[1]}" != Z && "${BASH_REMATCH[1]}" != X ]]
    return
  fi

  # An unreadable but signalable process is indeterminate, therefore active.
  return 0
}

child_wait_status=0
child_wait_bounded() {
  local -r pid="${1}" timeout="${2}"
  local deadline
  deadline=$(( SECONDS + timeout ))

  while child_is_active "${pid}" && (( SECONDS < deadline )); do
    sleep 0.1
  done
  child_is_active "${pid}" && return 1

  if wait "${pid}" 2>/dev/null; then
    child_wait_status=0
  else
    child_wait_status=$?
  fi
  return 0
}

child_terminate_and_reap() {
  local -r pid="${1}" label="${2}"
  [[ -n "${pid}" ]] || return 0

  if child_is_active "${pid}"; then
    kill -TERM "${pid}" 2>/dev/null || true
    if child_wait_bounded "${pid}" "${install_child_term_timeout}"; then
      return 0
    fi

    kill -KILL "${pid}" 2>/dev/null || true
    if child_wait_bounded "${pid}" "${install_child_kill_timeout}"; then
      return 0
    fi

    printf >&2 'warning: could not prove %s process %s terminated\n' \
      "${label}" "${pid}"
    return 1
  fi

  # Already exited (possibly a zombie): reap without blocking.
  child_wait_bounded "${pid}" 0
}

# shellcheck disable=SC2329  # invoked via signal traps
install_cleanup_signal() {
  local -r status="${1}"
  if (( install_cleanup_phase )); then
    (( install_cleanup_signal_status )) || install_cleanup_signal_status="${status}"
  else
    exit "${status}"
  fi
}

cleanup_partial_installation() {
  local exit_status=$? install_cleanup_phase=1 install_cleanup_signal_status=0
  trap - EXIT
  set +e

  local children_terminal=1
  if ! child_terminate_and_reap "${socat_pid}" socat; then
    children_terminal=0
  else
    socat_pid=''
  fi
  if ! child_terminate_and_reap "${qemu_pid}" QEMU; then
    children_terminal=0
  else
    qemu_pid=''
  fi

  if (( children_terminal )); then
    if ! (( install_succeeded )); then
      local mount_path="" remove_status=0
      mount_remove_tree "${installation_directory}" mount_path \
        || remove_status=$?
      case "${remove_status}" in
        0) ;;
        1) printf >&2 'warning: preserving partial installation with mounted subtree: %s\n' "${mount_path}" ;;
        2) printf >&2 'warning: preserving partial installation because cleanup safety is indeterminate: %s\n' "${installation_directory}" ;;
        *) printf >&2 'warning: could not remove partial installation safely: %s\n' "${installation_directory}" ;;
      esac
    else
      rm -f -- "${install_sock:-}" "${console_sock:-}" \
        "${install_progress:-}" "${progress_fifo:-}" "${install_ssh_key:-}"
    fi
  else
    printf >&2 'warning: preserving installation state because child termination is indeterminate: %s\n' \
      "${installation_directory}"
  fi

  trap - HUP INT TERM
  if (( install_cleanup_signal_status )); then
    exit "${install_cleanup_signal_status}"
  fi
  exit "${exit_status}"
}
trap cleanup_partial_installation EXIT
trap 'install_cleanup_signal 129' HUP
trap 'install_cleanup_signal 130' INT
trap 'install_cleanup_signal 143' TERM

if ! (umask 077; printf '%s\n' "${private_public}" > "${install_ssh_key}") \
    || ! chmod 0444 "${install_ssh_key}"; then
  error 10 <<<'Could not stage the validated SSH public key for installation.'
fi

system_disk="${installation_directory}"/system.qcow2
printf >&2 "Creating %s system disk image: '%s'\n" \
       "${VIRTDEV_SYSTEM_DISK_SIZE}" "${system_disk}"
qemu-img create -f qcow2 "${system_disk}" "${VIRTDEV_SYSTEM_DISK_SIZE}"

home_disk="${installation_directory}"/home.qcow2
printf >&2 "Creating %s home disk: '%s'\n" \
       "${VIRTDEV_HOME_DISK_SIZE}" "${home_disk}"
qemu-img create -f qcow2 "${home_disk}" "${VIRTDEV_HOME_DISK_SIZE}"

nvram="${installation_directory}"/nvram
printf >&2 'Copying default NVRAM...\n'
cp "${OVMF_VARS}" "${nvram}"

qemu_ovmf_code="${OVMF_CODE}"
qemu_nvram="${nvram}"
qemu_system_disk="${system_disk}"
qemu_home_disk="${home_disk}"
qemu_console_sock="${console_sock}"
qemu_install_sock="${install_sock}"
qemu_pacman_cache="${pacman_cache}"
qemu_ssh_key="${install_ssh_key}"
qemu_timezone="${VIRTDEV_TIMEZONE}"
qemu_locale="${VIRTDEV_LOCALE}"
qemu_keymap="${VIRTDEV_KEYMAP}"
qemu_dns="${VIRTDEV_INSTALL_DNS}"
qemu_packages="${VIRTDEV_PACKAGES:-}"
qemu_script="${VIRTDEV_SCRIPT:-}"
qemu_inventory="${VIRTDEV_INVENTORY:-}"
for qemu_value in qemu_ovmf_code qemu_nvram qemu_system_disk qemu_home_disk \
                  qemu_console_sock qemu_install_sock qemu_pacman_cache \
                  qemu_ssh_key qemu_timezone qemu_locale qemu_keymap qemu_dns \
                  qemu_packages qemu_script qemu_inventory; do
  qemu_suboption_encode "${qemu_value}"
done
unset qemu_value

qemu_extra_args=()
# shellcheck disable=SC2054  # commas are QEMU option syntax, not array separators
[[ -d /var/cache/pacman/pkg ]] && qemu_extra_args+=(
  -virtfs local,path=/var/cache/pacman/pkg,mount_tag=host_cache,security_model=mapped-xattr,readonly=on)
[[ -n "${VIRTDEV_PACKAGES:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/packages,file=${qemu_packages}")
[[ -n "${VIRTDEV_SCRIPT:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/script,file=${qemu_script}")
[[ -n "${VIRTDEV_INVENTORY:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/inventory,file=${qemu_inventory}")

install_display_progress() {
  local -r token="${1}"
  local message
  case "${token}" in
    partitioning)     message='Partitioning disks' ;;
    formatting)       message='Formatting filesystems' ;;
    mounting)         message='Mounting filesystems' ;;
    cache)            message='Configuring package cache' ;;
    pre_pacstrap)     message='Preparing for package installation' ;;
    pacstrap)         message='Installing base system and packages' ;;
    pacman_config)    message='Configuring pacman' ;;
    fstab)            message='Generating fstab' ;;
    locale)           message='Configuring locale' ;;
    timezone)         message='Setting timezone' ;;
    hostname)         message='Configuring hostname' ;;
    initramfs)        message='Rebuilding initramfs' ;;
    bootloader)       message='Installing bootloader' ;;
    network)          message='Configuring network' ;;
    user)             message='Configuring user and SSH' ;;
    autologin)        message='Configuring serial console' ;;
    services)         message='Enabling services' ;;
    script)           message='Running custom script' ;;
    inventory)        message='Capturing system inventory' ;;
    sync)             message='Syncing filesystems' ;;
    complete)         message='Installation complete' ;;
    failed)           message='Installation failed' ;;
    *)                return ;;
  esac
  printf >&2 '  %s\n' "$(terminal_write fg=cyan "${message}" reset)"
}

printf >&2 'Booting installer...\n'
printf >&2 'On failure, attach to the console for debugging:\n'
printf >&2 '    socat - UNIX-CONNECT:%s\n\n' "${console_sock}"

qemu-system-x86_64 \
    -enable-kvm \
    -cpu host \
    -machine q35 \
    -m "${VIRTDEV_VM_MEMORY}" \
    -smp "${VIRTDEV_VM_CPUS}" \
    -drive if=pflash,format=raw,readonly=on,file="${qemu_ovmf_code}" \
    -drive if=pflash,format=raw,file="${qemu_nvram}" \
    -drive file="${qemu_system_disk}",if=virtio,format=qcow2 \
    -drive file="${qemu_home_disk}",if=virtio,format=qcow2 \
    -cdrom "${VIRTDEV_ISO}" \
    -boot order=d,menu=off \
    -netdev user,id=net0 \
    -device virtio-net-pci,netdev=net0 \
    -device virtio-rng-pci \
    -display none \
    -serial unix:"${qemu_console_sock}",server=on,wait=off \
    -monitor none \
    -device virtio-serial \
    -chardev socket,path="${qemu_install_sock}",server=on,wait=off,id=install_ch \
    -device virtserialport,chardev=install_ch,name=org.virtdev.install \
    -virtfs local,path="${qemu_pacman_cache}",mount_tag=pacman_cache,security_model=mapped-xattr \
    -fw_cfg name=opt/virtdev/ssh_key,file="${qemu_ssh_key}" \
    -fw_cfg name=opt/virtdev/timezone,string="${qemu_timezone}" \
    -fw_cfg name=opt/virtdev/locale,string="${qemu_locale}" \
    -fw_cfg name=opt/virtdev/keymap,string="${qemu_keymap}" \
    -fw_cfg name=opt/virtdev/dns,string="${qemu_dns}" \
    "${qemu_extra_args[@]+"${qemu_extra_args[@]}"}" &
qemu_pid=$!

socket_deadline=$(( SECONDS + VIRTDEV_INSTALL_SOCKET_TIMEOUT ))
while [[ ! -S "${install_sock}" ]]; do
  child_is_active "${qemu_pid}" || break
  if (( SECONDS >= socket_deadline )); then
    error 10 <<MESSAGE
Installer VM did not create its progress socket within ${VIRTDEV_INSTALL_SOCKET_TIMEOUT}s.
The VM will be terminated before partial installation state is removed.
MESSAGE
  fi
  sleep 0.1
done

# Read progress tokens from the virtio-serial channel via a FIFO.
# Success requires the SSH capability token followed by `complete`; `failed`
# is the installer's non-zero EXIT token.
# Both unblock the reader naturally — no watchdog or polling needed.
# If QEMU dies before the guest sends a terminal token (crash, bad
# firmware, etc.), socat gets EOF and the reader exits with no match.
#
# -u makes socat unidirectional (socket -> stdout): this side only ever
# READS tokens from the guest, never writes to the channel. Without it
# socat is bidirectional and also forwards its own stdin into the socket,
# so a closed or non-interactive stdin (a pipe, `</dev/null`, a CI runner,
# or a stray Ctrl-D) reaches EOF immediately, tears the connection down,
# and the reader sees no tokens — falsely reporting "did not complete"
# while the guest installs fine. Reading is unaffected: a guest-side
# terminal token or QEMU death still EOFs the socket and ends the reader.
# Reads are capped before Bash allocates an unbounded record. An absolute
# progress deadline plus record/log budgets prevents a connected guest from
# retaining the global lock forever by dribbling or flooding status lines.
progress_fifo="${installation_directory}/progress.fifo"
progress_failure=''
guest_contract_seen=0
if [[ -S "${install_sock}" ]]; then
  mkfifo "${progress_fifo}"
  socat -u UNIX-CONNECT:"${install_sock}" - > "${progress_fifo}" 2>/dev/null &
  socat_pid=$!

  progress_deadline=$(( SECONDS + VIRTDEV_INSTALL_PROGRESS_TIMEOUT ))
  progress_records=0
  progress_bytes=0
  while :; do
    progress_remaining=$(( progress_deadline - SECONDS ))
    if (( progress_remaining <= 0 )); then
      progress_failure="no terminal progress token within ${VIRTDEV_INSTALL_PROGRESS_TIMEOUT}s"
      break
    fi

    token=''
    read_status=0
    IFS= read -r -t "${progress_remaining}" \
      -n "$(( install_progress_record_bytes + 1 ))" token \
      || read_status=$?

    if (( ${#token} > install_progress_record_bytes )); then
      progress_failure="progress record exceeded ${install_progress_record_bytes} bytes"
      break
    fi
    if (( read_status > 128 )); then
      progress_failure="no complete progress record within ${VIRTDEV_INSTALL_PROGRESS_TIMEOUT}s"
      break
    fi
    if (( read_status != 0 )); then
      progress_failure='progress channel closed without a terminal token'
      break
    fi

    (( progress_records += 1 ))
    (( progress_bytes += ${#token} + 1 ))
    if (( progress_records > install_progress_record_limit )); then
      progress_failure="progress record count exceeded ${install_progress_record_limit}"
      break
    fi
    if (( progress_bytes > install_progress_log_bytes )); then
      progress_failure="progress log exceeded ${install_progress_log_bytes} bytes"
      break
    fi

    printf '%s\n' "${token}" >> "${install_progress}"
    install_display_progress "${token}"
    case "${token}" in
      "${ssh_guest_contract_progress}") guest_contract_seen=1 ;;
      complete)
        (( guest_contract_seen )) \
          || progress_failure="installer did not advertise ${ssh_guest_contract_value}"
        break
        ;;
      failed) break ;;
    esac
  done < "${progress_fifo}"

  if ! child_terminate_and_reap "${socat_pid}" socat; then
    error 10 <<<'Could not terminate the installer progress bridge; installation state was preserved.'
  fi
  socat_pid=''
  rm -f -- "${progress_fifo}"
fi

if [[ -n "${progress_failure}" ]]; then
  error 10 <<MESSAGE
Installation progress failed: ${progress_failure}.
The VM will be terminated before partial installation state is removed.
MESSAGE
fi

if grep -qx 'complete' "${install_progress}" 2>/dev/null; then
  if ! child_wait_bounded "${qemu_pid}" "${VIRTDEV_INSTALL_SHUTDOWN_TIMEOUT}"; then
    error 10 <<MESSAGE
Installer reported completion but did not power off within ${VIRTDEV_INSTALL_SHUTDOWN_TIMEOUT}s.
The VM will be terminated and the partial installation discarded.
MESSAGE
  fi
  qemu_status="${child_wait_status}"
  qemu_pid=''
  if (( qemu_status != 0 )); then
    error 10 <<MESSAGE
Installer reported completion, but QEMU exited with status ${qemu_status}.
The installation is not accepted as cleanly terminated and will be discarded.
MESSAGE
  fi

  guest_contract="${installation_directory}/${ssh_guest_contract_name}"
  guest_contract_temporary="${guest_contract}.tmp"
  if [[ -e "${guest_contract}" || -L "${guest_contract}" \
        || -e "${guest_contract_temporary}" || -L "${guest_contract_temporary}" ]] \
      || ! (umask 077; printf '%s\n' "${ssh_guest_contract_value}" \
        > "${guest_contract_temporary}") \
      || ! chmod 0444 "${guest_contract_temporary}" \
      || ! sync -f "${guest_contract_temporary}" \
      || ! mv -T -- "${guest_contract_temporary}" "${guest_contract}" \
      || ! sync -f "${installation_directory}" \
      || ! ssh_guest_contract_valid "${installation_directory}"; then
    error 10 <<MESSAGE
Could not durably record the guest SSH transport contract.
The installation will be discarded rather than sealed without compatibility proof.
MESSAGE
  fi
  install_succeeded=1
  printf >&2 '\n%s\n' "$(terminal_write fg=green 'Installer finished.' reset)"
  printf >&2 'Run virtdev-seal to seal the base system images.\n'
elif child_is_active "${qemu_pid}"; then
  printf >&2 '\n%s\n' "$(terminal_write fg=red 'Installation did not complete successfully.' reset)"
  printf >&2 'Attach to the console for debugging:\n'
  printf >&2 '    socat - UNIX-CONNECT:%s\n' "${console_sock}"
  printf >&2 'Press Ctrl-C to terminate the virtual machine.\n'
  wait "${qemu_pid}" 2>/dev/null || true
  qemu_pid=''
  exit 10
else
  printf >&2 '\n%s\n' "$(terminal_write fg=red 'Installation did not complete successfully.' reset)"
  printf >&2 'The virtual machine has already exited.\n'
  exit 10
fi

rm -f -- "${install_progress}" "${install_sock}" "${console_sock}" \
  "${progress_fifo}" "${install_ssh_key}"
