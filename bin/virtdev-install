#!/usr/bin/env bash
#
# virtdev-install [--timezone tz] [--locale locale] [--keymap keymap]
#                 [--dns ip] [--packages path] [--script path]
#                 [--inventory path] [iso]
#
# Boots the virtdev ISO in a temporary QEMU process to install
# the base system into fresh qcow2 disks. Does not daemonize.
# Progress is reported via a virtio-serial channel and displayed
# as structured status messages. The serial console is available
# for debugging via the console socket.
#
# If no ISO path is given, defaults to the ISO produced by virtdev-iso.
#
# Resulting disk images are placed in ${VIRTDEV_HOME}/installation.
# Use virtdev-seal to promote them to sealed base system images
# from which project virtual machines may be derived.
#
# Exit codes:
#
#   0   success
#   3   ISO not found
#   4   OVMF_CODE not found
#   5   OVMF_VARS not found
#   6   installation directory already exists
#   7   sealed base system already present
#   8   SSH public key not found
#   9   socat not found
#  10   installation failed
#  11   explicit packages file missing or unreadable
#  12   explicit install script missing or unreadable
#  13   explicit inventory script missing or unreadable
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME              Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_ISO               Default: ${XDG_CACHE_HOME:-~/.cache}/virtdev/virtdev.iso
#   VIRTDEV_SSH_KEY           Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_TIMEZONE          Default: host timezone (UTC fallback)
#   VIRTDEV_LOCALE            Default: host locale (en_US.UTF-8 fallback)
#   VIRTDEV_KEYMAP            Default: host keymap (us fallback)
#   VIRTDEV_DNS               Default: 9.9.9.9
#   VIRTDEV_PACKAGES          Default: (none) path to extra packages file
#   VIRTDEV_SCRIPT            Default: (none) path to custom install script
#   VIRTDEV_INVENTORY         Default: (none) path to user inventory script
#   VIRTDEV_CACHE             Default: ${XDG_CACHE_HOME:-~/.cache}/virtdev
#   VIRTDEV_SYSTEM_DISK_SIZE  Default: 24G
#   VIRTDEV_HOME_DISK_SIZE    Default: 48G
#   VIRTDEV_VM_MEMORY         Default: 4096
#   VIRTDEV_VM_CPUS           Default: 4
#   OVMF_CODE                 Default: /usr/share/edk2/x64/OVMF_CODE.4m.fd
#   OVMF_VARS                 Default: /usr/share/edk2/x64/OVMF_VARS.4m.fd
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error lock arguments terminal ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_ISO:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev/virtdev.iso"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"

host_timezone="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
: "${VIRTDEV_TIMEZONE:="${host_timezone:-UTC}"}"

host_locale="$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null || true)"
: "${VIRTDEV_LOCALE:="${host_locale:-en_US.UTF-8}"}"

host_keymap="$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null || true)"
: "${VIRTDEV_KEYMAP:="${host_keymap:-us}"}"

: "${VIRTDEV_DNS:=9.9.9.9}"

: "${VIRTDEV_SYSTEM_DISK_SIZE:=24G}"
: "${VIRTDEV_HOME_DISK_SIZE:=48G}"
: "${VIRTDEV_VM_MEMORY:=4096}"
: "${VIRTDEV_VM_CPUS:=4}"
: "${OVMF_CODE:="/usr/share/edk2/x64/OVMF_CODE.4m.fd"}"
: "${OVMF_VARS:="/usr/share/edk2/x64/OVMF_VARS.4m.fd"}"

if [[ ! "${VIRTDEV_VM_MEMORY}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_MEMORY: must be a positive integer"
fi
if [[ ! "${VIRTDEV_VM_CPUS}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_CPUS: must be a positive integer"
fi

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([timezone]=value [locale]=value [keymap]=value
                 [dns]=value [packages]=value [script]=value
                 [inventory]=value)
# shellcheck disable=SC2034
declare -A spec_placeholders=([timezone]=tz [locale]=locale [keymap]=keymap
                              [dns]=ip [packages]=path [script]=path
                              [inventory]=path)
# shellcheck disable=SC2034
declare -a spec_positionals=("iso?")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

[[ -n "${flags[timezone]:-}" ]]  && VIRTDEV_TIMEZONE="${flags[timezone]}"
[[ -n "${flags[locale]:-}" ]]    && VIRTDEV_LOCALE="${flags[locale]}"
[[ -n "${flags[keymap]:-}" ]]    && VIRTDEV_KEYMAP="${flags[keymap]}"
[[ -n "${flags[dns]:-}" ]]       && VIRTDEV_DNS="${flags[dns]}"
[[ -n "${flags[packages]:-}" ]]  && VIRTDEV_PACKAGES="${flags[packages]}"
[[ -n "${flags[script]:-}" ]]    && VIRTDEV_SCRIPT="${flags[script]}"
[[ -n "${flags[inventory]:-}" ]] && VIRTDEV_INVENTORY="${flags[inventory]}"

if [[ $# -gt 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

if [[ $# -eq 1 ]]; then
  VIRTDEV_ISO="${1}"
fi

if [[ -n "${VIRTDEV_PACKAGES:-}" && \
      ( ! -f "${VIRTDEV_PACKAGES}" || ! -r "${VIRTDEV_PACKAGES}" ) ]]; then
  error 11 <<<"Packages file not found or not readable: ${VIRTDEV_PACKAGES}"
fi
if [[ -n "${VIRTDEV_SCRIPT:-}" && \
      ( ! -f "${VIRTDEV_SCRIPT}" || ! -r "${VIRTDEV_SCRIPT}" ) ]]; then
  error 12 <<<"Install script not found or not readable: ${VIRTDEV_SCRIPT}"
fi
if [[ -n "${VIRTDEV_INVENTORY:-}" && \
      ( ! -f "${VIRTDEV_INVENTORY}" || ! -r "${VIRTDEV_INVENTORY}" ) ]]; then
  error 13 <<<"Inventory script not found or not readable: ${VIRTDEV_INVENTORY}"
fi

lock_acquire

if ! command -v socat &>/dev/null; then
  error 9 <<<'socat not found, install socat'
fi

ssh_key_validate "${VIRTDEV_SSH_KEY}"

if [[ ! -f "${VIRTDEV_SSH_KEY}.pub" ]]; then
  error 8 <<<"SSH public key not found: '${VIRTDEV_SSH_KEY}.pub'"
fi

if [[ ! -f "${VIRTDEV_ISO}" ]]; then
  error 3 <<<"ISO not found: '${VIRTDEV_ISO}'"
fi

if [[ ! -f "${OVMF_CODE}" ]]; then
  error 4 <<<"OVMF_CODE not found: '${OVMF_CODE}'"
fi

if [[ ! -f "${OVMF_VARS}" ]]; then
  error 5 <<<"OVMF_VARS not found: '${OVMF_VARS}'"
fi

installation_directory="${VIRTDEV_HOME}"/installation

if [[ -d "${installation_directory}" ]]; then
  error 6 <<MESSAGE
Installation directory already exists: '${installation_directory}'
Use virtdev-seal to seal the installation, or remove it manually to reinstall.
MESSAGE
fi

system_directory="${VIRTDEV_HOME}"/system

if [[ -d "${system_directory}" ]]; then
  error 7 <<MESSAGE
Sealed base system images already present: '${system_directory}'
Remove the system directory manually to reinstall.
MESSAGE
fi

mkdir -p "${installation_directory}"

install_sock="${installation_directory}"/install.sock
console_sock="${installation_directory}"/console.sock
install_progress="${installation_directory}"/progress.log

: "${VIRTDEV_CACHE:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev"}"
pacman_cache="${VIRTDEV_CACHE}/pacman"
mkdir -p "${pacman_cache}"

install_succeeded=0
cleanup_partial_installation() {
  if ! (( install_succeeded )); then
    rm -rf "${installation_directory}"
  fi
  rm -f "${install_sock:-}" "${console_sock:-}" "${install_progress:-}" "${progress_fifo:-}"
}
trap cleanup_partial_installation EXIT

system_disk="${installation_directory}"/system.qcow2
printf >&2 "Creating %s system disk image: '%s'\n" \
       "${VIRTDEV_SYSTEM_DISK_SIZE}" "${system_disk}"
qemu-img create -f qcow2 "${system_disk}" "${VIRTDEV_SYSTEM_DISK_SIZE}"

home_disk="${installation_directory}"/home.qcow2
printf >&2 "Creating %s home disk: '%s'\n" \
       "${VIRTDEV_HOME_DISK_SIZE}" "${home_disk}"
qemu-img create -f qcow2 "${home_disk}" "${VIRTDEV_HOME_DISK_SIZE}"

nvram="${installation_directory}"/nvram
printf >&2 'Copying default NVRAM...\n'
cp "${OVMF_VARS}" "${nvram}"

qemu_extra_args=()
# shellcheck disable=SC2054  # commas are QEMU option syntax, not array separators
[[ -d /var/cache/pacman/pkg ]] && qemu_extra_args+=(
  -virtfs local,path=/var/cache/pacman/pkg,mount_tag=host_cache,security_model=mapped-xattr,readonly=on)
[[ -n "${VIRTDEV_PACKAGES:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/packages,file=${VIRTDEV_PACKAGES}")
[[ -n "${VIRTDEV_SCRIPT:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/script,file=${VIRTDEV_SCRIPT}")
[[ -n "${VIRTDEV_INVENTORY:-}" ]] && qemu_extra_args+=(
  -fw_cfg "name=opt/virtdev/inventory,file=${VIRTDEV_INVENTORY}")

install_display_progress() {
  local -r token="${1}"
  local message
  case "${token}" in
    partitioning)     message='Partitioning disks' ;;
    formatting)       message='Formatting filesystems' ;;
    mounting)         message='Mounting filesystems' ;;
    cache)            message='Configuring package cache' ;;
    pre_pacstrap)     message='Preparing for package installation' ;;
    pacstrap)         message='Installing base system and packages' ;;
    pacman_config)    message='Configuring pacman' ;;
    fstab)            message='Generating fstab' ;;
    locale)           message='Configuring locale' ;;
    timezone)         message='Setting timezone' ;;
    hostname)         message='Configuring hostname' ;;
    initramfs)        message='Rebuilding initramfs' ;;
    bootloader)       message='Installing bootloader' ;;
    network)          message='Configuring network' ;;
    user)             message='Configuring user and SSH' ;;
    autologin)        message='Configuring serial console' ;;
    services)         message='Enabling services' ;;
    script)           message='Running custom script' ;;
    inventory)        message='Capturing system inventory' ;;
    sync)             message='Syncing filesystems' ;;
    complete)         message='Installation complete' ;;
    failed)           message='Installation failed' ;;
    *)                return ;;
  esac
  printf >&2 '  %s\n' "$(terminal_write fg=cyan "${message}" reset)"
}

printf >&2 'Booting installer...\n'
printf >&2 'On failure, attach to the console for debugging:\n'
printf >&2 '    socat - UNIX-CONNECT:%s\n\n' "${console_sock}"

qemu-system-x86_64 \
    -enable-kvm \
    -cpu host \
    -machine q35 \
    -m "${VIRTDEV_VM_MEMORY}" \
    -smp "${VIRTDEV_VM_CPUS}" \
    -drive if=pflash,format=raw,readonly=on,file="${OVMF_CODE}" \
    -drive if=pflash,format=raw,file="${nvram}" \
    -drive file="${system_disk}",if=virtio,format=qcow2 \
    -drive file="${home_disk}",if=virtio,format=qcow2 \
    -cdrom "${VIRTDEV_ISO}" \
    -boot order=d,menu=off \
    -netdev user,id=net0 \
    -device virtio-net-pci,netdev=net0 \
    -device virtio-rng-pci \
    -display none \
    -serial unix:"${console_sock}",server=on,wait=off \
    -monitor none \
    -device virtio-serial \
    -chardev socket,path="${install_sock}",server=on,wait=off,id=install_ch \
    -device virtserialport,chardev=install_ch,name=org.virtdev.install \
    -virtfs local,path="${pacman_cache}",mount_tag=pacman_cache,security_model=mapped-xattr \
    -fw_cfg name=opt/virtdev/ssh_key,file="${VIRTDEV_SSH_KEY}.pub" \
    -fw_cfg name=opt/virtdev/timezone,string="${VIRTDEV_TIMEZONE}" \
    -fw_cfg name=opt/virtdev/locale,string="${VIRTDEV_LOCALE}" \
    -fw_cfg name=opt/virtdev/keymap,string="${VIRTDEV_KEYMAP}" \
    -fw_cfg name=opt/virtdev/dns,string="${VIRTDEV_DNS}" \
    "${qemu_extra_args[@]+"${qemu_extra_args[@]}"}" &
qemu_pid=$!

while [[ ! -S "${install_sock}" ]]; do
  kill -0 "${qemu_pid}" 2>/dev/null || break
  sleep 0.1
done

# Read progress tokens from the virtio-serial channel via a FIFO.
# The guest install script sends either 'complete' (success) or
# 'failed' (EXIT trap on non-zero exit) as its terminal token.
# Both unblock the reader naturally — no watchdog or polling needed.
# If QEMU dies before the guest sends a terminal token (crash, bad
# firmware, etc.), socat gets EOF and the reader exits with no match.
#
# -u makes socat unidirectional (socket -> stdout): this side only ever
# READS tokens from the guest, never writes to the channel. Without it
# socat is bidirectional and also forwards its own stdin into the socket,
# so a closed or non-interactive stdin (a pipe, `</dev/null`, a CI runner,
# or a stray Ctrl-D) reaches EOF immediately, tears the connection down,
# and the reader sees no tokens — falsely reporting "did not complete"
# while the guest installs fine. Reading is unaffected: a guest-side
# terminal token or QEMU death still EOFs the socket and ends the reader.
progress_fifo="${installation_directory}/progress.fifo"
if [[ -S "${install_sock}" ]]; then
  mkfifo "${progress_fifo}"
  socat -u UNIX-CONNECT:"${install_sock}" - > "${progress_fifo}" 2>/dev/null &
  socat_pid=$!

  while IFS= read -r token; do
    printf '%s\n' "${token}" >> "${install_progress}"
    install_display_progress "${token}"
    case "${token}" in complete|failed) break ;; esac
  done < "${progress_fifo}"

  kill "${socat_pid}" 2>/dev/null || true
  wait "${socat_pid}" 2>/dev/null || true
  rm -f "${progress_fifo}"
fi

if grep -qx 'complete' "${install_progress}" 2>/dev/null; then
  install_succeeded=1
  wait "${qemu_pid}" 2>/dev/null || true
  printf >&2 '\n%s\n' "$(terminal_write fg=green 'Installer finished.' reset)"
  printf >&2 'Run virtdev-seal to seal the base system images.\n'
elif kill -0 "${qemu_pid}" 2>/dev/null; then
  printf >&2 '\n%s\n' "$(terminal_write fg=red 'Installation did not complete successfully.' reset)"
  printf >&2 'Attach to the console for debugging:\n'
  printf >&2 '    socat - UNIX-CONNECT:%s\n' "${console_sock}"
  printf >&2 'Press Ctrl-C to terminate the virtual machine.\n'
  wait "${qemu_pid}" 2>/dev/null || true
  exit 10
else
  printf >&2 '\n%s\n' "$(terminal_write fg=red 'Installation did not complete successfully.' reset)"
  printf >&2 'The virtual machine has already exited.\n'
  exit 10
fi

rm -f "${install_progress}" "${install_sock}" "${console_sock}" "${progress_fifo}"
