#!/usr/bin/env bash
# shellcheck disable=SC2154  # machine descriptor constants provided by import
#
# virtdev-port <project>
#
# Prints the SSH port of a running project virtual machine.
# Exits non-zero if the project is not running.
#
# Machine-readable: stdout contains only the port number. For SSH, retain
# virtdev's project-bound identity policy:
#
#     virtdev ssh lone
#     virtdev ssh lone -- uname -a
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   64  usage error
#   81  corrupt port file
#   87  project has no port assigned (virtual machine not running)

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments port machine

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"


target_status=0
machine_target_require "${project}" || target_status=$?
case "${target_status}" in
  "${machine_target_invalid}") error 2 <<<"Not a machine target: ${project}" ;;
  "${machine_target_missing}") error 3 <<<"Machine target not found: ${project}" ;;
esac

if ! machine_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
fi

port=""
port_require port "${project}"

printf '%s\n' "${port}"
