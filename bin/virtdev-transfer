#!/usr/bin/env bash
#
# virtdev-transfer <project> <src> <dest>
#
# Copies files between the host and a running project virtual machine.
# Uploads use rsync over SSH. Downloads use a bounded tar stream, a
# private host stage, and atomic publication. Prefix the remote path
# with ':' to indicate the virtual machine side.
#
# Upload (host to virtual machine):
#
#     virtdev-transfer myproject local-file :remote-file
#     virtdev-transfer myproject ./src :~/src
#
# Download (virtual machine to host):
#
#     virtdev-transfer myproject :remote-file local-file
#     virtdev-transfer myproject :~/src ./src
#
# Remote paths without a leading '/' are relative to /home/dev.
# Trailing slash semantics follow rsync convention:
# 'dir/' copies contents, 'dir' copies the directory itself.
#
# Requires rsync on the host and, for uploads, the guest. Downloads
# require tar on both sides.
#
#     pacman -S rsync
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME                         Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY                      Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_TRANSFER_MAX_BYTES           Default: 8589934592 (8 GiB logical data)
#   VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES Default: 10737418240 (10 GiB)
#   VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES Default: 53687091200 (50 GiB)
#   VIRTDEV_TRANSFER_MAX_ENTRIES         Default: 200000
#   VIRTDEV_TRANSFER_TIMEOUT             Default: 3600 seconds total
#   VIRTDEV_TRANSFER_KILL_AFTER          Default: 5 seconds from TERM to KILL
#   VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES  Default: 65536
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   8   rsync not found
#   9   neither source nor destination is a remote path
#   10  both source and destination are remote paths
#   11  transfer resource, structure, output, or capacity limit exceeded
#   12  transfer deadline exceeded
#   13  guest transport, upload, or archive capture failed
#   14  guest produced an unsafe or malformed archive
#   15  host publication target is unsafe or incompatible
#   16  publication committed but its durability status is indeterminate
#   64  usage error
#   75  another transfer holds the host-target lock
#   76  host-target lock setup failed
#   77  SSH key not found
#   78  SSH key permissions too open
#   81  corrupt port file
#   87  no port assigned (virtual machine not running)
#   103 guest SSH host identity missing or corrupt
#   104 guest SSH transport marker missing or incompatible
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import diagnostic error integer lock mount validate arguments ssh port project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${VIRTDEV_TRANSFER_MAX_BYTES:=8589934592}"
: "${VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES:=10737418240}"
: "${VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES:=53687091200}"
: "${VIRTDEV_TRANSFER_MAX_ENTRIES:=200000}"
: "${VIRTDEV_TRANSFER_TIMEOUT:=3600}"
: "${VIRTDEV_TRANSFER_KILL_AFTER:=5}"
: "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES:=65536}"

integer_is_bounded_positive "${VIRTDEV_TRANSFER_MAX_BYTES}" 1099511627776 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_MAX_BYTES: expected 1..1099511627776'
integer_is_bounded_positive "${VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES}" 2199023255552 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES: expected 1..2199023255552'
integer_is_bounded_positive "${VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES}" 10995116277760 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES: expected 1..10995116277760'
integer_is_bounded_positive "${VIRTDEV_TRANSFER_MAX_ENTRIES}" 10000000 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_MAX_ENTRIES: expected 1..10000000'
integer_is_bounded_positive "${VIRTDEV_TRANSFER_TIMEOUT}" 86400 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_TIMEOUT: expected 1..86400'
integer_is_bounded_positive "${VIRTDEV_TRANSFER_KILL_AFTER}" 60 \
  || error 64 <<<'Invalid VIRTDEV_TRANSFER_KILL_AFTER: expected 1..60'
integer_is_bounded_positive "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" 1048576 \
  || error 64 <<<'Invalid VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES: expected 1..1048576'

readonly transfer_archive_entry_overhead=8192
readonly transfer_archive_fixed_overhead=10240
readonly transfer_free_space_reserve=536870912
readonly transfer_inode_reserve=4096
readonly transfer_member_path_max_bytes=4095
readonly transfer_member_depth_max=128
readonly transfer_extension_max_bytes=1048576
readonly transfer_archive_memory_kib=262144
readonly transfer_stage_overhead=$((
  VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES + transfer_archive_fixed_overhead + 65536
))

transfer_archive_limit=$(( VIRTDEV_TRANSFER_MAX_BYTES \
  + VIRTDEV_TRANSFER_MAX_ENTRIES * transfer_archive_entry_overhead \
  + transfer_archive_fixed_overhead ))
if (( VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES < transfer_archive_limit )); then
  error 64 <<MESSAGE
VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES must cover the configured logical-data
and archive-metadata ceiling (${transfer_archive_limit} bytes).
MESSAGE
fi

umask 077

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project src dest)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 3 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"
src="${2}"
dest="${3}"

validate_project_name "${project}"


project_require "${project}"

if ! project_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Run it with: virtdev-start ${project}
MESSAGE
fi

port=""
port_require port "${project}"

ssh_key_validate "${VIRTDEV_SSH_KEY}"

if ! command -v rsync &>/dev/null; then
  error 8 <<MESSAGE
rsync not found
Install it with: pacman -S rsync
MESSAGE
fi

src_is_remote=0
dest_is_remote=0

[[ "${src}" == :* ]] && src_is_remote=1
[[ "${dest}" == :* ]] && dest_is_remote=1

if (( src_is_remote + dest_is_remote == 0 )); then
  error 9 <<MESSAGE
Neither source nor destination is a remote path.
Prefix the remote path with ':' to indicate the virtual machine side.
Example: virtdev-transfer ${project} local-file :remote-file
MESSAGE
fi

if (( src_is_remote + dest_is_remote == 2 )); then
  error 10 <<MESSAGE
Both source and destination are remote paths.
Only one path can be on the virtual machine side.
For virtual machine-local copies: virtdev-ssh ${project} -- cp src dest
MESSAGE
fi

remote="dev@127.0.0.1"
transfer_deadline=$(( BASH_MONOSECONDS + VIRTDEV_TRANSFER_TIMEOUT ))
readonly transfer_cleanup_grace=2
readonly transfer_cleanup_kill_after=1
readonly transfer_publication_not_started=200

transfer_remaining() {
  local -n _transfer_remaining_result="${1}"
  _transfer_remaining_result=$(( transfer_deadline - BASH_MONOSECONDS ))
  (( _transfer_remaining_result > 0 )) \
    || error 12 <<<'Transfer wall-clock deadline expired'
}

transfer_deadline_run() {
  local remaining=$(( transfer_deadline - BASH_MONOSECONDS ))

  (( remaining > 0 )) || return 124
  timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
    "${remaining}" "$@"
}

transfer_deadline_capture() {
  local -n _transfer_deadline_capture_result="${1}"
  shift
  local status=0

  _transfer_deadline_capture_result="$(transfer_deadline_run "$@")" \
    || status=$?
  return "${status}"
}

transfer_publication_run() {
  local remaining=$(( transfer_deadline - BASH_MONOSECONDS ))

  (( remaining > 0 )) || return "${transfer_publication_not_started}"
  timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
    "${remaining}" "$@"
}

transfer_recovery_begin() {
  transfer_recovery_deadline=$((
    BASH_MONOSECONDS + VIRTDEV_TRANSFER_KILL_AFTER
  ))
}

transfer_recovery_run() {
  local remaining=$(( transfer_recovery_deadline - BASH_MONOSECONDS ))

  (( remaining > 0 )) || return 124
  timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
    "${remaining}" "$@"
}

transfer_recovery_capture() {
  local -n _transfer_recovery_capture_result="${1}"
  shift
  local status=0

  _transfer_recovery_capture_result="$(transfer_recovery_run "$@")" \
    || status=$?
  return "${status}"
}

if (( dest_is_remote )); then
  printf >&2 'Copying to %s...\n' "${project}"
  upload_diagnostic_directory="$(mktemp -d \
    --tmpdir virtdev-transfer-upload.XXXXXXXXXX)" \
    || error 11 <<<'Could not create a private upload diagnostic directory'
  upload_stderr="${upload_diagnostic_directory}/rsync.stderr"
  upload_stderr_fifo="${upload_diagnostic_directory}/rsync.stderr.fifo"
  ssh_command=""
  rsync_wrapper=""

  # shellcheck disable=SC2329  # invoked by the EXIT trap
  cleanup_upload() {
    local -r cleanup_status=$?

    trap - EXIT
    set +e
    [[ -z "${rsync_wrapper}" ]] || rm -f -- "${rsync_wrapper}"
    rm -f -- "${upload_stderr_fifo}" "${upload_stderr}"
    rmdir -- "${upload_diagnostic_directory}" 2>/dev/null || true
    exit "${cleanup_status}"
  }
  trap cleanup_upload EXIT

  ssh_rsync_command ssh_command rsync_wrapper "${project}" \
    "${VIRTDEV_SSH_KEY}" "${port}"
  remaining=''
  transfer_remaining remaining
  upload_status=0
  bounded_stderr_run "${upload_stderr}" "${upload_stderr_fifo}" \
      "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
      timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
        "${remaining}" rsync -a --quiet -e "${ssh_command}" -- \
        "${src}" "${remote}:${dest#:}" >/dev/null || upload_status=$?

  diagnostic_status=0
  bounded_stderr_emit "${upload_stderr}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
  case "${diagnostic_status}" in
    0) ;;
    2) error 11 <<<'Upload diagnostics exceeded their output budget' ;;
    *) error 13 <<<'Could not capture bounded upload diagnostics' ;;
  esac
  case "${upload_status}" in
    0) ;;
    124|137) error 12 <<<'Upload exceeded the transfer deadline' ;;
    *)
      error 13 <<MESSAGE
Upload failed (rsync or transport exit ${upload_status}).
The guest destination may contain a partial update.
MESSAGE
      ;;
  esac
  exit 0
fi

for command in tar rsync realpath; do
  command -v "${command}" &>/dev/null \
    || error 8 <<<"${command} is required for bounded downloads"
done

# shellcheck disable=SC2154  # helper directory provided by import
archive_gate="${virtdev_libexec_directory}/virtdev-archive-gate"
copy_tree_helper="${virtdev_libexec_directory}/virtdev-copy-tree"
file_state_helper="${virtdev_libexec_directory}/virtdev-file-state"
publish_helper="${virtdev_libexec_directory}/virtdev-publish"
for helper in "${archive_gate}" "${copy_tree_helper}" "${file_state_helper}" \
  "${publish_helper}"; do
  [[ -x "${helper}" ]] \
    || error 11 <<<"Required bounded-transfer helper is unavailable: ${helper}. Run 'make'."
done

remote_path="${src#:}"
if [[ -z "${remote_path}" || "${remote_path}" == *$'\n'* \
    || "${remote_path}" == *$'\r'* ]]; then
  error 64 <<<'Remote download path must be nonempty and contain no line breaks'
fi
tilde_slash=$'\x7e/'
if [[ "${remote_path}" == '~' ]]; then
  remote_normalized='/home/dev'
elif [[ "${remote_path:0:2}" == "${tilde_slash}" ]]; then
  remote_normalized="/home/dev/${remote_path:2}"
elif [[ "${remote_path}" == /* ]]; then
  remote_normalized="${remote_path}"
else
  remote_normalized="/home/dev/${remote_path}"
fi
remote_trailing=0
if [[ "${remote_normalized}" != / && "${remote_normalized}" == */ ]]; then
  remote_trailing=1
  while [[ "${remote_normalized}" != / && "${remote_normalized}" == */ ]]; do
    remote_normalized="${remote_normalized%/}"
  done
fi
remote_basename="${remote_normalized##*/}"
if [[ "${remote_normalized}" == / || -z "${remote_basename}" \
    || "${remote_basename}" == . || "${remote_basename}" == .. ]]; then
  error 64 <<<'Downloading a filesystem root or dot component is not supported'
fi
remote_request_path="${remote_normalized}"
(( remote_trailing )) && remote_request_path+='/'

if [[ -z "${dest}" || "${dest}" == *$'\n'* || "${dest}" == *$'\r'* ]]; then
  error 64 <<<'Host destination must be nonempty and contain no line breaks'
fi
dest_trailing=0
if [[ "${dest}" != / && "${dest}" == */ ]]; then
  dest_trailing=1
fi
dest_trimmed="${dest}"
while [[ "${dest_trimmed}" != / && "${dest_trimmed}" == */ ]]; do
  dest_trimmed="${dest_trimmed%/}"
done
if [[ "${dest_trimmed}" == /* ]]; then
  dest_lexical="${dest_trimmed}"
else
  dest_lexical="${PWD}/${dest_trimmed}"
fi
if [[ -L "${dest_lexical}" ]]; then
  error 15 <<<"Refusing a symlink publication destination: ${dest}"
fi
dest_initial_directory=0
if [[ -e "${dest_lexical}" ]]; then
  dest_absolute="$(realpath -e -- "${dest_lexical}")" \
    || error 15 <<<"Could not resolve host destination: ${dest}"
  [[ -d "${dest_absolute}" ]] && dest_initial_directory=1
else
  (( ! dest_trailing )) \
    || error 15 <<<"A destination ending in '/' must already be a directory: ${dest}"
  dest_name="${dest_lexical##*/}"
  dest_parent_lexical="${dest_lexical%/*}"
  [[ -n "${dest_parent_lexical}" ]] || dest_parent_lexical=/
  [[ -n "${dest_name}" && "${dest_name}" != . && "${dest_name}" != .. ]] \
    || error 15 <<<"Unsafe host destination: ${dest}"
  dest_parent="$(realpath -e -- "${dest_parent_lexical}")" \
    || error 15 <<<"Host destination parent does not exist: ${dest_parent_lexical}"
  [[ -d "${dest_parent}" && ! -L "${dest_parent}" ]] \
    || error 15 <<<"Host destination parent is not a real directory: ${dest_parent}"
  dest_absolute="${dest_parent%/}/${dest_name}"
fi

if (( remote_trailing )); then
  [[ "${dest_absolute}" != / ]] \
    || error 15 <<<'Refusing to merge a download into the host filesystem root'
  transaction_parent="${dest_absolute%/*}"
  [[ -n "${transaction_parent}" ]] || transaction_parent=/
elif (( dest_initial_directory )); then
  transaction_parent="${dest_absolute}"
else
  transaction_parent="${dest_absolute%/*}"
  [[ -n "${transaction_parent}" ]] || transaction_parent=/
fi
[[ -d "${transaction_parent}" && ! -L "${transaction_parent}" ]] \
  || error 15 <<<"Unsafe publication parent: ${transaction_parent}"

transfer_transaction="$(mktemp -d \
  --tmpdir="${transaction_parent}" '.virtdev-transfer.XXXXXXXX')" \
  || error 11 <<<"Could not create a private download stage in ${transaction_parent}"
transfer_preserve_transaction=0
transfer_df_counter=0
transfer_du_counter=0
transfer_file_state_counter=0
candidate_identity=''
transfer_recovery_deadline=0

cleanup_transfer() {
  local -r cleanup_status=$?
  local mount_path='' remove_status=0

  trap - EXIT
  set +e
  if (( transfer_preserve_transaction )); then
    printf >&2 'Preserved transfer transaction for recovery: %s\n' \
      "${transfer_transaction}"
  else
    mount_remove_tree_bounded "${transfer_transaction}" mount_path \
      "${transfer_cleanup_grace}" "${transfer_cleanup_kill_after}" \
      || remove_status=$?
    case "${remove_status}" in
      0) ;;
      1) printf >&2 'warning: preserving transfer stage with mounted subtree: %s\n' "${mount_path}" ;;
      4) printf >&2 'warning: preserving transfer stage after cleanup grace expired: %s\n' "${transfer_transaction}" ;;
      *) printf >&2 'warning: transfer stage cleanup is unsafe or incomplete: %s\n' "${transfer_transaction}" ;;
    esac
  fi
  exit "${cleanup_status}"
}
trap cleanup_transfer EXIT

transfer_df_value() {
  local -n _transfer_df_result="${1}"
  local -r column="${2}" path="${3}" phase="${4}"
  local remaining output value output_size
  local -a lines=() statuses=()

  (( ++transfer_df_counter ))
  output="${transfer_transaction}/df-${transfer_df_counter}"
  transfer_remaining remaining
  set +e
  case "${column}" in
    avail)
      timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
        "${remaining}" df -B1 --output=avail -- "${path}" 2>/dev/null \
        | head -c 4097 > "${output}"
      statuses=("${PIPESTATUS[@]}")
      ;;
    iavail)
      timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
        "${remaining}" df --output=iavail -- "${path}" 2>/dev/null \
        | head -c 4097 > "${output}"
      statuses=("${PIPESTATUS[@]}")
      ;;
    *) error 11 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  set -e
  (( ${#statuses[@]} == 2 && statuses[1] == 0 )) \
    || error 11 <<<"Could not capture host capacity during ${phase}"
  output_size="$(stat -c '%s' -- "${output}" 2>/dev/null)" \
    || output_size=''
  if [[ ! "${output_size}" =~ ^[0-9]+$ ]] \
      || (( output_size > 4096 )); then
    error 11 <<<"Could not parse host capacity during ${phase}"
  fi
  case "${statuses[0]}" in
    0) ;;
    124|137) error 12 <<<"Host capacity check timed out during ${phase}" ;;
    *) error 11 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  mapfile -t lines < "${output}"
  (( ${#lines[@]} == 2 )) \
    || error 11 <<<"Could not parse host capacity during ${phase}"
  value="${lines[1]//[[:space:]]/}"
  if [[ "${column}" == iavail && "${value}" == - ]]; then
    error 11 <<<"Host inode availability is unavailable during ${phase}"
  elif [[ "${value}" =~ ^[0-9]+$ && ${#value} -le 18 ]]; then
    _transfer_df_result="${value}"
  else
    error 11 <<<"Could not parse host capacity during ${phase}"
  fi
}

transfer_memory_limited() {
  (
    ulimit -v "${transfer_archive_memory_kib}" || exit 70
    exec "$@"
  )
}

transfer_tar_diagnostics_emit() {
  local -r capture="${1}" phase="${2}"
  local diagnostic_status=0

  bounded_stderr_emit "${capture}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
  case "${diagnostic_status}" in
    0)
      rm -f -- "${capture}" \
        || error 14 <<<"Could not retire host tar diagnostics after ${phase}"
      ;;
    2)
      error 11 \
        <<<"Host tar diagnostics exceeded their output budget during ${phase}"
      ;;
    *) error 14 <<<"Could not capture bounded host tar diagnostics during ${phase}" ;;
  esac
}

transfer_du_value() {
  local -n _transfer_du_result="${1}"
  local -r path="${2}" phase="${3}"
  local remaining output value ignored
  local -a statuses=()

  (( ++transfer_du_counter ))
  output="${transfer_transaction}/du-${transfer_du_counter}"
  remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return 2
  set +e
  LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      du -sx -B1 -- "${path}" 2>/dev/null \
    | head -c 4097 > "${output}"
  statuses=("${PIPESTATUS[@]}")
  set -e
  (( ${#statuses[@]} == 2 && statuses[1] == 0 )) \
    || return 3
  case "${statuses[0]}" in
    0) ;;
    124|137) return 2 ;;
    *) return 3 ;;
  esac
  read -r value ignored < "${output}"
  [[ "${value}" =~ ^[0-9]+$ && ${#value} -le 18 \
      && -n "${ignored}" ]] \
    || return 3
  rm -f -- "${output}" || return 3
  _transfer_du_result="${value}"
}

transfer_du_value_checked() {
  local -r result_name="${1}" path="${2}" phase="${3}"
  local status=0

  transfer_du_value "${result_name}" "${path}" "${phase}" || status=$?
  case "${status}" in
    0) ;;
    2) error 12 <<<"Allocated-byte accounting timed out during ${phase}" ;;
    *) error 11 <<<"Could not account for allocated bytes during ${phase}" ;;
  esac
}

transfer_transaction_budget() {
  local -r phase="${1}"
  local allocated='' status=0

  transfer_du_value allocated "${transfer_transaction}" \
    "transaction-${phase}" || status=$?
  (( status == 0 )) || return "${status}"
  (( allocated <= VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES )) || return 1
}

transfer_transaction_budget_checked() {
  local -r phase="${1}"
  local status=0

  transfer_transaction_budget "${phase}" || status=$?
  case "${status}" in
    0) ;;
    1) error 11 <<<"Transfer transaction exceeded its aggregate byte budget during ${phase}" ;;
    2) error 12 <<<"Transfer transaction accounting timed out during ${phase}" ;;
    *) error 11 <<<"Could not account for the transfer transaction during ${phase}" ;;
  esac
}

transfer_transaction_remaining() {
  local -n _transfer_transaction_remaining_result="${1}"
  local -r phase="${2}"
  local allocated='' status=0

  transfer_du_value allocated "${transfer_transaction}" \
    "transaction-${phase}" || status=$?
  (( status == 0 )) || return "${status}"
  (( allocated < VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES )) || return 1
  _transfer_transaction_remaining_result=$((
    VIRTDEV_TRANSFER_MAX_TRANSACTION_BYTES - allocated
  ))
}

transfer_transaction_remaining_checked() {
  local -r result_name="${1}" phase="${2}"
  local status=0

  transfer_transaction_remaining "${result_name}" "${phase}" || status=$?
  case "${status}" in
    0) ;;
    1) error 11 <<<"Transfer transaction exhausted its aggregate byte budget during ${phase}" ;;
    2) error 12 <<<"Transfer transaction accounting timed out during ${phase}" ;;
    *) error 11 <<<"Could not account for the transfer transaction during ${phase}" ;;
  esac
}

transfer_copy_tree_core() {
  local -r source_tree="${1}" destination_parent="${2}" policy="${3:-}"
  local remaining copy_status=0 diagnostic_status=0 budget_status=0
  local source_allocated='' transaction_remaining='' copy_ceiling
  local preflight_status=0
  local summary_entries summary_bytes summary_device summary_inode extra
  local summary="${destination_parent}/summary"
  local capture="${destination_parent}.stderr"
  local fifo="${destination_parent}.stderr.fifo"
  local -a helper_options=(identity)

  case "${policy}" in
    '') ;;
    reject-xattrs|strip-setid) helper_options+=("${policy}") ;;
    *) return 3 ;;
  esac

  transfer_du_value source_allocated "${source_tree}" \
    'tree-copy-source' || preflight_status=$?
  case "${preflight_status}" in
    0) ;;
    2) return 2 ;;
    *) return 3 ;;
  esac
  preflight_status=0
  transfer_transaction_remaining transaction_remaining \
    'tree-copy-preflight' || preflight_status=$?
  case "${preflight_status}" in
    0) ;;
    1) return 4 ;;
    2) return 2 ;;
    *) return 3 ;;
  esac
  copy_ceiling=$(( source_allocated + transfer_stage_overhead ))
  if [[ "${policy}" == reject-xattrs ]]; then
    copy_ceiling="${VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES}"
  fi
  (( copy_ceiling <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES \
      && copy_ceiling <= transaction_remaining )) || return 4

  TRANSFER_COPY_ENTRIES=''
  TRANSFER_COPY_BYTES=''
  TRANSFER_COPY_DEVICE=''
  TRANSFER_COPY_INODE=''
  mkdir -m 0700 -- "${destination_parent}" || return 3
  remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return 2
  bounded_stderr_run "${capture}" "${fifo}" \
      "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
      timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
        "${remaining}" "${copy_tree_helper}" \
        "${source_tree}" "${destination_parent}" \
        "${VIRTDEV_TRANSFER_MAX_BYTES}" "${VIRTDEV_TRANSFER_MAX_ENTRIES}" \
        "${transfer_free_space_reserve}" "${transfer_inode_reserve}" \
        "${helper_options[@]}" > "${summary}" || copy_status=$?
  bounded_stderr_emit "${capture}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
  case "${diagnostic_status}" in
    0) ;;
    2) return 4 ;;
    *) return 3 ;;
  esac
  rm -f -- "${capture}" || return 3
  case "${copy_status}" in
    0) ;;
    47) return 1 ;;
    42|44|45|46|48) return 4 ;;
    49) return 5 ;;
    124|137) return 2 ;;
    *) return 3 ;;
  esac
  read -r summary_entries summary_bytes summary_device summary_inode extra \
    < "${summary}"
  [[ "${summary_entries}" =~ ^[0-9]+$ \
      && "${summary_bytes}" =~ ^[0-9]+$ \
      && "${summary_device}" =~ ^[0-9]+$ \
      && "${summary_inode}" =~ ^[0-9]+$ && -z "${extra}" ]] \
    || return 3
  TRANSFER_COPY_ENTRIES="${summary_entries}"
  TRANSFER_COPY_BYTES="${summary_bytes}"
  TRANSFER_COPY_DEVICE="${summary_device}"
  TRANSFER_COPY_INODE="${summary_inode}"
  transfer_transaction_budget 'tree-copy' || budget_status=$?
  case "${budget_status}" in
    0) ;;
    1) return 4 ;;
    2) return 2 ;;
    *) return 3 ;;
  esac
}

transfer_copy_tree() {
  local -r source_tree="${1}" destination_parent="${2}" phase="${3}" \
    policy="${4:-}"
  local copy_status=0

  transfer_copy_tree_core "${source_tree}" "${destination_parent}" \
    "${policy}" \
    || copy_status=$?
  case "${copy_status}" in
    0) ;;
    1) error 14 <<<"${phase} changed while a stable copy was being constructed" ;;
    2) error 12 <<<"${phase} exceeded the transfer deadline" ;;
    4) error 11 <<<"${phase} exceeded a transfer resource or structure limit" ;;
    5) error 15 <<<"${phase} contains extended attributes or ACLs that cannot be preserved" ;;
    *) error 11 <<<"Could not construct a stable tree during ${phase}" ;;
  esac
}

transfer_file_state() {
  local -r source_file="${1}"
  local device inode mode uid gid links size mtime_seconds mtime_nanoseconds
  local ctime_seconds ctime_nanoseconds digest extra
  local remaining command_status=0 diagnostic_status=0
  local output capture fifo

  TRANSFER_FILE_IDENTITY=''
  TRANSFER_FILE_SEMANTIC=''
  (( ++transfer_file_state_counter ))
  output="${transfer_transaction}/file-state-${transfer_file_state_counter}"
  capture="${output}.stderr"
  fifo="${output}.stderr.fifo"
  remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return 2
  bounded_stderr_run "${capture}" "${fifo}" \
      "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
      timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
        "${remaining}" "${file_state_helper}" "${source_file}" \
        "${VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES}" \
        > "${output}" || command_status=$?
  bounded_stderr_emit "${capture}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
  case "${diagnostic_status}" in
    0) ;;
    2) return 4 ;;
    *) return 3 ;;
  esac
  rm -f -- "${capture}" || return 3
  case "${command_status}" in
    0) ;;
    44|47) return 1 ;;
    49) return 5 ;;
    124|137) return 2 ;;
    *) return 3 ;;
  esac
  read -r device inode mode uid gid links size mtime_seconds \
    mtime_nanoseconds ctime_seconds ctime_nanoseconds digest extra \
    < "${output}"
  [[ "${device}" =~ ^[0-9]+$ && "${inode}" =~ ^[0-9]+$ \
      && "${mode}" =~ ^[0-9a-f]+$ && "${uid}" =~ ^[0-9]+$ \
      && "${gid}" =~ ^[0-9]+$ && "${links}" =~ ^[0-9]+$ \
      && "${size}" =~ ^[0-9]+$ \
      && "${mtime_seconds}" =~ ^-?[0-9]+$ \
      && "${mtime_nanoseconds}" =~ ^[0-9]+$ \
      && "${ctime_seconds}" =~ ^-?[0-9]+$ \
      && "${ctime_nanoseconds}" =~ ^[0-9]+$ \
      && "${digest}" =~ ^[0-9a-f]{64}$ && -z "${extra}" \
      && ${#mtime_nanoseconds} -le 9 \
      && ${#ctime_nanoseconds} -le 9 ]] || return 3
  (( 10#${mtime_nanoseconds} <= 999999999 \
      && 10#${ctime_nanoseconds} <= 999999999 )) || return 3
  rm -f -- "${output}" || return 3

  TRANSFER_FILE_IDENTITY="${device}:${inode}"
  TRANSFER_FILE_SEMANTIC="${mode}:${uid}:${gid}:${links}:${size}:"
  TRANSFER_FILE_SEMANTIC+="${mtime_seconds}:${mtime_nanoseconds}:${digest}"
}

transfer_copy_tree_for_validation() {
  local -r source_tree="${1}" destination_parent="${2}" policy="${3:-}"
  local copy_status=0

  TRANSFER_VALIDATION_ENTRIES=''
  TRANSFER_VALIDATION_BYTES=''
  TRANSFER_VALIDATION_DEVICE=''
  TRANSFER_VALIDATION_INODE=''
  transfer_copy_tree_core "${source_tree}" "${destination_parent}" \
    "${policy}" \
    || copy_status=$?
  (( copy_status == 0 )) || return "${copy_status}"
  TRANSFER_VALIDATION_ENTRIES="${TRANSFER_COPY_ENTRIES}"
  TRANSFER_VALIDATION_BYTES="${TRANSFER_COPY_BYTES}"
  TRANSFER_VALIDATION_DEVICE="${TRANSFER_COPY_DEVICE}"
  TRANSFER_VALIDATION_INODE="${TRANSFER_COPY_INODE}"
}

transfer_directory_root_state() {
  local -r directory="${1}"
  local remaining command_status=0

  TRANSFER_DIRECTORY_ROOT_STATE=''
  remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || return 2
  TRANSFER_DIRECTORY_ROOT_STATE="$(LC_ALL=C timeout --signal=TERM \
    --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
    stat --printf='%f:%u:%g:%h:%s:%y' -- "${directory}" 2>/dev/null)" \
    || command_status=$?
  case "${command_status}" in
    0) ;;
    124|137) return 2 ;;
    *) return 3 ;;
  esac
}

transfer_trees_equal() {
  local -r expected="${1}" actual="${2}"
  local remaining rsync_status=0 head_status=0 diagnostic_status=0
  local expected_root actual_root comparison direction comparison_source \
    comparison_target
  local difference="${transfer_transaction}/tree-comparison"
  local capture="${transfer_transaction}/tree-comparison.stderr"
  local fifo="${transfer_transaction}/tree-comparison.stderr.fifo"
  local -a directions=() statuses=() rsync_options=()

  transfer_directory_root_state "${expected}" || return $?
  expected_root="${TRANSFER_DIRECTORY_ROOT_STATE}"
  transfer_directory_root_state "${actual}" || return $?
  actual_root="${TRANSFER_DIRECTORY_ROOT_STATE}"
  [[ "${expected_root}" == "${actual_root}" ]] || return 1

  for comparison in metadata content; do
    directions=(forward)
    case "${comparison}" in
      metadata)
        rsync_options=(-aHn --modify-window=-1 --numeric-ids)
        directions+=(reverse)
        ;;
      content)
        rsync_options=(-rlHnc)
        ;;
    esac
    for direction in "${directions[@]}"; do
      comparison_source="${expected}"
      comparison_target="${actual}"
      if [[ "${direction}" == reverse ]]; then
        comparison_source="${actual}"
        comparison_target="${expected}"
      fi
      remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
      (( remaining > 0 )) || return 2
      : > "${difference}" || return 3
      statuses=()
      diagnostic_status=0
      set +e
      LC_ALL=C bounded_stderr_run "${capture}" "${fifo}" \
          "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
          timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
            "${remaining}" rsync "${rsync_options[@]}" --delete \
              --itemize-changes --out-format=x -- \
              "${comparison_source}/" "${comparison_target}/" \
        | head -c 1 > "${difference}"
      statuses=("${PIPESTATUS[@]}")
      set -e
      (( ${#statuses[@]} == 2 )) || return 3
      rsync_status="${statuses[0]}"
      head_status="${statuses[1]}"
      bounded_stderr_emit "${capture}" \
        "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
      case "${diagnostic_status}" in
        0) ;;
        2) return 4 ;;
        *) return 3 ;;
      esac
      rm -f -- "${capture}" || return 3
      (( head_status == 0 )) || return 3
      case "${rsync_status}" in
        0) ;;
        124|137) return 2 ;;
        141)
          [[ -s "${difference}" ]] && return 1
          return 3
          ;;
        *) return 3 ;;
      esac
      [[ ! -s "${difference}" ]] || return 1
    done
  done
}

transfer_publication_manifest_write() {
  local -r directory="${1}" phase="${2}" entry="${3}" recovery="${4}"
  local -r operation_deadline="${5:-${transfer_deadline}}"
  local -r manifest="${directory}/publication" \
    temporary="${directory}/publication.tmp"
  local remaining=$(( operation_deadline - BASH_MONOSECONDS )) status=0

  (( remaining > 0 )) || return 2
  # shellcheck disable=SC2016  # child script receives values as positional args
  timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
    "${remaining}" bash -c '
      set -euo pipefail
      temporary=$1
      manifest=$2
      directory=$3
      shift 3
      rm -f -- "${temporary}"
      ( set -o noclobber
        umask 077
        printf "%s\0" "$@" > "${temporary}"
      )
      chmod 0600 -- "${temporary}"
      sync -f -- "${temporary}"
      mv -T -- "${temporary}" "${manifest}"
      sync -f -- "${directory}"
    ' _ "${temporary}" "${manifest}" "${directory}" \
      'version=1' "phase=${phase}" "target=${target}" \
      "entry=${entry}" "candidate_identity=${candidate_identity}" \
      "previous_type=${target_original_type}" \
      "previous_identity=${target_original_identity}" \
      "recovery=${recovery}" || status=$?
  case "${status}" in
    0) return 0 ;;
    124|137) return 2 ;;
    *) return 1 ;;
  esac
}

transfer_retain_previous_target() {
  local retained_identity
  local -r candidate_parent="${candidate%/*}"

  transfer_deadline_capture TRANSFER_RECOVERY_DIRECTORY mktemp -d \
    --tmpdir="${target_parent}" '.virtdev-transfer-recovery.XXXXXXXX' \
    || return 1
  transfer_deadline_run chmod 0700 -- "${TRANSFER_RECOVERY_DIRECTORY}" \
    && transfer_deadline_run sync -f -- "${target_parent}" || return 1
  TRANSFER_RECOVERY_ENTRY="${TRANSFER_RECOVERY_DIRECTORY}/previous"
  transfer_publication_manifest_write "${TRANSFER_RECOVERY_DIRECTORY}" \
    retaining "${TRANSFER_RECOVERY_ENTRY}" "${TRANSFER_RECOVERY_DIRECTORY}" \
    || return 1
  transfer_deadline_run mv -T -- "${candidate}" "${TRANSFER_RECOVERY_ENTRY}" \
    || return 1
  transfer_deadline_run sync -f -- "${TRANSFER_RECOVERY_DIRECTORY}" \
    && transfer_deadline_run sync -f -- "${candidate_parent}" || return 1
  transfer_deadline_capture retained_identity stat -c '%d:%i' -- \
    "${TRANSFER_RECOVERY_ENTRY}" 2>/dev/null || return 1
  [[ "${retained_identity}" == "${target_original_identity}" ]] || return 1
  transfer_publication_manifest_write "${TRANSFER_RECOVERY_DIRECTORY}" \
    retained "${TRANSFER_RECOVERY_ENTRY}" "${TRANSFER_RECOVERY_DIRECTORY}" \
    && transfer_deadline_run sync -f -- "${target_parent}"
}

printf >&2 'Capturing a bounded download from %s...\n' "${project}"
archive="${transfer_transaction}/capture.tar"
request="${transfer_transaction}/request"
capture_stderr="${transfer_transaction}/capture.stderr"
capture_stderr_fifo="${transfer_transaction}/capture.stderr.fifo"
printf '%s\0' "${remote_request_path}" > "${request}"

transaction_remaining=''
transfer_transaction_remaining_checked transaction_remaining \
  'archive capture preflight'
(( transaction_remaining > transfer_stage_overhead )) \
  || error 11 <<<'Transfer transaction has no bounded archive allowance'
transaction_archive_limit=$(( transaction_remaining - transfer_stage_overhead ))
available_bytes=''
transfer_df_value available_bytes avail "${transfer_transaction}" \
  'archive capture preflight'
if (( available_bytes <= transfer_free_space_reserve + 10240 )); then
  error 11 <<<'Not enough host free space to preserve the transfer reserve'
fi
effective_archive_limit=$(( available_bytes - transfer_free_space_reserve ))
(( effective_archive_limit <= transfer_archive_limit )) \
  || effective_archive_limit="${transfer_archive_limit}"
(( effective_archive_limit <= transaction_archive_limit )) \
  || effective_archive_limit="${transaction_archive_limit}"

remote_tar=$'set -euo pipefail\nIFS= read -r -d "" path || exit 64\ntrailing=0\nif [[ "${path}" != / && "${path}" == */ ]]; then\n  trailing=1\n  while [[ "${path}" != / && "${path}" == */ ]]; do path="${path%/}"; done\nfi\n[[ "${path}" != / ]] || exit 65\nbase="${path##*/}"\nparent="${path%/*}"\n[[ -n "${parent}" ]] || parent=/\n[[ -n "${base}" && "${base}" != . && "${base}" != .. ]] || exit 65\ncd -- "${parent}" || exit 66\n[[ -e "${base}" || -L "${base}" ]] || exit 67\nif (( trailing )) && { [[ ! -d "${base}" ]] || [[ -L "${base}" ]]; }; then exit 68; fi\nif [[ ! -d "${base}" && ! -f "${base}" && ! -L "${base}" ]]; then exit 69; fi\nprintf "%s\\0" "${base}" | /usr/bin/tar --create --file=- --one-file-system --null --verbatim-files-from --files-from=- --transform="flags=rh;s,^[^/]*,payload/item,"'

remaining=''
transfer_remaining remaining
set +e
# shellcheck disable=SC2154  # helper directory provided by import
LC_ALL=C bounded_stderr_run "${capture_stderr}" "${capture_stderr_fifo}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
    timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
      "${remaining}" "${virtdev_bin_directory}/virtdev-ssh" \
      "${project}" -- bash -c "${remote_tar}" \
    < "${request}" \
  | head -c "$(( effective_archive_limit + 1 ))" > "${archive}"
capture_status=("${PIPESTATUS[@]}")
set -e

diagnostic_status=0
bounded_stderr_emit "${capture_stderr}" \
  "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
case "${diagnostic_status}" in
  0) ;;
  2) error 11 <<<'Guest download diagnostics exceeded their output budget' ;;
  *) error 13 <<<'Could not capture bounded guest download diagnostics' ;;
esac
archive_size="$(stat -c '%s' -- "${archive}" 2>/dev/null)" \
  || archive_size=''
[[ "${archive_size}" =~ ^[0-9]+$ ]] \
  || error 13 <<<'Could not validate the captured download archive'
if (( archive_size > effective_archive_limit )); then
  error 11 <<<"Download exceeded its ${effective_archive_limit}-byte wire budget"
fi
(( ${#capture_status[@]} == 2 && capture_status[1] == 0 )) \
  || error 13 <<<'Could not store the bounded download archive'
case "${capture_status[0]}" in
  0) ;;
  124|137) error 12 <<<'Guest download capture exceeded the transfer deadline' ;;
  255) error 13 <<<'SSH transport failed during download capture' ;;
  *) error 13 <<<"Guest archive creation failed (exit ${capture_status[0]})" ;;
esac
transfer_transaction_budget_checked 'archive capture'

remaining=''
transfer_remaining remaining
gate_status=0
timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
  "${remaining}" "${archive_gate}" "${archive}" \
  "${VIRTDEV_TRANSFER_MAX_ENTRIES}" "${transfer_member_path_max_bytes}" \
  "${transfer_extension_max_bytes}" || gate_status=$?
case "${gate_status}" in
  0) ;;
  2) error 14 <<<'Guest produced malformed tar metadata' ;;
  3) error 11 <<<'Download archive metadata exceeded its bounded record budget' ;;
  124|137) error 12 <<<'Download archive validation exceeded the transfer deadline' ;;
  *) error 14 <<<'Could not validate guest tar metadata' ;;
esac

archive_paths_summary="${transfer_transaction}/archive-paths"
path_tar_stderr="${transfer_transaction}/path-list.stderr"
path_tar_stderr_fifo="${transfer_transaction}/path-list.stderr.fifo"
remaining=''
transfer_remaining remaining
set +e
# shellcheck disable=SC2016  # awk program is data passed through timeout
LC_ALL=C bounded_stderr_run "${path_tar_stderr}" \
    "${path_tar_stderr_fifo}" "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
    transfer_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      tar --quoting-style=escape --list --file="${archive}" \
  | LC_ALL=C transfer_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      awk -v maximum_entries="${VIRTDEV_TRANSFER_MAX_ENTRIES}" \
        -v maximum_path_bytes="${transfer_member_path_max_bytes}" \
        -v maximum_depth="${transfer_member_depth_max}" '
        function add_component(parent, value, key) {
          key = parent SUBSEP value
          if (!(key in child_id)) {
            nodes++
            if (nodes > maximum_entries + 1) { entries_over = 1; exit }
            child_id[key] = nodes
          }
          return child_id[key]
        }
        {
          members++
          if (members > maximum_entries) { entries_over = 1; exit }
          path = $0
          sub(/\/$/, "", path)
          while (substr(path, 1, 2) == "./") path = substr(path, 3)
          if (path == "" || substr(path, 1, 1) == "/" \
              || (path != "payload/item" \
                  && substr(path, 1, 13) != "payload/item/")) {
            invalid_path = 1
            exit
          }
          if (length(path) > maximum_path_bytes) { path_over = 1; exit }
          if (seen[path]++) { duplicate_path = 1; exit }
          count = split(path, component, "/")
          if (count - 2 > maximum_depth) { path_over = 1; exit }
          parent = 0
          for (i = 1; i <= count; i++) {
            if (component[i] == "" || component[i] == "." \
                || component[i] == "..") {
              invalid_path = 1
              exit
            }
            parent = add_component(parent, component[i])
          }
        }
        END {
          if (entries_over) exit 42
          if (invalid_path || duplicate_path) exit 43
          if (path_over) exit 44
          printf("%d %d\n", members, nodes - 1)
        }
      ' > "${archive_paths_summary}"
path_status=("${PIPESTATUS[@]}")
set -e
transfer_tar_diagnostics_emit "${path_tar_stderr}" 'download path listing'
case "${path_status[1]}" in
  0) ;;
  42) error 11 <<<'Download exceeded its extracted-entry budget' ;;
  43) error 14 <<<'Download archive contains a duplicate or unsafe member path' ;;
  44) error 11 <<<'Download archive path or nesting depth exceeded its limit' ;;
  124|137) error 12 <<<'Download path validation exceeded the transfer deadline' ;;
  *) error 14 <<<'Could not validate download archive paths' ;;
esac
case "${path_status[0]}" in
  0) ;;
  124|137) error 12 <<<'Download path listing exceeded the transfer deadline' ;;
  125) error 14 <<<'Could not supervise host tar during download path listing' ;;
  *) error 14 <<<'Guest produced an invalid download archive' ;;
esac
read -r members_listed extracted_entries extra \
  < "${archive_paths_summary}"
[[ "${members_listed}" =~ ^[0-9]+$ \
    && "${extracted_entries}" =~ ^[0-9]+$ && -z "${extra}" ]] \
  || error 14 <<<'Could not parse download path accounting'

remaining=''
transfer_remaining remaining
archive_summary_file="${transfer_transaction}/archive-summary"
accounting_tar_stderr="${transfer_transaction}/accounting-list.stderr"
accounting_tar_stderr_fifo="${transfer_transaction}/accounting-list.stderr.fifo"
set +e
# shellcheck disable=SC2016  # awk program is data passed through timeout
LC_ALL=C bounded_stderr_run "${accounting_tar_stderr}" \
    "${accounting_tar_stderr_fifo}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
    transfer_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      tar --numeric-owner --quoting-style=escape --list --verbose \
        --file="${archive}" \
  | LC_ALL=C transfer_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      awk -v maximum_entries="${VIRTDEV_TRANSFER_MAX_ENTRIES}" \
        -v maximum_bytes="${VIRTDEV_TRANSFER_MAX_BYTES}" '
        {
          count++
          type = substr($0, 1, 1)
          if (type !~ /^[-dlh]$/) bad_type = 1
          if (count > maximum_entries) { entries_over = 1; exit }
          if (type == "-") {
            size = $3
            if (size !~ /^[0-9]+$/) { bad_size = 1; exit }
            sub(/^0+/, "", size)
            if (size == "") size = "0"
            if (length(size) > length(maximum_bytes) \
                || (length(size) == length(maximum_bytes) \
                    && ("x" size) > ("x" maximum_bytes))) {
              bytes_over = 1
              exit
            }
            logical_bytes += size + 0
            if (logical_bytes > maximum_bytes) { bytes_over = 1; exit }
          }
        }
        END {
          if (entries_over) exit 42
          if (bad_type) exit 43
          if (bytes_over) exit 44
          if (bad_size) exit 45
          printf("%d %.0f\n", count, logical_bytes)
        }
      ' > "${archive_summary_file}"
summary_status=("${PIPESTATUS[@]}")
set -e
transfer_tar_diagnostics_emit "${accounting_tar_stderr}" \
  'download entry accounting'
case "${summary_status[1]}" in
  0) ;;
  42) error 11 <<<'Download exceeded its archive-entry budget' ;;
  43) error 14 <<<'Download archive contains an unsupported special file' ;;
  44) error 11 <<<'Download exceeded its logical-byte budget' ;;
  45) error 14 <<<'Download archive contains an invalid regular-file size' ;;
  124|137) error 12 <<<'Download accounting exceeded the transfer deadline' ;;
  *) error 14 <<<'Could not account for download archive entries' ;;
esac
case "${summary_status[0]}" in
  0) ;;
  124|137) error 12 <<<'Download accounting exceeded the transfer deadline' ;;
  125) error 14 <<<'Could not supervise host tar during download entry accounting' ;;
  *) error 14 <<<'Guest produced an invalid download archive' ;;
esac
read -r entries_captured logical_bytes_captured extra \
  < "${archive_summary_file}"
[[ "${entries_captured}" =~ ^[0-9]+$ \
    && "${logical_bytes_captured}" =~ ^[0-9]+$ && -z "${extra}" ]] \
  || error 14 <<<'Could not parse download archive accounting'
(( entries_captured == members_listed && entries_captured > 0 )) \
  || error 14 <<<'Download archive listings disagreed or were empty'

extraction_ceiling=$(( logical_bytes_captured \
  + extracted_entries * transfer_archive_entry_overhead ))
(( extraction_ceiling <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES )) \
  || error 11 <<<'Download exceeds its allocated-byte ceiling'
transaction_remaining=''
transfer_transaction_remaining_checked transaction_remaining \
  'archive extraction preflight'
(( transaction_remaining > transfer_stage_overhead \
    && extraction_ceiling <= transaction_remaining - transfer_stage_overhead )) \
  || error 11 <<<'Download extraction would exceed the aggregate transaction budget'
available_extract_bytes=''
available_inodes=''
transfer_df_value available_extract_bytes avail "${transfer_transaction}" \
  'archive extraction preflight'
transfer_df_value available_inodes iavail "${transfer_transaction}" \
  'archive extraction inode preflight'
(( available_extract_bytes >= extraction_ceiling + transfer_free_space_reserve )) \
  || error 11 <<<'Not enough host free space to extract the bounded download'
if (( available_inodes < extracted_entries + transfer_inode_reserve )); then
  error 11 <<<'Not enough host inodes to extract the bounded download'
fi

extract_directory="${transfer_transaction}/extract"
mkdir -m 0700 -- "${extract_directory}"
extraction_tar_stderr="${transfer_transaction}/extraction.stderr"
extraction_tar_stderr_fifo="${transfer_transaction}/extraction.stderr.fifo"
remaining=''
transfer_remaining remaining
extract_status=0
LC_ALL=C bounded_stderr_run "${extraction_tar_stderr}" \
    "${extraction_tar_stderr_fifo}" "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
    transfer_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      tar --extract --file="${archive}" --directory="${extract_directory}" \
        --no-same-owner --same-permissions --delay-directory-restore \
    > /dev/null \
  || extract_status=$?
transfer_tar_diagnostics_emit "${extraction_tar_stderr}" 'download extraction'
case "${extract_status}" in
  0) ;;
  124|137) error 12 <<<'Download extraction exceeded the transfer deadline' ;;
  125) error 14 <<<'Could not supervise host tar during download extraction' ;;
  *) error 14 <<<"Download archive extraction failed (exit ${extract_status})" ;;
esac
transfer_transaction_budget_checked 'download extraction'
payload="${extract_directory}/payload"
source_item="${payload}/item"
[[ -d "${payload}" && ! -L "${payload}" \
    && ( -e "${source_item}" || -L "${source_item}" ) ]] \
  || error 14 <<<'Download archive did not produce its exact payload root'
if find "${extract_directory}" -mindepth 1 -maxdepth 1 \
    ! -name payload -print -quit | grep -q .; then
  error 14 <<<'Download archive produced data outside its payload root'
fi

if [[ -L "${source_item}" ]]; then
  error 14 <<<'A downloaded root symlink cannot be confined after publication'
elif [[ -d "${source_item}" ]]; then
  symlink_root="${source_item}"
  resolved_link_file="${transfer_transaction}/resolved-link"
  remaining=''
  transfer_remaining remaining
  set +e
  LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
      find -P "${symlink_root}" -mindepth 1 -type l -print0 \
    | (
      set -euo pipefail
      symlink_count=0
      while IFS= read -r -d '' link_path; do
        (( ++symlink_count <= VIRTDEV_TRANSFER_MAX_ENTRIES )) \
          || error 11 <<<'Downloaded symlink count exceeded its entry budget'
        (( ${#link_path} <= ${#symlink_root} \
            + transfer_member_path_max_bytes + 1 )) \
          || error 11 <<<'Downloaded symlink path exceeded its byte budget'
        remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
        (( remaining > 0 )) \
          || error 12 <<<'Symlink validation exceeded the transfer deadline'
        link_status=0
        link_display=''
        diagnostic_quote link_display "${link_path}"
        timeout --signal=TERM \
          --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" "${remaining}" \
          realpath -m -z -- "${link_path}" > "${resolved_link_file}" \
          || link_status=$?
        case "${link_status}" in
          0) ;;
          124|137) error 12 <<<'Symlink validation exceeded the transfer deadline' ;;
          *) error 14 <<<"Could not resolve downloaded symlink: ${link_display}" ;;
        esac
        mapfile -d '' -t resolved_links < "${resolved_link_file}"
        (( ${#resolved_links[@]} == 1 )) \
          || error 14 <<<"Could not parse downloaded symlink: ${link_display}"
        resolved_link="${resolved_links[0]}"
        if [[ "${resolved_link}" != "${symlink_root}" \
            && "${resolved_link}" != "${symlink_root}/"* ]]; then
          error 14 <<<"Downloaded symlink escapes the transfer root: ${link_display}"
        fi
      done
    )
  symlink_status=("${PIPESTATUS[@]}")
  set -e
  (( ${#symlink_status[@]} == 2 )) \
    || error 14 <<<'Could not supervise downloaded symlink validation'
  case "${symlink_status[1]}" in
    0) ;;
    11|12|14) exit "${symlink_status[1]}" ;;
    *) error 14 <<<'Could not validate downloaded symlinks' ;;
  esac
  case "${symlink_status[0]}" in
    0) ;;
    124|137) error 12 <<<'Symlink enumeration exceeded the transfer deadline' ;;
    *) error 14 <<<'Could not completely enumerate downloaded symlinks' ;;
  esac
fi

extracted_allocated=''
transfer_du_value_checked extracted_allocated "${payload}" extracted
(( extracted_allocated <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES )) \
  || error 11 <<<'Extracted download exceeded its allocated-byte budget'

stable_parent="${transfer_transaction}/stable"
TRANSFER_COPY_ENTRIES=''
TRANSFER_COPY_BYTES=''
transfer_copy_tree "${payload}" "${stable_parent}" 'download stabilization' \
  strip-setid
(( TRANSFER_COPY_ENTRIES == extracted_entries \
    && TRANSFER_COPY_BYTES == logical_bytes_captured )) \
  || error 14 <<<'Download changed between archive validation and stabilization'
stable_payload="${stable_parent}/tree"
stable_item="${stable_payload}/item"
stable_allocated=''
transfer_du_value_checked stable_allocated "${stable_payload}" stable
(( stable_allocated <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES )) \
  || error 11 <<<'Stable download exceeded its allocated-byte budget'

rm -f -- "${archive}"
# shellcheck disable=SC2034  # populated through mount_remove_tree nameref
extract_mount=''
extract_remove_status=0
remaining=$(( transfer_deadline - BASH_MONOSECONDS ))
if (( remaining > 0 )); then
  mount_remove_tree_bounded "${extract_directory}" extract_mount \
    "${remaining}" "${VIRTDEV_TRANSFER_KILL_AFTER}" \
    || extract_remove_status=$?
else
  extract_remove_status=4
fi
case "${extract_remove_status}" in
  0) ;;
  4) error 12 <<<'Extraction-stage retirement exceeded the transfer deadline' ;;
  *) error 11 <<<'Could not safely retire the validated extraction stage' ;;
esac

if [[ -L "${stable_item}" ]]; then
  source_type=symlink
elif [[ -d "${stable_item}" ]]; then
  source_type=directory
elif [[ -f "${stable_item}" ]]; then
  source_type='file'
else
  error 14 <<<'Stable download has an unsupported root type'
fi
if (( remote_trailing )) && [[ "${source_type}" != directory ]]; then
  error 14 <<<'A remote path ending in slash did not resolve to a real directory'
fi

if (( remote_trailing )); then
  target="${dest_absolute}"
elif (( dest_initial_directory )); then
  target="${dest_absolute%/}/${remote_basename}"
else
  target="${dest_absolute}"
fi
[[ "${target}" != / && ! -L "${target}" ]] \
  || error 15 <<<"Unsafe host publication target: ${target}"
target_parent="${target%/*}"
[[ -n "${target_parent}" ]] || target_parent=/
[[ -d "${target_parent}" && ! -L "${target_parent}" ]] \
  || error 15 <<<"Host publication parent changed or is unsafe: ${target_parent}"

lock_acquire_transfer_target "${target}"

transaction_device=''
target_parent_device=''
stat_status=0
transfer_deadline_capture transaction_device stat -c '%d' -- \
  "${transfer_transaction}" || stat_status=$?
case "${stat_status}" in
  0) ;;
  124|137) error 12 <<<'Transfer-stage filesystem inspection exceeded the deadline' ;;
  *) error 15 <<<'Could not inspect transfer-stage filesystem' ;;
esac
stat_status=0
transfer_deadline_capture target_parent_device stat -c '%d' -- \
  "${target_parent}" || stat_status=$?
case "${stat_status}" in
  0) ;;
  124|137) error 12 <<<'Publication filesystem inspection exceeded the deadline' ;;
  *) error 15 <<<'Could not inspect publication filesystem' ;;
esac
[[ "${transaction_device}" == "${target_parent_device}" ]] \
  || error 15 <<<'Atomic download publication cannot cross filesystems'

target_exists=0
[[ -e "${target}" || -L "${target}" ]] && target_exists=1
candidate="${stable_item}"
target_original_type=''
target_original_identity=''
target_original_semantic=''
target_original_entries=''
target_original_bytes=''
target_baseline=''
if (( target_exists )); then
  [[ ! -L "${target}" ]] \
    || error 15 <<<"Refusing to replace a symlink host target: ${target}"
  if [[ -d "${target}" ]]; then
    target_original_type=directory
    [[ "${source_type}" == directory ]] \
      || error 15 <<<"Cannot merge a non-directory download into: ${target}"
    baseline_parent="${transfer_transaction}/baseline"
    transfer_copy_tree "${target}" "${baseline_parent}" \
      'existing destination stabilization' reject-xattrs
    target_original_identity="${TRANSFER_COPY_DEVICE}:${TRANSFER_COPY_INODE}"
    target_original_entries="${TRANSFER_COPY_ENTRIES}"
    target_original_bytes="${TRANSFER_COPY_BYTES}"
    target_baseline="${baseline_parent}/tree"
    clone_parent="${transfer_transaction}/clone"
    transfer_copy_tree "${target_baseline}" "${clone_parent}" \
      'existing destination clone'
    clone_allocated=''
    transfer_du_value_checked clone_allocated "${clone_parent}/tree" clone
    merge_ceiling=$((
      clone_allocated + stable_allocated + transfer_stage_overhead
    ))
    (( merge_ceiling <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES )) \
      || error 11 <<<'Private destination merge would exceed its allocated-byte ceiling'
    transaction_remaining=''
    transfer_transaction_remaining_checked transaction_remaining \
      'destination merge preflight'
    overlay_ceiling=$(( stable_allocated + transfer_stage_overhead ))
    (( overlay_ceiling <= transaction_remaining )) \
      || error 11 <<<'Private destination merge would exceed the aggregate transaction budget'
    remaining=''
    transfer_remaining remaining
    overlay_status=0
    timeout --signal=TERM --kill-after="${VIRTDEV_TRANSFER_KILL_AFTER}" \
      "${remaining}" rsync -aHS --safe-links --delay-updates -- \
      "${stable_item}/" "${clone_parent}/tree/" || overlay_status=$?
    case "${overlay_status}" in
      0) ;;
      124|137) error 12 <<<'Destination merge exceeded the transfer deadline' ;;
      *) error 15 <<<"Could not build a private destination merge (rsync ${overlay_status})" ;;
    esac
    publish_parent="${transfer_transaction}/publish"
    transfer_copy_tree "${clone_parent}/tree" "${publish_parent}" \
      'merged destination validation'
    candidate="${publish_parent}/tree"
  elif [[ "${source_type}" == directory ]]; then
    error 15 <<<"Cannot replace a non-directory host target with a directory: ${target}"
  elif [[ -f "${target}" ]]; then
    target_original_type='file'
    target_state_status=0
    transfer_file_state "${target}" || target_state_status=$?
    case "${target_state_status}" in
      0)
        target_original_identity="${TRANSFER_FILE_IDENTITY}"
        target_original_semantic="${TRANSFER_FILE_SEMANTIC}"
        ;;
      1) error 15 <<<'Existing host file changed or exceeded the validation bound' ;;
      2) error 12 <<<'Existing host file validation exceeded the transfer deadline' ;;
      4) error 11 <<<'Existing host file diagnostics exceeded their output budget' ;;
      5) error 15 <<<'Existing host file has extended attributes or ACLs that cannot be preserved' ;;
      *) error 15 <<<'Could not capture a stable existing host file' ;;
    esac
  else
    error 15 <<<"Host publication target has an unsupported type: ${target}"
  fi
fi

candidate_allocated=''
transfer_du_value_checked candidate_allocated "${candidate}" candidate
(( candidate_allocated <= VIRTDEV_TRANSFER_MAX_ALLOCATED_BYTES )) \
  || error 11 <<<'Publication candidate exceeded its allocated-byte budget'

publish_mode=noreplace
(( target_exists )) && publish_mode=exchange
stat_status=0
transfer_deadline_capture candidate_identity stat -c '%d:%i' -- \
  "${candidate}" 2>/dev/null || stat_status=$?
case "${stat_status}" in
  0) ;;
  124|137) error 12 <<<'Publication candidate inspection exceeded the deadline' ;;
  *) error 15 <<<'Could not bind the publication candidate identity' ;;
esac
[[ "${candidate_identity}" =~ ^[0-9]+:[0-9]+$ ]] \
  || error 15 <<<'Could not parse the publication candidate identity'
manifest_status=0
transfer_publication_manifest_write "${transfer_transaction}" prepared \
  "${candidate}" '' || manifest_status=$?
case "${manifest_status}" in
  0) ;;
  2) error 12 <<<'Publication manifest preparation exceeded the deadline' ;;
  *) error 15 <<<'Could not durably prepare the publication manifest' ;;
esac
transfer_transaction_budget_checked 'publication preparation'
(( ! target_exists )) || transfer_preserve_transaction=1
publish_status=0
transfer_publication_run "${publish_helper}" "${publish_mode}" \
  "${candidate}" "${target}" \
  || publish_status=$?
case "${publish_status}" in
  0) ;;
  1)
    transfer_preserve_transaction=0
    error 15 <<<'Host publication failed before the target was changed'
    ;;
  2)
    transfer_preserve_transaction=1
    transfer_publication_manifest_write "${transfer_transaction}" \
      publication-uncertain "${candidate}" '' || true
    error 16 <<MESSAGE
The completed download reached '${target}', but its post-publication sync failed.
The transaction was preserved for recovery inspection.
MESSAGE
    ;;
  3)
    if (( target_exists )); then
      transfer_publication_manifest_write "${transfer_transaction}" \
        publication-uncertain "${candidate}" '' || true
      error 16 <<MESSAGE
Existing-target publication returned an indeterminate conflict status.
The target and complete transaction were preserved for recovery: ${target}
MESSAGE
    fi
    transfer_preserve_transaction=0
    error 15 <<<"Host publication target appeared during transfer: ${target}"
    ;;
  "${transfer_publication_not_started}")
    transfer_preserve_transaction=0
    error 12 <<MESSAGE
The transfer deadline expired before publication began. The host target was not changed:
${target}
MESSAGE
    ;;
  124|137)
    transfer_preserve_transaction=1
    transfer_publication_manifest_write "${transfer_transaction}" \
      publication-uncertain "${candidate}" '' || true
    error 16 <<MESSAGE
Publication exceeded the transfer deadline and its rename state is unknown.
The target and complete transaction were preserved for recovery: ${target}
MESSAGE
    ;;
  *)
    transfer_preserve_transaction=1
    transfer_publication_manifest_write "${transfer_transaction}" \
      publication-uncertain "${candidate}" '' || true
    error 16 <<MESSAGE
Publication ended with indeterminate status ${publish_status}.
The target and complete transaction were preserved for recovery: ${target}
MESSAGE
    ;;
esac
transfer_publication_manifest_write "${transfer_transaction}" published \
  "${candidate}" '' || {
  transfer_preserve_transaction=1
  error 16 <<MESSAGE
The completed download reached '${target}', but its recovery manifest could not
be updated durably. The target and transaction were preserved for inspection.
MESSAGE
}

if (( target_exists )); then
  validation_status=0
  validation_detail='existing host target changed during publication'
  transaction_status=0
  transfer_transaction_budget 'post-publication validation' \
    || transaction_status=$?
  case "${transaction_status}" in
    0) ;;
    1) validation_status=4 ;;
    2) validation_status=2 ;;
    *) validation_status=3 ;;
  esac
  if (( validation_status == 0 )); then
    case "${target_original_type}" in
      directory)
        displaced_parent="${transfer_transaction}/displaced"
        transfer_copy_tree_for_validation "${candidate}" "${displaced_parent}" \
          reject-xattrs \
          || validation_status=$?
        if (( validation_status == 0 )) \
            && [[ "${TRANSFER_VALIDATION_DEVICE}:${TRANSFER_VALIDATION_INODE}" \
                != "${target_original_identity}" \
              || "${TRANSFER_VALIDATION_ENTRIES}" != "${target_original_entries}" \
              || "${TRANSFER_VALIDATION_BYTES}" != "${target_original_bytes}" ]]; then
          validation_status=1
        fi
        if (( validation_status == 0 )); then
          transfer_trees_equal "${target_baseline}" \
            "${displaced_parent}/tree" || validation_status=$?
        fi
        ;;
      file)
        transfer_file_state "${candidate}" || validation_status=$?
        if (( validation_status == 0 )) \
            && [[ "${TRANSFER_FILE_IDENTITY}" != "${target_original_identity}" \
              || "${TRANSFER_FILE_SEMANTIC}" != "${target_original_semantic}" ]]; then
          validation_status=1
        fi
        ;;
      *) validation_status=3 ;;
    esac
  fi

  if (( validation_status != 0 )); then
    case "${validation_status}" in
      1) validation_detail='existing host target changed during publication' ;;
      2) validation_detail='existing host target validation exceeded the deadline' ;;
      4) validation_detail='existing host target validation exceeded a resource limit' ;;
      5) validation_detail='existing host target gained unsupported extended attributes or ACLs' ;;
      *) validation_detail='existing host target could not be validated after publication' ;;
    esac
    transfer_recovery_begin
    live_candidate_identity=''
    stat_status=0
    transfer_recovery_capture live_candidate_identity stat -c '%d:%i' -- \
      "${target}" 2>/dev/null || stat_status=$?
    (( stat_status == 0 )) || error 16 <<MESSAGE
${validation_detail^}, and the provisional target identity is unknown.
The displaced target and transaction were preserved for recovery.
MESSAGE
    if [[ "${live_candidate_identity}" != "${candidate_identity}" ]]; then
      error 16 <<MESSAGE
${validation_detail^}, and another writer replaced the provisional target.
The displaced target and transaction were preserved for recovery.
MESSAGE
    fi

    transfer_publication_manifest_write "${transfer_transaction}" \
      rollback-pending "${candidate}" '' "${transfer_recovery_deadline}" \
      || true
    rollback_status=0
    transfer_recovery_run "${publish_helper}" exchange \
      "${candidate}" "${target}" \
      || rollback_status=$?
    case "${rollback_status}" in
      0)
        transfer_publication_manifest_write "${transfer_transaction}" \
          rolled-back "${candidate}" '' "${transfer_recovery_deadline}" \
          || error 16 <<MESSAGE
${validation_detail^}. The original target was restored durably, but the
preserved transaction manifest could not be updated durably.
MESSAGE
        rollback_exit=15
        (( validation_status != 2 )) || rollback_exit=12
        (( validation_status != 4 )) || rollback_exit=11
        error "${rollback_exit}" <<MESSAGE
${validation_detail^}. The original target was restored durably.
The rejected download transaction was preserved for inspection.
MESSAGE
        ;;
      *)
        error 16 <<MESSAGE
${validation_detail^}, and its rollback could not be proven durable.
The complete transaction was preserved for recovery.
MESSAGE
        ;;
    esac
  fi
  transfer_publication_manifest_write "${transfer_transaction}" validated \
    "${candidate}" '' || error 16 <<MESSAGE
The previous target was validated, but the recovery manifest could not be
updated durably. The target and transaction were preserved for inspection.
MESSAGE
  TRANSFER_RECOVERY_DIRECTORY=''
  TRANSFER_RECOVERY_ENTRY=''
  if ! transfer_retain_previous_target; then
    if [[ -n "${TRANSFER_RECOVERY_DIRECTORY}" ]]; then
      transfer_publication_manifest_write "${transfer_transaction}" \
        retention-uncertain "${candidate}" \
        "${TRANSFER_RECOVERY_DIRECTORY}" || true
    fi
    error 16 <<MESSAGE
The new target was validated, but the displaced target could not be retained
durably. Inspect the transaction and recovery sibling before any cleanup:
${transfer_transaction}
${TRANSFER_RECOVERY_DIRECTORY:-recovery sibling was not created}
MESSAGE
  fi
  transfer_publication_manifest_write "${transfer_transaction}" retained \
    "${TRANSFER_RECOVERY_ENTRY}" "${TRANSFER_RECOVERY_DIRECTORY}" \
    || error 16 <<MESSAGE
The displaced target was retained at '${TRANSFER_RECOVERY_ENTRY}', but the
transaction manifest could not be updated durably. Both locations were kept.
MESSAGE
  transfer_preserve_transaction=0
  printf >&2 'Previous host target retained for recovery: %s\n' \
    "${TRANSFER_RECOVERY_ENTRY}"
fi

printf >&2 'Downloaded %s entries (%s logical bytes) from %s.\n' \
  "${extracted_entries}" "${logical_bytes_captured}" "${project}"
