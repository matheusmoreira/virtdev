#!/usr/bin/env bash
# shellcheck disable=SC2154  # SSH contract constants are imported
#
# virtdev-seal
#
# Promotes installed base system images to sealed, read-only
# backing files from which per-project delta images are derived.
#
# Reads from  ${VIRTDEV_HOME}/installation/
# Writes to   ${VIRTDEV_HOME}/system/
#
# On success, the installation directory is removed.
#
# Run virtdev-install <iso> first to produce the installation directory.
# Run virtdev-create <project> after sealing to create a project VM.
#
# Exit codes:
#
#   3  installation staging directory not found or not a real directory
#   4  sealed-system path already exists
#   5  required installation file missing or not a regular file
#   6  system disk integrity check failed
#   7  home disk integrity check failed
#   8  unexpected installation entries would be stranded
#   9  staging or namespace durability barrier failed
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import enumerate error lock arguments terminal ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

lock_acquire

installation_directory="${VIRTDEV_HOME}/installation"
system_directory="${VIRTDEV_HOME}/system"

if [[ ! -d "${installation_directory}" || -L "${installation_directory}" ]]; then
  error 3 <<<"Installation staging is not a real directory: '${installation_directory}'"
fi

if [[ -e "${system_directory}" || -L "${system_directory}" ]]; then
  error 4 <<MESSAGE
Sealed base system path already present: '${system_directory}'
Inspect or remove it manually before sealing.
MESSAGE
fi

system_disk="${installation_directory}/system.qcow2"
home_disk="${installation_directory}/home.qcow2"
nvram="${installation_directory}/nvram"
guest_contract="${installation_directory}/${ssh_guest_contract_name}"

for f in "${system_disk}" "${home_disk}" "${nvram}" "${guest_contract}"; do
  if [[ ! -f "${f}" || -L "${f}" ]]; then
    error 5 <<<"Installation file not found: '${f}'"
  fi
done

if ! ssh_guest_contract_valid "${installation_directory}"; then
  error 5 <<MESSAGE
Installation lacks the current guest SSH transport contract: '${guest_contract}'
Re-run virtdev-iso and virtdev-install with the current virtdev version.
MESSAGE
fi

# installation/ is the unpublished staging tree. Refuse extras before making
# any changes: renaming the whole directory is the atomic commit, so no file
# can be stranded and system/ can never become partially populated.
declare -a unexpected_entries=()
enumerate_nul_sorted unexpected_entries "${enumerate_max_bytes}" \
  "${enumerate_max_records}" \
  find "${installation_directory}" -mindepth 1 -maxdepth 1 \
    ! -name system.qcow2 ! -name home.qcow2 ! -name nvram \
    ! -name generation ! -name "${ssh_guest_contract_name}" -print0 \
  || error 8 <<<'Could not completely enumerate installation staging; no base was published.'

if (( ${#unexpected_entries[@]} )); then
  unexpected_list=''
  for entry in "${unexpected_entries[@]}"; do
    printf -v quoted_entry '%q' "${entry#"${installation_directory}/"}"
    unexpected_list+="  ${quoted_entry}"$'\n'
  done
  error 8 <<MESSAGE
Installation directory contains unexpected entries: '${installation_directory}'
${unexpected_list}No base was published. Inspect or remove these entries, then retry.
MESSAGE
fi

generation="${installation_directory}/generation"
if [[ ( -e "${generation}" || -L "${generation}" ) \
      && ( ! -f "${generation}" || -L "${generation}" ) ]]; then
  error 5 <<<"Installation generation is not a regular file: '${generation}'"
fi

printf >&2 'Checking image integrity...\n'
if ! qemu-img check -q "${system_disk}"; then
  error 6 <<<"System disk image integrity check failed: '${system_disk}'"
fi
if ! qemu-img check -q "${home_disk}"; then
  error 7 <<<"Home disk image integrity check failed: '${home_disk}'"
fi

printf >&2 'Writing generation counter...\n'
# A failed durability barrier from an earlier attempt can leave this staging
# file mode 0444. It was never authoritative, so recreate it before retrying.
rm -f -- "${generation}"
printf '1\n' > "${generation}"

printf >&2 'Marking base system images read-only...\n'
chmod 444 "${system_disk}" "${home_disk}" "${nvram}" "${generation}" \
  "${guest_contract}"

# Commit the fully prepared sibling tree with one rename. Flush staged bytes
# and metadata before publication and the parent namespace afterward so a
# power loss cannot expose a half-sealed system directory.
if ! sync -f "${installation_directory}"; then
  error 9 <<MESSAGE
Could not durably flush installation staging: '${installation_directory}'
No base was published. The installation tree is preserved for retry.
MESSAGE
fi

printf >&2 "Publishing sealed base system at '%s'...\n" "${system_directory}"
if ! mv -T -- "${installation_directory}" "${system_directory}"; then
  error 9 <<MESSAGE
Could not atomically publish the sealed base at '${system_directory}'.
The installation tree is preserved for inspection or retry.
MESSAGE
fi

if ! sync -f "${VIRTDEV_HOME}"; then
  error 9 <<MESSAGE
The sealed base was published at '${system_directory}', but the namespace
durability barrier failed. Do not start a project until the filesystem is
healthy and the directory has been inspected.
MESSAGE
fi

printf >&2 '%s\n' "$(terminal_write fg=green "Base system sealed: '${system_directory}'" reset)"
printf >&2 'Run virtdev-create <name> to derive a virtual machine.\n'
