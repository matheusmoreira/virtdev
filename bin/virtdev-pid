#!/usr/bin/env bash
#
# virtdev-pid <project>
#
# Prints the QEMU process ID of a running project virtual machine.
# Machine-readable: stdout contains only the PID.
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   5   could not determine PID from systemd
#   64  usage error

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"


project_require "${project}"

unit="virtdev-${project}"

if ! project_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
fi

pid="$(systemctl --user show "${unit}" --property=ExecMainPID --value 2>/dev/null)"

if [[ -z "${pid}" || "${pid}" == "0" ]]; then
  error 5 <<<"Could not determine PID for: ${unit}"
fi

printf '%s\n' "${pid}"
