#!/usr/bin/env bash
# shellcheck disable=SC2154  # virtdev_bin_directory provided by lib/virtdev/import
#
# virtdev-start <project> [port]
#
# Starts a project virtual machine as a transient systemd user service.
# The VM runs in the background, and systemd tracks the process.
#
# Type=simple becomes active before QEMU runs. Start therefore requires a
# successful QMP query-status before publishing the port or reporting success;
# launch failures exit 13 without a stale running signal. Its socat transport
# and jq parser are preflighted with exit 23. Guest boot remains asynchronous.
#
# Lifecycle:
#
#     systemctl --user status virtdev-<project>     # status + recent logs
#     journalctl --user -u virtdev-<project>        # full logs
#     virtdev-stop <project>                        # clean ACPI shutdown
#
# Serial console access (when SSH is unavailable):
#
#     socat - UNIX-CONNECT:${VIRTDEV_HOME}/projects/<project>/console.sock
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments project terminal port passt qemu firewall runtime qmp

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_VM_MEMORY:=4096}"
: "${VIRTDEV_VM_CPUS:=4}"
: "${VIRTDEV_STOP_TIMEOUT:=60}"
: "${OVMF_CODE:="/usr/share/edk2/x64/OVMF_CODE.4m.fd"}"

if [[ ! "${VIRTDEV_VM_MEMORY}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_MEMORY: must be a positive integer"
fi
if [[ ! "${VIRTDEV_VM_CPUS}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_VM_CPUS: must be a positive integer"
fi
if [[ ! "${VIRTDEV_STOP_TIMEOUT}" =~ ^[1-9][0-9]*$ ]]; then
  error 64 <<<"Invalid VIRTDEV_STOP_TIMEOUT: must be a positive integer"
fi

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([zone]=value [unfiltered]=bool)
# shellcheck disable=SC2034
declare -A spec_placeholders=([zone]=zone)
# shellcheck disable=SC2034
declare -a spec_positionals=(project "port?")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

# Require QMP transport and parsing before any launch mutation.
if ! command -v socat &>/dev/null; then
  error 23 <<MESSAGE
socat is required for authoritative QMP launch confirmation.
Install socat and retry: pacman -S socat
MESSAGE
fi
if ! command -v jq &>/dev/null; then
  error 23 <<MESSAGE
jq is required for authoritative QMP launch confirmation.
Install jq and retry: pacman -S jq
MESSAGE
fi

# Network isolation (Phase 2). Resolve the zone, enforce the host egress
# lockdown, and resolve the systemd slice the virtual machine launches into —
# all before taking the lock, so a refused launch never blocks another virtdev
# operation. Zone precedence: an explicit --zone wins; else the project's
# configured default (its host-side `zone` file); else 'none' (start fully
# locked). firewall_zone_default already falls back to 'none' for an
# absent/invalid file. firewall_slice_for routes EVERY launch through the one
# helper so a new path cannot silently skip --slice and escape the baseline.
zone="${flags[zone]:-}"
if [[ -n "${zone}" ]]; then
  firewall_zone_name_valid "${zone}" \
    || error 64 <<<"invalid --zone '${zone}' (lowercase letters/digits/_, no dashes or dots)"
else
  zone="$(firewall_zone_default "${project}")"
fi

unfiltered=0
if [[ -n "${flags[unfiltered]:-}" && "${flags[unfiltered]}" != "0" ]]; then
  unfiltered=1
fi
if (( unfiltered )); then
  firewall_require --unfiltered
else
  firewall_require
  # Realized-zone guard: the resolved zone (explicit --zone or the project
  # default) must be a built-in or a custom zone present in the loaded ruleset's
  # manifest. A charset-valid but unapplied name (a typo, or a zone-definition
  # file not yet applied) fails HERE with guidance, instead of launching into an
  # empty slice that silently locks. (firewall/zones absent -> built-ins only.)
  firewall_zone_valid "${zone}" || error 22 <<MESSAGE
zone '${zone}' is not active in the host firewall (unknown, or defined but not applied).
Active zones: $(firewall_zones_active | paste -sd' ')
If you just created or edited a custom zone, apply it: sudo virtdev firewall apply
MESSAGE
fi
slice="$(firewall_slice_for "${zone}")"

# `filtered` is the inverse of --unfiltered and keys every firewall decision in this
# script (launch guard, realized-zone guard, host-map, post-launch assert), so they
# move together (design-S4 D3). The host-map decision (open_host_map) reads the
# firewall manifest, so it is resolved later UNDER the lock — see below.
filtered=$(( ! unfiltered ))

# Held until after systemd confirms the transient unit is active, so
# any other virtdev script that arrives during the critical section
# waits for either (a) this start to complete and the unit to be
# visible via 'systemctl is-active', or (b) this start to fail cleanly.
lock_acquire

# Resolve the host-map decision UNDER the lock. open_host_map says whether passt opens
# the guest->host loopback map; it reads the firewall manifest, which a concurrent
# `virtdev firewall apply` reload rewrites. apply holds THIS SAME lock across its
# scan->reload->manifest-write, so reading the manifest here cannot race a last-hole-
# removing apply: either this launch wins the lock and apply's later scan sees this
# machine's open map via its ExecStart marker and refuses (exit 100), or apply wins
# and this reads the already-updated manifest. Gated on filtered: an unfiltered launch
# never opens the map (the per-port nft narrowing is the map's sole confinement, and
# --unfiltered switches it off), which also keeps the exit-100 guard exact — no
# --allow-host-loopback in the ExecStart, so apply reads the map closed.
open_host_map=0
if (( filtered )) && firewall_zone_needs_hostmap "${zone}"; then
  open_host_map=1
fi

project_directory="${VIRTDEV_HOME}"/projects/"${project}"

if [[ ! -d "${project_directory}" ]]; then
  error 3 <<MESSAGE
Project not found: '${project_directory}'
Create project virtual machine first: virtdev-create '${project}'
MESSAGE
fi

# Harden the per-project directory so that socket files (monitor, console,
# passt) are not reachable by other local users. Pre-existing directories
# (created before this hardening) are updated on every start.
chmod 0700 "${project_directory}"

for file in system.qcow2 home.qcow2 nvram; do
  if [[ ! -f "${project_directory}/${file}" ]]; then
    error 4 <<<"Project file missing: '${project_directory}/${file}'"
  fi
done

if [[ ! -f "${OVMF_CODE}" ]]; then
  error 5 <<<"Firmware not found: '${OVMF_CODE}'"
fi

# Detached projects have standalone images with no backing file
# dependency. The generation check does not apply to them.
if ! project_is_detached "${project}"; then

# Detect base system changes since this project was created.
# After virtdev-maintain reseals the base, existing delta images
# are silently composed against the new base content by QEMU,
# which may produce filesystem corruption.
# Both generation files must exist — otherwise there is no way to
# guarantee the delta is safe against the current base.
system_directory="${VIRTDEV_HOME}"/system
system_generation_file="${system_directory}/generation"
project_generation_file="${project_directory}/generation"

if [[ ! -f "${system_generation_file}" ]]; then
  error 9 <<MESSAGE
Base system generation file missing: '${system_generation_file}'
Reinstall the base system: virtdev-install + virtdev-seal
MESSAGE
fi

if [[ ! -f "${project_generation_file}" ]]; then
  error 10 <<MESSAGE
Project generation file missing: '${project_generation_file}'
Recreate this project on top of the current base:

    virtdev-destroy ${project} && virtdev-create ${project}
MESSAGE
fi

system_generation="$(generation_read_base "${system_generation_file}")"
project_generation="$(generation_read_project "${project_generation_file}")"

if [[ "${system_generation}" != "${project_generation}" ]]; then
  error 11 <<MESSAGE
Base system has changed since this project was created.

	System generation:  ${system_generation}
	Project generation: ${project_generation}

Starting this project may cause filesystem corruption.
Transfer data and recreate it on top of the new base system:

    virtdev-destroy ${project} && virtdev-create ${project}
MESSAGE
fi

fi # ! project_is_detached

unit=virtdev-"${project}"

if systemctl --user --quiet is-active "${unit}" 2>/dev/null; then
  error 6 <<<"Project virtual machine is already running: ${project}"
fi

# Resolve SSH port
port_file="${project_directory}"/port

explicit_port=0
if [[ $# -eq 2 ]]; then
  # Explicit port from command line.
  # Require the same canonical representation that is persisted and consumed;
  # accepting a leading-zero spelling here would make Bash printf/arithmetic,
  # passt, and later readers disagree about the endpoint.
  explicit_port=1
  port="${2}"
  if ! port_is_valid "${port}"; then
    error 7 <<<"Invalid port: '${port}' (must be canonical decimal 1024-65535, without leading zeros)"
  fi
  if port_in_use "${port}"; then
    error 8 <<<"Port ${port} is already in use on this host"
  fi
else
  # Auto-assign: lowest available port starting from 2222
  port=2222
  while port_in_use "${port}"; do
    (( port++ ))
    if (( port > 65535 )); then
      error 15 <<<"No available port found in range 2222-65535"
    fi
  done
fi

# The disk/nvram paths are derived inside qemu_command from
# project_directory; the socket set (cleanup trap, stale-socket sweep) is
# owned by lib/virtdev/runtime. passt_sock (netexec --socket) and qmp_sock
# (the post-launch liveness probe) are spelled out here from the same
# runtime source, so they cannot drift from the qemu_command / cleanup set.
passt_sock="$(runtime_passt_sock "${project_directory}")"
qmp_sock="$(runtime_qmp_sock "${project_directory}")"
launch_phase_file="$(runtime_launch_phase_file "${project_directory}")"

# Cleanup-on-failure: every error path between here and the wait-loop
# success marker either proves the submitted unit terminal before removing its
# controls, or preserves those controls for recovery when state is unknown.
# The presence of port_file is virtdev's signal that a VM is running
# (consulted by virtdev-ssh, virtdev-list, virtdev-backup, etc.); a
# leftover port_file after an aborted start would lure later commands
# into trusting a unit that does not exist. The trap fires on any
# exit (set -e error, signal, or explicit error N) before vm_started=1 is
# set. Once submission is attempted, cleanup requests a stop and waits for a
# provable inactive/failed state before unlinking anything. The active-unit
# teardown paths are the
# QMP liveness gate (error 13) and the firewall assert (error 21) — both
# leave the unit active. A crash before active (error 12, unit
# failed/inactive) and a slow boot still activating past the 5s classify
# deadline (error 16) are handled by the same terminal-proof primitive. On
# these early failures port_file has not been written yet (it is published
# only after the liveness + firewall checks), so a confirmed runtime cleanup's
# rm -f is a no-op for it.
vm_started=0
unit_submission_attempted=0
cleanup_failed_start() {
  (( vm_started )) && return 0
  if (( unit_submission_attempted )); then
    if ! qemu_stop_unit_then_clean_runtime \
        "${unit}" "${project_directory}" "${VIRTDEV_STOP_TIMEOUT}"; then
      printf >&2 '%s\n' "$(terminal_write fg=yellow \
        'warning: failed start could not prove the submitted VM terminal; runtime controls were preserved.' reset)"
      printf >&2 'Unit: %s (last state: %s)\n' \
        "${unit}" "${VIRTDEV_QEMU_STOP_STATE}"
      printf >&2 'Inspect/stop the unit before removing files under: %s\n' \
        "${project_directory}"
    fi
  else
    # Submission never began, so no process can own these pre-launch paths.
    runtime_clean "${project_directory}"
  fi
}
trap cleanup_failed_start EXIT

# Remove stale sockets AND a stale port from a previous unclean shutdown
# (runtime_clean — the full sweep). The is-active check above already proved
# the unit is not running, so any port file here is genuinely stale (a prior
# start SIGKILLed before its own cleanup, or a deferred-cleanup poweroff).
# Clearing it now is what keeps "port file ⟺ machine confirmed running"
# honest: the port is (re)written LAST, only after the liveness + firewall
# checks, so leaving a stale port in place would let a lock-free reader
# (virtdev-ssh/-port/-backup) read the WRONG port during this launch window.
# With it cleared, that window shows an honest "no port yet" (exit 87 =
# not-running-yet) until the confirmed write. (A sockets-only sweep was
# correct only while the port was written BEFORE this point; it no longer
# is.) cleanup_failed_start below repeats the full sweep on any failure.
runtime_clean "${project_directory}"

# Clear any residual failed state from a previous start attempt. Without
# --collect (see below), a unit that exited with error persists as
# 'failed' in systemd's state until explicitly reset, which would make
# the name-in-use collision below block retries.
systemctl --user reset-failed "${unit}" 2>/dev/null || true

if [[ "$(loginctl show-user "${USER}" --property=Linger --value 2>/dev/null)" != "yes" ]]; then
  printf >&2 '%s\n' "$(terminal_write fg=yellow "warning: lingering is not enabled for user ${USER}" reset)"
  printf >&2 'The virtual machine will be killed when your last login session ends.\n'
  printf >&2 'Enable lingering to keep virtual machines alive across sessions:\n'
  printf >&2 '    sudo loginctl enable-linger %s\n' "${USER}"
fi

printf >&2 "Starting project virtual machine %s on SSH port %d...\n" "${project}" "${port}"

# The QEMU argv (everything after the netexec `--` boundary) is owned by
# lib/virtdev/qemu so it cannot drift from virtdev-maintain's copy — it is
# the network-isolation security boundary. start's disks and sockets share
# the per-project directory, so disk_dir and sock_dir are identical here.
declare -a qemu_argv=()
qemu_command qemu_argv \
    "${project_directory}" "${project_directory}" "${project}" \
    "${VIRTDEV_VM_MEMORY}" "${VIRTDEV_VM_CPUS}" "${OVMF_CODE}"

# --collect intentionally omitted: it sets CollectMode=inactive-or-failed,
# which would let systemd garbage-collect a failed unit before anything
# can query ExecMainStatus or similar post-mortem properties. virtdev-stop
# reads those properties after the VM exits; leaving --collect off keeps
# the unit loaded until reset-failed or the next virtdev-start clears it.
# Open passt's guest->host loopback map iff this is a FILTERED launch into a
# host-hole zone (open_host_map, resolved once above). The per-port restriction is
# enforced by the nft rules, not passt, whose host map is all-or-nothing — so the
# map is opened only when nft is actually enforcing it.
declare -a netexec_opts=(
  --socket "${passt_sock}"
  --phase-file "${launch_phase_file}"
  --forward "${port}"
)
if (( open_host_map )); then
  netexec_opts+=(--allow-host-loopback)
fi

unit_submission_attempted=1
systemd-run \
    --user \
    --unit="${unit}" \
    --slice="${slice}" \
    --description="virtdev project virtual machine: ${project}" \
    --property="ExecStop=${virtdev_bin_directory}/virtdev-stop --acpi-only ${project}" \
    --property="TimeoutStopSec=${VIRTDEV_STOP_TIMEOUT}" \
    -- \
    "${virtdev_bin_directory}/virtdev-netexec" \
        "${netexec_opts[@]}" \
        -- \
        "${qemu_argv[@]}"

# Wait for systemd to confirm the transient unit is active before the
# lock is released (via script exit). systemd-run returns when the
# unit is queued; ActiveState transitions activating → active once
# systemd has started tracking it. Without this wait, another virtdev
# script could take the lock between systemd-run returning and
# systemd seeing the unit, and its 'is-active' check would falsely
# conclude the VM is not running.
#
# qemu_activation_classify (lib/virtdev/qemu) runs the poll and returns
# a discriminant; the case below maps it to start's own exit codes and
# messages. The outcomes we distinguish, so the user gets a targeted
# message instead of a generic timeout:
#
#   - qemu_active:           normal — continue.
#   - 83/84/85/86:           passt-shim failures, accepted only with the
#                            host-owned `shim` launch-phase marker. The same
#                            numeric QEMU exits carry `qemu` and classify as a
#                            generic crash.
#                            passt now binds the forward port (not QEMU),
#                            so exit code 85 is the authoritative bind-race
#                            signal — the legacy post-hoc port re-probe is
#                            gone.
#   - qemu_crashed:          failed/inactive with a non-passt status
#                            (bad firmware path, bad qcow2 header, KVM
#                            init failure, …) — fail fast with the captured
#                            exit status so the user is not told "unit did
#                            not become active" when it entered and left in
#                            the same second.
#   - qemu_still_activating: deadline passed before systemd state and the
#                            authenticated QEMU phase were both ready.
qemu_activation_classify \
  "${unit}" 5 "${launch_phase_file}" && classify=0 || classify=$?
state="${VIRTDEV_QEMU_ACTIVE_STATE}"
exit_status="${VIRTDEV_QEMU_EXIT_STATUS}"
launch_phase="${VIRTDEV_QEMU_LAUNCH_PHASE}"
case "${classify}" in
  "${qemu_active}")
    : # Unit is active; fall through.
    ;;
  "${passt_port_race_exit_code}")
    if (( explicit_port )); then
      error 17 <<MESSAGE
Port ${port} is bound by another process: ${unit} exit status ${exit_status}.
Between virtdev-start's pre-flight port check and passt's bind() call,
a non-virtdev process took the port. The explicit port cannot be
retried until that process releases it.
Retry with a different port, or omit the port arg to auto-assign:
    virtdev-start ${project} <other-port>
    virtdev-start ${project}
MESSAGE
    else
      error 17 <<MESSAGE
Port ${port} is bound by another process: ${unit} exit status ${exit_status}.
Auto-assignment selected this port, but a non-virtdev process took
it between the port check and passt's bind() call. Retry —
auto-assignment will pick the next free port:
    virtdev-start ${project}
MESSAGE
    fi
    ;;
  "${passt_missing_exit_code}")
    error 18 <<MESSAGE
passt is not installed: ${unit} exit status ${exit_status}.
Install passt and retry: pacman -S passt
    virtdev-start ${project}
MESSAGE
    ;;
  "${passt_init_failure_exit_code}")
    error 19 <<MESSAGE
passt failed to initialise: ${unit} exit status ${exit_status}.
The socket did not come up before QEMU was launched. Investigate:
    systemctl --user status ${unit}
    journalctl --user -u ${unit}
MESSAGE
    ;;
  "${passt_qemu_missing_exit_code}")
    error 20 <<MESSAGE
QEMU command not found: ${unit} exit status ${exit_status}.
The netexec shim pre-flighted the QEMU binary and could not find it,
so passt was never started. Install QEMU and retry:
    pacman -S qemu-base
    virtdev-start ${project}
MESSAGE
    ;;
  "${qemu_crashed}")
    error 12 <<MESSAGE
Unit exited before becoming active: ${unit}
ActiveState: ${state}
Launch phase: ${launch_phase}
Main-process exit status: ${exit_status}
The netexec shim or QEMU failed during launch. Investigate:
    systemctl --user status ${unit}
    journalctl --user -u ${unit}
MESSAGE
    ;;
  "${qemu_still_activating}")
    error 16 <<MESSAGE
Unit/QEMU launch did not become ready within 5s: ${unit}
ActiveState: ${state:-unknown}
Launch phase: ${launch_phase}
systemd-run reported success, but QEMU ownership was not confirmed.
Investigate: systemctl --user status ${unit}
MESSAGE
    ;;
  *)
    # Defensive: qemu_activation_classify returns a fixed discriminant set, so this is
    # unreachable today — but without a catch-all an unrecognised value would fall
    # through the case and reach vm_started=1, marking a non-active unit as started.
    error 14 <<MESSAGE
Unexpected activation result '${classify}' for ${unit} (ActiveState: ${state:-unknown}).
This is a bug: qemu_activation_classify returned an unrecognised discriminant.
Investigate: systemctl --user status ${unit}
MESSAGE
    ;;
esac

# The unit is 'active', but that only means systemd saw the netexec shim
# fork — the transient unit is Type=simple (systemd-run omits Type=), so it
# flips to active the instant the shim is exec'd, BEFORE passt binds or QEMU
# runs. A passt failure or a QEMU boot-crash that lands after that fork would
# otherwise slip through here as a false green: success printed, exit 0, and a
# stale port file left behind. (The filtered path's ControlGroup assert below
# incidentally catches most of it, but --unfiltered skips that — where the
# false green was deterministic.) Positively confirm QEMU is actually running
# by probing its QMP control socket with query-status before publishing
# anything. This is NOT an SSH/boot wait — query-status answers sub-second on a
# live QEMU; start stays ASYNC. On failure vm_started is still 0, so
# cleanup_failed_start stops the unit and runtime_cleans (sockets + the
# not-yet-written port).
#
if ! qmp_query_running "${qmp_sock}" 5 "${unit}"; then
  error 13 <<MESSAGE
QEMU did not reach a running state: ${unit} (passt or QEMU failed at launch).
The transient unit went active when the netexec shim forked, but QEMU never
answered QMP query-status — passt failed to bring up the socket, or QEMU
crashed at boot (bad firmware/qcow2, KVM failure) right after the fork.
Investigate:
    systemctl --user status ${unit}
    journalctl --user -u ${unit}
MESSAGE
fi

# Close the firewall TOCTOU: the guard ran before the lock + systemd-run, so a
# user-manager teardown in that window could have churned virtdev.slice's inode,
# leaving this machine UNFILTERED behind the now-stale ruleset. Confirm it
# actually sits under the frozen virtdev.slice; on mismatch error while
# vm_started is still 0 so cleanup_failed_start stops the unit (fail CLOSED).
# --unfiltered opted out of the lockdown entirely, so it skips this.
if (( filtered )); then
  # Single ControlGroup read (no poll, unlike virtdev-maintain's retry): safe because
  # qemu_activation_classify above already polled the unit to `active`, which populates
  # ControlGroup. The poll-first ordering is the precondition — a future refactor that
  # moved this assert before the activation poll could see an empty ControlGroup and
  # fail CLOSED (a spurious exit 21).
  control_group="$(systemctl --user show "${unit}" -p ControlGroup --value 2>/dev/null || true)"
  if ! firewall_assert_unit_filtered "${control_group}"; then
    error 21 <<MESSAGE
host egress lockdown baseline changed during launch: ${project} is not filtered.
virtdev.slice's cgroup inode churned between the pre-launch guard and unit
activation (a user-manager restart?). The machine is being stopped to avoid
running unfiltered. Re-apply the firewall and retry:
    sudo virtdev firewall apply
    virtdev-start ${project}
MESSAGE
  fi
fi

# Publish the running signal LAST — only now that liveness is confirmed
# (QMP query-status) and, for a filtered launch, the machine is proven to
# sit under the frozen virtdev.slice. The port file is what virtdev-ssh,
# virtdev-list and virtdev-backup trust as "this machine is running"; writing
# it before these checks is exactly the false-green that let a failed launch
# strand a stale port. cleanup_failed_start's rm -f "${port_file}" stays
# correct — on an early failure the file simply does not exist yet.
printf '%s\n' "${port}" > "${port_file}"

vm_started=1

printf >&2 '%s\n' "$(terminal_write fg=green 'Virtual machine started.' reset)"
printf >&2 'SSH will be available after boot at: 127.0.0.1:%d\n' "${port}"
printf >&2 'Shut down cleanly with: virtdev-stop %s\n' "${project}"
