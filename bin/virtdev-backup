#!/usr/bin/env bash
# shellcheck disable=SC2154  # constants and helper paths provided by imports
#
# virtdev-backup [--verbose] <project>
# virtdev-backup --list <project>
# virtdev-backup --latest <project>
#
# Snapshots user-curated guest-side paths from a running project
# virtual machine into a timestamped host-side directory.
# Snapshots land at:
#
#   ${VIRTDEV_HOME}/backups/<project>/<YYYY-MM-DD>/<HH-MM-SS>/
#
# Each snapshot contains:
#
#   project       source project name, used to reject cross-project restore
#   manifest      frozen copy of the selected manifest
#   generation    base generation at capture time
#   tree/         extracted user-content subtree
#
# The manifest is user-curated and required. Lookup order:
#
#   1. ${VIRTDEV_HOME}/projects/<project>/manifest
#   2. ${XDG_CONFIG_HOME:-~/.config}/virtdev/projects/<project>/manifest
#
# First existing file wins. Put your stable manifest in the config
# location (dotfile-friendly, survives virtdev-nuke) and use the
# project-local location for one-off experiments that should be
# discarded with the VM.
#
# Format: one path per line; blank lines and lines starting with
# '#' are ignored. Paths are lexical roots under the guest's /home/dev/;
# absolute paths and '..' components are rejected. Trailing slashes are
# accepted but normalized so a symlink root is never dereferenced.
#
# The loaded manifest path is echoed to stderr on each run.
# Create mode reserves stdout for the final absolute snapshot path; transfer
# progress and diagnostics go to stderr so orchestrators can pin that path.
#
# Flags:
#
#   --verbose      Show archive member names.
#   --list         Print snapshots for the project. Does not create
#                  a snapshot; does not require the VM to be running.
#   --latest       Print the latest snapshot identifier
#                  (YYYY-MM-DD/HH-MM-SS) to stdout. Machine-readable.
#                  Prints nothing if no snapshots exist.
#
# The project's virtual machine must be running (SSH over the
# host-forwarded port). Concurrent same-project backups at the same
# second are prevented by mkdir EEXIST on the partial directory.
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME                Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY             Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_BACKUP_MAX_BYTES    Default: 8589934592 (8 GiB archive and data)
#   VIRTDEV_BACKUP_MAX_ENTRIES  Default: 200000 extracted paths
#   VIRTDEV_BACKUP_TIMEOUT      Default: 3600 seconds total
#   VIRTDEV_BACKUP_KILL_AFTER   Default: 5 seconds from TERM to KILL
#   XDG_CONFIG_HOME             Default: ~/.config
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   6   host tar not found
#   7   reserved (legacy rsync partial transfer)
#   8   manifest not found
#   9   manifest has no paths
#   10  partial snapshot directory already exists
#   11  no files captured (all manifest paths absent on guest)
#   12  base generation file missing
#   13  a snapshot with this timestamp already exists
#   15  manifest path escapes the guest home
#   16  manifest has malformed path entries
#   17  SSH transport failure
#   18  archive processing or snapshot publication failure
#   19  byte, entry, inode, or free-space budget exceeded
#   20  backup wall-clock deadline exceeded
#   64  usage error
#   77  SSH key not found
#   78  SSH key permissions too open
#   81  corrupt port file
#   82  corrupt generation file
#   87  no port assigned (virtual machine not running)
#   103 guest SSH host identity missing or corrupt
#   104 guest SSH transport marker missing or incompatible
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments ssh snapshot manifest terminal port project integer mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
: "${VIRTDEV_BACKUP_MAX_BYTES:=8589934592}"
: "${VIRTDEV_BACKUP_MAX_ENTRIES:=200000}"
: "${VIRTDEV_BACKUP_TIMEOUT:=3600}"
: "${VIRTDEV_BACKUP_KILL_AFTER:=5}"

integer_is_bounded_positive "${VIRTDEV_BACKUP_MAX_BYTES}" 1099511627776 \
  || error 64 <<<'Invalid VIRTDEV_BACKUP_MAX_BYTES: expected 1..1099511627776'
integer_is_bounded_positive "${VIRTDEV_BACKUP_MAX_ENTRIES}" 10000000 \
  || error 64 <<<'Invalid VIRTDEV_BACKUP_MAX_ENTRIES: expected 1..10000000'
integer_is_bounded_positive "${VIRTDEV_BACKUP_TIMEOUT}" 86400 \
  || error 64 <<<'Invalid VIRTDEV_BACKUP_TIMEOUT: expected 1..86400'
integer_is_bounded_positive "${VIRTDEV_BACKUP_KILL_AFTER}" 60 \
  || error 64 <<<'Invalid VIRTDEV_BACKUP_KILL_AFTER: expected 1..60'

umask 077

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([verbose]=bool [list]=bool [latest]=bool)
# shellcheck disable=SC2034
declare -A spec_short=([v]=verbose [l]=list)
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  if (( flags[list] )); then
    error 64 <<<'usage: virtdev-backup -l|--list <project>'
  else
    error 64 <<<'usage: virtdev-backup [-v|--verbose] <project>'
  fi
fi

project="${1}"

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

# Latest mode: print the most recent snapshot ID and exit.
if (( flags[latest] )); then
  latest_snapshot=''
  snapshot_latest_into latest_snapshot "${project}" \
    || error 18 <<<'Could not completely enumerate snapshots.'
  printf '%s' "${latest_snapshot}"
  exit 0
fi

# List mode stops here; it lists past snapshots regardless of VM state.
if (( flags[list] )); then
  backups_project_dir="$(snapshot_directory "${project}")"
  declare -a day_dirs=()
  snapshot_list_days_into day_dirs "${project}" \
    || error 18 <<<'Could not completely enumerate snapshot dates.'

  if (( ${#day_dirs[@]} == 0 )); then
    printf >&2 'No snapshots.\n'
    exit 0
  fi

  printf '%-12s  %-10s %-10s %-8s %s\n' 'DATE' 'TIME' 'AGE' 'SIZE' 'GENERATION'
  printf '%-12s  %-10s %-10s %-8s %s\n' '----' '----' '---' '----' '----------'

  now=$(date -u +%s)

  humanize_age() {
    local -r seconds="${1}"
    if (( seconds < 60 )); then
      printf '%ds ago' "${seconds}"
    elif (( seconds < 3600 )); then
      printf '%dm ago' "$((seconds / 60))"
    elif (( seconds < 86400 )); then
      printf '%dh ago' "$((seconds / 3600))"
    else
      printf '%dd ago' "$((seconds / 86400))"
    fi
  }

  for d in "${day_dirs[@]}"; do
    declare -a time_dirs=()
    snapshot_list_times_into time_dirs "${project}" "${d}" \
      || error 18 <<<'Could not completely enumerate snapshot times.'
    for t in "${time_dirs[@]}"; do
      snapshot="${backups_project_dir}/${d}/${t}"
      size="$(du -sh "${snapshot}" 2>/dev/null | cut -f1 || true)"
      # Display the snapshot's recorded base generation ('-' if absent,
      # '<corrupt>' if unreadable). Shared lenient reader; snapshot
      # generations are always integers in practice.
      generation='-'
      if [[ -s "${snapshot}/generation" ]]; then
        generation="$(generation_read_base_lenient "${snapshot}/generation")"
      fi
      time_colons="${t//-/:}"
      snap_epoch=$(date -u -d "${d} ${time_colons} UTC" +%s 2>/dev/null || echo 0)
      age_seconds=$(( now - snap_epoch ))
      (( age_seconds < 0 )) && age_seconds=0
      age="$(humanize_age "${age_seconds}")"
      printf '%-12s  %-10s %-10s %-8s %s\n' "${d}" "${t}" "${age}" "${size}" "${generation}"
    done
  done
  exit 0
fi

project_require_ordinary "${project}"

# From here on: create mode preconditions (4 and up).

backup_deadline=$(( BASH_MONOSECONDS + VIRTDEV_BACKUP_TIMEOUT ))
readonly backup_free_space_reserve=536870912
readonly backup_inode_reserve=4096
readonly backup_member_path_max_bytes=4095
readonly backup_member_depth_max=128
readonly backup_path_state_max_bytes=67108864
readonly backup_extension_max_bytes=1048576
readonly backup_archive_memory_kib=262144

backup_metadata_directory="$(mktemp -d --tmpdir="${VIRTDEV_HOME}" \
  .backup-metadata.XXXXXXXX)"
manifest_copy="${backup_metadata_directory}/manifest"
manifest_files_from="${backup_metadata_directory}/files-from"

cleanup_backup_metadata() {
  [[ -n "${manifest_copy}" ]] \
    && rm -f -- "${manifest_copy}" "${manifest_copy}.tmp"
  [[ -n "${manifest_files_from}" ]] \
    && rm -f -- "${manifest_files_from}" "${manifest_files_from}.tmp"
  if [[ -n "${backup_metadata_directory}" ]]; then
    rm -f -- "${backup_metadata_directory}"/df-*
    rmdir -- "${backup_metadata_directory}" 2>/dev/null || true
  fi
}
trap cleanup_backup_metadata EXIT

backup_df_value() {
  local -n _backup_df_result="${1}"
  local -r column="${2}" path="${3}" phase="${4}"
  local -r output="${backup_metadata_directory}/df-${column}"
  local remaining value output_size
  local -a lines=()
  local -a command_status=()

  remaining=$(( backup_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) || error 20 <<<"Backup deadline expired before ${phase}"
  set +e
  case "${column}" in
    avail)
      timeout --signal=TERM --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
        "${remaining}" df -B1 --output=avail -- "${path}" \
        2>/dev/null | head -c 4097 > "${output}"
      command_status=("${PIPESTATUS[@]}")
      ;;
    iavail)
      timeout --signal=TERM --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
        "${remaining}" df --output=iavail -- "${path}" \
        2>/dev/null | head -c 4097 > "${output}"
      command_status=("${PIPESTATUS[@]}")
      ;;
    *) error 18 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  set -e
  (( command_status[1] == 0 )) \
    || error 18 <<<"Could not inspect host capacity during ${phase}"
  output_size="$(stat -c '%s' -- "${output}" 2>/dev/null)" || output_size=''
  if [[ ! "${output_size}" =~ ^[0-9]+$ ]] || (( output_size > 4096 )); then
    error 18 <<<"Could not parse host capacity during ${phase}"
  fi
  case "${command_status[0]}" in
    0) ;;
    124|137) error 20 <<<"Backup ${phase} exceeded its wall-clock deadline" ;;
    *) error 18 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  mapfile -t lines < "${output}"
  (( ${#lines[@]} == 2 )) \
    || error 18 <<<"Could not parse host capacity during ${phase}"
  value="${lines[1]//[[:space:]]/}"
  if [[ "${column}" == iavail && "${value}" == - ]]; then
    _backup_df_result=''
  elif [[ "${value}" =~ ^[0-9]+$ && ${#value} -le 18 ]]; then
    _backup_df_result="${value}"
  else
    error 18 <<<"Could not parse host capacity during ${phase}"
  fi
}

backup_memory_limited() {
  (
    ulimit -v "${backup_archive_memory_kib}" || exit 70
    exec "$@"
  )
}

if ! project_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
fi

port=""
port_require port "${project}"

ssh_key_validate "${VIRTDEV_SSH_KEY}"

if ! command -v tar &>/dev/null; then
  error 6 <<MESSAGE
tar not found on the host
Install it with: pacman -S tar
MESSAGE
fi
archive_gate="${virtdev_libexec_directory}/virtdev-archive-gate"
if [[ ! -x "${archive_gate}" ]]; then
  error 18 <<<"virtdev-archive-gate not found: '${archive_gate}'. Run 'make' to compile it."
fi

if ! manifest_path="$(manifest_resolve "${project}")"; then
  error 8 <<MESSAGE
Backup manifest not found. Checked (in order):
	${project_directory}/manifest
	${XDG_CONFIG_HOME}/virtdev/projects/${project}/manifest
Create either; one path per line, relative to /home/dev/.
Blank lines and '#' comments are ignored.
MESSAGE
fi

metadata_available=''
backup_df_value metadata_available avail "${VIRTDEV_HOME}" \
  'manifest preflight'
if (( metadata_available < 2 * manifest_max_bytes + 1048576 )); then
  error 19 <<<'Not enough host free space for bounded backup metadata'
fi

manifest_status=0
manifest_freeze_validate "${manifest_path}" "${manifest_copy}" \
  "${manifest_files_from}" "${backup_deadline}" \
  "${VIRTDEV_BACKUP_KILL_AFTER}" || manifest_status=$?
case "${manifest_status}" in
  0) ;;
  "${manifest_result_empty}")
    error 9 <<<"Backup manifest has no paths: ${manifest_path}"
    ;;
  "${manifest_result_invalid}")
    error 16 <<<"Backup manifest contains an unsafe or malformed path: ${manifest_path}"
    ;;
  "${manifest_result_too_large}")
    error 19 <<MESSAGE
Backup manifest exceeds a metadata limit: ${manifest_path}
Maximums are ${manifest_max_bytes} bytes, ${manifest_max_lines} lines,
${manifest_max_entries} active entries, and ${manifest_max_path_bytes} bytes per path.
MESSAGE
    ;;
  "${manifest_result_timeout}")
    error 20 <<<'Backup manifest preflight exceeded its wall-clock deadline'
    ;;
  *) error 18 <<<"Could not freeze backup manifest: ${manifest_path}" ;;
esac

printf >&2 'manifest: %s\n' "${manifest_path}"

day="$(date -u +%Y-%m-%d)"
time="$(date -u +%H-%M-%S)"

backups_project_dir="${VIRTDEV_HOME}/backups/${project}"
day_dir="${backups_project_dir}/${day}"
partial="${day_dir}/${time}.partial"
final="${day_dir}/${time}"

# shellcheck disable=SC2174  # umask 077 above ensures intermediates get 0700 too
mkdir -p -m 0700 "${day_dir}"

if ! mkdir -m 0700 "${partial}" 2>/dev/null; then
  partial_guidance="$(mount_cleanup_guidance "${partial}")"
  error 10 <<MESSAGE
Partial snapshot already exists: ${partial}
Either another backup is in progress, or a previous backup was
killed (SIGKILL or similar) without its EXIT trap firing.
${partial_guidance}
MESSAGE
fi

backup_succeeded=0
backup_preserve_partial=0
ssh_wrapper=
cleanup_partial() {
  local mount_path="" remove_status=0
  if (( ! backup_succeeded && ! backup_preserve_partial )); then
    mount_remove_tree "${partial}" mount_path || remove_status=$?
    case "${remove_status}" in
      0) ;;
      1) printf >&2 'warning: preserving partial backup with mounted subtree: %s\n' "${mount_path}" ;;
      2) printf >&2 'warning: preserving partial backup because cleanup safety is indeterminate: %s\n' "${partial}" ;;
      *) printf >&2 'warning: could not remove partial backup safely: %s\n' "${partial}" ;;
    esac
  fi
  cleanup_backup_metadata
  [[ -n "${ssh_wrapper}" ]] && rm -f "${ssh_wrapper}"
  # Preserve the status that entered the EXIT trap.
  return 0
}
trap cleanup_partial EXIT

mv -- "${manifest_copy}" "${partial}/manifest"
manifest_copy=
files_from="${partial}/files-from"
mv -- "${manifest_files_from}" "${files_from}"
manifest_files_from=

# Restore rejects a snapshot whose source marker names another project.
printf '%s\n' "${project}" > "${partial}/project"

generation_file="${VIRTDEV_HOME}/system/generation"
if [[ ! -f "${generation_file}" ]]; then
  error 12 <<<"Base system generation file missing: '${generation_file}'"
fi
base_generation="$(generation_read_base "${generation_file}")"
printf '%s\n' "${base_generation}" > "${partial}/generation"

mkdir -m 0700 "${partial}/tree"

ssh_command=""
ssh_rsync_command ssh_command ssh_wrapper "${project}" \
  "${VIRTDEV_SSH_KEY}" "${port}"

archive="${partial}/capture.tar"

available_bytes=''
backup_df_value available_bytes avail "${partial}" \
  'archive capacity preflight'
if (( available_bytes <= backup_free_space_reserve + 1 )); then
  error 19 <<<'Not enough host free space to preserve the backup safety reserve'
fi
archive_limit="${VIRTDEV_BACKUP_MAX_BYTES}"
free_archive_limit=$(( available_bytes - backup_free_space_reserve ))
(( archive_limit <= free_archive_limit )) || archive_limit=${free_archive_limit}

# The guest receives only normalized relative roots. The loop drops roots that
# are already absent; tar then fails on unreadable data or a later race.
remote_tar=$'set -o pipefail\ncd /home/dev || exit 1\nwhile IFS= read -r path || [[ -n "${path}" ]]; do\n  if [[ -e "${path}" || -L "${path}" ]]; then\n    printf "%s\\n" "${path}"\n  fi\ndone | /usr/bin/tar --create --file=- --one-file-system --sparse --verbatim-files-from --files-from=-'
(( flags[verbose] )) && remote_tar+=' --verbose'
printf -v remote_tar_quoted '%q' "${remote_tar}"

printf >&2 'Backing up %s to %s...\n' "${project}" "${final#"${VIRTDEV_HOME}"/}"

remaining=$(( backup_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Backup deadline expired before capture'
set +e
LC_ALL=C timeout --signal=TERM --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
  "${remaining}" \
  "${ssh_command}" dev@127.0.0.1 /usr/bin/bash -c "${remote_tar_quoted}" \
  < "${files_from}" \
  | head -c "$(( archive_limit + 1 ))" > "${archive}"
capture_status=("${PIPESTATUS[@]}")
set -e

archive_size="$(stat -c '%s' -- "${archive}" 2>/dev/null || true)"
[[ "${archive_size}" =~ ^[0-9]+$ ]] \
  || error 18 <<<'Could not validate the captured backup archive'
if (( archive_size > archive_limit )); then
  error 19 <<MESSAGE
Backup exceeded its ${archive_limit}-byte effective archive budget.
The partial snapshot has been removed.
MESSAGE
fi
if (( capture_status[1] != 0 )); then
  error 18 <<<'Could not write the bounded backup archive'
fi
case "${capture_status[0]}" in
  0) ;;
  124|137) error 20 <<<'Backup capture exceeded its wall-clock deadline' ;;
  255) error 17 <<<'SSH transport failed while capturing the backup' ;;
  *) error 18 <<<"Guest archive creation failed (exit ${capture_status[0]})" ;;
esac

remaining=$(( backup_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Backup deadline expired before validation'
gate_status=0
timeout --signal=TERM --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
  "${remaining}" "${archive_gate}" "${archive}" \
  "${VIRTDEV_BACKUP_MAX_ENTRIES}" "${backup_member_path_max_bytes}" \
  "${backup_extension_max_bytes}" || gate_status=$?
case "${gate_status}" in
  0) ;;
  2) error 18 <<<'Guest produced malformed tar metadata' ;;
  3) error 19 <<<'Backup archive metadata exceeds its bounded record budget' ;;
  124|137) error 20 <<<'Backup metadata validation exceeded its wall-clock deadline' ;;
  *) error 18 <<<'Could not validate bounded tar metadata' ;;
esac

remaining=$(( backup_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Backup deadline expired before validation'
archive_paths_summary_file="${partial}/archive-paths-summary"
set +e
# shellcheck disable=SC2016  # awk program is passed through timeout
LC_ALL=C backup_memory_limited timeout --signal=TERM \
    --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
    "${remaining}" tar --quoting-style=escape --list --file="${archive}" \
  | LC_ALL=C backup_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" "${remaining}" \
      awk -v maximum_entries="${VIRTDEV_BACKUP_MAX_ENTRIES}" \
        -v maximum_path_bytes="${backup_member_path_max_bytes}" \
        -v maximum_path_depth="${backup_member_depth_max}" \
        -v maximum_path_state="${backup_path_state_max_bytes}" '
        function add_component(parent, value, key) {
          key = parent SUBSEP value
          if (!(key in child_id)) {
            path_state_bytes += length(value) + 32
            if (path_state_bytes > maximum_path_state) {
              path_over = 1
              exit
            }
            extracted_entries++
            if (extracted_entries > maximum_entries) {
              entries_over = 1
              exit
            }
            child_id[key] = extracted_entries
          }
          return child_id[key]
        }
        {
          members++
          if (members > maximum_entries) { entries_over = 1; exit }
          path = $0
          sub(/\/$/, "", path)
          if (substr(path, 1, 1) == "/") {
            invalid_path = 1
            exit
          }
          if (length(path) > maximum_path_bytes) {
            path_over = 1
            exit
          }
          while (substr(path, 1, 2) == "./") path = substr(path, 3)
          if (path == "" || path == ".") next
          count = split(path, component, "/")
          parent = 0
          depth = 0
          for (i = 1; i <= count; i++) {
            if (component[i] == "" || component[i] == ".") continue
            if (component[i] == "..") {
              invalid_path = 1
              exit
            }
            depth++
            if (depth > maximum_path_depth) {
              path_over = 1
              exit
            }
            parent = add_component(parent, component[i])
          }
        }
        END {
          if (entries_over) exit 42
          if (invalid_path) exit 43
          if (path_over) exit 44
          printf("%d %d\n", members, extracted_entries)
        }
      ' > "${archive_paths_summary_file}"
path_validation_status=("${PIPESTATUS[@]}")
set -e
case "${path_validation_status[1]}" in
  0) ;;
  42) error 19 <<<"Backup exceeded its ${VIRTDEV_BACKUP_MAX_ENTRIES}-entry extracted-tree budget" ;;
  43) error 18 <<<'Backup archive contains an unsafe member path' ;;
  44) error 19 <<MESSAGE
Backup archive paths exceeded a validation budget: ${backup_member_path_max_bytes}
bytes per member, ${backup_member_depth_max} components per member, or
${backup_path_state_max_bytes} bytes of retained component state.
MESSAGE
      ;;
  124|137) error 20 <<<'Backup path validation exceeded its wall-clock deadline' ;;
  *) error 18 <<<'Could not validate backup archive paths' ;;
esac
case "${path_validation_status[0]}" in
  0) ;;
  124|137) error 20 <<<'Backup path validation exceeded its wall-clock deadline' ;;
  *) error 18 <<<'Guest produced an invalid backup archive' ;;
esac
read -r members_listed extracted_entries extra_summary \
  < "${archive_paths_summary_file}"
[[ "${members_listed}" =~ ^[0-9]+$ \
    && "${extracted_entries}" =~ ^[0-9]+$ \
    && -z "${extra_summary}" ]] \
  || error 18 <<<'Could not summarize backup archive paths'

remaining=$(( backup_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Backup deadline expired before validation'
set +e
# shellcheck disable=SC2016  # awk program is passed through timeout
archive_summary="$({
  LC_ALL=C backup_memory_limited timeout --signal=TERM \
    --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
    "${remaining}" tar --numeric-owner --quoting-style=escape \
      --list --verbose --file="${archive}" \
    | LC_ALL=C backup_memory_limited timeout --signal=TERM \
      --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" "${remaining}" \
      awk -v maximum_entries="${VIRTDEV_BACKUP_MAX_ENTRIES}" \
        -v maximum_bytes="${VIRTDEV_BACKUP_MAX_BYTES}" '
      {
        count++
        type = substr($0, 1, 1)
        if (type !~ /^[-dlh]$/) bad_type = 1
        if (count > maximum_entries) { entries_over = 1; exit }
        if (type == "-") {
          size = $3
          if (size !~ /^[0-9]+$/) { bad_size = 1; exit }
          sub(/^0+/, "", size)
          if (size == "") size = "0"
          if (length(size) > length(maximum_bytes) \
              || (length(size) == length(maximum_bytes) \
                  && ("x" size) > ("x" maximum_bytes))) {
            bytes_over = 1
            exit
          }
          logical_bytes += size + 0
          if (logical_bytes > maximum_bytes) { bytes_over = 1; exit }
        }
      }
      END {
        if (entries_over) exit 42
        if (bad_type) exit 43
        if (bytes_over) exit 44
        if (bad_size) exit 45
        printf("%d %.0f\n", count, logical_bytes)
      }
    '
})"
validation_status=$?
set -e
case "${validation_status}" in
  0) ;;
  42) error 19 <<<"Backup exceeded its ${VIRTDEV_BACKUP_MAX_ENTRIES}-entry budget" ;;
  43) error 18 <<<'Backup archive contains an unsupported special file' ;;
  44) error 19 <<<"Backup exceeded its ${VIRTDEV_BACKUP_MAX_BYTES}-byte logical data budget" ;;
  45) error 18 <<<'Backup archive contains an invalid regular-file size' ;;
  124|137) error 20 <<<'Backup validation exceeded its wall-clock deadline' ;;
  *) error 18 <<<'Guest produced an invalid backup archive' ;;
esac
read -r entries_captured logical_bytes_captured extra_summary \
  <<< "${archive_summary}"
[[ "${entries_captured}" =~ ^[0-9]+$ \
    && "${logical_bytes_captured}" =~ ^[0-9]+$ \
    && -z "${extra_summary}" ]] \
  || error 18 <<<'Could not summarize backup archive entries'
(( entries_captured == members_listed )) \
  || error 18 <<<'Backup archive listings disagreed'

available_extract_bytes=''
available_inodes=''
backup_df_value available_extract_bytes avail "${partial}" \
  'extraction capacity preflight'
backup_df_value available_inodes iavail "${partial}" \
  'extraction inode preflight'
metadata_budget=$(( extracted_entries * 4096 ))
extract_budget=$(( archive_size + metadata_budget + backup_free_space_reserve ))
if [[ ! "${available_extract_bytes}" =~ ^[0-9]+$ \
      || ${#available_extract_bytes} -gt 18 \
      || available_extract_bytes -lt extract_budget ]]; then
  error 19 <<<'Not enough host free space to extract the bounded backup archive'
fi
if [[ "${available_inodes}" =~ ^[0-9]+$ ]] \
    && (( available_inodes < extracted_entries + backup_inode_reserve )); then
  error 19 <<<'Not enough host inodes to extract the bounded backup archive'
fi

remaining=$(( backup_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Backup deadline expired before extraction'
set +e
backup_memory_limited timeout --signal=TERM \
    --kill-after="${VIRTDEV_BACKUP_KILL_AFTER}" \
    "${remaining}" tar --extract --file="${archive}" \
      --directory="${partial}/tree" --no-same-owner --same-permissions \
      --delay-directory-restore --sparse
extraction_status=$?
set -e
if (( extraction_status != 0 )); then
  case "${extraction_status}" in
    124|137) error 20 <<<'Backup extraction exceeded its wall-clock deadline' ;;
    *) error 18 <<<"Backup extraction failed (exit ${extraction_status})" ;;
  esac
fi

rm -f "${archive}" "${archive_paths_summary_file}" "${files_from}"

if (( entries_captured == 0 )); then
  error 11 <<MESSAGE
No files captured during backup of ${project}.
Every manifest entry was skipped — most commonly because the
referenced paths do not exist on the guest. The partial snapshot
has been removed.
Verify the manifest against the guest: virtdev-ssh ${project} -- ls -la
MESSAGE
fi

# `mv -T` must fail rather than nest a partial under an existing snapshot.
if [[ -e "${final}" ]]; then
  error 13 <<MESSAGE
A snapshot already exists at this timestamp: ${final}
Another backup of ${project} completed within the same second. Wait a moment and retry.
MESSAGE
fi

if ! sync -f "${partial}"; then
  backup_preserve_partial=1
  error 18 <<MESSAGE
Could not durably flush the completed backup. The partial snapshot was preserved:
${partial}
MESSAGE
fi
mv -T -- "${partial}" "${final}"
if ! sync -f "${day_dir}"; then
  error 18 <<MESSAGE
Could not durably publish the completed backup. The final snapshot was preserved:
${final}
MESSAGE
fi
backup_succeeded=1

printf >&2 '%s\n' "$(terminal_write fg=green "Backed up ${entries_captured} entries." reset)"
printf '%s\n' "${final}"
