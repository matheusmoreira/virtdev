#!/usr/bin/env bash
# shellcheck disable=SC2154  # firewall_* constants provided by the imported firewall library
#
# virtdev-firewall — host egress lockdown: generate / apply / status / hold.
#
#   virtdev firewall apply     (root)  generate + atomically install + (re)load the ruleset
#   virtdev firewall status            report whether the lockdown is active (rootless)
#   virtdev firewall hold      (root)  ExecStart of virtdev-firewall.service: load the
#                                      ruleset into an owner,persist table and hold it
#
# The lockdown is a host-root nftables `inet virtdev` table that filters
# the virtual machines' egress (passt's host sockets) by destination,
# matched to the machines' systemd --user slice cgroups. The table carries
# the `owner,persist` flags and is held open by a resident holder
# (virtdev-firewall.service): while that service runs, another process's
# `nft flush ruleset` (a host firewall reload) SKIPS the table instead of
# wiping it, so no reassert timer is needed. The rootless policy (zones,
# slice names, the launch guard) lives in lib/virtdev/firewall; this tool
# owns the root-only ruleset generation, the apply flow, and the holder.
#
# Exit codes (local; 88 + 89 are library-owned by lib/virtdev/firewall):
#   89  invalid zone-definition file (apply, raised via firewall_zone_parse)
#   92  not invoked via sudo / target identity indeterminate
#   93  ruleset rejected by nft -c
#   94  unit install / daemon-reload / enable / manifest-write failure
#   95  ruleset installed on disk but the holder failed to load it
#   96  holder: ruleset file missing, or uid/base underivable from it
#   97  holder: table did not come up, or baseline record failed
#   98  apply: lingering not enabled for the target user
#   99  holder: zone-slice cgroup dirs never appeared (pins not running)
#  100  apply: refused — would strand a running machine's open host-loopback map
#  101  apply: timed out acquiring the user lock (another virtdev op in progress)
#
set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error arguments firewall

# No VIRTDEV_HOME / HOME defaulting at SOURCE TIME: the holder runs `hold` as a root
# system service where HOME is unset, so a top-level default would crash it under
# set -u. The one reader is the rootless self-elevation path in firewall_apply, which
# defaults VIRTDEV_HOME in-function to forward it across the sudo boundary; the root
# apply then reads it from the --virtdev-home flag, never from its own env (which sudo
# stripped anyway) — preserving "the root apply never trusts its environment".

# Custom-zone generation state, populated by firewall_load_custom_zones and read
# by firewall_generate / firewall_start_pins / firewall_write_zones_manifest. The
# tool's `apply` is the ONLY context that reads the user's zones/ config (root,
# via SUDO_UID); the holder and the rootless launch never do (spec §2.3).
declare -ga firewall_gen_zones=()      # custom zone names, sorted
declare -gA firewall_gen_base=()       # name -> base (a built-in)
declare -gA firewall_gen_ports=()      # name -> ";"-joined "<port> <proto...>" specs

# firewall_load_custom_zones <uid>
# Enumerate + parse the target user's custom zone-definition files into the
# firewall_gen_* globals. The config dir is CONSTRUCTED from the validated uid
# (getent home + /.config — NOT $XDG_CONFIG_HOME, which under sudo is root's
# environment, and NOT a search of a user-writable tree). Skips dotfiles and
# non-regular entries; REFUSES symlinks; a regular file must bear a valid zone
# name that does not shadow a built-in and must parse, or apply aborts (89). No
# zones/ dir is normal (zero custom zones).
firewall_load_custom_zones() {
  local -r uid="${1:?firewall_load_custom_zones: uid required}"
  firewall_gen_zones=(); firewall_gen_base=(); firewall_gen_ports=()
  local home
  # `|| home=""` neutralises the set -e abort: under pipefail a passwd miss makes
  # `getent | cut` non-zero, and as a plain assignment that would abort apply with a
  # bare exit 2 (colliding with validate's reserved code) BEFORE the graceful-skip
  # guard below. A missing passwd entry means "no custom zones", not an error.
  home="$(getent passwd "${uid}" | cut -d: -f6)" || home=""
  [[ -n "${home}" && -d "${home}" ]] || return 0
  local -r zones_dir="${home}/.config/virtdev/zones"
  [[ -d "${zones_dir}" ]] || return 0
  local f name base reason joined p
  local -a ports
  while IFS= read -r -d '' f; do
    name="$(basename -- "${f}")"
    [[ "${name}" == .* ]] && continue
    if [[ -L "${f}" ]]; then
      error "${firewall_invalid_zone_exit_code}" <<<"zone file is a symlink (refused): ${f}"
    fi
    [[ -f "${f}" ]] || continue                    # skip dirs / other non-regular
    firewall_zone_name_valid "${name}" \
      || error "${firewall_invalid_zone_exit_code}" <<<"invalid zone name '${name}' in ${zones_dir} (lowercase ^[a-z][a-z0-9_]*\$, no dashes/dots, <=${firewall_zone_name_max})"
    [[ -v "firewall_zone_known[${name}]" ]] \
      && error "${firewall_invalid_zone_exit_code}" <<<"zone '${name}' shadows a built-in; choose another name"
    base=""; ports=(); reason=""
    firewall_zone_parse "${f}" base ports reason \
      || error "${firewall_invalid_zone_exit_code}" <<<"zone '${name}': ${reason}"
    firewall_gen_zones+=("${name}")
    firewall_gen_base["${name}"]="${base}"
    joined=""
    for p in "${ports[@]}"; do joined+="${p};"; done
    firewall_gen_ports["${name}"]="${joined}"
  done < <(find "${zones_dir}" -mindepth 1 -maxdepth 1 -print0 | sort -z)
}

# firewall_relaxation_zones -> the BUILT-IN relaxation zones (the built-in
# registry minus the 'none' floor), sorted. Custom zones are appended alongside
# these by firewall_generate and firewall_start_pins (from firewall_gen_zones);
# the holder derives its own cgroup-dir wait-set from the installed ruleset, not
# from here (it has no access to the custom-zone set).
firewall_relaxation_zones() {
  firewall_zones | grep -vx none | sort
}

# firewall_generate <cgroup_base>
# <cgroup_base> is the cgroup2-root-relative path of virtdev.slice, e.g.
#   user.slice/user-1000.slice/user@1000.service/virtdev.slice
# Emits the full `inet virtdev` table to stdout: a FIXED, project-agnostic
# ladder. One base jump narrows to virtdev.slice (every machine, by cgroup
# ancestry — verified scoped: catches descendants, nothing outside), then one
# jump per RELAXATION zone matches that zone's shared slice one level deeper.
# 'none' emits no rule — the terminal drop is its policy. The ruleset no longer
# references per-project leaf slices: those were transient and absent at load
# time, which is exactly what kept the old table from ever loading.
firewall_generate() {
  local -r base="${1:?firewall_generate: cgroup base required}"
  local -r base_level="$(awk -F/ '{print NF}' <<<"${base}")"
  # The per-zone slices are direct children of virtdev.slice:
  # base/virtdev-<zone>.slice — one level deeper than the base.
  local -r zone_level=$(( base_level + 1 ))

  # Any host-hole zone present? (controls the conditional loopback narrowing).
  # firewall_gen_* are populated by firewall_load_custom_zones before this runs.
  local any_hole=0 z
  for z in "${firewall_gen_zones[@]}"; do
    [[ -n "${firewall_gen_ports[${z}]:-}" ]] && { any_hole=1; break; }
  done

  printf 'destroy table inet %s\n' "${firewall_table_name}"
  printf 'table inet %s {\n' "${firewall_table_name}"
  # owner,persist: the resident holder (virtdev-firewall.service) owns this
  # table, so another process's `nft flush ruleset` skips it — a host firewall
  # reload cannot wipe the lockdown. persist keeps the rules in place if the
  # holder ever dies (the guard then reports down until it is restarted).
  printf '  flags owner, persist\n'
  printf '  set lan_v4 { type ipv4_addr; flags interval; elements = { %s } }\n' "${firewall_lan_v4_elements}"
  printf '  set lan_v6 { type ipv6_addr; flags interval; elements = { %s } }\n' "${firewall_lan_v6_elements}"
  printf '  chain output {\n'
  printf '    type filter hook output priority 0; policy accept;\n'
  # Narrow to virtdev FIRST so the host's own egress is untouched; jump
  # only for sockets in virtdev.slice (every machine, by ancestry).
  # CROSS-REF: the holder's uid/base sed (firewall_hold step 1) parses this exact
  # `…virtdev.slice" jump virtdev_machines` literal — keep the two shapes in lockstep.
  printf '    socket cgroupv2 level %s "%s" jump virtdev_machines\n' "${base_level}" "${base}"
  printf '  }\n'
  printf '  chain virtdev_machines {\n'
  # Loopback DESTINATION accept for passt's SSH-forward reply (targets 127.0.0.1
  # in the machine's cgroup; none/wan would otherwise drop it and break virtdev
  # ssh). Accept by destination, not oifname — a guest->host-LAN-IP packet routes
  # via lo too, so oifname would fail open.
  #
  # CONDITIONAL NARROWING: only when a host-hole zone exists do we add
  # `ct state established`, so a guest-INITIATED new loopback flow falls through
  # to the zone chains and is gated per-port. With NO host-hole zone the
  # UNCONDITIONAL accept stands, preserving the documented property that
  # virtdev-ssh needs no conntrack (a notrack-on-lo host rule cannot break it) —
  # and passt's --map-host-loopback none still blocks guest-initiated loopback in
  # every zone, so there is nothing to gate. SAFETY of the narrowed form rests on
  # passt always performing a real connect(2) for guest flows: the host-side
  # packet is therefore SYN-first -> ct new -> gated by the zone (NOT on a generic
  # "established follows new", which is false under nf_conntrack_tcp_loose). Only
  # the SSH-reply leg (passt as the accepting server) is ct established. `related`
  # is deliberately excluded. (See DESIGN.md and the spec §4.2/§7.)
  if (( any_hole )); then
    printf '    ip daddr 127.0.0.1 ct state established accept\n'
    printf '    ip6 daddr ::1 ct state established accept\n'
  else
    printf '    ip daddr 127.0.0.1 accept\n'
    printf '    ip6 daddr ::1 accept\n'
  fi
  # One cgroup-ancestry jump per zone that owns a slice: the built-in relaxation
  # zones (everything but 'none') plus every custom zone. 'none' has no jump — the
  # terminal drop is its policy. Slices are named through firewall_slice_for (the
  # single source of truth), so launch (systemd-run --slice) and rule can't drift.
  # Uniform `jump zone_<z>`; each target chain is emitted below.
  # CROSS-REF: the holder's cgroup-dir-wait sed (firewall_hold step 2) parses these
  # `…/virtdev-<zone>.slice" jump zone_<z>` literals to derive its wait-set — keep the
  # two shapes in lockstep.
  local slice
  for z in $(firewall_relaxation_zones) "${firewall_gen_zones[@]}"; do
    slice="$(firewall_slice_for "${z}")"
    printf '    socket cgroupv2 level %s "%s/%s" jump zone_%s\n' "${zone_level}" "${base}" "${slice}" "${z}"
  done
  printf '    drop\n'                          # none + strays: deny by default
  printf '  }\n'
  # Built-in base chains — reusable jump targets; custom chains compose on them.
  # zone_none is the floor (also the base for `base none` custom zones); the
  # built-in 'none' machines reach the terminal drop above, not this chain.
  printf '  chain zone_none { drop; }\n'
  printf '  chain zone_wan {\n'
  printf '    fib daddr type local drop\n'     # the host itself (its LAN IP / 0.0.0.0 services)
  printf '    ip daddr @lan_v4 drop\n'
  printf '    ip6 daddr @lan_v6 drop\n'
  printf '    accept\n'                         # WAN
  printf '  }\n'
  printf '  chain zone_lan {\n'
  printf '    ip daddr @lan_v4 accept\n'
  printf '    ip6 daddr @lan_v6 accept\n'
  printf '    fib daddr type local accept\n'    # host + LAN
  printf '    drop\n'                            # WAN blocked
  printf '  }\n'
  printf '  chain zone_full { accept; }\n'
  # Custom-zone chains: bind-agnostic per-port host holes (fib daddr type local
  # matches loopback AND the host's LAN IPs), THEN jump to the base policy. The
  # per-port holes are the SOLE host access only under base none/wan, whose chains
  # drop the host after the holes; base lan/full accept the host wholesale, so on
  # those bases the holes are inert and the guest reaches the whole host loopback
  # — by design (lan/full mean "host open"; see DESIGN "Custom zones"). The zone
  # is marked hostmap=1 either way, so passt's host map opens for the launch.
  local spec pnum protos protoset
  local -a specs
  for z in "${firewall_gen_zones[@]}"; do
    printf '  chain zone_%s {\n' "${z}"
    IFS=';' read -r -a specs <<<"${firewall_gen_ports[${z}]}"
    for spec in "${specs[@]}"; do
      [[ -z "${spec}" ]] && continue
      read -r pnum protos <<<"${spec}"          # "1234 tcp udp" -> pnum=1234, protos="tcp udp"
      protoset="${protos// /, }"                # nft set form: "tcp, udp"
      printf '    fib daddr type local meta l4proto { %s } th dport %s accept\n' "${protoset}" "${pnum}"
    done
    printf '    jump zone_%s\n' "${firewall_gen_base[${z}]}"
    printf '  }\n'
  done
  printf '}\n'
}

# ── apply: ordered, fail-closed, atomic ─────────────────────────────
#
# The generated ruleset is admin state, not package state, so it is installed
# under /etc (never the pacman-managed /usr/lib). The systemd units come from one
# of two places depending on how virtdev-firewall is run (firewall_install_units):
# a packaged install already ships them to /usr/lib/systemd/{system,user} (systemd
# unit dirs) and apply leaves them there; a source checkout has them only in the
# tree's systemd/ dir, so apply copies them into /etc/systemd/{system,user}. The
# holder is a system unit, the pin a --user unit — the split is user-vs-system,
# not by file extension.
readonly firewall_etc_dir="/etc/virtdev"
readonly firewall_state_dir="${firewall_etc_dir}/firewall"
readonly firewall_nft_file="${firewall_state_dir}/nft"
readonly firewall_systemd_dir="/etc/systemd/system"
readonly firewall_user_systemd_dir="/etc/systemd/user"
readonly firewall_pkg_systemd_dir="/usr/lib/systemd/system"
readonly firewall_pkg_user_systemd_dir="/usr/lib/systemd/user"
readonly firewall_holder_unit="virtdev-firewall.service"
readonly firewall_pin_template="virtdev-firewall-pin@.service"

# Resolve + validate the target (the user whose virtual machines we
# protect) and CONSTRUCT — never search — the cgroup2-root-relative base
# path for that uid. The user's cgroup tree is user-writable (delegation),
# so a planted decoy virtdev.slice at another depth would bake a wrong
# baseline level and fail open; constructing from the validated uid is the
# only safe option.
firewall_target_base() {
  local -r uid="${SUDO_UID:-}"
  [[ "${uid}" =~ ^[1-9][0-9]*$ ]] \
    || error 92 <<<"run via sudo as your normal user (SUDO_UID unset/invalid: '${uid:-}'). Do not run as bare root."
  # Require the user manager cgroup. It exists once the user has a
  # lingering manager or an active session; do NOT gate on virtdev.slice,
  # which will not exist until the first virtual machine starts (that would
  # deadlock a fresh user).
  local -r svc="/sys/fs/cgroup/user.slice/user-${uid}.slice/user@${uid}.service"
  [[ -d "${svc}" ]] \
    || error 92 <<<"user@${uid}.service cgroup not found at ${svc}. Enable lingering (loginctl enable-linger) or start a virtual machine first."
  printf 'user.slice/user-%s.slice/user@%s.service/virtdev.slice\n' "${uid}" "${uid}"
}

# Run a command AS the target user from a root apply, with the user-manager runtime
# dir in the environment (the user manager is live — linger is required and checked
# first — so its private bus is reachable there). One place to get the cross-privilege
# environment right; firewall_user_systemctl and the coordination-lock setup both
# route through it.
firewall_user_run() {
  local -r uid="${1:?firewall_user_run: uid required}"; shift
  sudo -u "#${uid}" XDG_RUNTIME_DIR="/run/user/${uid}" "$@"
}

# Run `systemctl --user ...` for the target user from a root apply.
firewall_user_systemctl() {
  local -r uid="${1:?firewall_user_systemctl: uid required}"; shift
  firewall_user_run "${uid}" systemctl --user "$@"
}

# apply requires the target user to have lingering enabled: the resident pins
# and the user manager that owns the zone cgroups must run boot->shutdown,
# independent of an interactive login, or the holder's wait deadlocks and the
# cgroups the ruleset matches vanish at logout. A persistent per-user change is
# the user's call — refuse (98), never enable it silently.
firewall_require_linger() {
  local -r uid="${1:?firewall_require_linger: uid required}"
  local linger
  linger="$(loginctl show-user "${uid}" -p Linger --value 2>/dev/null || true)"
  [[ "${linger}" == "yes" ]] \
    || error 98 <<<"lingering is not enabled for uid ${uid}; the firewall pins must run boot->shutdown. Enable it:  loginctl enable-linger ${uid}"
}

# firewall_lock_user <uid> <forwarded_home>
# Acquire the target user's rootless virtdev lock (the SAME ${VIRTDEV_HOME}/lock that
# virtdev-start and the other rootless tools hold) on fd 8, making apply mutually
# exclusive with a concurrent launch for its whole scan->reload->manifest window —
# the structural close of the start-vs-apply race (a launch must not read the old
# manifest, open passt's map, then have our reload un-narrow the loopback under it).
#
# The lock HOME is the user's VIRTDEV_HOME, forwarded explicitly across the sudo
# boundary by the self-elevating apply (sudo strips the env); a direct
# `sudo virtdev firewall apply` with no flag falls back to the default built from the
# user's home dir. This is the ONLY apply input derived from VIRTDEV_HOME, and only to
# LOCATE the lock — a wrong/forged value cannot affect any security decision, only
# skip coordination (fail-safe).
#
# The lock file MUST stay user-owned: rootless lock_acquire append-opens it, so a
# root-owned one would lock out every rootless op. Ensure it exists via the SUDO_UID
# bridge, then open it READ-ONLY as root (DAC_OVERRIDE — no write, so no truncation of
# an arbitrary forwarded path) and flock. fd 8 stays open for the rest of the apply
# process, so the lock releases on exit. If the home is absent/unwritable, no rootless
# op has ever run there, so there is nothing to serialize against — warn and proceed.
firewall_lock_user() {
  local -r uid="${1:?firewall_lock_user: uid required}"
  local home="${2:-}"
  if [[ -z "${home}" ]]; then
    home="$(getent passwd "${uid}" | cut -d: -f6)" || home=""
    [[ -n "${home}" ]] && home="${home}/.local/share/virtdev"
  fi
  if [[ -z "${home}" ]]; then
    printf >&2 'firewall apply: could not resolve the user lock home; proceeding without start/apply coordination.\n'
    return 0
  fi
  local -r lockfile="${home}/lock"
  # Idempotently ensure the lock file exists USER-owned (best-effort).
  firewall_user_run "${uid}" mkdir -p -m 0700 "${home}" 2>/dev/null || true
  firewall_user_run "${uid}" touch "${lockfile}" 2>/dev/null || true
  # Require a real, non-symlink regular file before the read-open. A FIFO at this path
  # would make `exec 8<` block on open(2) unbounded — defeating the flock -w 60 ceiling
  # and wedging the root process — and a symlink could redirect it. A non-regular path
  # -> skip coordination (fail-safe), never hang. Matches the read guards in
  # firewall_zone_default / firewall_zone_parse.
  if [[ ! -f "${lockfile}" || -L "${lockfile}" ]]; then
    printf >&2 'firewall apply: no usable rootless lock at %s; proceeding without start/apply coordination.\n' "${lockfile}"
    return 0
  fi
  exec 8<"${lockfile}"
  # Block briefly: a launch holds the lock only through activation (a few seconds); a
  # 60 s hold means another virtdev op is wedged.
  flock -w 60 8 \
    || error 101 <<<"another virtdev operation has held the lock for 60s (${lockfile}); retry: virtdev firewall apply"
}

# Enable + start the resident pins AS THE USER, then RECONCILE. This materialises
# the virtdev-<zone>.slice cgroup dirs (a started-but-empty slice has none) before
# the generator's nft -c and the holder's wait need them. The pinned set is the
# built-in relaxation zones PLUS every custom zone — the same set the generator
# emits rules and dispatch for — so the two never drift. `enable --now` = start
# now + boot persistence. Reconcile disables a pin whose zone no longer exists, so
# a removed custom zone leaves no immortal sleep-infinity unit or stale cgroup.
firewall_start_pins() {
  local -r uid="${1:?firewall_start_pins: uid required}"
  local zone
  local -A desired=()
  local -a units=()
  while IFS= read -r zone; do
    desired["${zone}"]=1
    units+=( "virtdev-firewall-pin@${zone}.service" )
  done < <(firewall_relaxation_zones)
  for zone in "${firewall_gen_zones[@]}"; do
    desired["${zone}"]=1
    units+=( "virtdev-firewall-pin@${zone}.service" )
  done
  if [[ ${#units[@]} -gt 0 ]]; then
    firewall_user_systemctl "${uid}" enable --now "${units[@]}" \
      || error 94 <<<"failed enabling the firewall pins (${units[*]}) for uid ${uid}. Is the user manager running under linger?"
  fi
  # Reconcile: disable any loaded pin instance whose zone is no longer defined.
  # Best-effort — a disable failure must not abort an otherwise successful apply.
  local u z
  while IFS= read -r u; do
    [[ "${u}" == virtdev-firewall-pin@*.service ]] || continue
    z="${u#virtdev-firewall-pin@}"; z="${z%.service}"
    [[ -v "desired[${z}]" ]] && continue
    firewall_user_systemctl "${uid}" disable --now "${u}" 2>/dev/null || true
  done < <(firewall_user_systemctl "${uid}" list-units --all --plain --no-legend 'virtdev-firewall-pin@*.service' 2>/dev/null | awk '{print $1}')
}

# Make the holder + pin units available to systemd, then enable the holder.
# Two layouts: a SOURCE CHECKOUT has them only in the tree's systemd/ dir, which
# is not a systemd unit dir, so copy them into /etc (the holder to the system
# dir, the --user pin to the user dir). A PACKAGED install already ships them to
# /usr/lib/systemd/{system,user}, so there is nothing to copy. Copy (never
# symlink) in the checkout case: the holder runs as root from a root-owned unit,
# and a symlink into a possibly-user-writable tree would let the dev user rewrite
# ExecStart=. Reload both managers so a freshly-copied unit is visible.
firewall_install_units() {
  local -r uid="${1:?firewall_install_units: uid required}"
  local -r devdir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../systemd"

  if [[ -f "${devdir}/${firewall_holder_unit}" ]]; then
    install -m 0644 -o root -g root "${devdir}/${firewall_holder_unit}" \
      "${firewall_systemd_dir}/${firewall_holder_unit}" \
      || error 94 <<<"failed installing ${firewall_holder_unit}"
    install -d -m 0755 -o root -g root "${firewall_user_systemd_dir}"
    install -m 0644 -o root -g root "${devdir}/${firewall_pin_template}" \
      "${firewall_user_systemd_dir}/${firewall_pin_template}" \
      || error 94 <<<"failed installing ${firewall_pin_template}"
  else
    [[ -f "${firewall_pkg_systemd_dir}/${firewall_holder_unit}" \
       && -f "${firewall_pkg_user_systemd_dir}/${firewall_pin_template}" ]] \
      || error 94 <<<"firewall units not found in ${devdir} nor ${firewall_pkg_systemd_dir%/system}"
  fi

  systemctl daemon-reload || error 94 <<<"systemctl daemon-reload failed"
  firewall_user_systemctl "${uid}" daemon-reload \
    || error 94 <<<"systemctl --user daemon-reload failed for uid ${uid}"

  # Enable the holder for boot persistence only — the actual load happens via
  # the restart in firewall_apply.
  systemctl enable "${firewall_holder_unit}" \
    || error 94 <<<"failed enabling ${firewall_holder_unit}"
  systemctl reset-failed "${firewall_holder_unit}" 2>/dev/null || true
}

# firewall_guard_running_hostmap <uid>
# Targeted refuse (exit 100): block an apply that would STRAND an already-running
# machine's open passt host-loopback map. A host-hole zone launches passt with the
# guest->host 127.0.0.1 map OPEN — ALL ports, because passt's map is all-or-nothing
# — and the nft ruleset narrows it to the declared port(s). That narrowing is the
# conditional loopback rule in firewall_generate, which collapses to an
# UNCONDITIONAL `ip daddr 127.0.0.1 accept` once NO host-hole zone remains
# (any_hole=0). passt's map is fixed at machine launch and is NOT touched by apply
# (it restarts only the holder + pins, never the machine units), so removing the
# LAST host-hole zone while such a machine still runs would silently widen it from
# its declared port to EVERY host loopback port — a fail-OPEN, until that machine
# restarts. Refuse instead: the narrowing ruleset stays loaded and the machine stays
# gated; the admin stops the named machine(s) and re-applies.
#
# Runs BEFORE any system mutation, so a refusal changes nothing (apply stays
# all-or-nothing). Scope is precisely the fail-OPEN (new any_hole 1->0): removing one
# of several host-hole zones keeps any_hole=1, so the loopback stays `ct established`
# and a machine whose own hole vanished merely fails CLOSED (its new loopback flows
# drop) — no refuse needed. "Door open" is read from each running machine's OWN unit:
# its ExecStart carries `--allow-host-loopback` iff the launch opened passt's map.
# That is the authoritative per-machine signal — systemd-owned (unforgeable by the
# guest) and INDEPENDENT of firewall/zones, so a lost/stale manifest cannot blind
# this guard, and a machine launched --unfiltered (map never opened) is not counted.
#
# Serialized against a concurrent `virtdev start`: apply holds the rootless lock
# (firewall_lock_user) across its whole scan->reload->manifest window, and start reads
# the host-map state and launches under that SAME lock. So a machine cannot start into
# the zone being removed in the window between this scan and the holder reload — the
# launch either wins the lock (and its open map is then seen here via the ExecStart
# marker) or waits for apply. (Before firewall_lock_user that window was an unclosed
# narrow race; the lock closes it structurally — see firewall_apply / firewall_lock_user.)
firewall_guard_running_hostmap() {
  local -r uid="${1:?firewall_guard_running_hostmap: uid required}"

  # A host-hole zone survives this apply? Then the loopback rule stays narrowed
  # (`ct established`) for every machine, so no running map can be stranded.
  local z
  for z in "${firewall_gen_zones[@]}"; do
    [[ -n "${firewall_gen_ports[${z}]:-}" ]] && return 0
  done

  # No host-hole remains: collect machines whose passt host map is actually OPEN,
  # read from the AUTHORITATIVE per-machine source — the unit's own ExecStart, which
  # carries `--allow-host-loopback` iff the launch opened the map. systemd owns that
  # argv (the guest cannot forge it) and it is independent of firewall/zones, so a
  # lost/stale manifest cannot blind this guard and an --unfiltered machine that
  # never opened the map is correctly not flagged. Enumerate ALIVE machines through
  # the shared predicate (which catches `deactivating`, whose map is still open),
  # passing firewall_user_systemctl as the cross-privilege runner.
  # CROSS-REF: the `--allow-host-loopback` literal matched below is virtdev's OWN
  # netexec flag. Keep it in lockstep with its definition in virtdev-netexec (the
  # `spec` array) and the emit in virtdev-start; renaming the flag there without
  # updating this match silently fails the guard OPEN — no lint catches a string drift.
  local unit exec_start project running_units
  local -a stranded=()
  # Fail CLOSED on an enumeration failure (bus down / broken cross-privilege bridge):
  # bind the runner's rc so an empty stream from a FAILED enumeration cannot read as
  # "no machines" and let apply widen a live machine's host-loopback map (exit 102).
  running_units="$(firewall_running_machine_units firewall_user_systemctl "${uid}")" \
    || error 102 <<MESSAGE
apply refused: could not enumerate the target user's running machines (their systemd
manager was unreachable). Cannot verify that no machine holds passt's host-loopback
map open, so removing the last host-hole zone now might silently widen a live machine
to every host loopback port. Ensure the user session is reachable, then re-apply.
Nothing was changed.
MESSAGE
  while IFS= read -r unit; do
    [[ -n "${unit}" ]] || continue
    exec_start="$(firewall_user_systemctl "${uid}" show -p ExecStart --value "${unit}" 2>/dev/null || true)"
    [[ " ${exec_start} " == *" --allow-host-loopback "* ]] || continue
    project="${unit#virtdev-}"; project="${project%.service}"
    stranded+=("${project}")
  done <<<"${running_units}"

  [[ ${#stranded[@]} -eq 0 ]] && return 0

  local stops
  printf -v stops '  virtdev stop %s\n' "${stranded[@]}"
  error 100 <<MESSAGE
apply refused: this removes the last host-hole zone, but these machines are running
with passt's host-loopback map open (opened at launch, all ports). Reloading now
would widen them from their declared hole to EVERY host loopback port until they
restart. Stop them, then re-apply:
${stops}  sudo virtdev firewall apply
Nothing was changed.
MESSAGE
}

# apply: linger gate -> load+validate custom zones -> install units -> start pins
# -> generate/validate/install -> restart holder -> write firewall/zones. Custom
# zones are validated FIRST: a malformed zone-definition file aborts (exit 89)
# before any system mutation. The pins must start BEFORE generate: nft -c resolves
# the zone-slice cgroup paths to inodes, so those dirs must already exist. The
# holder (Type=notify) records firewall/cgroupv2 post-load; apply records the realized
# manifest firewall/zones (read by the rootless launch) only after the restart
# wins, so it never claims a zone is active before the ruleset actually loaded.
firewall_apply() {
  local -r forwarded_home="${1:-}"

  # apply must run as root but needs the INVOKING user's identity (SUDO_UID) and, for
  # the start/apply coordination lock, that user's VIRTDEV_HOME. sudo strips the env,
  # so when run rootless (`virtdev firewall apply`) self-elevate and forward
  # VIRTDEV_HOME EXPLICITLY as a flag — the only way the user's runtime VIRTDEV_HOME
  # crosses the privilege boundary intact. A direct `sudo virtdev firewall apply`
  # (already root, no flag) falls back to the default built from the user's home dir.
  if [[ "$(id -u)" -ne 0 ]]; then
    : "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
    exec sudo "$(readlink -f "${BASH_SOURCE[0]}")" apply --virtdev-home "${VIRTDEV_HOME}"
  fi

  local base
  base="$(firewall_target_base)"            # validates SUDO_UID
  local -r uid="${SUDO_UID}"                 # validated by firewall_target_base above

  firewall_require_linger "${uid}"

  # Parse the user's custom zones up front (root, via SUDO_UID) so a bad file
  # aborts before we touch units, pins, or the ruleset.
  firewall_load_custom_zones "${uid}"

  # Serialize the rest of apply against a concurrent `virtdev start`: hold the user's
  # rootless lock across the scan, the reload, and the manifest write, so a launch
  # cannot read the old manifest, open passt's map, and then have our reload un-narrow
  # the loopback under it (the start-vs-apply race). Acquired AFTER the config reads
  # above (which do not race a launch), so the hold is as short as possible.
  firewall_lock_user "${uid}" "${forwarded_home}"

  # Targeted refuse BEFORE any mutation: if this apply drops the last host-hole zone
  # while a machine runs with passt's host map open, that machine would fail OPEN to
  # all host loopback ports (its map outlives the nft narrowing). Refuse so the admin
  # stops it first; nothing here has changed yet (apply stays all-or-nothing).
  firewall_guard_running_hostmap "${uid}"

  install -d -m 0755 -o root -g root "${firewall_state_dir}"

  # Units first (holder -> system dir, pin -> user dir; both managers reloaded),
  # then start the pins so the virtdev-<zone>.slice cgroup dirs exist before the
  # generator's nft -c resolves them.
  firewall_install_units "${uid}"
  firewall_start_pins "${uid}"

  # Generate to a temp file ON THE SAME FILESYSTEM as the target so the
  # rename(2) below cannot fail EXDEV (a cross-fs $TMPDIR would).
  local tmp
  tmp="$(mktemp -p "${firewall_state_dir}" nft.XXXXXX)"
  # shellcheck disable=SC2064  # expand tmp now: the trap must name this exact file
  trap "rm -f '${tmp}'" EXIT

  firewall_generate "${base}" >"${tmp}"

  # Validate before installing, in a THROWAWAY network namespace. The ruleset
  # begins `destroy table inet virtdev`, but on a RE-apply the live table is
  # owner,persist and held by the running holder — so a plain `nft -c` of that
  # destroy/recreate is rejected EPERM ("Operation not permitted") by the owner
  # protection, which would break every re-apply (the common case once the
  # lockdown is up). A fresh netns has no `inet virtdev` table, so destroy/add
  # validate cleanly; cgroup2 paths are global (not netns-scoped) so
  # `socket cgroupv2` still resolves to the pin-backed slices. This validates the
  # exact ruleset the holder will load — the holder's own reload succeeds for the
  # same no-conflict reason (its predecessor's owner socket is gone before it
  # loads). nft -c + unshare both need root, which apply has.
  unshare --net -- nft -c -f "${tmp}" \
    || error 93 <<<"generated ruleset failed validation (nft -c). Left ${firewall_nft_file} unchanged."

  # Atomic install: rename(2) the validated temp over the target, then fix
  # ownership/mode (the mktemp temp is 0600). An interrupted apply can never
  # leave a destroy-table-only truncation; the prior good file survives any
  # earlier failure.
  mv -f "${tmp}" "${firewall_nft_file}"
  chown root:root "${firewall_nft_file}"
  chmod 0644 "${firewall_nft_file}"
  trap - EXIT

  # Publish the manifest LOCKSTEP with the ruleset: remove firewall/zones BEFORE the
  # restart, so from the instant the holder may load the new ruleset until the
  # manifest is rewritten below, no manifest exists. This enforces the invariant
  # "firewall/zones exists <=> the loaded ruleset was published by a COMPLETED apply".
  # Without it, any outcome that loads the new ruleset but skips the rewrite strands a
  # stale hostmap=1 manifest against an un-narrowed loopback (a fail-OPEN to the whole
  # host loopback): a crash in the restart->write window (robustness-S2 F1), or an
  # exit-95 abort whose holder then self-heals via Restart=on-failure to the new
  # ruleset (F3, no crash needed). With the manifest gone, every such outcome is
  # fail-CLOSED — custom zones refuse "run apply", built-ins fall to the legacy floor
  # — until the rewrite completes.
  rm -f "${firewall_zones_file}"

  # (Re)load NOW by restarting the holder. Its ExecStart (hold) includes the
  # freshly-installed ruleset into a new owner session; on a re-apply it
  # destroys the old owner table and recreates it. Type=notify, so `restart`
  # returns success only once the holder waited for the pins, loaded, verified,
  # and recorded firewall/cgroupv2 — the on-disk file and the kernel ruleset cannot
  # diverge behind a green service.
  systemctl restart virtdev-firewall.service \
    || error 95 <<<"installed ${firewall_nft_file} but the holder restart failed. It may still load via Restart=on-failure; the manifest stays withheld (fail-closed) until a load wins. Re-run to reconcile: sudo virtdev firewall apply"

  # The restart returned only after the holder (Type=notify) loaded + verified the
  # ruleset, so the realized manifest is now safe to (re)publish for the launch side.
  firewall_write_zones_manifest

  printf >&2 'host egress lockdown applied: %s\n' "${firewall_nft_file}"
}

# firewall_write_zones_manifest -> /etc/virtdev/firewall/zones, ATOMICALLY (mktemp
# + rename, like firewall_record_baseline) so a concurrent rootless reader never
# sees a torn write. One line "<zonename> <needs-hostmap 0|1>" per realized zone:
# all built-ins (hostmap 0 — they never use the passt remap) and every custom zone
# (hostmap 1 iff it declares >=1 port). Overwrites, so the set shrinks when a zone
# is removed. Written only AFTER a successful holder load, so it reflects exactly
# what is loaded. World-readable.
firewall_write_zones_manifest() {
  local tmp z hostmap b ok=1
  tmp="$(mktemp -p "${firewall_state_dir}" zones.XXXXXX)" || tmp=""
  if [[ -n "${tmp}" ]]; then
    {
      while IFS= read -r b; do printf '%s 0\n' "${b}"; done < <(firewall_zones)
      for z in "${firewall_gen_zones[@]}"; do
        hostmap=0; [[ -n "${firewall_gen_ports[${z}]:-}" ]] && hostmap=1
        printf '%s %s\n' "${z}" "${hostmap}"
      done
    } > "${tmp}" && chmod 0644 "${tmp}" && mv -f "${tmp}" "${firewall_zones_file}" || ok=0
  else
    ok=0
  fi
  if (( ! ok )); then
    # Fail CLOSED. firewall_apply already removed firewall/zones before the holder
    # restart (the primary lockstep guarantee), so on the normal path it is already
    # absent here; this is defence-in-depth that also reaps the partial temp. Decouple
    # the rm from set -e: a parent-dir/EROFS unlink failure must NOT swallow the
    # error 94 (that would exit a bare 1 with no diagnostic AND leave the stale
    # hostmap=1 manifest the removal exists to delete — a fail-OPEN to the whole host
    # loopback). Tell the admin to VERIFY removal, since a surviving stale manifest is
    # the dangerous case.
    rm -f "${tmp}" "${firewall_zones_file}" 2>/dev/null || true
    error 94 <<<"failed writing ${firewall_zones_file}; attempted to remove any stale manifest — VERIFY it is gone, then re-run: sudo virtdev firewall apply"
  fi
}

# firewall_record_baseline <uid> <base>
# Write "<uid> <virtdev.slice-inode>" to firewall/cgroupv2 ATOMICALLY (mktemp in the
# same dir + rename(2)), so a guard reading concurrently never catches a torn
# write (-> spurious exit-88 / a one-frame UNFILTERED read). <base> is the
# cgroup2-root-relative virtdev.slice path; its inode is the one the ruleset was
# just frozen against, so recording it here (post-load) — not at apply time —
# means a reboot re-records against the new inode and never bricks the guard.
# Returns non-zero on any failure (the caller turns that into exit 97).
firewall_record_baseline() {
  local -r uid="${1:?firewall_record_baseline: uid required}"
  local -r base="${2:?firewall_record_baseline: base required}"
  local inode
  inode="$(stat -c %i "/sys/fs/cgroup/${base}" 2>/dev/null || true)"
  [[ "${inode}" =~ ^[0-9]+$ ]] || return 1
  install -d -m 0755 -o root -g root "${firewall_state_dir}" || return 1
  local tmp
  tmp="$(mktemp -p "${firewall_state_dir}" cgroupv2.XXXXXX)" || return 1
  { printf '%s %s\n' "${uid}" "${inode}" >"${tmp}" \
      && chmod 0644 "${tmp}" \
      && mv -f "${tmp}" "${firewall_cgroupv2_file}"; } \
    || { rm -f "${tmp}"; return 1; }
}

# firewall_hold — ExecStart of virtdev-firewall.service (root, resident).
# Loads the installed ruleset into the `owner,persist` table via a persistent
# nft session and HOLDS that session open, so the table stays owned (and thus
# unflushable by other processes) for as long as the service runs. nft's owner
# protection lives only while the creating socket is open, so the service must
# stay resident; when it stops or dies, persist keeps the rules in place but the
# table becomes flushable and the guard (firewall_is_active) reports down.
#
# Four steps (panel §6): (1) DERIVE the uid + cgroup base from the installed
# ruleset — a boot system unit has no SUDO_UID; (2) WAIT for the pin-backed zone
# cgroup DIRS (an empty slice has none, so unit state is insufficient — bounded,
# exit 99 on timeout so the guard reads down = fail CLOSED; this also resolves
# the system-unit-cannot-After-a-user-unit boot ordering); (3) LOAD + verify the
# table came up (exit 97); (4) RECORD the frozen <uid> <inode> baseline so the
# guard can fail closed on a later user-manager teardown. Then notify ready and
# wait. SIGTERM exits cleanly; a crash returns non-zero so Restart= re-asserts.
firewall_hold() {
  [[ -f "${firewall_nft_file}" ]] \
    || error 96 <<<"ruleset not installed: ${firewall_nft_file}. Run: sudo virtdev firewall apply"
  # The EXIT trap reaps the forked nft -i child on EVERY exit path (signal,
  # error, normal) so a standalone `hold` never leaks an owner,persist child —
  # an orphan keeps the table owned and would block a later destroy/re-apply.
  # Under the service's KillMode=control-group the child is reaped anyway; this
  # makes the guarantee hold without it. The signal traps just exit, so the
  # single EXIT handler runs once.
  local holder=""
  trap '[[ -n "${holder:-}" ]] && kill "${holder}" 2>/dev/null || true' EXIT
  trap 'exit 0' TERM INT

  # 1. Derive uid + cgroup base from the installed ruleset. Only the base-jump
  #    literal ends in `virtdev.slice"` (the relaxation jumps end in
  #    `-<zone>.slice"`), so the substitution matches exactly that one line; the
  #    uid is identical across all three literals, so head -1 is a safe guard.
  #    CROSS-REF: this parses firewall_generate's base-jump emit (its
  #    `… jump virtdev_machines` printf); a change to that literal's shape needs a
  #    matching change here (no lint catches the drift).
  local uid base
  read -r uid base < <(
    sed -n 's#.*"\(user\.slice/user-\([0-9]\+\)\.slice/[^"]*virtdev\.slice\)".*#\2 \1#p' \
      "${firewall_nft_file}" | head -1
  ) || true
  [[ "${uid}" =~ ^[1-9][0-9]*$ && -n "${base}" ]] \
    || error 96 <<<"could not derive uid/base from ${firewall_nft_file}; re-run: sudo virtdev firewall apply"

  # 2. Wait for the pin-backed zone cgroup DIRS (what nft resolves to inodes; an
  #    empty slice has no dir). Bounded ~30 s; on timeout exit 99 (distinct from
  #    97) -> service failed -> guard reads down (fail CLOSED). The set is derived
  #    from the INSTALLED RULESET — every "<base>/virtdev-<zone>.slice" dispatch
  #    literal — NOT from a registry enumeration: the holder is a root service with
  #    no access to the user's custom-zone config, and deriving from the ruleset
  #    covers exactly the slices nft will resolve (built-ins + customs), no drift.
  #    The base-jump literal ends in "virtdev.slice" (no -<zone>), so it is not
  #    matched here. CROSS-REF: this parses firewall_generate's per-zone dispatch
  #    emit (its `… "%s/%s" jump zone_%s` printf); keep the two shapes in lockstep.
  local -a waitdirs=()
  local s
  while IFS= read -r s; do
    waitdirs+=( "/sys/fs/cgroup/${s}" )
  done < <(sed -n 's#.*"\([^"]*/virtdev-[a-z0-9_]\+\.slice\)".*#\1#p' "${firewall_nft_file}" | sort -u)
  local i d ok
  for (( i = 0; i < 150; i++ )); do
    ok=1
    for d in "${waitdirs[@]}"; do [[ -d "${d}" ]] || { ok=0; break; }; done
    (( ok )) && break
    sleep 0.2
  done
  for d in "${waitdirs[@]}"; do
    [[ -d "${d}" ]] \
      || error 99 <<<"holder: zone-slice cgroup dir never appeared: ${d}. Are the firewall pins running? (loginctl enable-linger; they start under the user manager)"
  done

  # 3. Load the ruleset into the owner,persist table and hold the session open.
  #    Interactive nft is line-oriented and cannot parse the multi-line block
  #    file, so feed it one `include` line plus a never-ending tail (the table is
  #    owned by that nft -i socket). Cross-process reads ARE allowed on owner
  #    tables, so the post-load poll can confirm it came up.
  nft -i < <(printf 'include "%s"\n' "${firewall_nft_file}"; exec sleep infinity) &
  holder=$!

  for (( i = 0; i < 25; i++ )); do
    nft list table inet "${firewall_table_name}" >/dev/null 2>&1 && break
    kill -0 "${holder}" 2>/dev/null || break
    sleep 0.2
  done
  # On any error below the EXIT trap reaps the child, so the failure arms do not
  # re-kill it (fail CLOSED: a down holder reads guard-down).
  if ! nft list table inet "${firewall_table_name}" >/dev/null 2>&1; then
    error 97 <<<"holder: 'inet ${firewall_table_name}' did not come up from ${firewall_nft_file}"
  fi

  # 4. Record the frozen baseline <uid> <virtdev.slice-inode> (atomic; §4). On
  #    failure the EXIT trap tears down the owning session so the guard reads
  #    down (fail CLOSED) rather than running with no recorded baseline.
  firewall_record_baseline "${uid}" "${base}" \
    || error 97 <<<"holder: failed recording ${firewall_cgroupv2_file}"

  systemd-notify --ready 2>/dev/null || true
  wait "${holder}"
}

# Rootless report of whether the lockdown is active. Uses the shared
# firewall_is_active predicate. Prints a single machine-readable token to
# stdout (active|inactive) and exits 0/1 accordingly.
firewall_status() {
  if firewall_is_active; then
    printf 'active\n'
    return 0
  fi
  printf 'inactive\n'
  return 1
}

# ── main: subcommand dispatch (apply|status) ────────────────────────
# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([virtdev-home]=value)
# shellcheck disable=SC2034
declare -A spec_placeholders=([virtdev-home]=path)
# shellcheck disable=SC2034
declare -a spec_positionals=("subcommand?" "args*")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

# --virtdev-home is an apply-only coordination input: the self-elevating rootless
# apply forwards the user's VIRTDEV_HOME through it across the sudo boundary so the
# root apply can take the SAME rootless lock the launches hold. Ignored by status/hold.
case "${1:-status}" in
  apply)  firewall_apply "${flags[virtdev-home]:-}" ;;
  status) firewall_status ;;
  hold)   firewall_hold ;;
  *)      error 64 <<<"$(arguments_usage spec); subcommands: apply status hold" ;;
esac
