#!/usr/bin/env bash
#
# virtdev-wait <project>
#
# Polls until SSH is accepting authenticated connections
# on the project's forwarded port, then exits 0.
# Useful after virtdev-start for scripted start -> provision flows:
#
#     virtdev-start myproject && virtdev-wait myproject && virtdev-ssh myproject ./provision.sh
#
# Polls every 2 seconds. Fails if SSH is not up within the timeout.
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME          Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY       Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_WAIT_TIMEOUT  Default: 120
#
# Exit codes:
#
#   0   SSH became available
#   2   invalid project name
#   3   project not found
#   6   virtual machine exited before SSH became available
#   7   timed out waiting for SSH
#   64  usage error
#   77  SSH key not found
#   78  SSH key permissions too open
#   81  corrupt port file
#   87  project has no port assigned (virtual machine not running)

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments ssh port project integer

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${VIRTDEV_WAIT_TIMEOUT:=120}"

if ! integer_is_bounded_positive "${VIRTDEV_WAIT_TIMEOUT}" 86400; then
  error 64 <<<"Invalid VIRTDEV_WAIT_TIMEOUT: must be an integer from 1 through 86400"
fi

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"


project_require "${project}"

port=""
port_require port "${project}"

ssh_key_validate "${VIRTDEV_SSH_KEY}"

printf >&2 'Waiting for %s to bind SSH on port %d with timeout %ds...\n' \
       "${project}" "${port}" "${VIRTDEV_WAIT_TIMEOUT}"

unit=virtdev-"${project}"

rc=0
ssh_poll_until_ready "${VIRTDEV_SSH_KEY}" "${port}" "${unit}" "${VIRTDEV_WAIT_TIMEOUT}" || rc=$?

case "${rc}" in
  0)
    printf >&2 'SSH is up: %s port %d\n' "${project}" "${port}"
    ;;
  2)
    error 6 <<MESSAGE
Virtual machine exited before SSH became available: ${project}
Inspect with: journalctl --user -u ${unit}
MESSAGE
    ;;
  *)
    error 7 <<MESSAGE
Timed out after ${VIRTDEV_WAIT_TIMEOUT}s waiting for SSH: ${project}
Is the virtual machine running? Start it with: virtdev-start ${project}
MESSAGE
    ;;
esac
