#!/usr/bin/env bash
#
# virtdev-disk <project>
#
# Shows disk usage information for a project virtual machine.
# Reports actual file sizes and qcow2 virtual sizes for both
# the system and home disk images.
#
# The project does not need to be running.
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments project terminal

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require "${project}"

if ! command -v qemu-img &>/dev/null; then
  error 5 <<MESSAGE
qemu-img not found
Install it with: pacman -S qemu-img
MESSAGE
fi

system_disk="${project_directory}/system.qcow2"
home_disk="${project_directory}/home.qcow2"

disk_info() {
  local -r path="${1}"
  local -r label="${2}"
  if [[ ! -f "${path}" ]]; then
    printf >&2 '%s: not found\n' "${label}"
    return
  fi
  local actual virtual backing info_text bytes backing_path
  actual="$(du -sh "${path}" 2>/dev/null | cut -f1)"
  # Parse qemu-img's human output, NOT --output=json: modern qemu-img
  # nests a children->file node that also carries "virtual-size", so a
  # flat grep over the JSON matched twice and printed the wrong
  # (underlying host-file) size. The human "virtual size:" and
  # "backing file:" lines are top-level and unambiguous.
  info_text="$(qemu-img info "${path}" 2>/dev/null || true)"
  bytes="$(printf '%s\n' "${info_text}" \
    | sed -n 's/^virtual size:.*(\([0-9]\{1,\}\) bytes).*/\1/p')"
  if [[ -n "${bytes}" ]]; then
    virtual="$(numfmt --to=iec-i --suffix=B "${bytes}")"
  else
    virtual="?"
  fi
  backing=""
  backing_path="$(printf '%s\n' "${info_text}" | sed -n 's/^backing file: //p')"
  if [[ -n "${backing_path}" ]]; then
    # Strip any " (actual path: ...)" suffix qemu-img appends.
    backing_path="${backing_path%% (actual path:*}"
    backing=" (backing: $(basename "${backing_path}"))"
  fi
  printf '  %-8s %6s / %-10s %s%s\n' "${label}" "${actual}" "${virtual}" "$(basename "${path}")" "${backing}"
}

# Color keyed on stdout, this command's output destination.
terminal_init "" 1

printf '%s\n' "$(terminal_write bold "${project}" reset)"

if project_is_detached "${project}"; then
  printf '  mode: detached (standalone)\n'
else
  printf '  mode: delta\n'
fi

printf '\n'
disk_info "${system_disk}" "system"
disk_info "${home_disk}" "home"

total="$(du -sh "${project_directory}" 2>/dev/null | cut -f1)"
printf '\n  total: %s\n' "${total}"
