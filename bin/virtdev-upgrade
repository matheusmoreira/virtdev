#!/usr/bin/env bash
# shellcheck disable=SC2154  # virtdev_bin_directory provided by lib/virtdev/import
#
# virtdev-upgrade [--only=project,...] [--except=project,...]
#                 [--yes] [--verbose]
#
# Audits projects, backs up and stops them, interactively reseals the base,
# rebuilds them, then prints recovery commands under one inherited store lock.
# Reseal is the commit point. Coupled qcow2 projects cannot be filtered out;
# detached projects may be. Rebuild is best-effort across the selected fleet.
#
# Exit codes:
#   3 base missing; 4 conflicting filters; 5 unknown filtered project;
#   6/7 audit failure; 8 aborted; 9 generation missing; 10 no projects;
#   11 empty selection; 12 coupled project excluded; 13 excluded detached
#   project not stopped; 14 bad base SSH contract; 20 backup failure;
#   30 maintenance failure; 40 rebuild failure; 41 unprovisioned rebuild.
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments manifest project snapshot confirm terminal firewall recreate-result lock ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=(
  [only]=value
  [except]=value
  [zone]=value
  [unfiltered]=bool
  [yes]=bool
  [verbose]=bool
)
# shellcheck disable=SC2034
declare -A spec_short=([y]=yes [v]=verbose)
# shellcheck disable=SC2034
declare -A spec_placeholders=([only]=projects [except]=projects [zone]=zone)
# shellcheck disable=SC2034
declare -a spec_positionals=()
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

if [[ -n "${flags[only]}" && -n "${flags[except]}" ]]; then
  error 4 <<<"--only and --except are mutually exclusive"
fi

lock_acquire

# Resolve the requested zone (Phase 2). An explicit --zone forces every rebuilt
# machine into that zone; otherwise each machine that was running is restored to
# its prior zone (captured in Phase 1, before the stop), and a stopped machine
# falls to its project zone file (resolved down in virtdev-start).
zone_arg="${flags[zone]:-}"
if [[ -n "${zone_arg}" ]]; then
  # Charset is validated UNCONDITIONALLY (matching virtdev-start): a malformed
  # --zone must fail up-front — even under --unfiltered — not be deferred to
  # Phase 3 recreate (after every backup + the maintain). The realized-zone
  # (manifest) check IS skipped under --unfiltered: the lockdown is not enforced
  # (and may not be applied at all), so the zone need not exist there.
  firewall_zone_name_valid "${zone_arg}" \
    || error 64 <<<"invalid --zone '${zone_arg}' (lowercase letters/digits/_, no dashes or dots)"
  if (( ! flags[unfiltered] )); then
    firewall_zone_valid "${zone_arg}" \
      || error 64 <<<"unknown or unapplied --zone '${zone_arg}'. Active zones: $(firewall_zones_active | paste -sd' ')"
  fi
fi

# Forward the firewall escape hatch to the lockdown-enforcing sub-invocations
# (Phase 1 start, Phase 2 maintain; Phase 3 recreate appends its own below), so
# `upgrade --unfiltered` works on a host whose firewall is not applied.
unfiltered_opt=()
(( flags[unfiltered] )) && unfiltered_opt=(--unfiltered)

# ── Parse --only / --except into arrays ──────────────────────────────

declare -a only_list=()
declare -a except_list=()
declare -A except_set=()

if [[ -n "${flags[only]}" ]]; then
  IFS=',' read -ra only_list <<< "${flags[only]}"
  for name in "${only_list[@]}"; do
    validate_project_name "${name}"
  done
fi

if [[ -n "${flags[except]}" ]]; then
  IFS=',' read -ra except_list <<< "${flags[except]}"
  for name in "${except_list[@]}"; do
    validate_project_name "${name}"
    except_set["${name}"]=1
  done
fi

# ── Enumerate projects ───────────────────────────────────────────────

projects_directory="${VIRTDEV_HOME}/projects"
system_directory="${VIRTDEV_HOME}/system"

if [[ ! -d "${system_directory}" ]]; then
  error 3 <<MESSAGE
Sealed base system not found: '${system_directory}'
Create it with virtdev-iso, virtdev-install and virtdev-seal.
MESSAGE
fi

if ! ssh_guest_contract_valid "${system_directory}"; then
  error 14 <<MESSAGE
Sealed-base SSH contract marker is missing or incompatible.
No backup or maintenance phase was started. If the base predates strict host
identity, use the previous virtdev version to back up projects, then build,
install, and seal the current ISO. virtdev-upgrade cannot cross that boundary.
MESSAGE
fi

system_generation_file="${system_directory}/generation"
if [[ ! -f "${system_generation_file}" ]]; then
  error 9 <<<"Base system generation file missing: '${system_generation_file}'"
fi
base_generation="$(generation_read_base "${system_generation_file}")"

declare -a valid_projects=()
project_list_into valid_projects \
  || error 6 <<<'Could not completely enumerate projects; upgrade was refused.'

if [[ ${#valid_projects[@]} -eq 0 ]]; then
  error 10 <<<"No projects found."
fi

# Apply --only or --except filter.
declare -a included=()
declare -a excluded=()
declare -A excluded_reasons=()

if [[ ${#only_list[@]} -gt 0 ]]; then
  declare -A only_set=()
  for name in "${only_list[@]}"; do
    if [[ ! -d "${projects_directory}/${name}" ]]; then
      error 5 <<<"Project not found: ${name}"
    fi
    only_set["${name}"]=1
  done
  for p in "${valid_projects[@]}"; do
    if [[ -v only_set["${p}"] ]]; then
      included+=("${p}")
    else
      excluded+=("${p}")
      excluded_reasons["${p}"]="--only"
    fi
  done
elif [[ ${#except_list[@]} -gt 0 ]]; then
  for name in "${except_list[@]}"; do
    if [[ ! -d "${projects_directory}/${name}" ]]; then
      error 5 <<<"Project not found: ${name}"
    fi
  done
  for p in "${valid_projects[@]}"; do
    if [[ -v except_set["${p}"] ]]; then
      excluded+=("${p}")
      excluded_reasons["${p}"]="--except"
    else
      included+=("${p}")
    fi
  done
else
  included=("${valid_projects[@]}")
fi

# Auto-skip detached projects before manifest audit. They are independent of
# the base and do not need either a backup manifest or a rebuild. Doing this
# first keeps an intentionally manifest-less detached archive from blocking an
# otherwise valid fleet upgrade.
declare -a included_after_detach=()
for p in "${included[@]}"; do
  if project_is_detached "${p}"; then
    excluded+=("${p}")
    excluded_reasons["${p}"]="detached"
  else
    included_after_detach+=("${p}")
  fi
done
included=("${included_after_detach[@]}")

# ── Audit ───────────────────────────────────────────────────────────

declare -a audit_failures=()

for p in "${included[@]}"; do
  if ! manifest_resolve "${p}" >/dev/null; then
    audit_failures+=("${p}: missing manifest")
  elif ! manifest_has_entries "$(manifest_resolve "${p}")"; then
    audit_failures+=("${p}: empty manifest")
  fi
done

if [[ ${#audit_failures[@]} -gt 0 ]]; then
  {
    printf 'Audit failed. These projects cannot be safely upgraded:\n\n'
    for failure in "${audit_failures[@]}"; do
      printf '    %s\n' "${failure}"
    done
    printf '\nCreate a manifest for each. A coupled project cannot be safely excluded from a reseal; detach it first if it must remain independent.\n'
  } >&2
  error 6 <<<"Aborting."
fi

# Check for already-outdated + stopped projects that can't be backed up.
declare -a outdated_blocked=()
declare -a included_after_skip=()

for p in "${included[@]}"; do
  outdated_status=0
  project_is_outdated "${p}" || outdated_status=$?
  if (( outdated_status == 2 || outdated_status == 3 )); then
    # Corrupt generation file: cannot assess, and must never be fed
    # into the backup/recreate pipeline. Exclude with a reason instead
    # of falling through to the else branch (which would treat it as a
    # normal rebuild candidate and recreate off the corrupt file).
    # Status 3 (corrupt BASE) is pre-empted by the base-generation read
    # near the top of this script (which aborts with code 82), so in
    # practice only 2 reaches here; guarding both keeps a future
    # reordering from feeding corruption into recreate.
    excluded+=("${p}")
    excluded_reasons["${p}"]="corrupt generation file"
  elif (( outdated_status == 0 )) && ! project_is_running "${p}"; then
    outdated_blocked+=("${p}")
  else
    included_after_skip+=("${p}")
  fi
done

if [[ ${#outdated_blocked[@]} -gt 0 ]]; then
  {
    printf 'These projects are already outdated and stopped.\n'
    printf 'They cannot be started for backup (virtdev-start refuses generation mismatches).\n\n'
    for p in "${outdated_blocked[@]}"; do
      printf '    %s\n' "${p}"
    done
    printf '\nDo not exclude or destroy them: each still contains data tied to its previous base.\n'
    printf 'Recover with the matching base and virtdev version, take and verify a snapshot, then retry.\n'
  } >&2
  error 7 <<<"Aborting."
fi

included=("${included_after_skip[@]}")

# The maintenance phase replaces system/ in place and retires the old base.
# Every non-detached delta therefore has to be backed up and rebuilt in this
# same transaction. A backup alone is not enough: an omitted project's live
# qcow2 delta still names system/{system,home}.qcow2 and would silently compose
# against the replacement bytes. Fail before the plan/confirmation and before
# any VM is stopped.
declare -a excluded_coupled=()
for p in "${excluded[@]}"; do
  if ! project_is_detached "${p}"; then
    excluded_coupled+=("${p}")
  fi
done

if [[ ${#excluded_coupled[@]} -gt 0 ]]; then
  {
    printf 'Cannot reseal while coupled projects are excluded.\n\n'
    printf 'These projects still depend on the exact current base bytes:\n\n'
    for p in "${excluded_coupled[@]}"; do
      printf '    %-30s (%s)\n' "${p}" "${excluded_reasons[${p}]}"
    done
    printf '\nInclude and rebuild them in this upgrade, or detach them before the base changes.\n'
    printf 'No virtual machine was stopped and the base is unchanged.\n'
  } >&2
  error 12 <<<"Aborting."
fi

if [[ ${#included[@]} -eq 0 ]]; then
  error 11 <<<"No projects to upgrade after filtering."
fi

# virtdev-maintain requires every project unit stopped. Prove excluded detached
# projects terminal before Phase 1 stops any included VM; otherwise a running
# excluded project would make Phase 2 fail only after avoidable fleet downtime.
declare -a excluded_not_stopped=()
for p in "${excluded[@]}"; do
  if ! project_is_stopped "${p}"; then
    excluded_not_stopped+=("${p}")
  fi
done
if [[ ${#excluded_not_stopped[@]} -gt 0 ]]; then
  {
    printf 'Excluded detached projects must be stopped before upgrade:\n\n'
    printf '    %s\n' "${excluded_not_stopped[@]}"
    printf '\nStop them and retry. No included VM was stopped and the base is unchanged.\n'
  } >&2
  error 13 <<<"Aborting."
fi

# Discover provision scripts for the plan display.
declare -A provision_paths=()
for p in "${included[@]}"; do
  provision_hook="${XDG_CONFIG_HOME}/virtdev/projects/${p}/provision"
  if [[ -f "${provision_hook}" && -r "${provision_hook}" ]]; then
    provision_paths["${p}"]="${provision_hook}"
  fi
done

# Print the plan.
{
  printf '\n'
  printf 'Projects to upgrade: %d\n' "${#included[@]}"
  for p in "${included[@]}"; do
    printf '    %s\n' "${p}"
  done

  if [[ ${#excluded[@]} -gt 0 ]]; then
    printf '\nNot upgraded: %d\n' "${#excluded[@]}"
    for p in "${excluded[@]}"; do
      printf '    %-30s (%s)\n' "${p}" "${excluded_reasons[${p}]}"
    done
  fi

  if [[ ${#provision_paths[@]} -gt 0 ]]; then
    printf '\nProvision scripts found:\n'
    for p in "${included[@]}"; do
      if [[ -v provision_paths["${p}"] ]]; then
        printf '    %-30s %s\n' "${p}" "${provision_paths[${p}]}"
      fi
    done
  fi

  printf '\n'
  printf 'This will back up, maintain the base system, and rebuild all listed projects.\n'
} >&2

if (( ! flags[yes] )); then
  if ! confirm_word "upgrade"; then
    error 8 <<<"Aborted."
  fi
fi

# ── Phase 1: Backup ─────────────────────────────────────────────────

total_phases=4
declare -a stopped_projects=()
declare -a indeterminate_projects=()
declare -A backup_snapshots=()

# Capture each running machine's zone BEFORE Phase 1 stops it (the Slice
# property reads empty once stopped). Phase 3 passes each captured zone back to
# virtdev-recreate so a running machine returns to the zone it was in, rather
# than silently dropping to a more restrictive default. An explicit
# upgrade-level --zone overrides all. Keyed by project name; only populated for
# machines that were running.
declare -A prior_slices=()

abort_backup() {
  {
    printf '\n%s\n' "${1}"
    if [[ ${#stopped_projects[@]} -gt 0 ]]; then
      printf '\nVirtual machines stopped during this phase:\n'
      for s in "${stopped_projects[@]}"; do
        printf '    %s\n' "${s}"
      done
      printf '\nRestart them with: virtdev-start <project>\n'
    fi
    if [[ ${#indeterminate_projects[@]} -gt 0 ]]; then
      printf '\nVirtual machines whose stop could not be proven:\n'
      for s in "${indeterminate_projects[@]}"; do
        printf '    %s\n' "${s}"
      done
      printf '\nInspect each with systemctl --user status virtdev-<project>, then run virtdev-stop <project>.\n'
    fi
    printf 'Base is unchanged. Backups taken so far are preserved.\n'
  } >&2
  error 20 <<<"Aborting."
}

cleanup_started_project() {
  local -r p="${1}"
  if "${virtdev_bin_directory}/virtdev-stop" "${p}"; then
    stopped_projects+=("${p}")
  else
    indeterminate_projects+=("${p}")
  fi
}

command_render() {
  local -r first="${1}"
  shift
  printf '%q' "${first}"
  (( $# )) && printf ' %q' "$@"
}

upgrade_start_resume() {
  local -r p="${1}"
  local -a command=(virtdev-start)
  local restore_zone=""

  if [[ -n "${zone_arg}" ]]; then
    command+=(--zone "${zone_arg}")
  elif [[ -n "${prior_slices[${p}]:-}" ]]; then
    restore_zone="$(firewall_zone_to_restore "${prior_slices[${p}]}")"
    [[ -z "${restore_zone}" ]] || command+=(--zone "${restore_zone}")
  fi
  (( flags[unfiltered] )) && command+=(--unfiltered)
  command+=("${p}")
  command_render "${command[@]}"
}

upgrade_resume() {
  local -r p="${1}"
  local -a command=(virtdev-recreate --no-backup)
  if [[ -n "${backup_snapshots[${p}]:-}" ]]; then
    command+=(--snapshot "${backup_snapshots[${p}]}")
  fi
  if [[ -n "${provision_paths[${p}]:-}" ]]; then
    command+=(--provision "${provision_paths[${p}]}")
  else
    command+=(--no-provision)
  fi
  (( flags[verbose] )) && command+=(--verbose)
  if [[ -n "${zone_arg}" ]]; then
    command+=(--zone "${zone_arg}")
  elif [[ -n "${prior_slices[${p}]:-}" ]]; then
    local restore_zone
    restore_zone="$(firewall_zone_to_restore "${prior_slices[${p}]}")"
    [[ -z "${restore_zone}" ]] || command+=(--zone "${restore_zone}")
  fi
  (( flags[unfiltered] )) && command+=(--unfiltered)
  command+=("${p}")
  command_render "${command[@]}"
}

upgrade_create_recovery() {
  local -r p="${1}"
  local -a restore_command=(virtdev-restore)

  command_render virtdev-create "${p}"
  printf '\n%s\n' "$(upgrade_start_resume "${p}")"
  command_render virtdev-wait "${p}"
  printf '\n'
  if [[ -n "${provision_paths[${p}]:-}" ]]; then
    command_render virtdev-ssh "${p}" -- bash -s
    printf ' < '
    printf '%q\n' "${provision_paths[${p}]}"
  fi
  (( flags[verbose] )) && restore_command+=(--verbose)
  restore_command+=("${p}" "${backup_snapshots[${p}]}")
  command_render "${restore_command[@]}"
  printf '\n'
}

upgrade_recovery() {
  local -r p="${1}" result="${2}"
  if (( result == recreate_result_create_failed )); then
    upgrade_create_recovery "${p}"
  else
    upgrade_resume "${p}"
    printf '\n'
  fi
}

printf '\n%s\n' "$(terminal_write bold "[Phase 1/${total_phases}] Backing up project virtual machines..." reset)" >&2

for p in "${included[@]}"; do
  printf '\n  %s:\n' "${p}" >&2
  was_running=0
  if project_is_running "${p}"; then
    was_running=1
    prior_slices["${p}"]="$(firewall_slice_of_unit "virtdev-${p}.service")"
  fi

  if (( ! was_running )); then
    printf '    Starting...\n' >&2
    if ! "${virtdev_bin_directory}/virtdev-start" "${unfiltered_opt[@]}" "${p}"; then
      abort_backup "Backup failed: could not start ${p}."
    fi
    if ! "${virtdev_bin_directory}/virtdev-wait" "${p}"; then
      cleanup_started_project "${p}"
      abort_backup "Backup failed: SSH did not come up for ${p}."
    fi
  fi

  backup_opts=()
  (( flags[verbose] )) && backup_opts+=(--verbose)
  backup_path=""
  if ! backup_path="$("${virtdev_bin_directory}/virtdev-backup" \
      "${backup_opts[@]}" "${p}")"; then
    if (( ! was_running )); then
      cleanup_started_project "${p}"
    fi
    abort_backup "Backup failed for ${p}."
  fi
  if ! backup_snapshots["${p}"]="$(snapshot_id_from_path "${p}" "${backup_path}")"; then
    if (( ! was_running )); then
      cleanup_started_project "${p}"
    fi
    abort_backup "Backup returned an invalid snapshot path for ${p}: ${backup_path}"
  fi
  printf '    Snapshot: %s\n' "${backup_snapshots[${p}]}" >&2

  printf '    Stopping...\n' >&2
  if ! "${virtdev_bin_directory}/virtdev-stop" "${p}"; then
    indeterminate_projects+=("${p}")
    abort_backup "Failed to stop ${p} after backup."
  fi
  stopped_projects+=("${p}")
done

# ── Phase 2: Maintain ───────────────────────────────────────────────

printf '\n%s\n' "$(terminal_write bold "[Phase 2/${total_phases}] Maintaining base system..." reset)" >&2
printf 'This is the interactive phase. SSH into the maintenance virtual machine,\n' >&2
printf 'perform updates, and power off when done.\n\n' >&2

if ! "${virtdev_bin_directory}/virtdev-maintain" "${unfiltered_opt[@]}"; then
  {
    printf '\nMaintain did not complete successfully.\n'
    printf 'Base is unchanged. All project virtual machines are stopped.\n'
    printf 'Backups are preserved. Restart virtual machines with:\n'
    printf '\n'
    for p in "${included[@]}"; do
      printf '    virtdev-start %s\n' "${p}"
    done
    printf '\n'
  } >&2
  error 30 <<<"Aborting."
fi

# ── Phase 3: Rebuild ────────────────────────────────────────────────

printf '\n%s\n' "$(terminal_write bold "[Phase 3/${total_phases}] Rebuilding project virtual machines..." reset)" >&2

declare -a succeeded=()
declare -a unprovisioned=()
declare -a failed=()
declare -A fail_reasons=()
declare -A fail_codes=()

for p in "${included[@]}"; do
  printf '\n  Recreating %s...\n' "${p}" >&2
  recreate_opts=(--no-backup --yes --snapshot "${backup_snapshots[${p}]}")
  (( flags[verbose] )) && recreate_opts+=(--verbose)
  if [[ -n "${provision_paths[${p}]:-}" ]]; then
    recreate_opts+=(--provision "${provision_paths[${p}]}")
  else
    recreate_opts+=(--no-provision)
  fi
  # Restore each machine's prior zone across the rebuild (it is already stopped,
  # so recreate cannot recapture it). Precedence mirrors recreate/start: an
  # explicit upgrade --zone wins; else a machine that WAS running is restored to
  # its mapped zone (stray/legacy slice -> most restrictive 'none'); else pass
  # no --zone so recreate -> virtdev-start reads the project's zone file.
  if [[ -n "${zone_arg}" ]]; then
    recreate_opts+=(--zone "${zone_arg}")
  elif [[ -n "${prior_slices[${p}]:-}" ]]; then
    # Shared restore mapping (identical to virtdev-recreate): an unrecognised slice
    # maps to empty -> omit --zone so recreate -> virtdev-start reads the zone file.
    restore_zone="$(firewall_zone_to_restore "${prior_slices[${p}]}")"
    [[ -n "${restore_zone}" ]] && recreate_opts+=(--zone "${restore_zone}")
  fi
  (( flags[unfiltered] )) && recreate_opts+=(--unfiltered)

  if "${virtdev_bin_directory}/virtdev-recreate" "${recreate_opts[@]}" "${p}"; then
    succeeded+=("${p}")
  else
    exit_code=$?
    if (( exit_code == recreate_result_unprovisioned )); then
      # recreate succeeded but the provision script failed: the VM is up
      # on the new base, just unprovisioned. Surface it distinctly — not
      # a clean success, not a hard failure.
      unprovisioned+=("${p}")
    else
      failed+=("${p}")
      fail_codes["${p}"]="${exit_code}"
      fail_reasons["${p}"]="$(recreate_result_phase "${exit_code}" 2>/dev/null || printf '%s' unknown)"
    fi
  fi
done

# ── Phase 4: Summary ────────────────────────────────────────────────

new_generation="$(generation_read_base "${system_generation_file}")"

printf '\n%s\n\n' "$(terminal_write bold "[Phase 4/${total_phases}] Summary" reset)" >&2

if (( ${#failed[@]} == 0 && ${#unprovisioned[@]} == 0 )); then
  printf >&2 '%s\n' "$(terminal_write fg=green bold 'Upgrade complete.' reset)"
elif (( ${#succeeded[@]} > 0 || ${#unprovisioned[@]} > 0 )); then
  printf >&2 '%s\n' "$(terminal_write fg=yellow bold 'Upgrade incomplete.' reset)"
else
  printf >&2 '%s\n' "$(terminal_write fg=red bold 'Upgrade failed.' reset)"
fi

if [[ ${#succeeded[@]} -gt 0 ]]; then
  printf >&2 '\n%s\n' "$(terminal_write fg=green "Upgraded: ${#succeeded[@]}" reset)"
  for p in "${succeeded[@]}"; do
    printf >&2 '    %s\n' "${p}"
  done
fi

if [[ ${#unprovisioned[@]} -gt 0 ]]; then
  printf >&2 '\n%s\n' "$(terminal_write fg=yellow "Upgraded but unprovisioned: ${#unprovisioned[@]}" reset)"
  for p in "${unprovisioned[@]}"; do
    printf >&2 '    %s\n' "${p}"
  done
  printf >&2 '\nThese virtual machines are up on the new base; re-run their provisioning.\n'
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  printf >&2 '\n%s\n' "$(terminal_write fg=red "Failed: ${#failed[@]}" reset)"
  for p in "${failed[@]}"; do
    printf >&2 '    %s\n' "${p}"
  done
  printf >&2 '\n'
  for p in "${failed[@]}"; do
    printf >&2 '%s:\n' "${p}"
    printf >&2 '    Failed at: %s\n' "${fail_reasons[${p}]}"
    printf >&2 '    Exit code: %s\n' "${fail_codes[${p}]}"
    printf >&2 '    Resume with:\n'
    while IFS= read -r recovery_command; do
      printf >&2 '        %s\n' "${recovery_command}"
    done < <(upgrade_recovery "${p}" "${fail_codes[${p}]}")
    printf >&2 '\n'
  done
fi

if [[ ${#excluded[@]} -gt 0 ]]; then
  printf >&2 '%s\n' "$(terminal_write fg=yellow "Not upgraded: ${#excluded[@]}" reset)"
  for p in "${excluded[@]}"; do
    printf >&2 '    %-30s (%s)\n' "${p}" "${excluded_reasons[${p}]}"
  done
  printf >&2 '\nThese projects are detached and remain independent of the base.\n'
fi

printf >&2 '\nBase generation: %s → %s\n' "${base_generation}" "${new_generation}"

if [[ ${#failed[@]} -gt 0 ]]; then
  exit 40
fi

if [[ ${#unprovisioned[@]} -gt 0 ]]; then
  exit 41
fi
