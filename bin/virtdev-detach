#!/usr/bin/env bash
#
# virtdev-detach [--in-place] [--yes] <project>
#
# Converts a project's qcow2 delta images into standalone images by
# absorbing the sealed base system. This removes the backing file
# dependency, making the project immune to maintenance cycles and
# generation mismatches. Trade-off: larger disk footprint, independent
# updates required.
#
# Two conversion modes:
#
#   Default (convert-then-swap):
#       Creates new standalone images alongside the originals, verifies
#       them, then renames into place. Originals are untouched until the
#       swap. Temporarily needs extra disk space (roughly one copy of
#       the base per disk).
#
#   --in-place (rebase):
#       Modifies images in place via qemu-img rebase. Less disk space
#       and write volume. The journal can finish metadata publication after
#       completed rebases, but cannot roll back an interrupted image rewrite.
#
# Both modes verify the resulting images with qemu-img check.
#
# The project must be stopped. A detached project:
#
#   - Boots without a generation check (virtdev-start skips it)
#   - Is skipped by virtdev-upgrade (independent of the base)
#   - Shows 'detached' in virtdev-list's GENERATION column
#   - Returns to coupled state if recreated (virtdev-recreate)
#
# Lock model: acquires the virtdev lock before mutation. The conversion
# reads sealed base images and rewrites project qcow2 files.
#
# Exit codes:
#
#   0   success
#   3   project not found
#   4   virtual machine is running
#   5   already detached
#   6   disk has no backing file
#   7   project/base generation mismatch or invalid detach generation state
#   8   user aborted at confirmation prompt
#   10  rebase failed for system disk (--in-place)
#   11  rebase failed for home disk (--in-place)
#   12  verification failed (convert mode — project unchanged)
#   13  convert failed for system disk
#   14  convert failed for home disk
#   15  in-place: detached but verification failed (images may be corrupt)
#   16  detach recovery state is missing, corrupt, or does not match the disks
#   17  in-place disks committed but detached metadata is incomplete
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME    Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments project confirm terminal

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=(
  [in-place]=bool
  [yes]=bool
)
# shellcheck disable=SC2034
declare -A spec_short=([y]=yes)
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require_ordinary "${project}"

system_disk="${project_directory}/system.qcow2"
home_disk="${project_directory}/home.qcow2"
generation_file="${project_directory}/generation"
base_generation_file="${VIRTDEV_HOME}/system/generation"

detach_generation_require_current() {
  if [[ ! -f "${base_generation_file}" ]]; then
    error 7 <<<"Base generation file missing: ${base_generation_file}"
  fi
  if [[ ! -f "${generation_file}" ]]; then
    error 7 <<<"Project generation file missing: ${generation_file}"
  fi

  local base_generation project_generation
  base_generation="$(generation_read_base "${base_generation_file}")"
  project_generation="$(generation_read_project "${generation_file}")"

  if [[ "${project_generation}" == detached ]]; then
    error 7 <<MESSAGE
Generation metadata does not describe a coupled project and numeric base:
    Base:    ${base_generation}
    Project: ${project_generation}
Refusing to rewrite qcow2 backing data from inconsistent metadata.
MESSAGE
  fi

  if [[ "${project_generation}" != "${base_generation}" ]]; then
    error 7 <<MESSAGE
Project generation does not match the currently installed base:
    Base:    ${base_generation}
    Project: ${project_generation}

Detaching now would flatten the delta against replacement base bytes and can
silently corrupt the resulting standalone image. Recover the exact historical
base or restore/recreate the project instead.
MESSAGE
  fi

  printf '%s' "${project_generation}"
}

disk_backing_state() {
  local -n _detach_backing_state="${1}"
  local info

  info="$(qemu-img info --output=json "${2}")" || return 1
  if grep -q '"backing-filename"' <<< "${info}"; then
    _detach_backing_state=backed
  else
    _detach_backing_state=standalone
  fi
}

has_backing() {
  local state=''
  disk_backing_state state "${1}" && [[ "${state}" == backed ]]
}

# Repeated under the lock before disk mutation.
if ! project_is_stopped "${project}"; then
  error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
fi

system_bak="${system_disk}.bak"
home_bak="${home_disk}.bak"
detach_transaction="${project_directory}/.detach.transaction"
detach_transaction_tmp="${detach_transaction}.tmp"

disk_identity() {
  local -r disk="${1}"
  [[ -f "${disk}" && ! -L "${disk}" ]] || return 1
  stat -c '%d:%i' -- "${disk}"
}

detach_transaction_load() {
  if [[ ! -f "${detach_transaction}" || -L "${detach_transaction}" ]]; then
    error 16 <<<"Detach transaction is not a regular file: ${detach_transaction}"
  fi

  local LC_ALL=C file_size raw body sentinel=$'\x01'
  file_size="$(stat -c '%s' -- "${detach_transaction}" 2>/dev/null)" \
    || error 16 <<<"Cannot read detach transaction: ${detach_transaction}"
  raw="$({ head -c 513 -- "${detach_transaction}"; printf '%s' "${sentinel}"; } 2>/dev/null)"
  raw="${raw%"${sentinel}"}"
  if [[ ! "${file_size}" =~ ^[0-9]+$ || ${file_size} -gt 512 \
        || ${#raw} -ne file_size || "${raw}" != *$'\n' ]]; then
    error 16 <<<"Detach transaction is malformed or oversized: ${detach_transaction}"
  fi

  body="${raw%$'\n'}"
  local -a transaction_lines=()
  mapfile -t transaction_lines <<< "${body}"
  detach_txn_mode=''
  if (( ${#transaction_lines[@]} == 6 )) \
      && [[ "${transaction_lines[0]}" == version=1 \
        && "${transaction_lines[1]}" == "project=${project}" \
        && "${transaction_lines[2]}" == generation=* \
        && "${transaction_lines[3]}" == system_identity=* \
        && "${transaction_lines[4]}" == home_identity=* \
        && "${transaction_lines[5]}" == phase=swapping ]]; then
    detach_txn_mode=convert
  elif (( ${#transaction_lines[@]} == 7 )) \
      && [[ "${transaction_lines[0]}" == version=2 \
        && "${transaction_lines[1]}" == "project=${project}" \
        && "${transaction_lines[2]}" == generation=* \
        && "${transaction_lines[3]}" == system_identity=* \
        && "${transaction_lines[4]}" == home_identity=* \
        && "${transaction_lines[5]}" == mode=* \
        && "${transaction_lines[6]}" == phase=* ]]; then
    detach_txn_mode="${transaction_lines[5]#mode=}"
    detach_txn_phase="${transaction_lines[6]#phase=}"
    case "${detach_txn_mode}:${detach_txn_phase}" in
      convert:swapping|in-place:rebasing) ;;
      *) detach_txn_mode='' ;;
    esac
  fi
  if [[ -z "${detach_txn_mode}" ]]; then
    error 16 <<<"Detach transaction identity does not match this operation: ${detach_transaction}"
  fi

  detach_txn_generation="${transaction_lines[2]#generation=}"
  detach_txn_system_identity="${transaction_lines[3]#system_identity=}"
  detach_txn_home_identity="${transaction_lines[4]#home_identity=}"
  if [[ ! "${detach_txn_generation}" =~ ^(0|[1-9][0-9]*)$ \
        || ${#detach_txn_generation} -gt 10 \
        || ! "${detach_txn_system_identity}" =~ ^[0-9]+:[0-9]+$ \
        || ! "${detach_txn_home_identity}" =~ ^[0-9]+:[0-9]+$ ]]; then
    error 16 <<<"Detach transaction fields are invalid: ${detach_transaction}"
  fi
  # shellcheck disable=SC2154  # generation_max comes from the project library
  if (( 10#${detach_txn_generation} > generation_max )); then
    error 16 <<<"Detach transaction generation is out of range: ${detach_transaction}"
  fi
}

detach_transaction_require_identity() {
  local -r path="${1}" expected="${2}" role="${3}"
  local actual
  actual="$(disk_identity "${path}" 2>/dev/null)" \
    || error 16 <<<"Detach recovery ${role} is missing or not a regular file: ${path}"
  if [[ "${actual}" != "${expected}" ]]; then
    error 16 <<MESSAGE
Detach recovery ${role} does not match the journaled original disk: ${path}
    Expected identity: ${expected}
    Actual identity:   ${actual}
No recovery mutation was attempted.
MESSAGE
  fi
}

detach_transaction_write() {
  local -r generation="${1}" system_identity="${2}" home_identity="${3}" \
    mode="${4}" phase="${5}"
  printf 'version=2\nproject=%s\ngeneration=%s\nsystem_identity=%s\nhome_identity=%s\nmode=%s\nphase=%s\n' \
    "${project}" "${generation}" "${system_identity}" "${home_identity}" \
    "${mode}" "${phase}" \
    > "${detach_transaction_tmp}"
  chmod 600 "${detach_transaction_tmp}"
  if ! sync -f "${detach_transaction_tmp}"; then
    error 16 <<<"Could not durably write detach transaction: ${detach_transaction_tmp}"
  fi
  mv -T -- "${detach_transaction_tmp}" "${detach_transaction}"
  if ! sync -f "${project_directory}"; then
    error 16 <<<"Could not durably publish detach transaction: ${detach_transaction}"
  fi
}

detach_generation_publish() {
  local -r value="${1}" temporary="${generation_file}.detach.tmp"

  rm -f -- "${temporary}" || return 1
  printf '%s\n' "${value}" > "${temporary}" || return 1
  chmod 0644 -- "${temporary}" || return 1
  sync -f -- "${temporary}" || return 1
  mv -T -- "${temporary}" "${generation_file}" || return 1
  sync -f -- "${project_directory}"
}

detach_transaction_remove() {
  rm -f -- "${detach_transaction_tmp}" "${detach_transaction}" || return 1
  sync -f -- "${project_directory}"
}

# A journal binds recovery to both disk inodes. A .bak name alone has no
# recovery authority.
if [[ ( -e "${system_bak}" || -L "${system_bak}" \
        || -e "${home_bak}" || -L "${home_bak}" ) \
      && ! -e "${detach_transaction}" && ! -L "${detach_transaction}" ]]; then
  error 16 <<MESSAGE
Unexplained detach backup file found without a matching transaction journal.
No disk was changed. Inspect these paths manually:
    ${system_bak}
    ${home_bak}
MESSAGE
fi

if [[ -e "${detach_transaction}" || -L "${detach_transaction}" ]]; then
  lock_acquire
  # TOCTOU re-check under the lock: a concurrent start may have booted the VM.
  # Fail CLOSED: an unreachable manager reads as not-stopped, never as safe.
  if ! project_is_stopped "${project}"; then
    error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
  fi
  detach_transaction_load

  if [[ "${detach_txn_mode}" == in-place ]]; then
    if [[ -e "${system_bak}" || -L "${system_bak}" \
        || -e "${home_bak}" || -L "${home_bak}" ]]; then
      error 16 <<<'In-place detach journal conflicts with convert-mode backup files; no recovery mutation was attempted.'
    fi
    detach_transaction_require_identity \
      "${system_disk}" "${detach_txn_system_identity}" 'system disk'
    detach_transaction_require_identity \
      "${home_disk}" "${detach_txn_home_identity}" 'home disk'
    system_backing_state=''
    home_backing_state=''
    disk_backing_state system_backing_state "${system_disk}" \
      || error 17 <<<'Could not inspect the journaled in-place system disk; recovery state was preserved.'
    disk_backing_state home_backing_state "${home_disk}" \
      || error 17 <<<'Could not inspect the journaled in-place home disk; recovery state was preserved.'
    if [[ "${system_backing_state}" != standalone \
        || "${home_backing_state}" != standalone ]]; then
      error 17 <<MESSAGE
In-place detach recovery cannot prove both exact disks are standalone.
    system: ${system_backing_state}
    home:   ${home_backing_state}
The journal was preserved. Inspect the images and restore from backup if either
interrupted rebase left an undefined image.
MESSAGE
    fi

    verify_failed=0
    qemu-img check -q "${system_disk}" || verify_failed=1
    qemu-img check -q "${home_disk}" || verify_failed=1
    detach_generation_publish detached || error 17 <<MESSAGE
Both journaled disks are standalone, but detached metadata could not be
published durably. The journal was preserved: ${detach_transaction}
MESSAGE
    detach_transaction_remove || error 17 <<MESSAGE
Detached metadata is committed, but journal cleanup could not be made durable:
${detach_transaction}
MESSAGE
    if (( verify_failed )); then
      error 15 <<MESSAGE
Project metadata was recovered as detached, but image verification failed.
Restore from backup if the images are corrupt: ${project}
MESSAGE
    fi
    printf >&2 '%s\n' "$(terminal_write fg=green "Recovered detached project: ${project}" reset)"
    exit 0
  fi

  if project_is_detached "${project}"; then
    [[ ! -e "${system_bak}" && ! -L "${system_bak}" ]] \
      || detach_transaction_require_identity \
           "${system_bak}" "${detach_txn_system_identity}" 'system backup'
    [[ ! -e "${home_bak}" && ! -L "${home_bak}" ]] \
      || detach_transaction_require_identity \
           "${home_bak}" "${detach_txn_home_identity}" 'home backup'
    if ! sync -f "${project_directory}"; then
      error 16 <<<'Could not make the completed detach durable; recovery files were preserved.'
    fi
    rm -f -- "${system_bak}" "${home_bak}" \
      "${system_disk}.detach" "${home_disk}.detach" \
      "${detach_transaction_tmp}"
    if ! sync -f "${project_directory}"; then
      error 16 <<<'Completed detach is safe, but recovery-file cleanup could not be made durable; the journal was preserved.'
    fi
    rm -f -- "${detach_transaction}"
    sync -f "${project_directory}" || true
    printf >&2 '%s\n' "$(terminal_write fg=green "Project is already detached: ${project}" reset)"
    exit 0
  fi

  printf >&2 '%s\n' "$(terminal_write fg=yellow 'Detected an interrupted journaled detach. Rolling back...' reset)"
  current_metadata=''
  current_metadata="$(generation_read_project "${generation_file}" 2>/dev/null)" \
    || error 16 <<<"Project generation is corrupt during detach recovery: ${generation_file}"
  if [[ "${current_metadata}" != "${detach_txn_generation}" \
        && "${current_metadata}" != detached ]]; then
    error 16 <<<"Project generation no longer matches the detach transaction; no recovery mutation was attempted."
  fi

  if [[ -e "${system_bak}" || -L "${system_bak}" ]]; then
    detach_transaction_require_identity \
      "${system_bak}" "${detach_txn_system_identity}" 'system backup'
  else
    detach_transaction_require_identity \
      "${system_disk}" "${detach_txn_system_identity}" 'system disk'
  fi
  if [[ -e "${home_bak}" || -L "${home_bak}" ]]; then
    detach_transaction_require_identity \
      "${home_bak}" "${detach_txn_home_identity}" 'home backup'
  else
    detach_transaction_require_identity \
      "${home_disk}" "${detach_txn_home_identity}" 'home disk'
  fi

  [[ ! -e "${system_bak}" && ! -L "${system_bak}" ]] \
    || mv -fT -- "${system_bak}" "${system_disk}"
  [[ ! -e "${home_bak}" && ! -L "${home_bak}" ]] \
    || mv -fT -- "${home_bak}" "${home_disk}"
  if ! has_backing "${system_disk}" || ! has_backing "${home_disk}"; then
    error 16 <<<'Journaled originals were restored, but their backing topology could not be verified; recovery state was preserved.'
  fi
  if ! detach_generation_publish "${detach_txn_generation}"; then
    error 16 <<<'Detach rollback completed in memory but could not be made durable; transaction state was preserved.'
  fi
  rm -f -- "${system_disk}.detach" "${home_disk}.detach" \
    "${detach_transaction_tmp}"
  if ! sync -f "${project_directory}"; then
    error 16 <<<'Detach rollback is safe, but temporary-file cleanup could not be made durable; the journal was preserved.'
  fi
  rm -f -- "${detach_transaction}"
  sync -f "${project_directory}" || true
  printf >&2 '%s\n' "$(terminal_write fg=green 'Recovery complete. Project restored to its pre-detach (coupled) state.' reset)"
  printf >&2 'Re-run virtdev-detach to detach it.\n'
  exit 0
fi

if project_is_detached "${project}"; then
  error 5 <<<"Already detached: ${project}"
fi

if ! has_backing "${system_disk}"; then
  error 6 <<<"System disk has no backing file: ${system_disk}"
fi

if ! has_backing "${home_disk}"; then
  error 6 <<<"Home disk has no backing file: ${home_disk}"
fi

current_generation="$(detach_generation_require_current)"

# Print summary.
{
  printf '\nDetaching project: %s\n' "${project}"
  printf '  System disk: %s\n' "${system_disk}"
  printf '  Home disk:   %s\n' "${home_disk}"
  printf '  Generation:  %s\n' "${current_generation}"
  if (( flags[in-place] )); then
    printf '  Mode:        journaled in-place (no image rollback)\n'
  else
    printf '  Mode:        convert (use --in-place to rebase in place)\n'
  fi
  printf '\n  No backup will be taken. Consider running virtdev-backup first.\n\n'
} >&2

if (( ! flags[yes] )); then
  if ! confirm_proceed; then
    error 8 <<<"Aborted."
  fi
fi

lock_acquire

# A concurrent detach may have created recovery state while this invocation was
# waiting for the global lock. Never overwrite it: release the lock by exiting
# and let a fresh invocation enter the journaled recovery branch above.
if [[ -e "${detach_transaction}" || -L "${detach_transaction}" \
      || -e "${system_bak}" || -L "${system_bak}" \
      || -e "${home_bak}" || -L "${home_bak}" ]]; then
  error 16 <<MESSAGE
Detach recovery state appeared while acquiring the lock.
No mutation was attempted; re-run virtdev-detach to validate and recover it.
MESSAGE
fi

# Discard unjournaled conversion temporaries from an interrupted pre-commit run.
rm -f -- "${system_disk}.detach" "${home_disk}.detach" \
  "${detach_transaction_tmp}" "${generation_file}.detach.tmp"

# Close the confirmation-to-lock race before mutating disks.
if ! project_is_stopped "${project}"; then
  error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
fi

if project_is_detached "${project}"; then
  error 5 <<<"Already detached: ${project}"
fi

if ! has_backing "${system_disk}"; then
  error 6 <<<"System disk has no backing file: ${system_disk}"
fi

if ! has_backing "${home_disk}"; then
  error 6 <<<"Home disk has no backing file: ${home_disk}"
fi

# Maintenance and generation metadata are protected by this same lock. Repeat
# the equality proof after acquiring it so neither a concurrent reseal nor a
# concurrent metadata repair can change the composition after confirmation.
current_generation="$(detach_generation_require_current)"

if (( flags[in-place] )); then
  # ── In-place mode (rebase) ──────────────────────────────────────

  system_original_identity="$(disk_identity "${system_disk}")" \
    || error 16 <<<"System disk is not a regular file: ${system_disk}"
  home_original_identity="$(disk_identity "${home_disk}")" \
    || error 16 <<<"Home disk is not a regular file: ${home_disk}"
  detach_transaction_write "${current_generation}" \
    "${system_original_identity}" "${home_original_identity}" \
    in-place rebasing

  printf >&2 'Rebasing system disk...\n'
  if ! qemu-img rebase -b "" -f qcow2 "${system_disk}"; then
    error 10 <<MESSAGE
Rebase failed for system disk: ${system_disk}
The image may be in an undefined state. The recovery journal was preserved;
inspect the image and restore from backup if needed.
MESSAGE
  fi

  printf >&2 'Rebasing home disk...\n'
  if ! qemu-img rebase -b "" -f qcow2 "${home_disk}"; then
    error 11 <<MESSAGE
Rebase failed for home disk: ${home_disk}
The system disk was already rebased. Both images may be in an
undefined state. The recovery journal was preserved; inspect the images and
restore from backup if needed.
MESSAGE
  fi

  printf >&2 'Verifying...\n'
  verify_failed=0
  if ! qemu-img check -q "${system_disk}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'Warning: system disk verification failed.' reset)"
    verify_failed=1
  fi
  if ! qemu-img check -q "${home_disk}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'Warning: home disk verification failed.' reset)"
    verify_failed=1
  fi

  detach_transaction_require_identity \
    "${system_disk}" "${system_original_identity}" 'system disk'
  detach_transaction_require_identity \
    "${home_disk}" "${home_original_identity}" 'home disk'
  system_backing_state=''
  home_backing_state=''
  disk_backing_state system_backing_state "${system_disk}" \
    || error 17 <<<'Could not verify the rebased system disk topology; the journal was preserved.'
  disk_backing_state home_backing_state "${home_disk}" \
    || error 17 <<<'Could not verify the rebased home disk topology; the journal was preserved.'
  if [[ "${system_backing_state}" != standalone \
      || "${home_backing_state}" != standalone ]]; then
    error 17 <<<'Rebase returned success without two standalone disks; the journal was preserved.'
  fi

  detach_generation_publish detached || error 17 <<MESSAGE
Both disks were rebased, but detached metadata could not be published durably.
The journal was preserved for recovery: ${detach_transaction}
MESSAGE
  detach_transaction_remove || error 17 <<MESSAGE
Detached metadata is committed, but journal cleanup could not be made durable:
${detach_transaction}
MESSAGE

  if (( verify_failed )); then
    printf >&2 '\n%s\n' "$(terminal_write fg=yellow "Project detached: ${project}, but verification FAILED — images may be corrupt." reset)"
    printf >&2 'Restore from backup if the images are bad.\n'
    exit 15
  fi

else
  # ── Default mode (convert-then-swap) ────────────────────────────

  system_detach="${system_disk}.detach"
  home_detach="${home_disk}.detach"

  detach_succeeded=0
  cleanup_detach_temps() {
    (( detach_succeeded )) || rm -f "${system_detach}" "${home_detach}"
  }
  trap cleanup_detach_temps EXIT

  printf >&2 'Converting system disk...\n'
  if ! qemu-img convert -O qcow2 "${system_disk}" "${system_detach}"; then
    error 13 <<MESSAGE
Convert failed for system disk: ${system_disk}
Project is unchanged. Check disk space and retry.
MESSAGE
  fi

  printf >&2 'Converting home disk...\n'
  if ! qemu-img convert -O qcow2 "${home_disk}" "${home_detach}"; then
    error 14 <<MESSAGE
Convert failed for home disk: ${home_disk}
Project is unchanged. Check disk space and retry.
MESSAGE
  fi

  printf >&2 'Verifying...\n'
  if ! qemu-img check -q "${system_detach}" || ! qemu-img check -q "${home_detach}"; then
    error 12 <<MESSAGE
Verification failed for converted images.
Project is unchanged. The converted images have been removed.
MESSAGE
  fi

  system_original_identity="$(disk_identity "${system_disk}")" \
    || error 16 <<<"System disk is not a regular file: ${system_disk}"
  home_original_identity="$(disk_identity "${home_disk}")" \
    || error 16 <<<"Home disk is not a regular file: ${home_disk}"
  detach_transaction_write "${current_generation}" \
    "${system_original_identity}" "${home_original_identity}" \
    convert swapping

  # The journal keeps the rename sequence recoverable until publication syncs.
  trap '' INT TERM HUP QUIT
  printf >&2 'Swapping...\n'
  mv -T -- "${system_disk}" "${system_bak}"
  mv -T -- "${system_detach}" "${system_disk}"
  mv -T -- "${home_disk}" "${home_bak}"
  mv -T -- "${home_detach}" "${home_disk}"
  if ! detach_generation_publish detached; then
    error 16 <<MESSAGE
The detach swap completed but could not be made durable.
Journal and original disks were preserved for recovery: ${detach_transaction}
MESSAGE
  fi
  rm -f -- "${system_bak}" "${home_bak}"
  if ! sync -f "${project_directory}"; then
    error 16 <<MESSAGE
The project is safely detached, but original-disk cleanup could not be made
durable. The transaction journal was preserved for a cleanup retry.
MESSAGE
  fi
  rm -f -- "${detach_transaction}"
  if ! sync -f "${project_directory}"; then
    printf >&2 'warning: detached project is committed, but cleanup durability could not be confirmed; a harmless transaction marker may reappear after power loss\n'
  fi
  trap - INT TERM HUP QUIT

  detach_succeeded=1
fi

printf 'Done.\n\n' >&2
printf >&2 '%s\n' "$(terminal_write fg=green "Project detached: ${project}" reset)"
