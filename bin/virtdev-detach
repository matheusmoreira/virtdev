#!/usr/bin/env bash
#
# virtdev-detach [--in-place] [--yes] <project>
#
# Converts a project's qcow2 delta images into standalone images by
# absorbing the sealed base system. This removes the backing file
# dependency, making the project immune to maintenance cycles and
# generation mismatches. Trade-off: larger disk footprint, independent
# updates required.
#
# Two conversion modes:
#
#   Default (convert-then-swap):
#       Creates new standalone images alongside the originals, verifies
#       them, then renames into place. Originals are untouched until the
#       swap. Temporarily needs extra disk space (roughly one copy of
#       the base per disk).
#
#   --in-place (rebase):
#       Modifies images in place via qemu-img rebase. Less disk space
#       and write volume. No rollback on interruption — if the rebase
#       is interrupted, the image is in an undefined state.
#
# Both modes verify the resulting images with qemu-img check.
#
# The project must be stopped. A detached project:
#
#   - Boots without a generation check (virtdev-start skips it)
#   - Is skipped by virtdev-upgrade (independent of the base)
#   - Shows 'detached' in virtdev-list's GENERATION column
#   - Returns to coupled state if recreated (virtdev-recreate)
#
# Lock model: acquires the virtdev lock before mutation. The conversion
# reads sealed base images and rewrites project qcow2 files.
#
# Exit codes:
#
#   0   success
#   3   project not found
#   4   virtual machine is running
#   5   already detached
#   6   disk has no backing file
#   7   project/base generation mismatch or invalid detach generation state
#   8   user aborted at confirmation prompt
#   10  rebase failed for system disk (--in-place)
#   11  rebase failed for home disk (--in-place)
#   12  verification failed (convert mode — project unchanged)
#   13  convert failed for system disk
#   14  convert failed for home disk
#   15  in-place: detached but verification failed (images may be corrupt)
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME    Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments project confirm terminal

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=(
  [in-place]=bool
  [yes]=bool
)
# shellcheck disable=SC2034
declare -A spec_short=([y]=yes)
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require "${project}"

system_disk="${project_directory}/system.qcow2"
home_disk="${project_directory}/home.qcow2"
generation_file="${project_directory}/generation"
base_generation_file="${VIRTDEV_HOME}/system/generation"

detach_generation_require_current() {
  if [[ ! -f "${base_generation_file}" ]]; then
    error 7 <<<"Base generation file missing: ${base_generation_file}"
  fi
  if [[ ! -f "${generation_file}" ]]; then
    error 7 <<<"Project generation file missing: ${generation_file}"
  fi

  local base_generation project_generation
  base_generation="$(generation_read_base "${base_generation_file}")"
  project_generation="$(generation_read_project "${generation_file}")"

  if [[ "${project_generation}" == detached ]]; then
    error 7 <<MESSAGE
Generation metadata does not describe a coupled project and numeric base:
    Base:    ${base_generation}
    Project: ${project_generation}
Refusing to rewrite qcow2 backing data from inconsistent metadata.
MESSAGE
  fi

  if [[ "${project_generation}" != "${base_generation}" ]]; then
    error 7 <<MESSAGE
Project generation does not match the currently installed base:
    Base:    ${base_generation}
    Project: ${project_generation}

Detaching now would flatten the delta against replacement base bytes and can
silently corrupt the resulting standalone image. Recover the exact historical
base or restore/recreate the project instead.
MESSAGE
  fi

  printf '%s' "${project_generation}"
}

has_backing() {
  qemu-img info --output=json "${1}" \
    | grep -q '"backing-filename"'
}

# Pre-lock checks: fast failure before the confirmation prompt.
# These are repeated under the lock below to close the TOCTOU window.
# Fail CLOSED: only a PROVABLY stopped machine proceeds — an unreachable manager
# reads as not-stopped, never as safe (detach mutates disks).
if ! project_is_stopped "${project}"; then
  error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
fi

system_bak="${system_disk}.bak"
home_bak="${home_disk}.bak"

# ── Interrupted-detach recovery (BEFORE the guards below) ───────────
# A prior detach interrupted mid-swap leaves .bak files AND a state the
# detached/has-backing guards below would mis-reject: a half-swapped project has
# standalone disks (no backing -> err 6), and a completed-but-uncleaned swap has
# generation=detached (-> err 5). So recover HERE — ahead of those guards — then
# exit. Recovery mutates disks, so it takes the lock and refuses a running VM.
# Re-run virtdev-detach afterward to detach a freshly-recovered (coupled) project.
if [[ -f "${system_bak}" || -f "${home_bak}" ]]; then
  lock_acquire
  # TOCTOU re-check under the lock: a concurrent start may have booted the VM.
  # Fail CLOSED: an unreachable manager reads as not-stopped, never as safe.
  if ! project_is_stopped "${project}"; then
    error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
  fi
  if [[ -f "${system_bak}" || -f "${home_bak}" ]]; then
    if project_is_detached "${project}"; then
      printf >&2 '%s\n' "$(terminal_write fg=yellow 'Cleaning up .bak files from a completed previous detach...' reset)"
      rm -f "${system_bak}" "${home_bak}"
      printf >&2 '%s\n' "$(terminal_write fg=green "Project is already detached: ${project}" reset)"
    else
      printf >&2 '%s\n' "$(terminal_write fg=yellow 'Detected an interrupted detach swap. Recovering...' reset)"
      [[ -f "${system_bak}" ]] && mv -f "${system_bak}" "${system_disk}"
      [[ -f "${home_bak}" ]]   && mv -f "${home_bak}" "${home_disk}"
      rm -f "${system_disk}.detach" "${home_disk}.detach"
      printf >&2 '%s\n' "$(terminal_write fg=green 'Recovery complete. Project restored to its pre-detach (coupled) state.' reset)"
      printf >&2 'Re-run virtdev-detach to detach it.\n'
    fi
  fi
  exit 0
fi

if project_is_detached "${project}"; then
  error 5 <<<"Already detached: ${project}"
fi

if ! has_backing "${system_disk}"; then
  error 6 <<<"System disk has no backing file: ${system_disk}"
fi

if ! has_backing "${home_disk}"; then
  error 6 <<<"Home disk has no backing file: ${home_disk}"
fi

current_generation="$(detach_generation_require_current)"

# Print summary.
{
  printf '\nDetaching project: %s\n' "${project}"
  printf '  System disk: %s\n' "${system_disk}"
  printf '  Home disk:   %s\n' "${home_disk}"
  printf '  Generation:  %s\n' "${current_generation}"
  if (( flags[in-place] )); then
    printf '  Mode:        in-place (no rollback on interruption)\n'
  else
    printf '  Mode:        convert (use --in-place to rebase in place)\n'
  fi
  printf '\n  No backup will be taken. Consider running virtdev-backup first.\n\n'
} >&2

if (( ! flags[yes] )); then
  if ! confirm_proceed; then
    error 8 <<<"Aborted."
  fi
fi

lock_acquire

# No .bak here — the interrupted-detach recovery near the top handles that case
# and exits, so the originals are intact. A SIGKILL during a prior convert can
# still leave orphaned .detach temp files (a full base-sized copy each, not
# touched by the .bak-keyed recovery); sweep them for disk-space/orphan hygiene.
# The convert's own EXIT trap covers ordinary signals; this covers a SIGKILL or
# power loss between runs.
rm -f "${system_disk}.detach" "${home_disk}.detach"

# Post-lock re-checks: close the TOCTOU window between the pre-lock
# checks and lock acquisition. A concurrent virtdev-start could have
# booted the VM, or a concurrent virtdev-detach could have completed.
# Fail CLOSED: only a PROVABLY stopped machine proceeds (unreachable manager reads as not-stopped).
if ! project_is_stopped "${project}"; then
  error 4 <<MESSAGE
Virtual machine is running: ${project}
Stop it first: virtdev-stop ${project}
MESSAGE
fi

if project_is_detached "${project}"; then
  error 5 <<<"Already detached: ${project}"
fi

if ! has_backing "${system_disk}"; then
  error 6 <<<"System disk has no backing file: ${system_disk}"
fi

if ! has_backing "${home_disk}"; then
  error 6 <<<"Home disk has no backing file: ${home_disk}"
fi

# Maintenance and generation metadata are protected by this same lock. Repeat
# the equality proof after acquiring it so neither a concurrent reseal nor a
# concurrent metadata repair can change the composition after confirmation.
current_generation="$(detach_generation_require_current)"

if (( flags[in-place] )); then
  # ── In-place mode (rebase) ──────────────────────────────────────

  printf >&2 'Rebasing system disk...\n'
  if ! qemu-img rebase -b "" -f qcow2 "${system_disk}"; then
    error 10 <<MESSAGE
Rebase failed for system disk: ${system_disk}
The image may be in an undefined state. Restore from backup.
MESSAGE
  fi

  printf >&2 'Rebasing home disk...\n'
  if ! qemu-img rebase -b "" -f qcow2 "${home_disk}"; then
    error 11 <<MESSAGE
Rebase failed for home disk: ${home_disk}
The system disk was already rebased. Both images may be in an
undefined state. Restore from backup.
MESSAGE
  fi

  printf >&2 'Verifying...\n'
  verify_failed=0
  if ! qemu-img check -q "${system_disk}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'Warning: system disk verification failed.' reset)"
    verify_failed=1
  fi
  if ! qemu-img check -q "${home_disk}"; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'Warning: home disk verification failed.' reset)"
    verify_failed=1
  fi

  printf 'detached\n' > "${generation_file}"
  chmod 644 "${generation_file}"

  if (( verify_failed )); then
    # The in-place rebase already removed the backing file (irreversible), so the
    # disks ARE standalone — the 'detached' marker above keeps the metadata
    # consistent with on-disk reality (gating it would leave a standalone project
    # wrongly marked coupled, which virtdev-start could then refuse to boot).
    # Exit 15, distinct from convert mode's exit 12 ("verify failed, project
    # UNCHANGED"), so a caller can tell "committed but maybe corrupt" from "safely
    # rolled back".
    printf >&2 '\n%s\n' "$(terminal_write fg=yellow "Project detached: ${project}, but verification FAILED — images may be corrupt." reset)"
    printf >&2 'Restore from backup if the images are bad.\n'
    exit 15
  fi

else
  # ── Default mode (convert-then-swap) ────────────────────────────

  system_detach="${system_disk}.detach"
  home_detach="${home_disk}.detach"

  detach_succeeded=0
  cleanup_detach_temps() {
    (( detach_succeeded )) || rm -f "${system_detach}" "${home_detach}"
  }
  trap cleanup_detach_temps EXIT

  printf >&2 'Converting system disk...\n'
  if ! qemu-img convert -O qcow2 "${system_disk}" "${system_detach}"; then
    error 13 <<MESSAGE
Convert failed for system disk: ${system_disk}
Project is unchanged. Check disk space and retry.
MESSAGE
  fi

  printf >&2 'Converting home disk...\n'
  if ! qemu-img convert -O qcow2 "${home_disk}" "${home_detach}"; then
    error 14 <<MESSAGE
Convert failed for home disk: ${home_disk}
Project is unchanged. Check disk space and retry.
MESSAGE
  fi

  printf >&2 'Verifying...\n'
  if ! qemu-img check -q "${system_detach}" || ! qemu-img check -q "${home_detach}"; then
    error 12 <<MESSAGE
Verification failed for converted images.
Project is unchanged. The converted images have been removed.
MESSAGE
  fi

  # Swap: rename originals aside, move converted images into place,
  # write the generation marker, then remove the originals. Signals
  # are trapped for the critical section — a SIGKILL or power loss
  # would leave .bak files which the recovery block above handles on
  # the next invocation.
  trap '' INT TERM HUP QUIT
  printf >&2 'Swapping...\n'
  mv "${system_disk}" "${system_bak}"
  mv "${system_detach}" "${system_disk}"
  mv "${home_disk}" "${home_bak}"
  mv "${home_detach}" "${home_disk}"
  printf 'detached\n' > "${generation_file}"
  chmod 644 "${generation_file}"
  rm -f "${system_bak}" "${home_bak}"
  trap - INT TERM HUP QUIT

  detach_succeeded=1
fi

printf 'Done.\n\n' >&2
printf >&2 '%s\n' "$(terminal_write fg=green "Project detached: ${project}" reset)"
