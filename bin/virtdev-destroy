#!/usr/bin/env bash
#
# virtdev-destroy [--yes] <project>
#
# Permanently deletes a project virtual machine and all its disk images.
# The project must not be running.
#
# Requires typing the project name to confirm. The --yes flag skips
# the prompt; it exists primarily for virtdev-recreate, which drives
# destroy as one step in the destroy/rebuild chain. Other scripted
# callers (bulk cleanup loops, pipelines) can use it too.
#
# This operation is irreversible.
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments snapshot confirm terminal project mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([yes]=bool)
# shellcheck disable=SC2034
declare -A spec_short=([y]=yes)
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

lock_acquire

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require_ordinary "${project}"

# Transitional or unknown state is not proof that deletion is safe.
if ! project_is_stopped "${project}"; then
  error 4 <<MESSAGE
Project virtual machine is running: ${project}
Stop it with: virtdev-stop ${project}
MESSAGE
fi

require_unmounted_project() {
  local mount_path="" status=0

  mount_find_below "$(realpath -m -- "${project_directory}")" mount_path \
    || status=$?
  case "${status}" in
    0)
      error 6 <<MESSAGE
Mounted filesystem detected below project directory: '${mount_path}'
Unmount it explicitly; project destruction was refused.
MESSAGE
      ;;
    1) ;;
    *) error 6 <<<'Could not inspect mount state; project destruction was refused.' ;;
  esac
}

require_unmounted_project

printf >&2 'This will permanently delete:\n\n'
printf >&2 '\t%s\n' "${project_directory}"
find "${project_directory}" -type f \
  | sort \
  | while IFS= read -r f; do
      printf >&2 '\t\t%s\t%s\n' "$(du -sh "${f}" 2>/dev/null | cut -f1 || true)" "$(basename "${f}")"
    done

backups_project_dir="$(snapshot_directory "${project}")"
backup_count=0
snapshot_count_into backup_count "${project}" \
  || error 6 <<<'Could not completely enumerate preserved backups; destruction was refused.'
if (( backup_count > 0 )); then
  printf >&2 '\nBackups preserved: %d snapshot(s) at %s\n' "${backup_count}" "${backups_project_dir}"
fi

printf >&2 '\nThis operation is irreversible.\n'

if (( ! flags[yes] )); then
  if ! confirm_word "${project}"; then
    error 5 <<<"Aborted."
  fi
fi

require_unmounted_project
mount_path=''
remove_status=0
mount_remove_tree "${project_directory}" mount_path || remove_status=$?
case "${remove_status}" in
  0) ;;
  1)
    error 6 <<<"Mounted filesystem appeared during project destruction: '${mount_path}'"
    ;;
  *) error 6 <<<'Project directory changed or could not be removed safely.' ;;
esac
printf >&2 '%s\n' "$(terminal_write fg=green "Project destroyed: ${project}" reset)"
