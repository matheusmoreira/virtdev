#!/usr/bin/env bash
#
# virtdev-list
#
# Lists all project virtual machines with their SSH port and status.
#
# Output columns:
#
#   PROJECT   Name of the project virtual machine
#   PORT      Host-side SSH forwarding port
#   STATUS    running | stopped
#   ZONE      Network zone of a running virtual machine, derived from its
#             live systemd slice AND the host egress lockdown being active:
#             none | wan | full | UNFILTERED (the lockdown is down, so the
#             machine is not actually filtered) | - (stopped).
#   GENERATION  Base generation the project was created against,
#               or 'detached' for standalone projects
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error arguments project terminal port firewall

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

mapfile -t projects < <(project_list)

if [[ ${#projects[@]} -eq 0 ]]; then
  printf >&2 'No projects found.\n'
  exit 0
fi

# Color decision keyed on stdout (the table's destination), not stderr:
# `virtdev list | grep` or `virtdev list > file` must not embed ANSI
# escapes in the machine-readable output.
terminal_init "" 1

system_generation_file="${VIRTDEV_HOME}/system/generation"
if [[ -s "${system_generation_file}" ]]; then
  base_generation="$(generation_read_lenient "${system_generation_file}")"
else
  base_generation='-'
  printf >&2 'warning: base system generation file missing: %s\n' "${system_generation_file}"
fi

max_name=7
for project in "${projects[@]}"; do
  (( ${#project} > max_name )) && max_name=${#project}
done
(( max_name += 2 ))

printf "%-${max_name}s %-5s %-8s %-10s %s\n" 'PROJECT' 'PORT' 'STATUS' 'ZONE' 'GENERATION'
printf "%-${max_name}s %-5s %-8s %-10s %s\n" '-------' '----' '------' '----' '----------'

declare -A running_state=()
project_load_running_state running_state "${projects[@]}"

# The host egress lockdown is global state, not per-project: query it once
# here rather than forking systemctl per running row. A running machine is
# only as filtered as the lockdown is up, so a down lockdown displays
# UNFILTERED for every running machine. Use the SHARED firewall_is_active
# predicate (holder active + the recorded base inode still matching the live
# virtdev.slice) so the displayed state matches the launch guard exactly — a
# bare is-active check would show a reassuring zone in the very window (a churned
# base inode) the guard refuses to launch in.
firewall_up=1
firewall_is_active || firewall_up=0

# zone_display <project> <running?0|1>
# Derives the displayed zone from the live unit's Slice and the firewall state.
# A stopped machine has no zone (-). A running machine with the lockdown down is
# UNFILTERED (never a falsely reassuring zone name). Otherwise the shared
# firewall_zone_of_slice maps the live slice to its zone (a stray/legacy/unknown
# slice reads 'none', the most restrictive — matching the rebuild paths).
zone_display() {
  local -r project="${1}" running="${2}"
  [[ "${running}" == "1" ]] || { printf -- '-'; return; }
  [[ "${firewall_up}" == "1" ]] || { printf 'UNFILTERED'; return; }
  printf '%s' "$(firewall_zone_of_unit "virtdev-${project}.service")"
}

for project in "${projects[@]}"; do
  project_directory="${VIRTDEV_HOME}/projects/${project}"
  generation_file="${project_directory}/generation"

  if [[ "${running_state[${project}]}" == "1" ]]; then
    status='running'
    status_color='fg=green'
    port="$(port_read_lenient "${project}")"
    zone="$(zone_display "${project}" 1)"
  else
    status='stopped'
    status_color='fg=red'
    port='-'
    zone="$(zone_display "${project}" 0)"
  fi

  if [[ -s "${generation_file}" ]]; then
    generation="$(generation_read_lenient "${generation_file}")"
  else
    generation='-'
  fi
  generation_color=''
  if [[ "${generation}" == '<corrupt>' ]]; then
    generation_color='fg=red'
  elif [[ "${generation}" == "detached" ]]; then
    generation_color='fg=yellow'
  elif [[ "${generation}" != '-' && "${base_generation}" != '-' \
          && "${base_generation}" != '<corrupt>' \
          && "${generation}" != "${base_generation}" ]]; then
    generation_color='fg=red'
  fi

  colored_status="$(terminal_write "${status_color}" "${status}" reset)"
  if [[ -n "${generation_color}" ]]; then
    colored_generation="$(terminal_write "${generation_color}" "${generation}" reset)"
  else
    colored_generation="${generation}"
  fi

  printf "%-${max_name}s %-5s %s%-*s %-10s %s\n" \
    "${project}" "${port}" \
    "${colored_status}" $(( 8 - ${#status} )) "" \
    "${zone}" \
    "${colored_generation}"
done

if [[ "${base_generation}" != '-' ]]; then
  printf >&2 '\nBase generation: %s\n' "${base_generation}"
fi