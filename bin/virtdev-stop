#!/usr/bin/env bash
# shellcheck disable=SC2154  # machine descriptor constants provided by import
#
# virtdev-stop <project>
#
# Shuts down a project virtual machine cleanly via ACPI powerdown.
# Falls back to systemctl stop (SIGTERM) if the monitor is unavailable
# or the guest does not respond within a timeout.
#
# The QEMU monitor socket is used to send 'system_powerdown',
# which triggers a clean ACPI shutdown in the guest.
# It should halt gracefully since systemd sees it as a power button press.
#
# Requires socat.
#
#     pacman -S socat
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments terminal machine runtime lifecycle integer stop-result

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_STOP_TIMEOUT:=60}"

if ! integer_is_bounded_positive "${VIRTDEV_STOP_TIMEOUT}" 86400; then
  error 64 <<<"Invalid VIRTDEV_STOP_TIMEOUT: must be an integer from 1 through 86400"
fi

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

target_status=0
machine_target_require "${project}" || target_status=$?
case "${target_status}" in
  "${machine_target_invalid}") error 2 <<<"Not a machine target: ${project}" ;;
  "${machine_target_missing}") error 3 <<<"Machine target not found: ${project}" ;;
esac

# Maintenance skips the lock so it can be stopped while maintain owns it.
if [[ "${VIRTDEV_MACHINE_KIND}" != "${machine_kind_maintenance}" ]]; then
  lock_acquire
fi

unit="${VIRTDEV_MACHINE_UNIT}"
project_directory="${VIRTDEV_MACHINE_RUNTIME_DIR}"
monitor_sock="$(runtime_monitor_sock "${project_directory}")"

stop_finalize() {
  local qemu_exit cleanup_status=0
  qemu_exit="$(systemctl --user show "${unit}" --property=ExecMainStatus --value 2>/dev/null || true)"
  qemu_exit="${qemu_exit:-?}"
  # Maintain owns reset-failed because it still needs ExecMainStatus.
  if [[ "${VIRTDEV_MACHINE_KIND}" != "${machine_kind_maintenance}" ]]; then
    systemctl --user reset-failed "${unit}" 2>/dev/null || true
  fi
  # Full teardown: sockets + the port running-signal (lib/virtdev/runtime).
  lifecycle_clean_unowned "${project_directory}" || cleanup_status=$?
  if (( cleanup_status != lifecycle_stop_clean )); then
    error "${stop_result_cleanup_incomplete}" <<MESSAGE
Virtual machine is stopped, but runtime cleanup is incomplete: ${project}
Inspect remaining artifacts under: ${project_directory}
After correcting the unsafe artifact, retry: virtdev-stop -- ${project}
MESSAGE
  fi
  printf >&2 '%s\n' "$(terminal_write fg=green "Virtual machine stopped: ${project}" reset " (QEMU exit ${qemu_exit})")"
}

# Transitional units must be driven to a terminal state; only a proven stopped
# unit may short-circuit.
if machine_is_stopped "${project}"; then
  stop_finalize
  exit 0
fi

# Empty ActiveState means the user manager is unreachable, so VM state is unknown.
if machine_is_unreachable "${project}"; then
  error 6 <<MESSAGE
Cannot reach the user systemd manager to stop: ${project}
Its state is indeterminate (no session bus — an unset/stale XDG_RUNTIME_DIR, or a
login-less ssh/cron context). Ensure your user session is reachable, then retry.
MESSAGE
fi

if ! command -v socat &>/dev/null; then
  printf >&2 '%s\n' "$(terminal_write fg=yellow 'socat not found, falling back to SIGTERM...' reset)"
  systemctl --user stop "${unit}"
  socat_deadline=$(( SECONDS + VIRTDEV_STOP_TIMEOUT ))
  while :; do
    socat_state="$(systemctl --user show "${unit}" --property=ActiveState --value 2>/dev/null || true)"
    case "${socat_state}" in
      inactive|failed) break ;;
    esac
    if (( SECONDS >= socat_deadline )); then
      break
    fi
    sleep 0.2
  done
  case "${socat_state}" in
    inactive|failed) ;;
    *)
      error 5 <<MESSAGE
Unit ${unit} is in unexpected state after stop: '${socat_state}'.
Expected 'inactive' or 'failed'. The virtual machine may still be running.
Investigate: systemctl --user status ${unit}
MESSAGE
      ;;
  esac
  stop_finalize
  exit 0
fi

# Prefer ACPI; fall back to SIGTERM. Every path joins the terminal-state wait.
if [[ -S "${monitor_sock}" ]]; then
  printf >&2 "Sending ACPI powerdown to: %s\n" "${project}"
  # Unidirectional socat returns after the send instead of waiting for QEMU exit.
  if ! echo 'system_powerdown' | socat -u - UNIX-CONNECT:"${monitor_sock}" &>/dev/null; then
    printf >&2 '%s\n' "$(terminal_write fg=yellow 'Monitor send failed, falling back to SIGTERM...' reset)"
    systemctl --user stop "${unit}"
  fi
else
  printf >&2 '%s\n' "$(terminal_write fg=yellow 'Monitor socket not found, falling back to SIGTERM...' reset)"
  systemctl --user stop "${unit}"
fi

# `systemctl stop` may return before the unit settles. Allow one timeout for
# ACPI and, after escalation, one timeout for SIGTERM.
deadline=$(( SECONDS + VIRTDEV_STOP_TIMEOUT ))
escalated=0
while :; do
  active_state="$(systemctl --user show "${unit}" --property=ActiveState --value 2>/dev/null || true)"
  case "${active_state}" in
    inactive|failed) break ;;
  esac
  if (( SECONDS >= deadline )); then
    if (( ! escalated )); then
      printf >&2 '%s\n' "$(terminal_write fg=yellow "Guest did not halt within ${VIRTDEV_STOP_TIMEOUT}s, falling back to SIGTERM..." reset)"
      systemctl --user stop "${unit}"
      escalated=1
      deadline=$(( SECONDS + VIRTDEV_STOP_TIMEOUT ))
      continue
    fi
    break
  fi
  sleep 0.2
done

# Success requires a terminal unit state.
case "${active_state}" in
  inactive|failed) ;;
  *)
    error 5 <<MESSAGE
Unit ${unit} is in unexpected state after stop: '${active_state}'.
Expected 'inactive' or 'failed'. The virtual machine may still be running.
Investigate: systemctl --user status ${unit}
MESSAGE
    ;;
esac

stop_finalize
