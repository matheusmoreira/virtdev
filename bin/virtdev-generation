#!/usr/bin/env bash
#
# virtdev-generation [project]
#
# Prints the base system generation, or a project's generation.
# Machine-readable: stdout contains only the generation string.
#
# Without arguments: prints the sealed base generation (integer).
# With a project: prints the project's generation (integer or 'detached').
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   project generation file not found
#   5   base generation file not found
#   64  usage error
#   82  corrupt generation file

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=("project?")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -gt 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

if [[ $# -eq 0 ]]; then
  generation_file="${VIRTDEV_HOME}/system/generation"
  if [[ ! -f "${generation_file}" ]]; then
    error 5 <<<"Base system generation file not found: '${generation_file}'"
  fi
  generation="$(generation_read_base "${generation_file}")"
  printf '%s\n' "${generation}"
  exit 0
fi

project="${1}"

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require "${project}"

generation_file="${project_directory}/generation"
if [[ ! -f "${generation_file}" ]]; then
  error 4 <<<"Generation file not found: '${generation_file}'"
fi

# Assign, then print. `printf '%s' "$(generation_read_project …)"` would run the
# reader in a command substitution whose exit (error 82 on a corrupt
# file) does not propagate to printf, so the script would print a blank
# line and exit 0 — defeating the corruption check on its own
# machine-readable channel. A bare assignment propagates under `set -e`.
generation="$(generation_read_project "${generation_file}")"
printf '%s\n' "${generation}"
