#!/usr/bin/env bash
#
# virtdev-key
#
# Generates the ed25519 key pair used to authenticate
# into virtdev virtual machines.
#
# virtdev-install validates the pair and injects the current public key into the
# guest at install time. ISO builds are key-independent. virtdev-ssh uses the
# private key at runtime.
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME     Base directory for virtdev data.
#                    Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#
#   VIRTDEV_SSH_KEY  Path where the key pair is generated.
#                    Default: ${VIRTDEV_HOME}/ssh/id
#
# Exit codes:
#
#   0   success (key generated or already present)
#   3   existing private key is invalid or is not ed25519
#   4   public key path has an unsafe file type
#   5   ssh-keygen is unavailable
#   64  usage error

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error arguments lock ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"

# shellcheck disable=SC2034  # spec read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

lock_acquire

if ! command -v ssh-keygen &>/dev/null; then
  error 5 <<<'ssh-keygen not found; install OpenSSH'
fi

key_directory="$(dirname "${VIRTDEV_SSH_KEY}")"

if [[ ! -d "${key_directory}" ]]; then
  printf >&2 "Creating key directory: '%s'\n" "${key_directory}"
  mkdir -p "${key_directory}"
  chmod 700 "${key_directory}"
fi

public_key="${VIRTDEV_SSH_KEY}.pub"

key_staging=''
cleanup_key_staging() {
  [[ -z "${key_staging}" ]] || rm -rf -- "${key_staging}"
}
trap cleanup_key_staging EXIT

if [[ ! -e "${VIRTDEV_SSH_KEY}" && ! -L "${VIRTDEV_SSH_KEY}" ]]; then
  key_staging="$(mktemp -d "${key_directory}/.virtdev-key.XXXXXX")"
  ssh-keygen -q -t ed25519 -N '' -C 'virtdev' -f "${key_staging}/id"
  chmod 600 "${key_staging}/id"
  mv -T -- "${key_staging}/id" "${VIRTDEV_SSH_KEY}"
  printf >&2 "SSH private key generated: '%s'\n" "${VIRTDEV_SSH_KEY}"
fi

if [[ ! -f "${VIRTDEV_SSH_KEY}" || -L "${VIRTDEV_SSH_KEY}" ]]; then
  error 3 <<<"SSH private key is not a regular file: '${VIRTDEV_SSH_KEY}'"
fi
chmod 600 "${VIRTDEV_SSH_KEY}"

derived_public=''
if ! derived_public="$(ssh_client_public_from_private "${VIRTDEV_SSH_KEY}")"; then
  error 3 <<MESSAGE
Existing SSH private key is invalid, encrypted, or not ed25519:
    '${VIRTDEV_SSH_KEY}'
The file was preserved. Move it aside or select another VIRTDEV_SSH_KEY.
MESSAGE
fi

if [[ ( -e "${public_key}" || -L "${public_key}" ) \
      && ( ! -f "${public_key}" || -L "${public_key}" ) ]]; then
  error 4 <<<"SSH public key path is not a regular file: '${public_key}'"
fi

existing_public=''
if [[ -f "${public_key}" ]]; then
  existing_public="$(ssh_client_public_read "${public_key}" 2>/dev/null || true)"
fi

if [[ "${existing_public}" != "${derived_public}" ]]; then
  if [[ -z "${key_staging}" ]]; then
    key_staging="$(mktemp -d "${key_directory}/.virtdev-key.XXXXXX")"
  fi
  printf '%s virtdev\n' "${derived_public}" > "${key_staging}/id.pub"
  chmod 644 "${key_staging}/id.pub"
  mv -T -- "${key_staging}/id.pub" "${public_key}"
  printf >&2 "SSH public key created/repaired from the private key: '%s'\n" \
    "${public_key}"
else
  printf >&2 "SSH key pair already valid: '%s'\n" "${VIRTDEV_SSH_KEY}"
fi
