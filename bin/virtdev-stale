#!/usr/bin/env bash
#
# virtdev-stale
#
# Prints names of projects whose generation does not match the
# sealed base, one per line. Detached projects are excluded.
# Prints nothing if all projects are current.
#
# Machine-readable: suitable for xargs or shell loops:
#
#     virtdev-stale | xargs -I{} virtdev-recreate --no-backup {}
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error arguments project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

declare -a stale_projects=()
project_list_into stale_projects \
  || error 3 <<<'Could not completely enumerate projects.'
for p in "${stale_projects[@]}"; do
  status=0
  project_is_outdated "${p}" || status=$?
  case "${status}" in
    0) printf '%s\n' "${p}" ;;                  # outdated
    1) : ;;                                      # current or detached
    2) printf >&2 'warning: %s has corrupt or indeterminate generation/topology state; skipping\n' "${p}" ;;
    3) error 82 <<MESSAGE
Base system generation file is corrupt: ${VIRTDEV_HOME}/system/generation
Cannot determine which projects are outdated; reseal or repair the base.
MESSAGE
       ;;
  esac
done
