#!/usr/bin/env bash
# shellcheck disable=SC2154  # virtdev_bin_directory provided by lib/virtdev/import
#
# virtdev-recreate [--provision <path>] [--snapshot <id>]
#                  [--no-backup] [--no-restore] [--no-provision]
#                  [--yes] [--verbose] <project>
#
# Takes a project virtual machine through the destroy/rebuild cycle
# without losing user-curated state. Composes the existing virtdev
# primitives into a single operation gated by one type-the-name
# confirmation prompt.
#
# The chain (with all defaults):
#
#     1. virtdev-backup        snapshot home-disk state to backups/
#     2. virtdev-stop          ACPI shutdown
#     3. virtdev-destroy --yes wipe project disks
#     4. virtdev-create        rebuild on the current sealed base
#     5. virtdev-start         boot the fresh VM
#     6. virtdev-wait          wait for SSH to come up
#     7. provision             optional: bash -s the provision script
#     8. virtdev-restore       overlay the exact snapshot produced by step 1
#
# Provision discovery (resolves a script path or skips):
#
#     1. --no-provision        kill switch wins
#     2. --provision <path>    explicit path; precondition-checked
#     3. ${XDG_CONFIG_HOME:-~/.config}/virtdev/projects/<name>/provision
#     4. otherwise: no provision step
#
# Provision execution: virtdev-ssh <project> -- bash -s < <path>. The
# script is interpreted as bash (the shebang is ignored). Working
# directory is the dev user's /home/dev/. Wrap other interpreters
# from a one-line bash launcher.
#
# One inherited store lock covers the complete transaction, including backup,
# provision, and restore. Lock-aware child commands reuse its descriptors.
#
# Failure semantics: fail-fast at any non-zero subcommand exit. The
# exit code identifies which step failed (10 incompatible base, 20 backup, 21 stop, 22
# destroy, 23 create, 24 start, 25 wait, 27 restore; 28 = the resolved
# zone was removed before the destroy step); the message names the
# recovery command for that boundary.
#
# Provision is the exception: the VM is already up, so a failed
# provision script is non-fatal — recreate finishes and exits 26
# ("recreated but unprovisioned") instead of aborting. virtdev-upgrade
# treats 26 as a distinct unprovisioned outcome, not a hard failure.
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME    Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments snapshot manifest confirm terminal project firewall recreate-result lock ssh

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=(
  [provision]=value
  [snapshot]=value
  [zone]=value
  [unfiltered]=bool
  [no-backup]=bool
  [no-restore]=bool
  [no-provision]=bool
  [yes]=bool
  [verbose]=bool
)
# shellcheck disable=SC2034
declare -A spec_short=([p]=provision [y]=yes [v]=verbose)
# shellcheck disable=SC2034
declare -A spec_placeholders=([provision]=path [snapshot]=snapshot [zone]=zone)
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

pinned_snapshot="${flags[snapshot]:-}"
if [[ -n "${pinned_snapshot}" ]]; then
  snapshot_validate_format "${pinned_snapshot}"
  if (( ! flags[no-backup] )); then
    error 64 <<<"--snapshot requires --no-backup (a new backup otherwise supplies the exact snapshot)"
  fi
  if (( flags[no-restore] )); then
    error 64 <<<"--snapshot and --no-restore are mutually exclusive"
  fi
fi

lock_acquire

# Resolve the zone to relaunch into (Phase 2 network isolation). Precedence:
#   1. an explicit --zone always wins;
#   2. else restore the zone a RUNNING machine was in (captured before the stop);
#   3. else pass nothing and let virtdev-start resolve from the project's zone
#      file — never synthesize --zone none, which would ignore that file.
zone_arg="${flags[zone]:-}"
if [[ -n "${zone_arg}" ]]; then
  # Charset is validated UNCONDITIONALLY (matching virtdev-start): a malformed
  # --zone must fail up-front — even under --unfiltered — not be deferred to the
  # start step, which for recreate is AFTER the irreversible destroy. The
  # realized-zone (manifest) check IS skipped under --unfiltered: the lockdown is
  # not enforced (and may not be applied at all), so the zone need not exist there.
  firewall_zone_name_valid "${zone_arg}" \
    || error 64 <<<"invalid --zone '${zone_arg}' (lowercase letters/digits/_, no dashes or dots)"
  if (( ! flags[unfiltered] )); then
    firewall_zone_valid "${zone_arg}" \
      || error 64 <<<"unknown or unapplied --zone '${zone_arg}'. Active zones: $(firewall_zones_active | paste -sd' ')"
  fi
fi

unit="virtdev-${project}"
project_directory="${VIRTDEV_HOME}/projects/${project}"
backups_project_dir="$(snapshot_directory "${project}")"

project_require_ordinary "${project}"

system_directory="${VIRTDEV_HOME}/system"
if ! ssh_guest_contract_valid "${system_directory}"; then
  error 10 <<MESSAGE
Sealed-base SSH contract marker is missing or incompatible.
No project data was changed. If the base predates strict host identity, use the
previous virtdev version for backup, then install and seal the current ISO.
MESSAGE
fi

if [[ -n "${pinned_snapshot}" && ! -d "${backups_project_dir}/${pinned_snapshot}" ]]; then
  error 9 <<<"Pinned restore snapshot not found: ${backups_project_dir}/${pinned_snapshot}"
fi

# Capture VM state once. Used for both the precondition check (which
# requires it active unless --no-backup) and the do_stop decision
# (skip stop when the VM is already down).
#
# This deliberately keeps project_is_running (provably active), NOT the fail-closed
# project_is_stopped the destructive commands use. recreate is a thin orchestrator
# and its only irreversible step is virtdev-destroy (below), which is itself
# fail-closed — so a bus-flaky read that wrongly skips the stop still cannot wipe a
# live machine, because the guarded destroy refuses. Keep that invariant: if recreate
# ever grows a raw disk op, it would need the fail-closed predicate here too.
unit_active=0
if project_is_running "${project}"; then
  unit_active=1
fi

# Capture the live SLICE BEFORE the stop below clears it (the Slice property reads
# empty once the unit is gone), so a running machine can be restored to the zone it
# was in. The slice is mapped to a zone at resolution time via the shared
# firewall_zone_to_restore (identical to virtdev-upgrade).
prior_slice=""
if (( unit_active )); then
  prior_slice="$(firewall_slice_of_unit "${unit}")"
fi

# The zone to relaunch into: explicit --zone wins; else the zone a running machine was
# in, via firewall_zone_to_restore — which returns empty for an absent/unrecognised
# slice so we omit --zone and let virtdev-start read the project zone file (rather than
# force the most restrictive 'none', the old behaviour that diverged from upgrade);
# else empty.
if [[ -n "${zone_arg}" ]]; then
  zone="${zone_arg}"
elif (( unit_active )); then
  zone="$(firewall_zone_to_restore "${prior_slice}")"
else
  zone=""
fi

if (( ! flags[no-backup] )); then
  if (( ! unit_active )); then
    error 4 <<MESSAGE
Virtual machine is not running: ${project}
Recreate must take a backup first, which requires SSH into the virtual machine.
Either start it with:    virtdev-start ${project}
Or skip the backup with: virtdev-recreate --no-backup ${project}
MESSAGE
  fi

  if ! manifest_resolve "${project}" >/dev/null; then
    error 5 <<MESSAGE
Backup manifest not found at either of:
    ${project_directory}/manifest
    ${XDG_CONFIG_HOME}/virtdev/projects/${project}/manifest
Create one with paths to back up (one per line; '#' comments allowed).
Or skip the backup with: virtdev-recreate --no-backup ${project}
MESSAGE
  fi

  manifest_path="$(manifest_resolve "${project}")"
  if ! manifest_has_entries "${manifest_path}"; then
    error 8 <<MESSAGE
Backup manifest is empty (no unindented, non-blank, non-comment lines):
    ${manifest_path}
Add at least one path starting at column 0. Or skip the backup with:
    virtdev-recreate --no-backup ${project}
MESSAGE
  fi
fi

# Provision resolution. The kill switch wins; the flag wins over the
# hook; the hook wins over nothing. Echoed to stderr at execution time
# so the user can spot which path actually ran.
provision_path=""
if (( ! flags[no-provision] )); then
  if [[ -n "${flags[provision]}" ]]; then
    if [[ ! -f "${flags[provision]}" || ! -r "${flags[provision]}" ]]; then
      error 6 <<MESSAGE
Provision script not found or not readable: ${flags[provision]}
MESSAGE
    fi
    provision_path="${flags[provision]}"
  else
    provision_hook="${XDG_CONFIG_HOME}/virtdev/projects/${project}/provision"
    if [[ -f "${provision_hook}" && -r "${provision_hook}" ]]; then
      provision_path="${provision_hook}"
    fi
  fi
fi

# Snapshot inventory: needed for the "skip restore when --no-backup
# and no prior snapshots" rule, and for the latest-snapshot reference
# in restore-failure recovery hints.
has_snapshots=0
snapshot_any "${project}" && has_snapshots=1

# Decide which steps will actually run. Computed up front so the plan
# print is accurate and the chain executes without re-deriving.
do_backup=$((    ! flags[no-backup] ))
do_stop=$((      unit_active ))
do_provision=0
[[ -n "${provision_path}" ]] && do_provision=1
do_restore=$((   ! flags[no-restore] ))

# Restore needs something to restore from. If we are taking a backup
# this run, that supplies it. If we are not (--no-backup), fall back
# to any prior snapshot; if there are none, skip restore.
restore_skip_reason=""
if (( do_restore )); then
  if (( ! do_backup )) && (( ! has_snapshots )); then
    do_restore=0
    restore_skip_reason="no prior snapshots"
  elif (( ! do_backup )) && [[ -z "${pinned_snapshot}" ]]; then
    pinned_snapshot="$(snapshot_latest "${project}")"
    [[ -n "${pinned_snapshot}" ]] \
      || error 9 <<<'Could not pin the selected restore snapshot'
  fi
fi

# Plan print. Active steps are numbered contiguously; skipped steps
# show -- instead of a number. The user reads this immediately before
# being asked to type the project name to confirm.
total_steps=$(( 4 + do_backup + do_stop + do_provision + do_restore ))
{
  printf '\n'
  printf 'Plan for recreate of %s:\n' "${project}"
  step=0
  if (( do_backup )); then
    printf '  %d. backup\n' "$(( ++step ))"
  else
    printf '  -- backup        (skipped: --no-backup)\n'
  fi
  if (( do_stop )); then
    printf '  %d. stop\n' "$(( ++step ))"
  else
    printf '  -- stop          (skipped: virtual machine already stopped)\n'
  fi
  printf '  %d. destroy --yes\n' "$(( ++step ))"
  printf '  %d. create\n'        "$(( ++step ))"
  printf '  %d. start\n'         "$(( ++step ))"
  printf '  %d. wait\n'          "$(( ++step ))"
  if (( do_provision )); then
    printf '  %d. provision     %s\n' "$(( ++step ))" "${provision_path}"
  elif (( flags[no-provision] )); then
    printf '  -- provision     (skipped: --no-provision)\n'
  else
    printf '  -- provision     (skipped: no script found)\n'
  fi
  if (( do_restore )); then
    if (( do_backup )); then
      printf '  %d. restore       (exact snapshot produced by step 1)\n' "$(( ++step ))"
    elif [[ -n "${pinned_snapshot}" ]]; then
      printf '  %d. restore       (%s)\n' "$(( ++step ))" "${pinned_snapshot}"
    else
      printf '  %d. restore       (latest existing snapshot)\n' "$(( ++step ))"
    fi
  elif (( flags[no-restore] )); then
    printf '  -- restore       (skipped: --no-restore)\n'
  else
    printf '  -- restore       (skipped: %s)\n' "${restore_skip_reason}"
  fi
  printf '\n'
  printf 'This is irreversible.\n'
} >&2

if (( ! flags[yes] )); then
  if ! confirm_word "${project}"; then
    error 7 <<<'Aborted.'
  fi
fi

# Subcommand invocation goes through the resolved bin directory so the
# dev tree and the pacman-installed package both work without relying
# on PATH ordering (a user with both installed could otherwise mix
# versions inside a single recreate run).
backup() {
  local opts=()
  (( flags[verbose] )) && opts+=(--verbose)
  "${virtdev_bin_directory}/virtdev-backup" "${opts[@]}" "${project}"
}

stop() {
  "${virtdev_bin_directory}/virtdev-stop" "${project}"
}

destroy() {
  "${virtdev_bin_directory}/virtdev-destroy" --yes "${project}"
}

create() {
  "${virtdev_bin_directory}/virtdev-create" "${project}"
}

start() {
  local opts=()
  [[ -n "${zone}" ]] && opts+=(--zone "${zone}")
  (( flags[unfiltered] )) && opts+=(--unfiltered)
  "${virtdev_bin_directory}/virtdev-start" "${opts[@]}" "${project}"
}

wait_ssh() {
  "${virtdev_bin_directory}/virtdev-wait" "${project}"
}

provision() {
  "${virtdev_bin_directory}/virtdev-ssh" "${project}" -- bash -s < "${provision_path}"
}

restore() {
  local opts=()
  (( flags[verbose] )) && opts+=(--verbose)
  local snapshot="${backup_snapshot:-${pinned_snapshot}}"
  if [[ -n "${snapshot}" ]]; then
    "${virtdev_bin_directory}/virtdev-restore" "${opts[@]}" "${project}" "${snapshot}"
  else
    "${virtdev_bin_directory}/virtdev-restore" "${opts[@]}" "${project}"
  fi
}

# Return the transaction's exact snapshot, resolving latest only when no
# backup or explicit selection supplied one.
selected_snapshot() {
  (( do_restore )) || return 0
  if [[ -n "${backup_snapshot:-}" ]]; then
    printf '%s' "${backup_snapshot}"
  elif [[ -n "${pinned_snapshot}" ]]; then
    printf '%s' "${pinned_snapshot}"
  else
    snapshot_latest "${project}"
  fi
}

command_render() {
  local -r first="${1}"
  shift
  printf '%q' "${first}"
  (( $# )) && printf ' %q' "$@"
}

start_resume() {
  local -a command=(virtdev-start)
  [[ -n "${zone}" ]] && command+=(--zone "${zone}")
  (( flags[unfiltered] )) && command+=(--unfiltered)
  command+=("${project}")
  command_render "${command[@]}"
}

recreate_resume() {
  local -a command=(virtdev-recreate)
  local -r snapshot="${backup_snapshot:-${pinned_snapshot}}"
  local extra
  local no_backup_added=0

  if (( do_restore )) && [[ -n "${snapshot}" ]]; then
    command+=(--no-backup --snapshot "${snapshot}")
    no_backup_added=1
  fi
  for extra in "$@"; do
    if [[ "${extra}" == --no-backup && ${no_backup_added} == 1 ]]; then
      continue
    fi
    command+=("${extra}")
  done
  (( flags[no-restore] )) && command+=(--no-restore)
  (( flags[no-provision] )) && command+=(--no-provision)
  if [[ -n "${flags[provision]}" ]]; then
    command+=(--provision "${flags[provision]}")
  fi
  (( flags[verbose] )) && command+=(--verbose)
  [[ -n "${zone_arg}" ]] && command+=(--zone "${zone_arg}")
  (( flags[unfiltered] )) && command+=(--unfiltered)
  command+=("${project}")
  command_render "${command[@]}"
}

restore_resume() {
  local -a command=(virtdev-restore)
  local snapshot

  (( flags[verbose] )) && command+=(--verbose)
  command+=("${project}")
  snapshot="$(selected_snapshot)"
  [[ -z "${snapshot}" ]] || command+=("${snapshot}")
  command_render "${command[@]}"
}

provision_resume() {
  command_render virtdev-ssh "${project}" -- bash -s
  printf ' < '
  printf '%q' "${provision_path}"
}

post_wait_resume() {
  if (( do_provision )); then
    printf '    %s\n' "$(provision_resume)"
  fi
  if (( do_restore )); then
    printf '    %s\n' "$(restore_resume)"
  fi
}

# Chain execution. Each step prints its banner first so the user can
# see where they are in the plan; on failure the matching error block
# tells them what state the project is in now and which command to
# run by hand to resume.
step=0
provision_failed=0
backup_snapshot=""

if (( do_backup )); then
  (( ++step ))
  printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] backup" reset)" >&2
  backup_path=""
  if ! backup_path="$(backup)"; then
    error "${recreate_result_backup_failed}" <<MESSAGE
backup failed (virtdev-backup exited non-zero).
Project ${project} is unchanged. Inspect the backup output above
and rerun:
    $(recreate_resume)
MESSAGE
  fi
  if ! backup_snapshot="$(snapshot_id_from_path "${project}" "${backup_path}")"; then
    error "${recreate_result_backup_failed}" <<MESSAGE
virtdev-backup returned an invalid snapshot path: '${backup_path}'
The project is unchanged and the backup output was not trusted for restore.
MESSAGE
  fi
  printf 'snapshot: %s\n' "${backup_snapshot}" >&2
fi

if (( do_stop )); then
  (( ++step ))
  printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] stop" reset)" >&2
  if ! stop; then
    snap="$(selected_snapshot)"
    snap_hint=""
    [[ -n "${snap}" ]] && snap_hint="
Snapshot from this run: ${backups_project_dir}/${snap}/"
    error "${recreate_result_stop_failed}" <<MESSAGE
stop failed (virtdev-stop exited non-zero).
The virtual machine may be in an indeterminate state. Inspect with:
    systemctl --user status ${unit}
Stop it manually, then rerun with --no-backup (the snapshot is
already on disk):
    virtdev-stop ${project}
    $(recreate_resume --no-backup)${snap_hint}
MESSAGE
  fi
fi

# Re-validate the resolved zone immediately before the IRREVERSIBLE destroy. An
# explicit --zone was checked at parse time and a captured zone at capture time, but a
# concurrent `firewall apply` could have removed a custom zone since — re-check here so
# a vanished zone fails BEFORE the disks are wiped, not at the start step after destroy
# (which would leave a fresh machine that cannot launch into its zone).
# Skipped under --unfiltered (the lockdown is not enforced for this relaunch).
if (( ! flags[unfiltered] )) && [[ -n "${zone}" ]] && ! firewall_zone_valid "${zone}"; then
  error "${recreate_result_zone_removed}" <<MESSAGE
zone '${zone}' is no longer active (removed since this recreate began).
${project} is backed up and stopped but NOT destroyed — nothing is lost.
Re-apply the zone (or pass --zone), then rerun:
    sudo virtdev firewall apply
    $(recreate_resume --no-backup)
MESSAGE
fi

(( ++step ))
printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] destroy" reset)" >&2
if ! destroy; then
  snap="$(selected_snapshot)"
  snap_hint=""
  [[ -n "${snap}" ]] && snap_hint="
Snapshot is preserved at: ${backups_project_dir}/${snap}/"
  error "${recreate_result_destroy_failed}" <<MESSAGE
destroy failed (virtdev-destroy exited non-zero).
The project still exists. Inspect, fix, and rerun with --no-backup:
    $(recreate_resume --no-backup)${snap_hint}
MESSAGE
fi

(( ++step ))
printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] create" reset)" >&2
if ! create; then
  snap="$(selected_snapshot)"
  snap_hint=""
  [[ -n "${snap}" ]] && snap_hint="
Snapshot is preserved at: ${backups_project_dir}/${snap}/"
  error "${recreate_result_create_failed}" <<MESSAGE
create failed (virtdev-create exited non-zero).
The project directory was destroyed and the new one was not built, so a
recreate resume would dead-end at "Project not found". Rebuild by hand:
    virtdev-create ${project}
    $(start_resume)
    virtdev-wait ${project}
$(post_wait_resume)${snap_hint}
MESSAGE
fi

(( ++step ))
printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] start" reset)" >&2
if ! start; then
  snap="$(selected_snapshot)"
  snap_hint=""
  [[ -n "${snap}" ]] && snap_hint="
Snapshot path: ${backups_project_dir}/${snap}/"
  error "${recreate_result_start_failed}" <<MESSAGE
start failed (virtdev-start exited non-zero).
A fresh project exists for ${project}, but the fixed unit's ownership is
indeterminate. Submission or cleanup may have partially succeeded. Inspect it:
    systemctl --user status ${unit}
If it exists, stop it and wait for inactive/failed state. Then resume:
    $(start_resume)
    virtdev-wait ${project}
$(post_wait_resume)${snap_hint}
MESSAGE
fi

(( ++step ))
printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] wait" reset)" >&2
if ! wait_ssh; then
  snap="$(selected_snapshot)"
  snap_hint=""
  wait_followup='Once SSH is up, no later recreate steps remain.'
  if (( do_provision || do_restore )); then
    wait_followup="Once SSH is up, finish the selected recreate steps:
$(post_wait_resume)"
  fi
  [[ -n "${snap}" ]] && snap_hint="
Snapshot path: ${backups_project_dir}/${snap}/"
  error "${recreate_result_wait_failed}" <<MESSAGE
wait failed (virtdev-wait exited non-zero).
The fresh virtual machine is up at the systemd level but SSH did not come up
within the timeout. Inspect with:
    journalctl --user -u ${unit}
${wait_followup}${snap_hint}
MESSAGE
fi

if (( do_provision )); then
  (( ++step ))
  printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] provision ${provision_path}" reset)" >&2
  if ! provision; then
    provision_failed=1
    printf >&2 '%s\n' "$(terminal_write bold fg=yellow "Provision failed (script exited non-zero): ${provision_path}" reset)"
    printf >&2 'The virtual machine is up but unprovisioned. Re-run manually:\n'
    printf >&2 '    %s\n' "$(provision_resume)"
  fi
fi

if (( do_restore )); then
  (( ++step ))
  printf '\n%s\n' "$(terminal_write bold "[${step}/${total_steps}] restore" reset)" >&2
  if ! restore; then
    snap="$(selected_snapshot)"
    snap_hint=""
    provision_hint=""
    restore_project_state="$(recreate_restore_project_state \
      "${provision_failed}")"
    if (( provision_failed )); then
      provision_hint="
Provisioning also failed. Retry it with:
    $(provision_resume)"
    fi
    [[ -n "${snap}" ]] && snap_hint="
Selected snapshot: ${backups_project_dir}/${snap}/
Retry with explicit snapshot:
    virtdev-restore ${project} ${snap}"
    error "${recreate_result_restore_failed}" <<MESSAGE
restore failed (virtdev-restore exited non-zero).
The fresh virtual machine is ${restore_project_state}, but the snapshot was not
applied.${provision_hint}${snap_hint}
MESSAGE
  fi
fi

printf >&2 '\n'
if (( provision_failed )); then
  printf >&2 '%s\n' "$(terminal_write fg=yellow "Project recreated: ${project}" reset " (provision failed — unprovisioned)")"
elif (( do_restore )); then
  printf >&2 '%s\n' "$(terminal_write fg=green "Project recreated: ${project}" reset)"
else
  printf >&2 '%s\n' "$(terminal_write fg=green "Project recreated: ${project}" reset " (restore skipped)")"
fi

# Provision failure is non-fatal to the recreate (the VM is up), but
# exit 26 so a scripted caller — notably virtdev-upgrade — can surface
# "recreated but unprovisioned" rather than count it as a clean success.
(( provision_failed )) && exit "${recreate_result_unprovisioned}"
exit 0
