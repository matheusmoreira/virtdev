#!/usr/bin/env bash
# shellcheck disable=SC2154  # machine descriptor constants provided by import
#
# virtdev-path <machine> [resource]
#
# Prints the absolute path to a project resource.
# Machine-readable: stdout contains only the path.
#
# Resources (default: data):
#
#   data        project directory (disks, nvram, port, generation)
#   runtime     ephemeral runtime directory (same as data for projects)
#   backups     backup snapshots directory
#   manifest    resolved manifest file path
#   system-image project's system disk image
#   home-image   project's home disk image
#
# Special project names:
#
#   base        the sealed base system directory
#   maintenance the maintenance staging directory
#
# Exit codes:
#
#   0   success
#   3   project not found
#   4   resource not found (manifest does not exist, etc.)
#   5   unknown resource name
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments manifest machine

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project "resource?")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"
resource="${2:-data}"

case "${project}" in
  base)
    dir=system
    case "${resource}" in
      data)
        path="${VIRTDEV_HOME}/${dir}"
        ;;
      system-image)
        path="${VIRTDEV_HOME}/${dir}/system.qcow2"
        ;;
      home-image)
        path="${VIRTDEV_HOME}/${dir}/home.qcow2"
        ;;
      *)
        error 5 <<<"Unknown resource for ${project}: '${resource}' (valid: data, system-image, home-image)"
        ;;
    esac
    if [[ ! -e "${path}" ]]; then
      error 4 <<<"Path does not exist: '${path}'"
    fi
    printf '%s\n' "${path}"
    exit 0
    ;;
esac

validate_project_name "${project}"

target_status=0
machine_target_require "${project}" || target_status=$?
case "${target_status}" in
  "${machine_target_invalid}") error 2 <<<"Not a machine target: ${project}" ;;
  "${machine_target_missing}") error 3 <<<"Machine target not found: ${project}" ;;
esac
project_directory="${VIRTDEV_MACHINE_DATA_DIR}"

if [[ "${VIRTDEV_MACHINE_KIND}" == "${machine_kind_maintenance}" ]]; then
  case "${resource}" in
    data) path="${VIRTDEV_MACHINE_DATA_DIR}" ;;
    runtime) path="${VIRTDEV_MACHINE_RUNTIME_DIR}" ;;
    system-image) path="${VIRTDEV_MACHINE_DATA_DIR}/system.qcow2" ;;
    home-image) path="${VIRTDEV_MACHINE_DATA_DIR}/home.qcow2" ;;
    *)
      error 5 <<<"Unknown resource for maintenance: '${resource}' (valid: data, runtime, system-image, home-image)"
      ;;
  esac
  [[ -e "${path}" ]] || error 4 <<<"Path does not exist: '${path}'"
  printf '%s\n' "${path}"
  exit 0
fi

case "${resource}" in
  data)
    printf '%s\n' "${project_directory}"
    ;;
  runtime)
    printf '%s\n' "${VIRTDEV_MACHINE_RUNTIME_DIR}"
    ;;
  backups)
    printf '%s\n' "${VIRTDEV_HOME}/backups/${project}"
    ;;
  manifest)
    if ! path="$(manifest_resolve "${project}")"; then
      error 4 <<MESSAGE
Manifest not found. Checked:
    ${project_directory}/manifest
    ${XDG_CONFIG_HOME:-${HOME}/.config}/virtdev/projects/${project}/manifest
MESSAGE
    fi
    printf '%s\n' "${path}"
    ;;
  system-image)
    printf '%s\n' "${project_directory}/system.qcow2"
    ;;
  home-image)
    printf '%s\n' "${project_directory}/home.qcow2"
    ;;
  *)
    error 5 <<<"Unknown resource: '${resource}' (valid: data, runtime, backups, manifest, system-image, home-image)"
    ;;
esac
