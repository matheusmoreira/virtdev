#!/usr/bin/env bash
#
# virtdev-ssh <project> [--client-option=<option>]... [-- [command...]]
#
# Connects into a running project virtual machine
# via SSH and as the dev user.
#
# Client options precede the destination; remote command arguments follow it.
# Options that take a value must carry it in the same token.
#
#     virtdev-ssh myproject --client-option=-L3000:localhost:3000 \
#       --client-option=-N
#     virtdev-ssh myproject -- ls -la
#
# The SSH key is read from VIRTDEV_SSH_KEY,
# defaulting to ${VIRTDEV_HOME}/ssh/id.
#
#     export VIRTDEV_SSH_KEY=~/.ssh/virtdev_id
#
# SSH configuration is assembled from up to four sources
# (highest priority first):
#
#   1. per-project pre-ssh trigger output
#   2. system pre-ssh trigger output
#   3. ${XDG_CONFIG_HOME}/virtdev/projects/<name>/ssh_config
#   4. ${XDG_CONFIG_HOME}/virtdev/ssh_config
#
# Pre-ssh triggers fire before connecting; post-ssh triggers
# fire after disconnecting. See lib/virtdev/trigger for details.
#
# Exit codes:
#
#   2   invalid project name
#   3   project not found
#   4   virtual machine not running
#   64  usage error
#   77  SSH key not found
#   78  SSH key permissions too open
#   80  pre-ssh trigger aborted (from lib/virtdev/trigger)
#   81  corrupt port file
#   87  no port assigned (virtual machine not running)
#   103 guest SSH host identity missing or corrupt
#   104 guest SSH transport marker missing or incompatible
#   105 SSH config contains a forbidden client-identity directive
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments ssh trigger port project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"

usage='usage: virtdev-ssh <project> [--client-option=<option>]... [-- [command...]]'
for argument in "$@"; do
  case "${argument}" in
    --help|-h) printf '%s\n' "${usage}"; exit 0 ;;
    --) break ;;
  esac
done

declare -a parsed_arguments=()
while (( $# > 0 )); do
  case "${1}" in
    --)
      parsed_arguments+=("$@")
      break
      ;;
    --color=*)
      arguments_color_set "${1#*=}"
      shift
      ;;
    --color)
      if (( $# >= 2 )) && [[ "${2}" != -* ]]; then
        arguments_color_set "${2}"
        shift 2
      else
        arguments_color_set yes
        shift
      fi
      ;;
    *)
      parsed_arguments+=("${1}")
      shift
      ;;
  esac
done
set -- "${parsed_arguments[@]}"

if [[ "${1:-}" == -- ]]; then
  shift
fi
if [[ $# -lt 1 ]]; then
  error 64 <<<"${usage}"
fi

project="${1}"
shift

readonly max_client_options=64
declare -a client_options=() remote_command=()
while (( $# > 0 )); do
  case "${1}" in
    --)
      shift
      remote_command=("$@")
      break
      ;;
    --client-option)
      (( $# >= 2 )) || error 64 <<<'--client-option requires one SSH option token'
      client_option="${2}"
      shift 2
      ;;
    --client-option=*)
      client_option="${1#*=}"
      shift
      ;;
    *)
      error 64 <<MESSAGE
Remote commands must follow '--'; client options use --client-option=<option>.
Usage: virtdev-ssh <project> [--client-option=<option>]... [-- [command...]]
MESSAGE
      ;;
  esac
  ssh_client_option_valid "${client_option}" || error 64 <<MESSAGE
Invalid client option token: '${client_option}'
Attach option arguments to their flag, for example: --client-option=-L3000:localhost:3000
MESSAGE
  (( ${#client_options[@]} < max_client_options )) \
    || error 64 <<<"At most ${max_client_options} client options are allowed"
  client_options+=("${client_option}")
done

validate_project_name "${project}"

project_require "${project}"

if ! project_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
fi

port=""
port_require port "${project}"

ssh_key_validate "${VIRTDEV_SSH_KEY}"
ssh_host_identity_require "${project}"

# --- Trigger and SSH config assembly ---

export VIRTDEV_PROJECT="${project}"
export VIRTDEV_PORT="${port}"
export VIRTDEV_SSH_KEY

system_trigger_config=""
project_trigger_config=""
pre_ssh_fired=0

config_file=""
ssh_exit=0
cleanup_phase=0
cleanup_signal_status=0

# shellcheck disable=SC2329  # invoked via trap
cleanup_signal() {
  local -r status="${1}"
  if (( cleanup_phase )); then
    (( cleanup_signal_status )) || cleanup_signal_status="${status}"
  else
    exit "${status}"
  fi
}

# shellcheck disable=SC2329  # invoked via trap
cleanup() {
  local rc=$? cleanup_phase=1 cleanup_signal_status=0

  trap - EXIT
  # Unlink mandatory state before optional post-event work.
  [[ -n "${config_file}" ]] && rm -f "${config_file}"
  if (( pre_ssh_fired )); then
    export VIRTDEV_SSH_EXIT="${rc}"
    trigger_fire post-ssh || true
  fi

  trap - INT TERM HUP
  if (( cleanup_signal_status )); then
    exit "${cleanup_signal_status}"
  fi
  return "${rc}"
}
trap cleanup EXIT
trap 'cleanup_signal 130' INT
trap 'cleanup_signal 143' TERM
trap 'cleanup_signal 129' HUP

trigger_fire pre-ssh system_trigger_config project_trigger_config
pre_ssh_fired=1

project_ssh_config="${XDG_CONFIG_HOME}/virtdev/projects/${project}/ssh_config"
system_ssh_config="${XDG_CONFIG_HOME}/virtdev/ssh_config"

config_file="$(mktemp)"
{
  [[ -n "${project_trigger_config}" ]] && printf '%s\n' "${project_trigger_config}"
  [[ -n "${system_trigger_config}" ]]  && printf '%s\n' "${system_trigger_config}"
  if [[ -f "${project_ssh_config}" ]]; then
    cat "${project_ssh_config}"
    printf '\n'
  fi
  if [[ -f "${system_ssh_config}" ]]; then
    cat "${system_ssh_config}"
    printf '\n'
  fi
} > "${config_file}"

declare -a ssh_argv=()
ssh_transport_argv ssh_argv interactive "${project}" \
  "${VIRTDEV_SSH_KEY}" "${port}" "${config_file}"
ssh_argv+=("${client_options[@]}" dev@127.0.0.1)
ssh_argv+=("${remote_command[@]}")
"${ssh_argv[@]}" || ssh_exit=$?

exit "${ssh_exit}"
