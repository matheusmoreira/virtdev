#!/usr/bin/env bash
#
# virtdev-restore [--verbose] <project> [snapshot]
#
# Restores a backup snapshot into a running project virtual machine.
# The snapshot layout is produced by virtdev-backup and lives under:
#
#   ${VIRTDEV_HOME}/backups/<project>/<YYYY-MM-DD>/<HH-MM-SS>/
#
# With no snapshot argument, restores the newest snapshot for the
# project. With a snapshot (YYYY-MM-DD/HH-MM-SS), restores that
# exact snapshot.
#
# List available snapshots with: virtdev-backup --list <project>
#
# Flags:
#
#   --verbose    Show rsync per-file progress.
#
# Destructive: overwrites guest files without prompting. Because
# rsync operates on a live, running VM, partial failures may leave
# the guest's filesystem with some restored files and some not. This
# matches virtdev-transfer's semantics.
#
# The project's virtual machine must be running.
#
# Requires rsync on both host and guest:
#
#     pacman -S rsync
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME       Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY    Default: ${VIRTDEV_HOME}/ssh/id
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   6   rsync not found
#   7   rsync partial transfer (some files skipped or failed)
#   8   no snapshots for project
#   10  snapshot missing manifest
#   11  empty snapshot (tree contains no files)
#   12  snapshot belongs to a different project
#   13  project generation file missing
#   16  snapshot date not found
#   17  no snapshots on requested date
#   18  snapshot time not found
#   21  rsync transport failure (SSH connection lost)
#   22  rsync failed with unexpected exit code
#   23  snapshot missing tree/
#   24  snapshot missing project marker
#   64  usage error
#   77  SSH key not found
#   78  SSH key permissions too open
#   79  invalid snapshot format
#   81  corrupt port file
#   82  corrupt generation file
#   87  no port assigned (virtual machine not running)
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate arguments ssh snapshot terminal port project

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"

umask 077

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([verbose]=bool)
# shellcheck disable=SC2034
declare -A spec_short=([v]=verbose)
# shellcheck disable=SC2034
declare -a spec_positionals=(project "snapshot?")
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

given_date=""
given_time=""
if (( $# == 2 )); then
  snapshot_validate_format "${2}"
  given_date="${2%%/*}"
  given_time="${2##*/}"
fi

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require_ordinary "${project}"

if ! project_is_running "${project}"; then
  error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
fi

port=""
port_require port "${project}"

ssh_key_validate "${VIRTDEV_SSH_KEY}"

if ! command -v rsync &>/dev/null; then
  error 6 <<MESSAGE
rsync not found
Install it with: pacman -S rsync
MESSAGE
fi

backups_project_dir="$(snapshot_directory "${project}")"

# Resolve date component. Resolution failures get codes distinct
# from the syntactic ones above: 16 = date directory absent,
# 17 = date directory empty (no times under it), 18 = time directory
# absent within an existing date.
if [[ -z "${given_date}" ]]; then
  resolved_snapshot="$(snapshot_latest "${project}")"
  if [[ -z "${resolved_snapshot}" ]]; then
    error 8 <<MESSAGE
No snapshots for this project: ${project}
Create one with: virtdev-backup ${project}
MESSAGE
  fi
  resolved_date="${resolved_snapshot%%/*}"
  resolved_time="${resolved_snapshot##*/}"
else
  if [[ ! -d "${backups_project_dir}/${given_date}" ]]; then
    error 16 <<<"Snapshot date not found: ${given_date}"
  fi
  resolved_date="${given_date}"
fi

# Resolve time component.
if [[ -z "${given_time}" && -z "${resolved_time:-}" ]]; then
  resolved_time="$(snapshot_list_times "${project}" "${resolved_date}" | tail -n1)"
  if [[ -z "${resolved_time}" ]]; then
    error 17 <<<"No snapshots on date ${resolved_date}"
  fi
else
  if [[ ! -d "${backups_project_dir}/${resolved_date}/${given_time}" ]]; then
    error 18 <<<"Snapshot time not found: ${resolved_date}/${given_time}"
  fi
  resolved_time="${given_time}"
fi

snapshot="${backups_project_dir}/${resolved_date}/${resolved_time}"

if [[ ! -f "${snapshot}/manifest" ]]; then
  error 10 <<<"Snapshot missing manifest: ${snapshot}"
fi
if [[ ! -d "${snapshot}/tree" ]]; then
  error 23 <<<"Snapshot missing tree/: ${snapshot}"
fi
if [[ ! -f "${snapshot}/project" ]]; then
  error 24 <<MESSAGE
Snapshot missing 'project' marker: ${snapshot}
This snapshot was likely produced by an older virtdev-backup that
did not record the source project, so cross-project restoration
cannot be verified. Refusing to proceed.
Re-run virtdev-backup to produce a snapshot with origin metadata.
MESSAGE
fi

# Refuse cross-project restoration. The snapshot records the project
# it was taken from; restoring it into a different project would
# silently overwrite that project's files with the source project's
# tree. manifest paths are user-curated and may differ between
# projects; even when they overlap, the resulting filesystem is
# half-merged and impossible to audit after the fact.
snapshot_project="$(< "${snapshot}/project")"
if [[ "${snapshot_project}" != "${project}" ]]; then
  error 12 <<MESSAGE
Snapshot belongs to a different project.
	snapshot project: ${snapshot_project}
	target project:   ${project}
Snapshots are project-scoped; cross-project restoration is refused.
MESSAGE
fi

# The project's base generation records which sealed base it was created
# against (the convention: a single non-negative integer; see virtdev-start,
# virtdev-create, virtdev-maintain, commit 4b82a64). Its PRESENCE is required —
# a project missing it is structurally incomplete (error 13) — but the VALUE is
# only displayed below, so read it leniently: a corrupt generation must not
# abort a restore, which recovers DATA and should not fail on unreadable
# metadata. Matches the snapshot-generation reader a few lines down.
project_generation_file="${project_directory}/generation"
if [[ ! -f "${project_generation_file}" ]]; then
  error 13 <<MESSAGE
Project generation file missing: '${project_generation_file}'
The project's audit trail is incomplete; refusing to proceed.
MESSAGE
fi
project_generation="$(generation_read_project_lenient "${project_generation_file}")"

# Read the snapshot's recorded base generation for display.
# Empty/absent is displayed as '-'; corrupt content is non-fatal here
# (display-only), via the shared lenient reader.
snapshot_generation='-'
if [[ -s "${snapshot}/generation" ]]; then
  snapshot_generation="$(generation_read_base_lenient "${snapshot}/generation")"
fi

# Display the generation transition. Mismatch is the EXPECTED case in
# the destroy-recreate-restore workflow (snapshot taken under one
# base, restored under the next), so it is informational, not fatal.
# Same-generation restoration is the rollback case.
printf >&2 'Restoring %s from %s/%s\n' \
    "${project}" "${resolved_date}" "${resolved_time}"
printf >&2 '  snapshot generation: %s\n' "${snapshot_generation}"
printf >&2 '  current generation:  %s\n' "${project_generation}"

ssh_command=""
rsync_wrapper=""
ssh_rsync_command ssh_command rsync_wrapper "${project}" \
  "${VIRTDEV_SSH_KEY}" "${port}"

# No --safe-links here, unlike virtdev-backup, and that is deliberate:
# --safe-links is enforced on the RECEIVER. backup pulls (host is the
# receiver — protect the host snapshot from guest symlink traversal);
# restore pushes (the untrusted guest is the receiver), so --safe-links
# would only protect the guest from the trusted host — the reverse of
# the threat model — and creates no guest→host vector. Do not "fix" this
# asymmetry by adding --safe-links (or --link-dest) without re-checking
# virtdev-backup's guards.
# -r is REQUIRED despite -a: with --files-from in effect, rsync's man page
# notes "the --archive (-a) option's behavior does not imply --recursive
# (-r), so specify it explicitly". Without it a directory manifest entry is
# recreated empty on the guest and its contents are silently skipped — the
# mirror of the same fix in virtdev-backup.
rsync_opts=(-a -r --no-D --ignore-missing-args --stats)
(( flags[verbose] )) && rsync_opts+=(--info=progress2)

rsync_log="$(mktemp)"
trap 'rm -f "${rsync_log}" "${rsync_wrapper}"' EXIT

# Force LC_ALL=C so rsync's --stats output is in English. The
# partial-transfer counter (exit 23/24) and the restored-files count
# parse the 'Number of regular files transferred:' line; under a
# non-English locale rsync would emit a translated label and the parse
# would fail silently. Mirrors virtdev-backup.
if ! LC_ALL=C rsync "${rsync_opts[@]}" \
    --files-from=<(grep -Ev '^\s*(#|$)' "${snapshot}/manifest") \
    -e "${ssh_command}" \
    "${snapshot}/tree/" \
    "dev@127.0.0.1:/home/dev/" \
    | tee "${rsync_log}"; then
  # PIPESTATUS[0] is rsync's exit code, intact because pipefail makes
  # the pipeline's exit non-zero on rsync failure and the if-not
  # branch reads PIPESTATUS as its first operation. Distinguish the
  # partial-transfer codes (23, 24) from transport errors (255) and
  # everything else, since the implications for the user differ:
  # partial means the guest filesystem is half-merged; transport
  # usually means nothing was touched.
  rsync_exit="${PIPESTATUS[0]}"
  case "${rsync_exit}" in
    23|24)
      partial_count="$(awk -F: '/^Number of regular files transferred:/ {
        gsub(/[ ,]/, "", $2); print $2
      }' "${rsync_log}")"
      error 7 <<MESSAGE
rsync transfer of ${project} completed with errors (exit ${rsync_exit}).
${partial_count:-?} files restored; the rest were skipped or failed.
The guest filesystem is in a half-merged state — some paths now
match the snapshot and others retain their pre-restore contents.
See the per-file output above for which entries failed.
Re-run virtdev-restore to retry; rsync's incremental check will
skip files that already match.
MESSAGE
      ;;
    255)
      error 21 <<MESSAGE
rsync transfer failed during restore of ${project} (exit 255: transport).
The SSH connection to the guest could not be established or was lost.
If it dropped mid-transfer, some files may already have been written —
verify the guest's state before retrying.
Verify the virtual machine is reachable, then retry:

    virtdev-ssh ${project} -- true
    virtdev-restore ${project}
MESSAGE
      ;;
    *)
      error 22 <<MESSAGE
rsync transfer failed during restore of ${project} (exit ${rsync_exit}).
The transfer aborted before completion. See the per-file output
above for the cause. The guest filesystem may be unmodified or
partially modified — verify the state before retrying.
MESSAGE
      ;;
  esac
fi

files_transferred="$(awk -F: '/^Number of regular files transferred:/ {
  gsub(/[ ,]/, "", $2); print $2
}' "${rsync_log}")"
files_transferred="${files_transferred:-0}"

# Refuse a restore from a snapshot whose tree is empty (nothing to
# restore). Check the snapshot tree's contents, NOT rsync's transfer
# count: a re-run against a guest that already matches transfers zero
# files while the snapshot is fully populated (the rollback-retry
# case), and rejecting that would be a false failure. Mirrors backup.
if ! snapshot_tree_has_entries "${snapshot}/tree"; then
  error 11 <<MESSAGE
Empty snapshot: ${resolved_date}/${resolved_time}
The snapshot's tree contains no entries to restore.
MESSAGE
fi

printf >&2 '%s\n' "$(terminal_write fg=green "Restored ${files_transferred} files from ${resolved_date}/${resolved_time} into ${project}." reset)"
