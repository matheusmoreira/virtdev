#!/usr/bin/env bash
# shellcheck disable=SC2154  # constants and helper paths provided by imports
#
# virtdev-restore [--verbose] [--preflight] <project> [snapshot]
#
# Restores a backup snapshot into a running project virtual machine.
# The snapshot layout is produced by virtdev-backup and lives under:
#
#   ${VIRTDEV_HOME}/backups/<project>/<YYYY-MM-DD>/<HH-MM-SS>/
#
# With no snapshot argument, restores the newest snapshot for the
# project. With a snapshot (YYYY-MM-DD/HH-MM-SS), restores that
# exact snapshot.
#
# List available snapshots with: virtdev-backup --list <project>
#
# Flags:
#
#   --verbose    Show rsync per-file progress.
#   --preflight  Validate and stage the selected snapshot without changing the guest.
#
# Destructive: overwrites guest files without prompting. Because
# rsync operates on a live, running VM, partial failures may leave
# the guest's filesystem with some restored files and some not. This
# matches virtdev-transfer's semantics.
#
# The project's virtual machine must be running.
#
# Requires rsync on both host and guest:
#
#     pacman -S rsync
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME               Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_SSH_KEY            Default: ${VIRTDEV_HOME}/ssh/id
#   VIRTDEV_RESTORE_MAX_BYTES  Default: 8589934592 (8 GiB regular logical data)
#   VIRTDEV_RESTORE_MAX_ENTRIES Default: 200000
#   VIRTDEV_RESTORE_TIMEOUT    Default: 3600 seconds total
#   VIRTDEV_RESTORE_KILL_AFTER Default: 5 seconds from TERM to KILL
#   VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES Default: 65536
#
# Exit codes:
#
#   0   success
#   2   invalid project name
#   3   project not found
#   4   virtual machine is not running
#   6   rsync not found
#   7   rsync partial transfer (some files skipped or failed)
#   8   no snapshots for project
#   10  snapshot manifest missing or empty
#   11  empty snapshot (tree contains no files)
#   12  snapshot belongs to a different project
#   13  project generation file missing
#   16  snapshot date not found
#   17  no snapshots on requested date
#   18  snapshot time not found
#   19  snapshot data, structure, staging-state, or accounting failure
#   20  restore wall-clock deadline exceeded
#   21  rsync transport failure (SSH connection lost)
#   22  rsync failed with unexpected exit code
#   23  snapshot missing tree/
#   24  snapshot missing project marker
#   25  bounded staging helper not found
#   64  usage error
#   77  SSH key not found
#   78  SSH key permissions too open
#   79  invalid snapshot format
#   81  corrupt port file
#   82  corrupt generation file
#   87  no port assigned (virtual machine not running)
#   103 guest SSH host identity missing or corrupt
#   104 guest SSH transport marker missing or incompatible
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import diagnostic error validate arguments ssh snapshot manifest terminal port project integer mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_SSH_KEY:="${VIRTDEV_HOME}/ssh/id"}"
: "${VIRTDEV_RESTORE_MAX_BYTES:=8589934592}"
: "${VIRTDEV_RESTORE_MAX_ENTRIES:=200000}"
: "${VIRTDEV_RESTORE_TIMEOUT:=3600}"
: "${VIRTDEV_RESTORE_KILL_AFTER:=5}"
: "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES:=65536}"

integer_is_bounded_positive "${VIRTDEV_RESTORE_MAX_BYTES}" 1099511627776 \
  || error 64 <<<'Invalid VIRTDEV_RESTORE_MAX_BYTES: expected 1..1099511627776'
integer_is_bounded_positive "${VIRTDEV_RESTORE_MAX_ENTRIES}" 10000000 \
  || error 64 <<<'Invalid VIRTDEV_RESTORE_MAX_ENTRIES: expected 1..10000000'
integer_is_bounded_positive "${VIRTDEV_RESTORE_TIMEOUT}" 86400 \
  || error 64 <<<'Invalid VIRTDEV_RESTORE_TIMEOUT: expected 1..86400'
integer_is_bounded_positive "${VIRTDEV_RESTORE_KILL_AFTER}" 60 \
  || error 64 <<<'Invalid VIRTDEV_RESTORE_KILL_AFTER: expected 1..60'
integer_is_bounded_positive "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" 1048576 \
  || error 64 <<<'Invalid VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES: expected 1..1048576'

umask 077

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([verbose]=bool [preflight]=bool)
# shellcheck disable=SC2034
declare -A spec_short=([v]=verbose)
# shellcheck disable=SC2034
declare -a spec_positionals=(project "snapshot?")
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

given_date=""
given_time=""
if (( $# == 2 )); then
  snapshot_validate_format "${2}"
  given_date="${2%%/*}"
  given_time="${2##*/}"
fi

validate_project_name "${project}"

project_directory="${VIRTDEV_HOME}/projects/${project}"

project_require_ordinary "${project}"

if (( ! flags[preflight] )); then
  if ! project_is_running "${project}"; then
    error 4 <<MESSAGE
Virtual machine is not running: ${project}
Start it with: virtdev-start ${project}
MESSAGE
  fi

  port=""
  port_require port "${project}"
  ssh_key_validate "${VIRTDEV_SSH_KEY}"
  if ! command -v rsync &>/dev/null; then
    error 6 <<MESSAGE
rsync not found
Install it with: pacman -S rsync
MESSAGE
  fi
fi

# shellcheck disable=SC2154  # provided by lib/virtdev/import
copy_tree_helper="${virtdev_libexec_directory}/virtdev-copy-tree"
if [[ ! -x "${copy_tree_helper}" ]]; then
  error 25 <<<"virtdev-copy-tree not found: '${copy_tree_helper}'. Run 'make' to compile it."
fi

restore_deadline=$(( BASH_MONOSECONDS + VIRTDEV_RESTORE_TIMEOUT ))
readonly restore_free_space_reserve=536870912
readonly restore_inode_reserve=4096
readonly restore_cleanup_grace=2
readonly restore_cleanup_kill_after=1
restore_summary_directory="$(mktemp -d --tmpdir="${VIRTDEV_HOME}" \
  .restore-summary.XXXXXXXX)"
restore_tree_summary_file="${restore_summary_directory}/tree"
restore_allocated_summary_file="${restore_summary_directory}/allocated"
restore_copy_summary_file="${restore_summary_directory}/copy"
restore_manifest_copy="${restore_summary_directory}/manifest"
restore_files_from="${restore_summary_directory}/files-from"
restore_expected_project="${restore_summary_directory}/project"
rsync_log=''
rsync_wrapper=''
restore_stage=''
cleanup_restore() {
  local -r original_status=$?
  local -r cleanup_deadline=$(( BASH_MONOSECONDS + restore_cleanup_grace ))
  local mount_path='' remove_status=0 remaining path

  set +e
  for path in "${rsync_log}" "${rsync_wrapper}"; do
    [[ -z "${path}" ]] || rm -f -- "${path}"
  done
  if [[ -n "${restore_stage}" ]]; then
    remaining=$(( cleanup_deadline - BASH_MONOSECONDS ))
    if (( remaining > 0 )); then
      mount_remove_tree_bounded "${restore_stage}" mount_path "${remaining}" \
        "${restore_cleanup_kill_after}" || remove_status=$?
    else
      remove_status=4
    fi
    case "${remove_status}" in
      0) ;;
      1) printf >&2 'warning: preserving restore stage with mounted subtree: %s\n' "${mount_path}" ;;
      4) printf >&2 'warning: preserving restore stage after cleanup grace expired: %s\n' "${restore_stage}" ;;
      *) printf >&2 'warning: preserving restore stage because cleanup safety is indeterminate: %s\n' "${restore_stage}" ;;
    esac
  fi
  mount_path=''
  remove_status=0
  remaining=$(( cleanup_deadline - BASH_MONOSECONDS ))
  if (( remaining > 0 )); then
    mount_remove_tree_bounded "${restore_summary_directory}" mount_path \
      "${remaining}" "${restore_cleanup_kill_after}" || remove_status=$?
  else
    remove_status=4
  fi
  case "${remove_status}" in
    0) ;;
    1) printf >&2 'warning: preserving restore summary state with mounted subtree: %s\n' "${mount_path}" ;;
    4) printf >&2 'warning: preserving restore summary state after cleanup grace expired: %s\n' "${restore_summary_directory}" ;;
    *) printf >&2 'warning: preserving restore summary state because cleanup safety is indeterminate: %s\n' "${restore_summary_directory}" ;;
  esac
  return "${original_status}"
}
trap cleanup_restore EXIT

backups_project_dir="$(snapshot_directory "${project}")"

# Resolve omitted components to the latest available snapshot.
if [[ -z "${given_date}" ]]; then
  resolved_snapshot=''
  snapshot_latest_into resolved_snapshot "${project}" \
    || error 19 <<<'Could not completely enumerate snapshots'
  if [[ -z "${resolved_snapshot}" ]]; then
    error 8 <<MESSAGE
No snapshots for this project: ${project}
Create one with: virtdev-backup ${project}
MESSAGE
  fi
  resolved_date="${resolved_snapshot%%/*}"
  resolved_time="${resolved_snapshot##*/}"
else
  selection_status=0
  snapshot_hierarchy_state "${project}" "${given_date}" \
    || selection_status=$?
  case "${selection_status}" in
    0) ;;
    "${snapshot_state_missing}")
      error 16 <<<"Snapshot date not found: ${given_date}"
      ;;
    *)
      error 19 <<<"Snapshot date is a symlink or non-directory: ${given_date}"
      ;;
  esac
  resolved_date="${given_date}"
  selection_status=0
  snapshot_hierarchy_state "${project}" "${resolved_date}" "${given_time}" \
    || selection_status=$?
  case "${selection_status}" in
    0) ;;
    "${snapshot_state_missing}")
      error 18 <<<"Snapshot time not found: ${resolved_date}/${given_time}"
      ;;
    *)
      error 19 \
        <<<"Snapshot time is a symlink or non-directory: ${resolved_date}/${given_time}"
      ;;
  esac
  resolved_time="${given_time}"
fi

snapshot="${backups_project_dir}/${resolved_date}/${resolved_time}"
selection_status=0
snapshot_hierarchy_state "${project}" "${resolved_date}" "${resolved_time}" \
  || selection_status=$?
(( selection_status == 0 )) \
  || error 19 <<<"Selected snapshot is no longer a real directory: ${snapshot}"

if [[ ! -f "${snapshot}/manifest" || -L "${snapshot}/manifest" ]]; then
  error 10 <<<"Snapshot missing manifest: ${snapshot}"
fi
if [[ ! -d "${snapshot}/tree" || -L "${snapshot}/tree" ]]; then
  error 23 <<<"Snapshot missing tree/: ${snapshot}"
fi
if [[ ! -f "${snapshot}/project" || -L "${snapshot}/project" ]]; then
  error 24 <<MESSAGE
Snapshot missing 'project' marker: ${snapshot}
This snapshot was likely produced by an older virtdev-backup that
did not record the source project, so cross-project restoration
cannot be verified. Refusing to proceed.
Re-run virtdev-backup to produce a snapshot with origin metadata.
MESSAGE
fi

printf '%s\n' "${project}" > "${restore_expected_project}"
snapshot_project_size="$(stat -c '%s' -- "${snapshot}/project" 2>/dev/null)" \
  || snapshot_project_size=''
remaining=$(( restore_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) \
  || error 20 <<<'Restore deadline expired before project-marker validation'
marker_status=0
timeout --signal=TERM --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" \
  "${remaining}" cmp -s -- "${snapshot}/project" \
  "${restore_expected_project}" || marker_status=$?
case "${marker_status}" in
  0|1) ;;
  124|137) error 20 <<<'Restore project-marker validation exceeded its wall-clock deadline' ;;
  *) error 19 <<<'Could not validate snapshot project marker' ;;
esac
if [[ "${snapshot_project_size}" != "$(( ${#project} + 1 ))" \
      || -L "${snapshot}/project" || ${marker_status} -ne 0 ]]; then
  error 12 <<MESSAGE
Snapshot belongs to a different project.
Target project: ${project}
Snapshots are project-scoped; cross-project restoration is refused.
MESSAGE
fi

# Generation is required for auditability but read leniently for display.
project_generation_file="${project_directory}/generation"
if [[ ! -f "${project_generation_file}" ]]; then
  error 13 <<MESSAGE
Project generation file missing: '${project_generation_file}'
The project's audit trail is incomplete; refusing to proceed.
MESSAGE
fi
project_generation="$(generation_read_project_lenient "${project_generation_file}")"

# Missing or corrupt snapshot generation does not block data recovery.
snapshot_generation='-'
if [[ -s "${snapshot}/generation" ]]; then
  snapshot_generation="$(generation_read_base_lenient "${snapshot}/generation")"
fi

snapshot_tree_status=0
snapshot_tree_has_entries_strict "${snapshot}/tree" || snapshot_tree_status=$?
case "${snapshot_tree_status}" in
  0) ;;
  1) error 11 <<MESSAGE
Empty snapshot: ${resolved_date}/${resolved_time}
The snapshot's tree contains no entries to restore.
MESSAGE
     ;;
  *) error 19 <<<'Could not inspect the complete snapshot tree' ;;
esac

# A generation mismatch is normal after recreate.
if (( flags[preflight] )); then
  printf >&2 'Checking restore source for %s at %s/%s\n' \
    "${project}" "${resolved_date}" "${resolved_time}"
else
  printf >&2 'Restoring %s from %s/%s\n' \
      "${project}" "${resolved_date}" "${resolved_time}"
fi
printf >&2 '  snapshot generation: %s\n' "${snapshot_generation}"
printf >&2 '  current generation:  %s\n' "${project_generation}"

restore_require_confined_tree() {
  local -r tree="${1}"
  local mount_path="" mount_status=0

  mount_find_below "$(realpath -m -- "${tree}")" mount_path \
    || mount_status=$?
  case "${mount_status}" in
    0)
      error 19 <<MESSAGE
Snapshot tree contains a mounted filesystem: '${mount_path}'
No guest files were changed.
MESSAGE
      ;;
    1) ;;
    *) error 19 <<<'Could not inspect snapshot mount state' ;;
  esac
  manifest_sources_confined "${tree}" "${restore_files_from}" \
    || error 19 <<<'Snapshot manifest crosses a symlinked source path'
}

restore_df_value() {
  local -n _restore_df_result="${1}"
  local -r column="${2}" path="${3}" phase="${4}"
  local -r df_output="${restore_summary_directory}/df-${column}"
  local remaining value output_size
  local -a df_lines=()
  local -a df_status=()

  remaining=$(( restore_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) \
    || error 20 <<<"Restore deadline expired before ${phase}"
  case "${column}" in
    avail|iavail) ;;
    *) error 19 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  set +e
  case "${column}" in
    avail)
      timeout --signal=TERM --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" \
        "${remaining}" df -B1 --output=avail -- "${path}" \
        2>/dev/null | head -c 4097 > "${df_output}"
      df_status=("${PIPESTATUS[@]}")
      ;;
    iavail)
      timeout --signal=TERM --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" \
        "${remaining}" df --output=iavail -- "${path}" \
        2>/dev/null | head -c 4097 > "${df_output}"
      df_status=("${PIPESTATUS[@]}")
      ;;
  esac
  set -e
  (( df_status[1] == 0 )) \
    || error 19 <<<"Could not inspect host capacity during ${phase}"
  output_size="$(stat -c '%s' -- "${df_output}" 2>/dev/null)" \
    || output_size=''
  if [[ ! "${output_size}" =~ ^[0-9]+$ ]] || (( output_size > 4096 )); then
    error 19 <<<"Could not parse host capacity during ${phase}"
  fi
  case "${df_status[0]}" in
    0) ;;
    124|137) error 20 <<<"Restore ${phase} exceeded its wall-clock deadline" ;;
    *) error 19 <<<"Could not inspect host capacity during ${phase}" ;;
  esac
  mapfile -t df_lines < "${df_output}"
  if (( ${#df_lines[@]} != 2 )); then
    error 19 <<<"Could not parse host capacity during ${phase}"
  fi
  value="${df_lines[1]//[[:space:]]/}"
  if [[ "${column}" == iavail && "${value}" == - ]]; then
    _restore_df_result=''
    return 0
  fi
  if [[ ! "${value}" =~ ^[0-9]+$ || ${#value} -gt 18 ]]; then
    error 19 <<<"Could not parse host capacity during ${phase}"
  fi
  _restore_df_result="${value}"
}

metadata_available=''
restore_df_value metadata_available avail "${VIRTDEV_HOME}" \
  'manifest capacity preflight'
if (( metadata_available < 2 * manifest_max_bytes + 1048576 )); then
  error 19 <<<'Not enough host free space for bounded restore metadata'
fi
manifest_status=0
manifest_freeze_validate "${snapshot}/manifest" "${restore_manifest_copy}" \
  "${restore_files_from}" "${restore_deadline}" \
  "${VIRTDEV_RESTORE_KILL_AFTER}" || manifest_status=$?
case "${manifest_status}" in
  0) ;;
  "${manifest_result_empty}")
    error 10 <<<"Snapshot manifest has no restorable paths: ${snapshot}"
    ;;
  "${manifest_result_timeout}")
    error 20 <<<'Restore manifest preflight exceeded its wall-clock deadline'
    ;;
  "${manifest_result_too_large}")
    error 19 <<<'Snapshot manifest exceeds its bounded metadata budget'
    ;;
  "${manifest_result_invalid}")
    error 19 <<<'Snapshot manifest contains an unsafe or malformed path'
    ;;
  *) error 19 <<<'Could not freeze snapshot manifest' ;;
esac

restore_summarize_tree() {
  local -r tree="${1}" output="${2}" phase="${3}" entry_limit="${4}"
  local -r count_output="${restore_summary_directory}/tree-count"
  local remaining sort_available entries regular_entries extra_count
  local sort_state_budget
  local -a count_status=()
  local -a summary_status=()

  remaining=$(( restore_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) \
    || error 20 <<<"Restore deadline expired before ${phase} preflight"
  set +e
  # shellcheck disable=SC2016  # awk programs are literal
  LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      find "${tree}" -xdev -printf '%D %i %y %s\n' 2>/dev/null \
    | LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      awk -v maximum_entries="${entry_limit}" \
        -v maximum_bytes="${VIRTDEV_RESTORE_MAX_BYTES}" '
      NR == 1 {
        if (NF != 4 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ \
            || $3 != "d" || $4 !~ /^[0-9]+$/) { invalid = 1; exit }
        root_device = $1
        root_seen = 1
        next
      }
      {
        entries++
        if (entries > maximum_entries) { entries_over = 1; exit }
        if (NF != 4 || $1 != root_device || $2 !~ /^[0-9]+$/ \
            || $3 !~ /^[fdl]$/ || $4 !~ /^[0-9]+$/) {
          invalid = 1
          exit
        }
        if ($3 == "f") {
          size = $4
          sub(/^0+/, "", size)
          if (size == "") size = "0"
          if (length(size) > length(maximum_bytes) \
              || (length(size) == length(maximum_bytes) \
                  && ("x" size) > ("x" maximum_bytes))) {
            bytes_over = 1
            exit
          }
          regular_entries++
        }
      }
      END {
        if (entries_over) exit 42
        if (invalid || !root_seen) exit 43
        if (bytes_over) exit 44
        printf("%d %d\n", entries, regular_entries)
      }
      ' > "${count_output}"
  count_status=("${PIPESTATUS[@]}")
  set -e
  case "${count_status[1]}" in
    42)
      error 19 <<MESSAGE
Snapshot exceeds the ${entry_limit}-entry restore budget.
No guest files were changed.
MESSAGE
      ;;
    44)
      error 19 <<MESSAGE
Snapshot exceeds the ${VIRTDEV_RESTORE_MAX_BYTES}-byte restore budget.
No guest files were changed.
MESSAGE
      ;;
  esac
  if [[ "${count_status[0]}" =~ ^(124|137)$ \
        || "${count_status[1]}" =~ ^(124|137)$ ]]; then
    error 20 <<<"Restore ${phase} preflight exceeded its wall-clock deadline"
  fi
  (( count_status[1] == 0 )) \
    || error 19 <<<"Could not count ${phase} snapshot entries"
  (( count_status[0] == 0 )) \
    || error 19 <<<"Could not inspect ${phase} snapshot entries"
  read -r entries regular_entries extra_count < "${count_output}"
  if [[ ! "${entries}" =~ ^[0-9]+$ \
        || ! "${regular_entries}" =~ ^[0-9]+$ \
        || -n "${extra_count}" ]]; then
    error 19 <<<"Could not parse ${phase} snapshot entry count"
  fi

  sort_state_budget=$(( regular_entries * 128 ))
  restore_df_value sort_available avail "${restore_summary_directory}" \
    "${phase} preflight capacity check"
  if (( sort_available < sort_state_budget + restore_free_space_reserve )); then
    error 19 <<<'Not enough host free space for bounded restore preflight state'
  fi
  remaining=$(( restore_deadline - BASH_MONOSECONDS ))
  (( remaining > 0 )) \
    || error 20 <<<"Restore deadline expired before ${phase} inode preflight"
  set +e
  # shellcheck disable=SC2016  # awk programs are literal
  LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      find "${tree}" -xdev -printf '%D %i %y %s\n' 2>/dev/null \
    | LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      awk -v expected_entries="${entries}" \
        -v expected_regular="${regular_entries}" \
        -v maximum_bytes="${VIRTDEV_RESTORE_MAX_BYTES}" '
        NR == 1 {
          if (NF != 4 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ \
              || $3 != "d" || $4 !~ /^[0-9]+$/) { invalid = 1; exit }
          root_device = $1
          root_seen = 1
          next
        }
        {
          entries++
          if (entries > expected_entries) { changed = 1; exit }
          if (NF != 4 || $1 != root_device || $2 !~ /^[0-9]+$/ \
              || $3 !~ /^[fdl]$/ || $4 !~ /^[0-9]+$/) {
            invalid = 1
            exit
          }
          if ($3 == "f") {
            size = $4
            sub(/^0+/, "", size)
            if (size == "") size = "0"
            if (length(size) > length(maximum_bytes) \
                || (length(size) == length(maximum_bytes) \
                    && ("x" size) > ("x" maximum_bytes))) {
              bytes_over = 1
              exit
            }
            regular_entries++
            if (regular_entries > expected_regular) { changed = 1; exit }
            printf("%s %s %s\n", $1, $2, size)
          }
        }
        END {
          if (invalid || !root_seen) exit 43
          if (bytes_over) exit 44
          if (changed || entries != expected_entries \
              || regular_entries != expected_regular) exit 45
        }
      ' \
    | LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      sort --unique --buffer-size=32M \
        --temporary-directory="${restore_summary_directory}" \
    | LC_ALL=C timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      awk -v maximum_bytes="${VIRTDEV_RESTORE_MAX_BYTES}" \
        -v expected_entries="${entries}" '
        {
          if (NF != 3 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ \
              || $3 !~ /^[0-9]+$/) { invalid = 1; exit }
          size = $3
          sub(/^0+/, "", size)
          if (size == "") size = "0"
          key = $1 ":" $2
          if (key == previous_key) {
            if (size != previous_size) { invalid = 1; exit }
            next
          }
          logical_bytes += size + 0
          if (logical_bytes > maximum_bytes) { bytes_over = 1; exit }
          previous_key = key
          previous_size = size
        }
        END {
          if (invalid) exit 43
          if (bytes_over) exit 44
          printf("%d %.0f\n", expected_entries, logical_bytes)
        }
      ' > "${output}"
  summary_status=("${PIPESTATUS[@]}")
  set -e
  case "${summary_status[1]}" in
    42)
      error 19 <<MESSAGE
Snapshot exceeds the ${entry_limit}-entry restore budget.
No guest files were changed.
MESSAGE
      ;;
    45)
      error 19 <<<"Snapshot changed between ${phase} preflight scans"
      ;;
    44)
      error 19 <<MESSAGE
Snapshot exceeds the ${VIRTDEV_RESTORE_MAX_BYTES}-byte restore budget.
No guest files were changed.
MESSAGE
      ;;
  esac
  case "${summary_status[3]}" in
    44)
      error 19 <<MESSAGE
Snapshot exceeds the ${VIRTDEV_RESTORE_MAX_BYTES}-byte restore budget.
No guest files were changed.
MESSAGE
      ;;
  esac
  if [[ "${summary_status[0]}" =~ ^(124|137)$ \
        || "${summary_status[1]}" =~ ^(124|137)$ \
        || "${summary_status[2]}" =~ ^(124|137)$ \
        || "${summary_status[3]}" =~ ^(124|137)$ ]]; then
    error 20 <<<"Restore ${phase} preflight exceeded its wall-clock deadline"
  fi
  case "${summary_status[3]}" in
    0) ;;
    *) error 19 <<<"Could not summarize ${phase} snapshot inode data" ;;
  esac
  case "${summary_status[2]}" in
    0) ;;
    *) error 19 <<<"Could not sort ${phase} snapshot inode data" ;;
  esac
  case "${summary_status[1]}" in
    0) ;;
    *) error 19 <<<"Could not summarize ${phase} snapshot entries" ;;
  esac
  case "${summary_status[0]}" in
    0) ;;
    *) error 19 <<<"Could not inspect ${phase} snapshot entries" ;;
  esac
}

restore_require_confined_tree "${snapshot}/tree"
restore_summarize_tree "${snapshot}/tree" \
  "${restore_tree_summary_file}" source "${VIRTDEV_RESTORE_MAX_ENTRIES}"
read -r source_entries source_logical_bytes extra_summary \
  < "${restore_tree_summary_file}"
[[ "${source_entries}" =~ ^[0-9]+$ \
    && "${source_logical_bytes}" =~ ^[0-9]+$ \
    && -z "${extra_summary}" ]] \
  || error 19 <<<'Could not parse source snapshot summary'

remaining=$(( restore_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Restore deadline expired before capacity preflight'
set +e
LC_ALL=C timeout --signal=TERM \
    --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
    du -sx -B1 -- "${snapshot}/tree" 2>/dev/null \
  | awk 'NR == 1 && $1 ~ /^[0-9]+$/ { print $1; found = 1 }
      END { if (!found) exit 1 }' > "${restore_allocated_summary_file}"
allocated_status=("${PIPESTATUS[@]}")
set -e
case "${allocated_status[0]}" in
  0) ;;
  124|137) error 20 <<<'Restore capacity preflight exceeded its wall-clock deadline' ;;
  *) error 19 <<<'Could not inspect allocated snapshot bytes' ;;
esac
(( allocated_status[1] == 0 )) \
  || error 19 <<<'Could not summarize allocated snapshot bytes'
source_allocated_bytes="$(< "${restore_allocated_summary_file}")"
[[ "${source_allocated_bytes}" =~ ^[0-9]+$ \
    && ${#source_allocated_bytes} -le 18 ]] \
  || error 19 <<<'Could not parse allocated snapshot bytes'

available_bytes=''
available_inodes=''
restore_df_value available_bytes avail "${VIRTDEV_HOME}" \
  'restore capacity preflight'
restore_df_value available_inodes iavail "${VIRTDEV_HOME}" \
  'restore inode preflight'
metadata_budget=$(( source_entries * 4096 ))
staging_budget=$(( source_allocated_bytes + metadata_budget \
  + restore_free_space_reserve ))
if (( available_bytes < staging_budget )); then
  error 19 <<<'Not enough host free space to stage the bounded restore snapshot'
fi
if [[ "${available_inodes}" =~ ^[0-9]+$ ]] \
    && (( available_inodes < source_entries + restore_inode_reserve )); then
  error 19 <<<'Not enough host inodes to stage the bounded restore snapshot'
fi

restore_require_confined_tree "${snapshot}/tree"
remaining=$(( restore_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Restore deadline expired before snapshot staging'
restore_stage="$(mktemp -d --tmpdir="${VIRTDEV_HOME}" .restore.XXXXXXXX)"
stage_status=0
timeout --signal=TERM --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" \
  "${remaining}" "${copy_tree_helper}" \
  "${snapshot}/tree" "${restore_stage}" \
  "${source_logical_bytes}" "${source_entries}" \
  "${restore_free_space_reserve}" "${restore_inode_reserve}" \
  > "${restore_copy_summary_file}" || stage_status=$?
case "${stage_status}" in
  0) ;;
  42) error 19 <<<'Snapshot entry set changed during bounded staging' ;;
  44) error 19 <<<'Snapshot byte set changed during bounded staging' ;;
  45) error 19 <<<'Host capacity reserve was reached during bounded staging' ;;
  46) error 19 <<<'Snapshot nesting or path length exceeds the safe staging limit' ;;
  47) error 19 <<<'Snapshot changed while constructing its stable stage' ;;
  48) error 19 <<<'Snapshot metadata exceeds the bounded staging-state budget' ;;
  124|137) error 20 <<<'Restore snapshot staging exceeded its wall-clock deadline' ;;
  *) error 19 <<<'Could not create a stable restore snapshot' ;;
esac
read -r copied_entries copied_logical_bytes extra_copy_summary \
  < "${restore_copy_summary_file}"
[[ "${copied_entries}" == "${source_entries}" \
    && "${copied_logical_bytes}" == "${source_logical_bytes}" \
    && -z "${extra_copy_summary}" ]] \
  || error 19 <<<'Snapshot changed while constructing its stable stage'

restore_source_tree="${restore_stage}/tree"
restore_require_confined_tree "${restore_source_tree}"
restore_summarize_tree "${restore_source_tree}" \
  "${restore_tree_summary_file}" stable "${copied_entries}"
read -r restore_entries restore_logical_bytes extra_summary \
  < "${restore_tree_summary_file}"
[[ "${restore_entries}" == "${copied_entries}" \
    && "${restore_logical_bytes}" == "${copied_logical_bytes}" \
    && -z "${extra_summary}" ]] \
  || error 19 <<<'Could not validate stable snapshot summary'

if (( flags[preflight] )); then
  printf >&2 'Restore preflight passed for %s/%s\n' \
    "${resolved_date}" "${resolved_time}"
  exit 0
fi

ssh_command=""
rsync_log="$(mktemp)"
transfer_stderr="${restore_summary_directory}/transfer.stderr"
transfer_stderr_fifo="${restore_summary_directory}/transfer.stderr.fifo"
ssh_rsync_command ssh_command rsync_wrapper "${project}" \
  "${VIRTDEV_SSH_KEY}" "${port}"

# Receiver-side --safe-links protects the host on backup, not on restore.
# With --files-from, rsync's -a does not imply -r.
rsync_opts=(-a -r --one-file-system --sparse --hard-links --no-D \
  --ignore-missing-args --stats)
(( flags[verbose] )) && rsync_opts+=(--info=progress2)

# Keep the parsed rsync --stats labels stable.
remaining=$(( restore_deadline - BASH_MONOSECONDS ))
(( remaining > 0 )) || error 20 <<<'Restore deadline expired before transfer'
restore_require_confined_tree "${restore_source_tree}"
set +e
LC_ALL=C bounded_stderr_run "${transfer_stderr}" "${transfer_stderr_fifo}" \
    "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" \
    timeout --signal=TERM \
      --kill-after="${VIRTDEV_RESTORE_KILL_AFTER}" "${remaining}" \
      rsync "${rsync_opts[@]}" \
    --files-from="${restore_files_from}" \
    -e "${ssh_command}" \
    "${restore_source_tree}/" \
    "dev@127.0.0.1:/home/dev/" \
    | tee "${rsync_log}"
transfer_status=("${PIPESTATUS[@]}")
set -e
diagnostic_status=0
bounded_stderr_emit "${transfer_stderr}" \
  "${VIRTDEV_REMOTE_DIAGNOSTIC_MAX_BYTES}" || diagnostic_status=$?
case "${diagnostic_status}" in
  0) ;;
  2)
    error 19 <<MESSAGE
Guest restore diagnostics exceeded the bounded output budget.
The guest filesystem may be partially modified; inspect it before retrying.
MESSAGE
    ;;
  *) error 22 <<<'Could not capture bounded guest restore diagnostics' ;;
esac
rsync_exit="${transfer_status[0]}"
tee_exit="${transfer_status[1]}"
(( tee_exit == 0 )) || error 22 <<<'Could not record restore transfer output'
if (( rsync_exit != 0 )); then
  case "${rsync_exit}" in
    124|137)
      error 20 <<MESSAGE
Restore transfer exceeded its wall-clock deadline.
The guest filesystem may be partially modified; inspect it before retrying.
MESSAGE
      ;;
    23|24)
      partial_count="$(awk -F: '/^Number of regular files transferred:/ {
        gsub(/[ ,]/, "", $2); print $2
      }' "${rsync_log}")"
      error 7 <<MESSAGE
rsync transfer of ${project} completed with errors (exit ${rsync_exit}).
${partial_count:-?} files restored; the rest were skipped or failed.
The guest filesystem is in a half-merged state — some paths now
match the snapshot and others retain their pre-restore contents.
See the per-file output above for which entries failed.
Re-run virtdev-restore to retry; rsync's incremental check will
skip files that already match.
MESSAGE
      ;;
    255)
      error 21 <<MESSAGE
rsync transfer failed during restore of ${project} (exit 255: transport).
The SSH connection to the guest could not be established or was lost.
If it dropped mid-transfer, some files may already have been written —
verify the guest's state before retrying.
Verify the virtual machine is reachable, then retry:

    virtdev-ssh ${project} -- true
    virtdev-restore ${project}
MESSAGE
      ;;
    *)
      error 22 <<MESSAGE
rsync transfer failed during restore of ${project} (exit ${rsync_exit}).
The transfer aborted before completion. See the per-file output
above for the cause. The guest filesystem may be unmodified or
partially modified — verify the state before retrying.
MESSAGE
      ;;
  esac
fi

files_transferred="$(awk -F: '/^Number of regular files transferred:/ {
  gsub(/[ ,]/, "", $2); print $2
}' "${rsync_log}")"
files_transferred="${files_transferred:-0}"

printf >&2 '%s\n' "$(terminal_write fg=green "Restored ${files_transferred} files from ${resolved_date}/${resolved_time} into ${project}." reset)"
