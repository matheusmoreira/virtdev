#!/usr/bin/env bash
#
# virtdev-iso
#
# Builds the virtdev Arch Linux installation ISO.
# The resulting ISO is written to ${VIRTDEV_CACHE}/virtdev.iso,
# which is the default VIRTDEV_ISO consumed by virtdev-install.
#
# Configuration via environment variables:
#
#   VIRTDEV_HOME           Base directory for virtdev data.
#                          Default: ${XDG_DATA_HOME:-~/.local/share}/virtdev
#   VIRTDEV_CACHE          Cache/build/output directory.
#                          Default: ${XDG_CACHE_HOME:-~/.cache}/virtdev
#
#   VIRTDEV_ISO_PROFILE    Path to the virtdev ISO profile directory.
#                          Detected automatically; set to override.
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error arguments lock mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"
: "${VIRTDEV_CACHE:="${XDG_CACHE_HOME:-${HOME}/.cache}/virtdev"}"

# shellcheck disable=SC2034  # spec read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=()
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 0 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

#
# Resolve ISO profile directory:
#   1. Explicit override via VIRTDEV_ISO_PROFILE
#   2. Adjacent to script (git checkout: bin/../iso)
#   3. Installed system path (package: /usr/share/virtdev/profile)
#
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ -n "${VIRTDEV_ISO_PROFILE:-}" ]]; then
  iso_profile="${VIRTDEV_ISO_PROFILE}"
elif [[ -f "${script_dir}/../iso/profiledef.sh" ]]; then
  iso_profile="$(cd "${script_dir}/../iso" && pwd -P)"
else
  iso_profile="/usr/share/virtdev/profile"
fi

if [[ ! -f "${iso_profile}/profiledef.sh" ]]; then
  error 3 <<<"ISO profile not found: '${iso_profile}'"
fi

if ! command -v mkarchiso &>/dev/null; then
  error 4 <<<'mkarchiso not found, install archiso'
fi

profile=/usr/share/archiso/configs/releng

if [[ ! -d "${profile}" ]]; then
  error 5 <<<"archiso releng profile not found: '${profile}'"
fi

# shellcheck disable=SC2154  # provided by lib/virtdev/import
remove_tree_helper="${virtdev_libexec_directory}/virtdev-remove-tree"
if [[ ! -x "${remove_tree_helper}" ]]; then
  error 12 <<<"virtdev-remove-tree not found: '${remove_tree_helper}'. Run 'make' to compile it."
fi

lock_acquire_cache

invoking_uid="$(/usr/bin/id -u)"
if [[ ! "${invoking_uid}" =~ ^[0-9]+$ ]]; then
  error 11 <<<'could not resolve numeric build owner (internal bug)'
fi

build_directory="$(realpath -m -- "${VIRTDEV_CACHE}")"
if ! mkdir -p -- "${build_directory}" \
    || [[ ! -d "${build_directory}" || -L "${build_directory}" ]]; then
  error 10 <<<"Cannot prepare ISO build root: '${build_directory}'"
fi
build_owner="$(stat -c '%u' -- "${build_directory}" 2>/dev/null || true)"
if [[ "${build_owner}" != "${invoking_uid}" ]]; then
  error 10 <<MESSAGE
ISO build root is not owned by uid ${invoking_uid}: '${build_directory}'
Choose a user-owned VIRTDEV_CACHE or repair the build-root ownership explicitly.
MESSAGE
fi
chmod 0700 -- "${build_directory}" \
  || error 10 <<<"Cannot secure ISO build root: '${build_directory}'"
build_directory="$(realpath -- "${build_directory}")"
if ! exec {build_directory_fd}<"${build_directory}"; then
  error 10 <<<"Cannot pin ISO build root: '${build_directory}'"
fi
build_identity="$(stat -Lc '%d:%i:%u' -- \
  "/proc/self/fd/${build_directory_fd}" 2>/dev/null || true)"
current_identity="$(stat -Lc '%d:%i:%u' -- \
  "${build_directory}" 2>/dev/null || true)"
if [[ -z "${build_identity}" || "${build_identity}" != "${current_identity}" \
    || "${build_identity##*:}" != "${invoking_uid}" ]]; then
  error 10 <<<"ISO build root changed while it was being pinned: '${build_directory}'"
fi
build_anchor="$(realpath -- "/proc/self/fd/${build_directory_fd}")"
if [[ "${build_anchor}" != "${build_directory}" ]]; then
  error 10 <<<"ISO build root changed while it was being pinned: '${build_directory}'"
fi
output_directory="${build_directory}"
work_directory="${build_directory}"/work
profile_directory="${build_directory}"/profile

build_root="$(realpath -m "${build_directory}")"
for path in "${work_directory}" "${profile_directory}"; do
  real="$(realpath -m "${path}")"
  if [[ "${real}" != "${build_root}"/?* ]]; then
    error 10 <<MESSAGE
Build path is not strictly under build root: '${path}'
    Resolved:   '${real}'
    Build root: '${build_root}'
ISO build aborted.
MESSAGE
  fi
done

if [[ "${work_directory}" != "${build_directory}/work" \
   || "${profile_directory}" != "${build_directory}/profile" ]]; then
  error 11 <<<"build path construction mismatch (internal bug)"
fi

require_unmounted_tree() {
  local -r path="${1}"
  local mount_path="" status=0

  mount_find_below "$(realpath -m -- "${path}")" mount_path || status=$?
  case "${status}" in
    0)
      error 12 <<MESSAGE
Mounted filesystem detected below ISO build path: '${mount_path}'
Unmount stale mkarchiso mounts explicitly; automatic cleanup was refused.
MESSAGE
      ;;
    1) ;;
    *) error 12 <<<'Could not inspect mount state; ISO cleanup was refused.' ;;
  esac
}

quarantine_directory=""

cleanup_quarantine_directory() {
  local -r status="${?}"
  if [[ -n "${quarantine_directory}" ]]; then
    sudo /usr/bin/rmdir -- "${quarantine_directory}" 2>/dev/null || true
  fi
  return "${status}"
}
trap cleanup_quarantine_directory EXIT

prepare_quarantine_directory() {
  local quarantine_candidate quarantine_owner quarantine_mode quarantine_real
  local quarantine_root
  local root_owner root_mode root_mode_value status=0 expected_prefix

  [[ -z "${quarantine_directory}" ]] || return 0
  mount_find_containing "${build_anchor}" quarantine_root || status=$?
  if (( status != 0 )); then
    error 12 <<<'Could not identify the ISO build filesystem for safe cleanup.'
  fi
  root_owner="$(stat -c '%u' -- "${quarantine_root}" 2>/dev/null || true)"
  root_mode="$(stat -c '%a' -- "${quarantine_root}" 2>/dev/null || true)"
  if [[ "${root_owner}" != 0 || ! "${root_mode}" =~ ^[0-7]{3,4}$ ]]; then
    error 12 <<<"Unsafe ISO cleanup quarantine root: '${quarantine_root}'"
  fi
  root_mode_value=$(( 8#${root_mode} ))
  if (( (root_mode_value & 0022) != 0 && (root_mode_value & 01000) == 0 )); then
    error 12 <<<"ISO cleanup quarantine root is writable without sticky protection: '${quarantine_root}'"
  fi

  quarantine_candidate="$(
    sudo /usr/bin/mktemp -d --tmpdir="${quarantine_root}" .virtdev-iso.XXXXXXXXXX
  )" || error 12 <<<'Could not create a privileged ISO cleanup quarantine.'
  quarantine_real="$(realpath -- "${quarantine_candidate}" 2>/dev/null || true)"
  quarantine_owner="$(stat -c '%u' -- "${quarantine_candidate}" 2>/dev/null || true)"
  quarantine_mode="$(stat -c '%a' -- "${quarantine_candidate}" 2>/dev/null || true)"
  expected_prefix="${quarantine_root%/}/.virtdev-iso."
  if [[ "${quarantine_real}" != "${expected_prefix}"* \
      || -L "${quarantine_candidate}" || ! -d "${quarantine_candidate}" \
      || "${quarantine_owner}" != 0 || "${quarantine_mode}" != 700 ]]; then
    error 12 <<<'Privileged ISO cleanup returned an unsafe quarantine directory.'
  fi
  quarantine_directory="${quarantine_real}"
}

cleanup_build_tree() {
  local -r path="${1}" leaf="${2}"
  local anchored_path quarantined mount_path="" original_mount status=0

  anchored_path="/proc/self/fd/${build_directory_fd}/${leaf}"
  [[ -e "${anchored_path}" || -L "${anchored_path}" ]] || return 0
  require_unmounted_tree "${anchored_path}"
  prepare_quarantine_directory
  quarantined="${quarantine_directory}/${leaf}"

  if ! (cd -- "/proc/self/fd/${build_directory_fd}" \
      && sudo /usr/bin/mv --no-target-directory -- "${leaf}" "${quarantined}"); then
    error 12 <<<"Could not quarantine ISO build tree: '${path}'"
  fi

  mount_find_below "${quarantined}" mount_path || status=$?
  case "${status}" in
    0)
      original_mount="${path}${mount_path#"${quarantined}"}"
      if (cd -- "/proc/self/fd/${build_directory_fd}" \
          && sudo /usr/bin/mv --no-target-directory -- "${quarantined}" "${leaf}"); then
        error 12 <<MESSAGE
Mounted filesystem detected below ISO build path: '${original_mount}'
Unmount stale mkarchiso mounts explicitly; automatic cleanup was refused.
MESSAGE
      fi
      error 12 <<MESSAGE
Mounted filesystem detected in quarantined ISO tree: '${mount_path}'
The preserved tree could not be returned to '${path}'.
Recover it explicitly from '${quarantined}'.
MESSAGE
      ;;
    1) ;;
    *)
      error 12 <<MESSAGE
Could not inspect the quarantined ISO tree; cleanup was refused.
Recover it explicitly from '${quarantined}'.
MESSAGE
      ;;
  esac

  mount_path=""
  status=0
  mount_path="$(sudo "${remove_tree_helper}" "${quarantined}")" || status=$?
  case "${status}" in
    0) ;;
    1)
      original_mount="${path}${mount_path#"${quarantined}"}"
      error 12 <<MESSAGE
Mounted filesystem appeared during ISO cleanup: '${original_mount}'
The quarantined tree was preserved for inspection: '${quarantined}'
MESSAGE
      ;;
    *)
      error 12 <<<"Could not remove quarantined ISO build tree safely: '${quarantined}'"
      ;;
  esac
}

printf >&2 'Clearing build tree...\n'
cleanup_build_tree "${work_directory}" work
cleanup_build_tree "${profile_directory}" profile
if [[ -n "${quarantine_directory}" ]]; then
  sudo /usr/bin/rmdir -- "${quarantine_directory}" \
    || error 12 <<<"Could not remove ISO cleanup quarantine: '${quarantine_directory}'"
  quarantine_directory=""
fi
current_identity="$(stat -Lc '%d:%i:%u' -- \
  "${build_directory}" 2>/dev/null || true)"
if [[ "${current_identity}" != "${build_identity}" ]]; then
  error 10 <<<"ISO build root changed during cleanup: '${build_directory}'"
fi
mkdir -p "${work_directory}" "${profile_directory}"

printf >&2 "Copying profile: '%s'\n" "${profile}"
cp -r "${profile}/." "${profile_directory}/"
for obsolete_tree in "${profile_directory}/grub" \
    "${profile_directory}/syslinux"; do
  obsolete_mount=''
  obsolete_status=0
  mount_remove_tree "${obsolete_tree}" obsolete_mount || obsolete_status=$?
  case "${obsolete_status}" in
    0) ;;
    1) error 12 <<<"Mounted filesystem appeared below ISO profile: '${obsolete_mount}'" ;;
    *) error 12 <<<"Could not remove obsolete ISO profile tree safely: '${obsolete_tree}'" ;;
  esac
done
rm -f -- "${profile_directory}/efiboot/loader/entries/"*.conf

printf >&2 'Overlaying ISO configuration files...\n'
cp -r "${iso_profile}/." "${profile_directory}/"

printf >&2 'Sweeping stale ISOs from output directory...\n'
find "${output_directory}" -maxdepth 1 -name '*-x86_64.iso' -exec rm -f {} +

printf >&2 'Creating Arch Linux installation media...\n'
sudo mkarchiso -v -w "${work_directory}" -o "${output_directory}" "${profile_directory}"

mapfile -t built_isos < <(find "${output_directory}" -maxdepth 1 -name '*-x86_64.iso')

if [[ ${#built_isos[@]} -eq 0 ]]; then
  error 8 <<<"Failed to create installation media in '${output_directory}'"
fi

if [[ ${#built_isos[@]} -gt 1 ]]; then
  error 9 <<<"Multiple ISOs found in '${output_directory}'"
fi

iso="${output_directory}/virtdev.iso"
mv "${built_isos[0]}" "${iso}"

printf >&2 "Created Arch Linux installation media: '%s'\n" "${iso}"
