#!/usr/bin/env bash
# shellcheck disable=SC2154  # SSH contract constants are imported
#
# virtdev-create <project>
#
# Creates a named project virtual machine
# derived from the sealed base system images.
# Provisions the project directory.
# Does not start the virtual machine
# nor assign an SSH port.
# Use virtdev-start for that.
#
# Project layout:
#
#   ${VIRTDEV_HOME}/
#     projects/
#       ${project}/
#         system.qcow2    (delta over system/system.qcow2)
#         home.qcow2      (delta over system/home.qcow2)
#         nvram           (UEFI variable store copy)
#         guest-contract  (guest/host transport compatibility)
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/virtdev/import"

import error validate lock arguments terminal project runtime ssh mount

: "${VIRTDEV_HOME:="${XDG_DATA_HOME:-${HOME}/.local/share}/virtdev"}"

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=()
# shellcheck disable=SC2034
declare -a spec_positionals=(project)
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

if [[ $# -ne 1 ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

project="${1}"

validate_project_name "${project}"

# Create and move share the same storage/machine reservations.
if reserved_reason="$(validate_project_name_reserved "${project}")"; then
  error 3 <<<"${reserved_reason}"
fi

project_directory="${VIRTDEV_HOME}/projects/${project}"
if ! runtime_socket_paths_fit "${project_directory}"; then
  error 2 <<MESSAGE
Runtime path is too long for Unix sockets: '${project_directory}'
Choose a shorter VIRTDEV_HOME or project name before creating the project.
MESSAGE
fi

lock_acquire

system_directory="${VIRTDEV_HOME}/system"

base_directory_require() {
  if [[ ! -d "${system_directory}" || -L "${system_directory}" ]]; then
    error 4 <<MESSAGE
Sealed base system images not found: '${system_directory}'
Run virtdev-install and virtdev-seal first
MESSAGE
  fi
}

base_image_require() {
  local -r file="${1}"
  if [[ ! -f "${system_directory}/${file}" \
      || -L "${system_directory}/${file}" ]]; then
    error 5 <<<"Base system image missing: '${system_directory}/${file}'"
  fi
}

base_generation_require() {
  if [[ ! -f "${system_directory}/generation" \
      || -L "${system_directory}/generation" ]]; then
    error 7 <<<"Base system generation file missing: '${system_directory}/generation'"
  fi
}

base_contract_require() {
  if ! ssh_guest_contract_valid "${system_directory}"; then
    error 8 <<MESSAGE
Sealed-base SSH contract marker is missing or incompatible.
If the base predates strict host identity, build and install the current ISO,
then seal a new base before creating projects.
MESSAGE
  fi
}

base_directory_require

for file in system.qcow2 home.qcow2 nvram; do
  base_image_require "${file}"
done

base_generation_require
base_generation="$(generation_read_base "${system_directory}/generation")"

base_contract_require

if [[ -d "${project_directory}" ]]; then
  error 6 <<<"Project already exists: '${project_directory}'"
fi

# Create project directory and disk images. Failed cleanup preserves any tree
# whose mount or identity state cannot be proved safe.

mkdir -p "${project_directory}"
chmod 0700 "${project_directory}"

create_succeeded=0
cleanup_partial_project() {
  local mount_path="" remove_status=0
  if (( ! create_succeeded )); then
    mount_remove_tree "${project_directory}" mount_path || remove_status=$?
    case "${remove_status}" in
      0) ;;
      1) printf >&2 'warning: preserving partial project with mounted subtree: %s\n' "${mount_path}" ;;
      2) printf >&2 'warning: preserving partial project because cleanup safety is indeterminate: %s\n' "${project_directory}" ;;
      *) printf >&2 'warning: could not remove partial project safely: %s\n' "${project_directory}" ;;
    esac
  fi
}
trap cleanup_partial_project EXIT

system_disk="${project_directory}/system.qcow2"
home_disk="${project_directory}/home.qcow2"
nvram="${project_directory}/nvram"

base_directory_require
base_image_require system.qcow2
printf >&2 "Creating system delta image: '%s'\n" "${system_disk}"
qemu-img create \
    -f qcow2 \
    -b "${system_directory}/system.qcow2" \
    -F qcow2 \
    "${system_disk}"

base_directory_require
base_image_require home.qcow2
printf >&2 "Creating home delta image: '%s'\n" "${home_disk}"
qemu-img create \
    -f qcow2 \
    -b "${system_directory}/home.qcow2" \
    -F qcow2 \
    "${home_disk}"

base_directory_require
base_image_require nvram
printf >&2 "Copying NVRAM: '%s'\n" "${nvram}"
cp "${system_directory}/nvram" "${nvram}"
chmod 644 "${nvram}"

printf '%s\n' "${base_generation}" > "${project_directory}/generation"
chmod 644 "${project_directory}/generation"
base_directory_require
base_contract_require
cp -- "${system_directory}/${ssh_guest_contract_name}" \
  "${project_directory}/${ssh_guest_contract_name}"
chmod 0444 "${project_directory}/${ssh_guest_contract_name}"
ssh_guest_contract_valid "${project_directory}" \
  || error 8 <<<'Could not copy the guest SSH transport contract into the project.'

create_succeeded=1

printf >&2 '\n'
printf >&2 '%s\n' "$(terminal_write fg=green "Project virtual machine created: '${project}'" reset)"
printf >&2 "Directory: '%s'\n" "${project_directory}"
printf >&2 "Start it with: virtdev-start %s\n" "${project}"
