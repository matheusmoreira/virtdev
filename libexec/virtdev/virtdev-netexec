#!/usr/bin/env bash
# shellcheck disable=SC2154  # imported readonly result constants
#
# virtdev-netexec --runtime-dir <path> [--forward <port>]
#                 [--allow-host-loopback] -- <qemu-command...>
#
# Internal passt/QEMU exec shim. It publishes launch ownership before reserved
# shim failures and again before exec, so QEMU's numeric exit is never confused
# with a pre-exec failure.
#
# Exit codes:
#   64  usage error (arguments library)
#   83  passt binary not found (constant from lib/virtdev/passt)
#   84  passt failed to initialise (constant from lib/virtdev/passt)
#   86  QEMU command not found / not executable (pre-flight)
#

set -euo pipefail

# shellcheck disable=SC1090,SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../lib/virtdev/import"

import error arguments passt port runtime

# shellcheck disable=SC2034  # spec/companions read via nameref
declare -A spec=([runtime-dir]=required [forward]=value [allow-host-loopback]=bool)
# shellcheck disable=SC2034
declare -A spec_placeholders=([runtime-dir]=path [forward]=port)
# shellcheck disable=SC2034
declare -a spec_positionals=("qemu-command+")
# shellcheck disable=SC2034
declare -A flags=()
declare -a positional=()
arguments_parse spec flags positional "$@"
set -- "${positional[@]}"

runtime_dir="${flags[runtime-dir]:-}"
forward_port="${flags[forward]:-}"
# CROSS-REF: the firewall exit-100 guard (firewall_guard_running_hostmap) string-matches
# this exact flag name in each machine's ExecStart to detect an open host map. Renaming
# the flag here means updating that match too, or the guard silently fails OPEN.
allow_host_loopback=0
if [[ -n "${flags[allow-host-loopback]:-}" && "${flags[allow-host-loopback]}" != "0" ]]; then
  allow_host_loopback=1
fi

if [[ $# -lt 1 || -z "${runtime_dir}" ]]; then
  error 64 <<<"$(arguments_usage spec)"
fi

if [[ ! -d "${runtime_dir}" || -L "${runtime_dir}" ]]; then
  error 64 <<<"Invalid runtime directory: '${runtime_dir}'"
fi
runtime_dir="$(readlink -f -- "${runtime_dir}")" \
  || error 64 <<<"Could not resolve runtime directory"
runtime_owner="$(stat -c '%u' -- "${runtime_dir}")" \
  || error 64 <<<"Could not inspect runtime directory: '${runtime_dir}'"
runtime_mode="$(stat -c '%a' -- "${runtime_dir}")" \
  || error 64 <<<"Could not inspect runtime directory: '${runtime_dir}'"
if [[ "${runtime_owner}" != "${EUID}" || "${runtime_mode}" != 700 ]]; then
  error 64 <<<"Runtime directory must be owned by uid ${EUID} with mode 0700: '${runtime_dir}'"
fi
if ! runtime_socket_paths_fit "${runtime_dir}"; then
  error 64 <<<"Runtime directory produces an overlong Unix socket path: '${runtime_dir}'"
fi

socket="$(runtime_network_sock "${runtime_dir}")"
phase_file="$(runtime_launch_phase_file "${runtime_dir}")"
phase_tmp="${phase_file}.tmp"
if [[ ( -e "${socket}" || -L "${socket}" ) \
      && ( ! -S "${socket}" || -L "${socket}" ) ]]; then
  error 1 <<<"Refusing non-socket network artifact: '${socket}'"
fi
for phase_artifact in "${phase_file}" "${phase_tmp}"; do
  if [[ ( -e "${phase_artifact}" || -L "${phase_artifact}" ) \
        && ( ! -f "${phase_artifact}" || -L "${phase_artifact}" ) ]]; then
    error 1 <<<"Refusing unsafe launch-phase artifact: '${phase_artifact}'"
  fi
done
unset phase_artifact

if ! runtime_launch_phase_publish \
    "${phase_file}" "${runtime_launch_phase_shim}"; then
  error 1 <<<"Could not publish netexec launch phase: '${phase_file}'"
fi
if [[ -n "${forward_port}" ]] && ! port_is_valid "${forward_port}"; then
  error 64 <<<"Invalid forward port: '${forward_port}' (must be canonical 1024-65535)"
fi

# Preflight QEMU before passt can background and become orphaned.
if ! command -v "${1}" &>/dev/null; then
  error "${passt_qemu_missing_exit_code}" <<MESSAGE
QEMU command not found or not executable: ${1}
MESSAGE
fi

if ! command -v passt &>/dev/null; then
  error "${passt_missing_exit_code}" <<MESSAGE
passt not found in PATH.
Install it: pacman -S passt
MESSAGE
fi

passt_socket_clean "${socket}"

declare -a passt_argv=()
passt_command passt_argv "${socket}" "${forward_port}" "${allow_host_loopback}"
if ! "${passt_argv[@]}"; then
  error "${passt_init_failure_exit_code}" <<MESSAGE
passt failed to initialise. The socket did not come up.
Investigate the unit logs: journalctl --user -u virtdev-<project>
MESSAGE
fi

if ! runtime_launch_phase_publish \
    "${phase_file}" "${runtime_launch_phase_qemu}"; then
  error 1 <<<"Could not publish QEMU launch phase: '${phase_file}'"
fi
exec "$@"
