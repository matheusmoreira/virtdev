#!/usr/bin/env bash

set -euo pipefail

systemctl_wants_active_state=0
systemctl_wants_exec_main_status=0
systemctl_wants_main_pid=0
systemctl_wants_id=0
systemctl_wants_control_group=0
systemctl_wants_slice=0
systemctl_next_property=0
for systemctl_arg in "$@"; do
  systemctl_property=''
  if (( systemctl_next_property )); then
    systemctl_property="${systemctl_arg}"
    systemctl_next_property=0
  else
    case "${systemctl_arg}" in
      -p|--property) systemctl_next_property=1 ;;
      --property=*)  systemctl_property="${systemctl_arg#*=}" ;;
    esac
  fi
  case "${systemctl_property}" in
    ActiveState)    systemctl_wants_active_state=1 ;;
    ExecMainStatus) systemctl_wants_exec_main_status=1 ;;
    MainPID)        systemctl_wants_main_pid=1 ;;
    Id)             systemctl_wants_id=1 ;;
    ControlGroup)   systemctl_wants_control_group=1 ;;
    Slice)          systemctl_wants_slice=1 ;;
  esac
done

state="${SYSTEMCTL_ACTIVE_STATE:-inactive}"
if [[ -n "${SYSTEMCTL_STATE_FILE:-}" && -f "${SYSTEMCTL_STATE_FILE}" ]]; then
  state="$(< "${SYSTEMCTL_STATE_FILE}")"
fi
if (( systemctl_wants_active_state )) \
    && [[ -n "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE:-}" \
          && -s "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}" ]]; then
  IFS= read -r state < "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}"
  tail -n +2 "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}" \
    > "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}.tmp"
  mv -T -- "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}.tmp" \
    "${SYSTEMCTL_ACTIVE_SEQUENCE_FILE}"
fi

if [[ " $* " == *" stop "* ]]; then
  [[ -n "${SYSTEMCTL_STOP_FILE:-}" ]] && : > "${SYSTEMCTL_STOP_FILE}"
  [[ -z "${SYSTEMCTL_STOP_DELAY:-}" ]] || sleep "${SYSTEMCTL_STOP_DELAY}"
  if [[ "${SYSTEMCTL_UNREACHABLE:-0}" == 1 \
        || ( -n "${SYSTEMCTL_UNREACHABLE_FILE:-}" \
             && -e "${SYSTEMCTL_UNREACHABLE_FILE}" ) ]]; then
    exit 1
  fi
  if [[ -n "${SYSTEMCTL_STATE_FILE:-}" ]]; then
    printf 'inactive\n' > "${SYSTEMCTL_STATE_FILE}"
  fi
  [[ -n "${SYSTEMCTL_STOP_DONE_FILE:-}" ]] && : > "${SYSTEMCTL_STOP_DONE_FILE}"
  exit 0
fi

if [[ "${SYSTEMCTL_UNREACHABLE:-0}" == 1 \
      || ( -n "${SYSTEMCTL_UNREACHABLE_FILE:-}" \
           && -e "${SYSTEMCTL_UNREACHABLE_FILE}" ) ]]; then
  exit 1
fi

if [[ " $* " == *" list-units "* ]]; then
  if [[ -n "${SYSTEMCTL_LIST_UNITS_FILE:-}" \
      && -f "${SYSTEMCTL_LIST_UNITS_FILE}" ]]; then
    cat -- "${SYSTEMCTL_LIST_UNITS_FILE}"
  fi
  exit "${SYSTEMCTL_LIST_STATUS:-0}"
fi

if [[ " $* " == *" show "* ]]; then
  [[ -z "${SYSTEMCTL_SHOW_DELAY:-}" ]] || sleep "${SYSTEMCTL_SHOW_DELAY}"
  if (( systemctl_wants_exec_main_status )); then
    printf '%s\n' "${SYSTEMCTL_EXEC_MAIN_STATUS:-0}"
  elif (( systemctl_wants_main_pid )); then
    printf '%s\n' "${SYSTEMCTL_MAIN_PID:-0}"
  elif (( systemctl_wants_control_group )); then
    printf '%s\n' "${SYSTEMCTL_CONTROL_GROUP:-/user.slice/virtdev.slice/virtdev-probe.service}"
  elif (( systemctl_wants_slice )); then
    printf '%s\n' "${SYSTEMCTL_SLICE:-virtdev-none.slice}"
  elif (( systemctl_wants_id && systemctl_wants_active_state )); then
    for systemctl_arg in "$@"; do
      [[ "${systemctl_arg}" == virtdev-* ]] || continue
      systemctl_unit="${systemctl_arg}"
      [[ "${systemctl_unit}" == *.service ]] \
        || systemctl_unit+='.service'
      systemctl_unit_state="${state}"
      if [[ -n "${SYSTEMCTL_STATE_MAP_FILE:-}" \
            && -f "${SYSTEMCTL_STATE_MAP_FILE}" ]]; then
        while read -r systemctl_map_unit systemctl_map_state; do
          if [[ "${systemctl_map_unit}" == "${systemctl_unit}" ]]; then
            systemctl_unit_state="${systemctl_map_state}"
            break
          fi
        done < "${SYSTEMCTL_STATE_MAP_FILE}"
      fi
      printf 'Id=%s\nActiveState=%s\n\n' \
        "${systemctl_unit}" "${systemctl_unit_state}"
    done
  else
    printf '%s\n' "${state}"
  fi
  exit 0
fi

if [[ " $* " == *" is-active "* ]]; then
  [[ -z "${SYSTEMCTL_IS_ACTIVE_DELAY:-}" ]] \
    || sleep "${SYSTEMCTL_IS_ACTIVE_DELAY}"
  printf '%s\n' "${state}"
  case "${state}" in
    active|activating|reloading) exit 0 ;;
    *) exit 3 ;;
  esac
fi
