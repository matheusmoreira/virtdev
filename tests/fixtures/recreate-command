#!/usr/bin/env bash

set -euo pipefail

command_name="${0##*/}"
phase="${command_name#virtdev-}"
project="${!#}"

if [[ "${phase}" == recreate ]]; then
  if [[ -n "${UPGRADE_RECREATE_ARGS_FILE:-}" ]]; then
    printf '%s\0' "$@" > "${UPGRADE_RECREATE_ARGS_FILE}"
  fi
  recreate_status="${UPGRADE_RECREATE_STATUS:-0}"
  if (( recreate_status == 23 )); then
    rm -rf -- "${VIRTDEV_HOME:?}/projects/${project}"
  fi
  exit "${recreate_status}"
fi

if [[ "${RECREATE_FAIL_STEP:-}" == "${phase}" ]]; then
  exit 1
fi
IFS=',' read -r -a failure_steps <<< "${RECREATE_FAIL_STEPS:-}"
for failure_step in "${failure_steps[@]}"; do
  [[ -z "${failure_step}" || "${failure_step}" != "${phase}" ]] || exit 1
done

case "${phase}" in
  backup)
    mkdir -p "${RECREATE_SNAPSHOT_PATH:?}/tree"
    printf '%s\n' "${RECREATE_SNAPSHOT_PATH}"
    ;;
  destroy)
    rm -rf -- "${VIRTDEV_HOME:?}/projects/${project}"
    ;;
  create)
    mkdir -p "${VIRTDEV_HOME:?}/projects/${project}"
    ;;
  restore)
    if [[ -n "${RECREATE_RESTORE_ARGS_FILE:-}" ]]; then
      printf '%s\0' "$@" > "${RECREATE_RESTORE_ARGS_FILE}"
    fi
    ;;
  ssh)
    if [[ -n "${RECREATE_SSH_ARGS_FILE:-}" ]]; then
      printf '%s\0' "$@" > "${RECREATE_SSH_ARGS_FILE}"
    fi
    ;;
  maintain|start|stop|wait) ;;
  *)
    printf 'unexpected recreate fixture command: %s\n' "${command_name}" >&2
    exit 64
    ;;
esac
