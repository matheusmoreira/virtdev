#!/usr/bin/env bash

set -euo pipefail

command_name="${0##*/}"
phase="${command_name#virtdev-}"
project="${!#}"

case "${phase}" in
  backup|stop|destroy|create|start|wait|recreate)
    if [[ "${project}" == -* ]]; then
      previous_index=$(( $# - 1 ))
      (( previous_index > 0 )) && [[ "${!previous_index}" == -- ]] || exit 64
    fi
    ;;
esac

if [[ "${phase}" == destroy \
      && -n "${RECREATE_MUTATE_PROVISION_SOURCE:-}" ]]; then
  printf 'mutated\n' > "${RECREATE_MUTATE_PROVISION_SOURCE}"
fi

if [[ "${phase}" == recreate ]]; then
  if [[ -n "${UPGRADE_RECREATE_ARGS_FILE:-}" ]]; then
    printf '%s\0' "$@" > "${UPGRADE_RECREATE_ARGS_FILE}"
  fi
  if [[ -n "${UPGRADE_PROVISION_CAPTURE_FILE:-}" ]]; then
    recreate_arguments=("$@")
    for (( argument_index = 0; \
          argument_index + 1 < ${#recreate_arguments[@]}; \
          ++argument_index )); do
      if [[ "${recreate_arguments[argument_index]}" == --provision ]]; then
        cp -- "${recreate_arguments[argument_index + 1]}" \
          "${UPGRADE_PROVISION_CAPTURE_FILE}"
      fi
    done
  fi
  recreate_status="${UPGRADE_RECREATE_STATUS:-0}"
  if (( recreate_status == 23 )); then
    rm -rf -- "${VIRTDEV_HOME:?}/projects/${project}"
  fi
  exit "${recreate_status}"
fi

if [[ "${phase}" == restore && "${1:-}" == --preflight ]]; then
  [[ "${RECREATE_FAIL_PREFLIGHT:-0}" != 1 ]]
  exit
fi

if [[ "${phase}" == create && "${RECREATE_FAIL_STEP:-}" == create \
      && "${RECREATE_PRESERVE_CREATE_PARTIAL:-0}" == 1 ]]; then
  mkdir -p "${VIRTDEV_HOME:?}/projects/${project}"
  exit 1
fi

if [[ "${phase}" == stop && -n "${RECREATE_STOP_STATUS:-}" ]]; then
  exit "${RECREATE_STOP_STATUS}"
fi

if [[ "${phase}" == maintain && -n "${RECREATE_MAINTAIN_STATUS:-}" ]]; then
  exit "${RECREATE_MAINTAIN_STATUS}"
fi

if [[ "${phase}" == maintain \
      && -n "${RECREATE_MUTATE_UPGRADE_PROVISION_SOURCE:-}" ]]; then
  printf 'mutated\n' > "${RECREATE_MUTATE_UPGRADE_PROVISION_SOURCE}"
fi

if [[ "${RECREATE_FAIL_STEP:-}" == "${phase}" ]]; then
  exit 1
fi
IFS=',' read -r -a failure_steps <<< "${RECREATE_FAIL_STEPS:-}"
for failure_step in "${failure_steps[@]}"; do
  [[ -z "${failure_step}" || "${failure_step}" != "${phase}" ]] || exit 1
done

case "${phase}" in
  backup)
    mkdir -p "${RECREATE_SNAPSHOT_PATH:?}/tree"
    printf '%s\n' "${RECREATE_SNAPSHOT_PATH}"
    ;;
  destroy)
    rm -rf -- "${VIRTDEV_HOME:?}/projects/${project}"
    ;;
  create)
    mkdir -p "${VIRTDEV_HOME:?}/projects/${project}"
    ;;
  restore)
    if [[ -n "${RECREATE_RESTORE_ARGS_FILE:-}" ]]; then
      printf '%s\0' "$@" > "${RECREATE_RESTORE_ARGS_FILE}"
    fi
    ;;
  ssh)
    if [[ -n "${RECREATE_SSH_STDIN_FILE:-}" ]]; then
      tee "${RECREATE_SSH_STDIN_FILE}" >/dev/null
    fi
    if [[ -n "${RECREATE_SSH_ARGS_FILE:-}" ]]; then
      printf '%s\0' "$@" > "${RECREATE_SSH_ARGS_FILE}"
    fi
    ;;
  maintain|start|stop|wait) ;;
  *)
    printf 'unexpected recreate fixture command: %s\n' "${command_name}" >&2
    exit 64
    ;;
esac
