#!/usr/bin/env bash

set -euo pipefail

if (( $# >= 2 )) \
    && [[ "${*: -2:1}" == bash && "${*: -1}" == -s ]] \
    && [[ "${MAINTENANCE_EXECUTE_HOOKS:-0}" == 1 ]]; then
  : "${MAINTENANCE_HOOK_CAPTURE_DIRECTORY:?}"
  mkdir -p -- "${MAINTENANCE_HOOK_CAPTURE_DIRECTORY}"
  hook_count_file="${MAINTENANCE_HOOK_CAPTURE_DIRECTORY}/count"
  hook_count=0
  [[ ! -s "${hook_count_file}" ]] || hook_count="$(< "${hook_count_file}")"
  hook_count=$(( hook_count + 1 ))
  printf '%d\n' "${hook_count}" > "${hook_count_file}"
  hook_capture="${MAINTENANCE_HOOK_CAPTURE_DIRECTORY}/${hook_count}"
  cat > "${hook_capture}"
  if (( hook_count == 1 )) && [[ -n "${MAINTENANCE_HOOK_REPLACE_SOURCE:-}" ]]; then
    printf "printf 'replacement-inventory\\n'\n" \
      > "${MAINTENANCE_HOOK_REPLACE_SOURCE}"
  fi
  exec bash -s < "${hook_capture}"
fi

case "${MAINTENANCE_SSH_MODE:-failure}" in
  ready)
    exit 0
    ;;
  ready-exit)
    : "${SYSTEMCTL_STATE_FILE:?}"
    printf 'inactive\n' > "${SYSTEMCTL_STATE_FILE}"
    exit 0
    ;;
  ready-boot2-exit)
    : "${SYSTEMCTL_STATE_FILE:?}"
    : "${MAINTENANCE_BOOT_COUNT_FILE:?}"
    if [[ "$(< "${MAINTENANCE_BOOT_COUNT_FILE}")" == 2 ]]; then
      printf 'inactive\n' > "${SYSTEMCTL_STATE_FILE}"
    fi
    exit 0
    ;;
  manager-loss)
    : "${SYSTEMCTL_UNREACHABLE_FILE:?}"
    : > "${SYSTEMCTL_UNREACHABLE_FILE}"
    exit 1
    ;;
  failure)
    exit 1
    ;;
  *)
    exit 2
    ;;
esac
