#!/usr/bin/env bash

set -euo pipefail

[[ -n "${BACKUP_PID_FILE:-}" ]] && printf '%d\n' "$$" > "${BACKUP_PID_FILE}"
if [[ -n "${BACKUP_COMMAND_FILE:-}" ]]; then
  printf '%s\n' "$*" > "${BACKUP_COMMAND_FILE}"
fi
cat >/dev/null
if [[ -n "${BACKUP_READY_FILE:-}" ]]; then
  printf '%d\n' "$$" > "${BACKUP_READY_FILE}"
fi
if [[ -n "${BACKUP_TRIGGER_FILE:-}" ]]; then
  while [[ ! -e "${BACKUP_TRIGGER_FILE}" ]]; do
    sleep 0.01
  done
fi
if [[ -n "${BACKUP_STREAM_DELAY:-}" ]]; then
  sleep "${BACKUP_STREAM_DELAY}"
fi
if [[ -n "${BACKUP_STDERR_BYTES:-}" ]]; then
  head -c "${BACKUP_STDERR_BYTES}" /dev/zero | tr '\0' x >&2
fi
cat -- "${BACKUP_TAR_STREAM:?}"
exit "${BACKUP_SSH_STATUS:-0}"
