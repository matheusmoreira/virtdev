#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  info)
    if [[ "${QEMU_HAS_BACKING:-1}" == 1 ]]; then
      printf '{"backing-filename":"/base/image.qcow2"}\n'
    else
      printf '{}\n'
    fi
    ;;
  *)
    if [[ -n "${QEMU_LOG:-}" ]]; then
      printf '%s\n' "$*" >> "${QEMU_LOG}"
    fi
    exit "${QEMU_OTHER_STATUS:-99}"
    ;;
esac
