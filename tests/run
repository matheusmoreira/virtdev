#!/usr/bin/env bash

set -euo pipefail

test_directory="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
test_lock_directory=""

if [[ -z "${VIRTDEV_LOCK_DIRECTORY:-}" ]]; then
  test_lock_directory="$(mktemp -d --tmpdir virtdev-tests.XXXXXXXXXX)"
  export VIRTDEV_LOCK_DIRECTORY="${test_lock_directory}"
fi

# shellcheck disable=SC2329  # invoked by the EXIT trap
cleanup() {
  [[ -z "${test_lock_directory}" ]] \
    || rm -rf -- "${test_lock_directory}"
}
trap cleanup EXIT

status=0
mapfile -t test_files \
  < <(find "${test_directory}" -maxdepth 1 -type f -name 'test-*.bash' \
    -print | LC_ALL=C sort)

for test_file in "${test_files[@]}"; do
  printf 'TEST %s\n' "$(basename "${test_file}")"
  if ! bash "${test_file}" </dev/null; then
    status=1
  fi
done

exit "${status}"
